<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>383. Pentru cei bolnavi</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:03.847"><div><p begin="0:08.020" end="0:14.903" ttm:agent="v1"><span begin="0:08.020" end="0:09.397">Pentru</span> <span begin="0:09.397" end="0:10.085">cei</span> <span begin="0:10.085" end="0:11.462">bolnavi</span> <span begin="0:11.462" end="0:14.903">coboară</span></p><p begin="0:14.903" end="0:20.410" ttm:agent="v1"><span begin="0:14.903" end="0:16.280">Înc-o</span> <span begin="0:16.280" end="0:17.657">dată</span> <span begin="0:17.657" end="0:18.345">pe</span> <span begin="0:18.345" end="0:20.410">pământ,</span></p><p begin="0:20.410" end="0:27.293" ttm:agent="v1"><span begin="0:20.410" end="0:21.098">Cum</span> <span begin="0:21.098" end="0:21.787">ai</span> <span begin="0:21.787" end="0:22.475">fost</span> <span begin="0:22.475" end="0:27.293">odinioară,</span></p><p begin="0:27.293" end="0:33.040" ttm:agent="v1"><span begin="0:27.293" end="0:28.670">Medic</span> <span begin="0:28.670" end="0:30.735">iubitor</span> <span begin="0:30.735" end="0:31.423">și</span> <span begin="0:31.423" end="0:33.040">blând!</span></p><p begin="0:33.040" end="0:39.923" ttm:agent="v1"><span begin="0:33.040" end="0:33.728">Le</span> <span begin="0:33.728" end="0:35.793">alină</span> <span begin="0:35.793" end="0:39.923">suferința,</span></p><p begin="0:39.923" end="0:45.430" ttm:agent="v1"><span begin="0:39.923" end="0:41.300">Fi-le</span> <span begin="0:41.300" end="0:41.988">bun</span> <span begin="0:41.988" end="0:45.430">Mângâietor,</span></p><p begin="0:45.430" end="0:52.313" ttm:agent="v1"><span begin="0:45.430" end="0:48.872">Întărește-le</span> <span begin="0:48.872" end="0:52.313">credința,</span></p><p begin="0:52.313" end="1:01.340" ttm:agent="v1"><span begin="0:52.313" end="0:53.690">Dă-le</span> <span begin="0:53.690" end="0:54.378">sfat</span> <span begin="0:54.378" end="0:55.067">și</span> <span begin="0:55.067" end="1:01.340">ajutor!</span></p><p begin="1:01.340" end="1:08.189" ttm:agent="v1"><span begin="1:01.340" end="1:04.080">Mântuiește-i</span> <span begin="1:04.080" end="1:04.764">din</span> <span begin="1:04.764" end="1:08.189">păcate,</span></p><p begin="1:08.189" end="1:13.668" ttm:agent="v1"><span begin="1:08.189" end="1:10.244">Spune-le</span> <span begin="1:10.244" end="1:10.928">că</span> <span begin="1:10.928" end="1:11.613">sunt</span> <span begin="1:11.613" end="1:13.668">iertați,</span></p><p begin="1:13.668" end="1:20.517" ttm:agent="v1"><span begin="1:13.668" end="1:14.353">Să</span> <span begin="1:14.353" end="1:15.038">te</span> <span begin="1:15.038" end="1:16.408">simtă</span> <span begin="1:16.408" end="1:17.093">ca</span> <span begin="1:17.093" end="1:17.777">un</span> <span begin="1:17.777" end="1:20.517">Frate</span></p><p begin="1:20.517" end="1:27.356" ttm:agent="v1"><span begin="1:20.517" end="1:21.202">Și</span> <span begin="1:21.202" end="1:21.887">să</span> <span begin="1:21.887" end="1:23.257">fie</span> <span begin="1:23.257" end="1:27.356">vindecați!</span></p><p begin="1:27.356" end="1:34.308" ttm:agent="v1"><span begin="1:27.356" end="1:28.746">Doamne,</span> <span begin="1:28.746" end="1:29.442">Tu</span> <span begin="1:29.442" end="1:30.137">știi</span> <span begin="1:30.137" end="1:30.832">cel</span> <span begin="1:30.832" end="1:31.527">mai</span> <span begin="1:31.527" end="1:34.308">bine,</span></p><p begin="1:34.308" end="1:39.869" ttm:agent="v1"><span begin="1:34.308" end="1:35.003">Știi</span> <span begin="1:35.003" end="1:35.698">ce</span> <span begin="1:35.698" end="1:37.088">vremuri</span> <span begin="1:37.088" end="1:37.784">vor</span> <span begin="1:37.784" end="1:39.869">urma,</span></p><p begin="1:39.869" end="1:46.821" ttm:agent="v1"><span begin="1:39.869" end="1:40.564">Noi</span> <span begin="1:40.564" end="1:42.650">ne-ncredem</span> <span begin="1:42.650" end="1:43.345">doar</span> <span begin="1:43.345" end="1:44.040">în</span> <span begin="1:44.040" end="1:46.821">Tine,</span></p><p begin="1:46.821" end="1:52.382" ttm:agent="v1"><span begin="1:46.821" end="1:48.906">Facă-se</span> <span begin="1:48.906" end="1:49.601">doar</span> <span begin="1:49.601" end="1:50.992">voia</span> <span begin="1:50.992" end="1:52.382">Ta!</span></p></div></body></tt>