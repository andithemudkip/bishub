<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>179. ’Naintea Ta, Isus iubit!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:51.180"><div><p begin="0:14.940" end="0:21.159" ttm:agent="v1"><span begin="0:14.940" end="0:17.272">’Naintea</span> <span begin="0:17.272" end="0:18.049">Ta,</span> <span begin="0:18.049" end="0:19.604">Isus</span> <span begin="0:19.604" end="0:21.159">iubit,</span></p><p begin="0:21.159" end="0:27.378" ttm:agent="v1"><span begin="0:21.159" end="0:21.936">Vin</span> <span begin="0:21.936" end="0:22.714">azi</span> <span begin="0:22.714" end="0:27.378">încrezător,</span></p><p begin="0:27.378" end="0:33.597" ttm:agent="v1"><span begin="0:27.378" end="0:28.155">Căci</span> <span begin="0:28.155" end="0:28.933">Tu</span> <span begin="0:28.933" end="0:31.265">de-aceea</span> <span begin="0:31.265" end="0:32.042">Te-ai</span> <span begin="0:32.042" end="0:33.597">jertfit,</span></p><p begin="0:33.597" end="0:39.816" ttm:agent="v1"><span begin="0:33.597" end="0:34.375">Să-mi</span> <span begin="0:34.375" end="0:35.152">fii</span> <span begin="0:35.152" end="0:39.816">Mântuitor!</span></p><p begin="0:39.816" end="0:46.036" ttm:agent="v1"><span begin="0:39.816" end="0:40.594">Ah,</span> <span begin="0:40.594" end="0:42.149">dulce-i</span> <span begin="0:42.149" end="0:42.926">să</span> <span begin="0:42.926" end="0:43.703">știi</span> <span begin="0:43.703" end="0:44.481">că</span> <span begin="0:44.481" end="0:45.258">stă</span> <span begin="0:45.258" end="0:46.036">scris:</span></p><p begin="0:46.036" end="0:52.255" ttm:agent="v1"><span begin="0:46.036" end="0:46.813">„Sunt</span> <span begin="0:46.813" end="0:48.368">gata</span> <span begin="0:48.368" end="0:49.145">să</span> <span begin="0:49.145" end="0:52.255">Te-ajut!”</span></p><p begin="0:52.255" end="0:58.474" ttm:agent="v1"><span begin="0:52.255" end="0:53.032">Tu</span> <span begin="0:53.032" end="0:55.364">bucurii</span> <span begin="0:55.364" end="0:56.142">din</span> <span begin="0:56.142" end="0:58.474">Paradis</span></p><p begin="0:58.474" end="1:05.973" ttm:agent="v1"><span begin="0:58.474" end="0:59.251">Mi-ai</span> <span begin="0:59.251" end="1:00.029">dat</span> <span begin="1:00.029" end="1:00.806">când</span> <span begin="1:00.806" end="1:01.584">Ți-am</span> <span begin="1:01.584" end="1:05.973">cerut...</span></p><p begin="1:05.973" end="1:12.161" ttm:agent="v1"><span begin="1:05.973" end="1:06.747">Eu</span> <span begin="1:06.747" end="1:09.067">altceva</span> <span begin="1:09.067" end="1:10.614">nimic</span> <span begin="1:10.614" end="1:12.161">n-aduc</span></p><p begin="1:12.161" end="1:18.349" ttm:agent="v1"><span begin="1:12.161" end="1:13.708">Decât</span> <span begin="1:13.708" end="1:14.482">o</span> <span begin="1:14.482" end="1:16.029">vină</span> <span begin="1:16.029" end="1:18.349">grea...</span></p><p begin="1:18.349" end="1:24.538" ttm:agent="v1"><span begin="1:18.349" end="1:19.123">Ah,</span> <span begin="1:19.123" end="1:20.670">unde,</span> <span begin="1:20.670" end="1:22.990">încotro</span> <span begin="1:22.990" end="1:24.538">s-apuc?</span></p><p begin="1:24.538" end="1:30.726" ttm:agent="v1"><span begin="1:24.538" end="1:25.311">Sper</span> <span begin="1:25.311" end="1:26.085">doar</span> <span begin="1:26.085" end="1:26.858">în</span> <span begin="1:26.858" end="1:28.405">mila</span> <span begin="1:28.405" end="1:30.726">Ta!</span></p><p begin="1:30.726" end="1:36.914" ttm:agent="v1"><span begin="1:30.726" end="1:31.499">În</span> <span begin="1:31.499" end="1:33.046">mine</span> <span begin="1:33.046" end="1:33.820">nu-i</span> <span begin="1:33.820" end="1:36.140">nimica</span> <span begin="1:36.140" end="1:36.914">bun,</span></p><p begin="1:36.914" end="1:43.102" ttm:agent="v1"><span begin="1:36.914" end="1:37.687">Tot</span> <span begin="1:37.687" end="1:38.461">ce-am</span> <span begin="1:38.461" end="1:40.008">făcut</span> <span begin="1:40.008" end="1:40.781">e</span> <span begin="1:40.781" end="1:43.102">rău;</span></p><p begin="1:43.102" end="1:49.290" ttm:agent="v1"><span begin="1:43.102" end="1:45.422">Nădejdea</span> <span begin="1:45.422" end="1:46.969">toată</span> <span begin="1:46.969" end="1:48.516">însă-o</span> <span begin="1:48.516" end="1:49.290">pun</span></p><p begin="1:49.290" end="1:56.958" ttm:agent="v1"><span begin="1:49.290" end="1:50.063">În</span> <span begin="1:50.063" end="1:53.158">ajutorul</span> <span begin="1:53.158" end="1:56.958">Tău!</span></p><p begin="1:56.958" end="2:03.146" ttm:agent="v1"><span begin="1:56.958" end="1:57.732">Gol,</span> <span begin="1:57.732" end="1:59.279">nimeni</span> <span begin="1:59.279" end="2:00.052">n-a</span> <span begin="2:00.052" end="2:01.599">venit</span> <span begin="2:01.599" end="2:03.146">’napoi,</span></p><p begin="2:03.146" end="2:09.334" ttm:agent="v1"><span begin="2:03.146" end="2:03.920">Din</span> <span begin="2:03.920" end="2:04.693">câți</span> <span begin="2:04.693" end="2:05.467">Te-au</span> <span begin="2:05.467" end="2:09.334">căutat,</span></p><p begin="2:09.334" end="2:15.522" ttm:agent="v1"><span begin="2:09.334" end="2:10.108">Căci</span> <span begin="2:10.108" end="2:10.881">Tu,</span> <span begin="2:10.881" end="2:11.655">pe</span> <span begin="2:11.655" end="2:12.428">toți,</span> <span begin="2:12.428" end="2:13.202">din</span> <span begin="2:13.202" end="2:13.975">mari</span> <span begin="2:13.975" end="2:15.522">nevoi</span></p><p begin="2:15.522" end="2:22.097" ttm:agent="v1"><span begin="2:15.522" end="2:16.296">I-ai</span> <span begin="2:16.296" end="2:17.069">scos</span> <span begin="2:17.069" end="2:17.843">când</span> <span begin="2:17.843" end="2:18.616">Te-au</span> <span begin="2:18.616" end="2:22.097">rugat!</span></p><p begin="2:22.097" end="2:27.899" ttm:agent="v1"><span begin="2:22.097" end="2:24.031">De-aceea,</span> <span begin="2:24.031" end="2:24.805">dar,</span> <span begin="2:24.805" end="2:26.352">acum</span> <span begin="2:26.352" end="2:27.125">și</span> <span begin="2:27.125" end="2:27.899">eu</span></p><p begin="2:27.899" end="2:34.087" ttm:agent="v1"><span begin="2:27.899" end="2:28.672">Cu</span> <span begin="2:28.672" end="2:30.219">lacrimi</span> <span begin="2:30.219" end="2:30.993">strig</span> <span begin="2:30.993" end="2:31.766">și</span> <span begin="2:31.766" end="2:34.087">sper:</span></p><p begin="2:34.087" end="2:40.275" ttm:agent="v1"><span begin="2:34.087" end="2:34.860">„Ah,</span> <span begin="2:34.860" end="2:37.181">mântuie</span> <span begin="2:37.181" end="2:39.501">sufletul</span> <span begin="2:39.501" end="2:40.275">meu,</span></p><p begin="2:40.275" end="2:45.689" ttm:agent="v1"><span begin="2:40.275" end="2:41.048">Nu</span> <span begin="2:41.048" end="2:41.822">mă</span> <span begin="2:41.822" end="2:43.369">lăsa</span> <span begin="2:43.369" end="2:44.142">să</span> <span begin="2:44.142" end="2:45.689">pier!”</span></p></div></body></tt>