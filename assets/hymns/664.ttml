<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>664. Ți-aducem, Doamne-acest copil!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:12.676"><div><p begin="0:12.530" end="0:18.093" ttm:agent="v1"><span begin="0:12.530" end="0:14.616">Ți-aducem</span> <span begin="0:14.616" end="0:17.050">Doamne-acest</span> <span begin="0:17.050" end="0:18.093">copil</span></p><p begin="0:18.093" end="0:23.655" ttm:agent="v1"><span begin="0:18.093" end="0:18.788">Să-l</span> <span begin="0:18.788" end="0:23.655">binecuvântezi,</span></p><p begin="0:23.655" end="0:29.218" ttm:agent="v1"><span begin="0:23.655" end="0:24.351">Cu</span> <span begin="0:24.351" end="0:25.741">mâna</span> <span begin="0:25.741" end="0:26.437">Ta</span> <span begin="0:26.437" end="0:27.132">un</span> <span begin="0:27.132" end="0:27.827">cer</span> <span begin="0:27.827" end="0:29.218">senin</span></p><p begin="0:29.218" end="0:36.021" ttm:agent="v1"><span begin="0:29.218" end="0:31.304">Deasupra</span> <span begin="0:31.304" end="0:31.999">lui</span> <span begin="0:31.999" end="0:36.021">s-așezi!</span></p><p begin="0:36.021" end="0:41.444" ttm:agent="v1"><span begin="0:36.021" end="0:38.055">Păstrează-l</span> <span begin="0:38.055" end="0:38.732">Tu,</span> <span begin="0:38.732" end="0:39.410">în</span> <span begin="0:39.410" end="0:40.766">grija</span> <span begin="0:40.766" end="0:41.444">Ta,</span></p><p begin="0:41.444" end="0:46.868" ttm:agent="v1"><span begin="0:41.444" end="0:42.800">Să</span> <span begin="0:42.800" end="0:43.478">crească-n</span> <span begin="0:43.478" end="0:44.156">har</span> <span begin="0:44.156" end="0:46.868">mereu,</span></p><p begin="0:46.868" end="0:52.291" ttm:agent="v1"><span begin="0:46.868" end="0:48.563">Curat,</span> <span begin="0:48.563" end="0:48.902">cu</span> <span begin="0:48.902" end="0:50.258">toată</span> <span begin="0:50.258" end="0:52.291">inima</span></p><p begin="0:52.291" end="0:59.315" ttm:agent="v1"><span begin="0:52.291" end="0:53.647">Iubind</span> <span begin="0:53.647" end="0:54.325">pe</span> <span begin="0:54.325" end="0:59.315">Dumnezeu!</span></p><p begin="0:59.315" end="1:04.766" ttm:agent="v1"><span begin="0:59.315" end="1:01.359">I-ndreaptă</span> <span begin="1:01.359" end="1:02.722">ochii</span> <span begin="1:02.722" end="1:04.084">către</span> <span begin="1:04.084" end="1:04.766">cer</span></p><p begin="1:04.766" end="1:10.217" ttm:agent="v1"><span begin="1:04.766" end="1:06.810">Să-nvingă</span> <span begin="1:06.810" end="1:08.172">lumea</span> <span begin="1:08.172" end="1:10.217">rea,</span></p><p begin="1:10.217" end="1:15.667" ttm:agent="v1"><span begin="1:10.217" end="1:12.261">Să-nvețe-al</span> <span begin="1:12.261" end="1:14.305">dragostei</span> <span begin="1:14.305" end="1:15.667">mister,</span></p><p begin="1:15.667" end="1:22.538" ttm:agent="v1"><span begin="1:15.667" end="1:16.349">Pe</span> <span begin="1:16.349" end="1:17.711">Tine-a</span> <span begin="1:17.711" end="1:18.393">Te</span> <span begin="1:18.393" end="1:22.538">urma!</span></p><p begin="1:22.538" end="1:28.016" ttm:agent="v1"><span begin="1:22.538" end="1:24.592">Trimite,</span> <span begin="1:24.592" end="1:25.962">Doamne,</span> <span begin="1:25.962" end="1:27.331">îngeri</span> <span begin="1:27.331" end="1:28.016">buni</span></p><p begin="1:28.016" end="1:33.494" ttm:agent="v1"><span begin="1:28.016" end="1:28.701">Să-l</span> <span begin="1:28.701" end="1:30.070">poarte,</span> <span begin="1:30.070" end="1:33.494">iubitor,</span></p><p begin="1:33.494" end="1:38.972" ttm:agent="v1"><span begin="1:33.494" end="1:34.179">Spre</span> <span begin="1:34.179" end="1:35.548">cerul</span> <span begin="1:35.548" end="1:36.233">plin</span> <span begin="1:36.233" end="1:36.918">de</span> <span begin="1:36.918" end="1:37.602">mari</span> <span begin="1:37.602" end="1:38.972">minuni</span></p><p begin="1:38.972" end="1:45.930" ttm:agent="v1"><span begin="1:38.972" end="1:39.657">Să</span> <span begin="1:39.657" end="1:40.341">fii</span> <span begin="1:40.341" end="1:41.026">al</span> <span begin="1:41.026" end="1:41.711">lui</span> <span begin="1:41.711" end="1:45.930">Păstor!</span></p><p begin="1:45.930" end="1:51.353" ttm:agent="v1"><span begin="1:45.930" end="1:46.608">Cu</span> <span begin="1:46.608" end="1:50.675">binecuvântarea</span> <span begin="1:50.675" end="1:51.353">Ta</span></p><p begin="1:51.353" end="1:56.776" ttm:agent="v1"><span begin="1:51.353" end="1:54.065">Zidește-ne</span> <span begin="1:54.065" end="1:56.776">deplin,</span></p><p begin="1:56.776" end="2:02.199" ttm:agent="v1"><span begin="1:56.776" end="1:57.454">Să</span> <span begin="1:57.454" end="1:58.471">fim,</span> <span begin="1:58.471" end="1:58.810">când</span> <span begin="1:58.810" end="1:59.488">Tu</span> <span begin="1:59.488" end="2:00.166">ne</span> <span begin="2:00.166" end="2:00.844">vei</span> <span begin="2:00.844" end="2:02.199">chema,</span></p><p begin="2:02.199" end="2:06.267" ttm:agent="v1"><span begin="2:02.199" end="2:02.877">Cu</span> <span begin="2:02.877" end="2:04.233">Tine-n</span> <span begin="2:04.233" end="2:04.911">veci!</span> <span begin="2:04.911" end="2:06.267">Amin.</span></p></div></body></tt>