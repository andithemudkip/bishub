<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>688. Rămâi cu pacea Ta</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:30.462"><div><p begin="0:13.020" end="0:19.039" ttm:agent="v1"><span begin="0:13.020" end="0:14.525">Rămâi</span> <span begin="0:14.525" end="0:15.277">cu</span> <span begin="0:15.277" end="0:16.782">pacea</span> <span begin="0:16.782" end="0:19.039">Ta,</span></p><p begin="0:19.039" end="0:25.058" ttm:agent="v1"><span begin="0:19.039" end="0:21.296">Părinte,</span> <span begin="0:21.296" end="0:22.049">Te</span> <span begin="0:22.049" end="0:25.058">rugăm,</span></p><p begin="0:25.058" end="0:31.078" ttm:agent="v1"><span begin="0:25.058" end="0:25.811">Prin</span> <span begin="0:25.811" end="0:27.316">Duhul</span> <span begin="0:27.316" end="0:28.068">Sfânt</span> <span begin="0:28.068" end="0:28.820">a</span> <span begin="0:28.820" end="0:29.573">Te</span> <span begin="0:29.573" end="0:31.078">urma,</span></p><p begin="0:31.078" end="0:38.097" ttm:agent="v1"><span begin="0:31.078" end="0:31.830">Noi</span> <span begin="0:31.830" end="0:33.335">Ție</span> <span begin="0:33.335" end="0:38.097">ne-ncredințăm!</span></p><p begin="0:38.097" end="0:44.116" ttm:agent="v1"><span begin="0:38.097" end="0:39.602">Rămâi</span> <span begin="0:39.602" end="0:40.354">cu</span> <span begin="0:40.354" end="0:41.859">harul</span> <span begin="0:41.859" end="0:44.116">Tău,</span></p><p begin="0:44.116" end="0:50.135" ttm:agent="v1"><span begin="0:44.116" end="0:44.868">Căci</span> <span begin="0:44.868" end="0:46.373">ziua-i</span> <span begin="0:46.373" end="0:47.126">spre</span> <span begin="0:47.126" end="0:50.135">apus,</span></p><p begin="0:50.135" end="0:56.154" ttm:agent="v1"><span begin="0:50.135" end="0:50.888">Să</span> <span begin="0:50.888" end="0:51.640">ne</span> <span begin="0:51.640" end="0:53.145">ferești</span> <span begin="0:53.145" end="0:53.897">de</span> <span begin="0:53.897" end="0:55.402">orice</span> <span begin="0:55.402" end="0:56.154">rău,</span></p><p begin="0:56.154" end="1:03.214" ttm:agent="v1"><span begin="0:56.154" end="0:57.659">Prin</span> <span begin="0:57.659" end="0:58.412">dragostea</span> <span begin="0:58.412" end="0:59.164">Ta,</span> <span begin="0:59.164" end="1:03.214">Isus!</span></p><p begin="1:03.214" end="1:09.173" ttm:agent="v1"><span begin="1:03.214" end="1:04.703">Rămâi</span> <span begin="1:04.703" end="1:05.448">pe</span> <span begin="1:05.448" end="1:06.193">veci</span> <span begin="1:06.193" end="1:06.938">în</span> <span begin="1:06.938" end="1:09.173">noi,</span></p><p begin="1:09.173" end="1:15.132" ttm:agent="v1"><span begin="1:09.173" end="1:09.917">O,</span> <span begin="1:09.917" end="1:11.407">Tată,</span> <span begin="1:11.407" end="1:12.152">Te</span> <span begin="1:12.152" end="1:15.132">rugăm,</span></p><p begin="1:15.132" end="1:21.091" ttm:agent="v1"><span begin="1:15.132" end="1:15.876">Ne</span> <span begin="1:15.876" end="1:16.621">fii</span> <span begin="1:16.621" end="1:18.856">speranță</span> <span begin="1:18.856" end="1:19.601">în</span> <span begin="1:19.601" end="1:21.091">nevoi,</span></p><p begin="1:21.091" end="1:24.815" ttm:agent="v1"><span begin="1:21.091" end="1:22.953">Isuse,</span> <span begin="1:22.953" end="1:23.325">Te</span> <span begin="1:23.325" end="1:24.815">așteptăm!</span></p></div></body></tt>