<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>377. De zici: „Iubesc pe Dumnezeu”</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="3:03.536"><div><p begin="0:12.516" end="0:18.525" ttm:agent="v1"><span begin="0:12.516" end="0:13.267">De</span> <span begin="0:13.267" end="0:14.770">zici:</span> <span begin="0:14.770" end="0:15.521">„Iubesc</span> <span begin="0:15.521" end="0:17.023">pe</span> <span begin="0:17.023" end="0:18.525">Dumnezeu”,</span></p><p begin="0:18.525" end="0:25.284" ttm:agent="v1"><span begin="0:18.525" end="0:19.276">Iar</span> <span begin="0:19.276" end="0:21.530">fratelui</span> <span begin="0:21.530" end="0:22.281">porți</span> <span begin="0:22.281" end="0:25.284">ură,</span></p><p begin="0:25.284" end="0:31.293" ttm:agent="v1"><span begin="0:25.284" end="0:26.035">Nu-i</span> <span begin="0:26.035" end="0:28.288">adevăr</span> <span begin="0:28.288" end="0:29.039">în</span> <span begin="0:29.039" end="0:30.542">glasul</span> <span begin="0:30.542" end="0:31.293">tău,</span></p><p begin="0:31.293" end="0:38.052" ttm:agent="v1"><span begin="0:31.293" end="0:32.044">Spui</span> <span begin="0:32.044" end="0:33.546">doar</span> <span begin="0:33.546" end="0:34.297">minciuni</span> <span begin="0:34.297" end="0:35.048">din</span> <span begin="0:35.048" end="0:38.052">gură!</span></p><p begin="0:38.052" end="0:44.060" ttm:agent="v1"><span begin="0:38.052" end="0:39.470">Iubești</span> <span begin="0:39.470" end="0:40.472">pe</span> <span begin="0:40.472" end="0:42.558">Dumnezeu,</span> <span begin="0:42.558" end="0:43.309">tu</span> <span begin="0:43.309" end="0:44.060">crezi,</span></p><p begin="0:44.060" end="0:54.299" ttm:agent="v1"><span begin="0:44.060" end="0:45.563">Urând</span> <span begin="0:45.563" end="0:46.314">pe</span> <span begin="0:46.314" end="0:48.567">frate-tău</span> <span begin="0:48.567" end="0:49.318">ce-l</span> <span begin="0:49.318" end="0:54.299">vezi?...</span></p><p begin="0:54.299" end="1:00.278" ttm:agent="v1"><span begin="0:54.299" end="0:55.046">De</span> <span begin="0:55.046" end="0:55.794">vei</span> <span begin="0:55.794" end="0:57.289">privi</span> <span begin="0:57.289" end="1:00.278">nepăsător</span></p><p begin="1:00.278" end="1:07.007" ttm:agent="v1"><span begin="1:00.278" end="1:01.025">Pe</span> <span begin="1:01.025" end="1:01.773">cel</span> <span begin="1:01.773" end="1:02.520">în</span> <span begin="1:02.520" end="1:07.007">suferință</span></p><p begin="1:07.007" end="1:12.985" ttm:agent="v1"><span begin="1:07.007" end="1:07.754">Și</span> <span begin="1:07.754" end="1:08.501">nu-i</span> <span begin="1:08.501" end="1:09.249">vei</span> <span begin="1:09.249" end="1:09.996">da</span> <span begin="1:09.996" end="1:10.743">vreun</span> <span begin="1:10.743" end="1:12.985">ajutor</span></p><p begin="1:12.985" end="1:19.714" ttm:agent="v1"><span begin="1:12.985" end="1:13.733">Când</span> <span begin="1:13.733" end="1:15.227">are</span> <span begin="1:15.227" end="1:19.714">trebuință,</span></p><p begin="1:19.714" end="1:25.693" ttm:agent="v1"><span begin="1:19.714" end="1:20.461">Nu</span> <span begin="1:20.461" end="1:21.126">ești</span> <span begin="1:21.126" end="1:22.787">creștin,</span> <span begin="1:22.787" end="1:23.451">ci</span> <span begin="1:23.451" end="1:24.198">minți</span> <span begin="1:24.198" end="1:25.693">mereu</span></p><p begin="1:25.693" end="1:35.562" ttm:agent="v1"><span begin="1:25.693" end="1:26.440">Când</span> <span begin="1:26.440" end="1:27.935">zici:</span> <span begin="1:27.935" end="1:28.682">„Iubesc</span> <span begin="1:28.682" end="1:29.430">pe</span> <span begin="1:29.430" end="1:35.562">Dumnezeu.”</span></p><p begin="1:35.562" end="1:41.511" ttm:agent="v1"><span begin="1:35.562" end="1:36.305">Când</span> <span begin="1:36.305" end="1:37.792">cinstea</span> <span begin="1:37.792" end="1:40.023">altuia</span> <span begin="1:40.023" end="1:41.511">pătezi</span></p><p begin="1:41.511" end="1:48.209" ttm:agent="v1"><span begin="1:41.511" end="1:42.254">Prin</span> <span begin="1:42.254" end="1:43.741">vorbe</span> <span begin="1:43.741" end="1:44.485">de</span> <span begin="1:44.485" end="1:48.209">rușine,</span></p><p begin="1:48.209" end="1:54.158" ttm:agent="v1"><span begin="1:48.209" end="1:48.953">Și</span> <span begin="1:48.953" end="1:50.440">contra</span> <span begin="1:50.440" end="1:51.184">lui</span> <span begin="1:51.184" end="1:51.927">tu</span> <span begin="1:51.927" end="1:54.158">trâmbițezi</span></p><p begin="1:54.158" end="2:00.857" ttm:agent="v1"><span begin="1:54.158" end="1:54.902">Tot</span> <span begin="1:54.902" end="1:55.645">rău,</span> <span begin="1:55.645" end="1:57.133">și</span> <span begin="1:57.133" end="1:57.876">nicicând</span> <span begin="1:57.876" end="2:00.857">bine,</span></p><p begin="2:00.857" end="2:06.806" ttm:agent="v1"><span begin="2:00.857" end="2:01.601">Când</span> <span begin="2:01.601" end="2:04.575">numele-i</span> <span begin="2:04.575" end="2:05.319">vorbești</span> <span begin="2:05.319" end="2:06.062">de</span> <span begin="2:06.062" end="2:06.806">rău,</span></p><p begin="2:06.806" end="2:16.045" ttm:agent="v1"><span begin="2:06.806" end="2:07.550">Tu</span> <span begin="2:07.550" end="2:08.293">nu</span> <span begin="2:08.293" end="2:09.780">iubești</span> <span begin="2:09.780" end="2:10.524">pe</span> <span begin="2:10.524" end="2:16.045">Dumnezeu!</span></p><p begin="2:16.045" end="2:22.023" ttm:agent="v1"><span begin="2:16.045" end="2:16.792">De</span> <span begin="2:16.792" end="2:17.539">L-ai</span> <span begin="2:17.539" end="2:19.034">iubi</span> <span begin="2:19.034" end="2:22.023">cu-adevărat,</span></p><p begin="2:22.023" end="2:28.752" ttm:agent="v1"><span begin="2:22.023" end="2:22.771">Ar</span> <span begin="2:22.771" end="2:25.013">observa</span> <span begin="2:25.013" end="2:25.760">și</span> <span begin="2:25.760" end="2:28.752">alții!</span></p><p begin="2:28.752" end="2:34.731" ttm:agent="v1"><span begin="2:28.752" end="2:30.247">Milos</span> <span begin="2:30.247" end="2:30.994">și</span> <span begin="2:30.994" end="2:32.489">gata</span> <span begin="2:32.489" end="2:33.236">de</span> <span begin="2:33.236" end="2:34.731">iertat</span></p><p begin="2:34.731" end="2:41.459" ttm:agent="v1"><span begin="2:34.731" end="2:35.478">Ai</span> <span begin="2:35.478" end="2:36.225">fi</span> <span begin="2:36.225" end="2:37.720">atunci</span> <span begin="2:37.720" end="2:38.467">cu</span> <span begin="2:38.467" end="2:41.459">frații!</span></p><p begin="2:41.459" end="2:47.438" ttm:agent="v1"><span begin="2:41.459" end="2:42.871">Isus</span> <span begin="2:42.871" end="2:45.196">iubește-n</span> <span begin="2:45.196" end="2:46.691">acest</span> <span begin="2:46.691" end="2:47.438">fel!</span></p><p begin="2:47.438" end="2:54.164" ttm:agent="v1"><span begin="2:47.438" end="2:49.680">Iubește</span> <span begin="2:49.680" end="2:50.427">deci</span> <span begin="2:50.427" end="2:51.174">și</span> <span begin="2:51.174" end="2:51.922">tu</span> <span begin="2:51.922" end="2:52.669">ca</span> <span begin="2:52.669" end="2:54.164">El!</span></p></div></body></tt>