<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>616. Cum strigă-un cerb</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:37.309"><div><p begin="0:06.081" end="0:17.003" ttm:agent="v1"><span begin="0:06.081" end="0:08.471">Cum</span> <span begin="0:08.471" end="0:08.812">strigă-un</span> <span begin="0:08.812" end="0:10.860">cerb</span> <span begin="0:10.860" end="0:12.225">setos</span> <span begin="0:12.225" end="0:12.907">de</span> <span begin="0:12.907" end="0:14.273">apă</span> <span begin="0:14.273" end="0:17.003">rece,</span></p><p begin="0:17.003" end="0:30.655" ttm:agent="v1"><span begin="0:17.003" end="0:19.392">Așa</span> <span begin="0:19.392" end="0:19.733">de</span> <span begin="0:19.733" end="0:23.147">Dumnezeu,</span> <span begin="0:23.147" end="0:24.853">setos</span> <span begin="0:24.853" end="0:25.194">strig</span> <span begin="0:25.194" end="0:30.655">eu:</span></p><p begin="0:30.655" end="0:41.577" ttm:agent="v1"><span begin="0:30.655" end="0:32.020">O,</span> <span begin="0:32.020" end="0:33.386">lasă-Ți</span> <span begin="0:33.386" end="0:37.481">haru-asupră-mi</span> <span begin="0:37.481" end="0:38.505">să</span> <span begin="0:38.505" end="0:38.846">se</span> <span begin="0:38.846" end="0:41.577">plece,</span></p><p begin="0:41.577" end="0:53.089" ttm:agent="v1"><span begin="0:41.577" end="0:42.942">Din</span> <span begin="0:42.942" end="0:44.307">apa</span> <span begin="0:44.307" end="0:47.038">vieții</span> <span begin="0:47.038" end="0:47.720">dă-mi</span> <span begin="0:47.720" end="0:48.403">să</span> <span begin="0:48.403" end="0:49.427">beau</span> <span begin="0:49.427" end="0:53.089">mereu!</span></p><p begin="0:53.089" end="1:04.065" ttm:agent="v1"><span begin="0:53.089" end="0:57.891">Îndurător</span> <span begin="0:57.891" end="0:58.577">mă</span> <span begin="0:58.577" end="0:59.263">ții</span> <span begin="0:59.263" end="0:59.949">pe-a’</span> <span begin="0:59.949" end="1:01.321">Tale</span> <span begin="1:01.321" end="1:04.065">brațe,</span></p><p begin="1:04.065" end="1:17.786" ttm:agent="v1"><span begin="1:04.065" end="1:05.437">Când</span> <span begin="1:05.437" end="1:06.466">îmi</span> <span begin="1:06.466" end="1:06.809">dau</span> <span begin="1:06.809" end="1:09.553">seama,</span> <span begin="1:09.553" end="1:10.239">cânt</span> <span begin="1:10.239" end="1:10.925">și</span> <span begin="1:10.925" end="1:11.954">prind</span> <span begin="1:11.954" end="1:17.786">curaj:</span></p><p begin="1:17.786" end="1:28.762" ttm:agent="v1"><span begin="1:17.786" end="1:20.187">Numai</span> <span begin="1:20.187" end="1:20.530">spre</span> <span begin="1:20.530" end="1:23.274">Tine</span> <span begin="1:23.274" end="1:24.646">glasu-mi</span> <span begin="1:24.646" end="1:25.675">să</span> <span begin="1:25.675" end="1:28.762">se-nalțe,</span></p><p begin="1:28.762" end="1:41.622" ttm:agent="v1"><span begin="1:28.762" end="1:30.134">Știu</span> <span begin="1:30.134" end="1:31.163">că</span> <span begin="1:31.163" end="1:33.564">mă-ncerci,</span> <span begin="1:33.564" end="1:34.250">dar</span> <span begin="1:34.250" end="1:34.936">știu</span> <span begin="1:34.936" end="1:35.622">că</span> <span begin="1:35.622" end="1:36.651">nu</span> <span begin="1:36.651" end="1:36.994">mă</span> <span begin="1:36.994" end="1:41.622">lași!</span></p><p begin="1:41.622" end="1:52.379" ttm:agent="v1"><span begin="1:41.622" end="1:42.967">Cum</span> <span begin="1:42.967" end="1:43.975">poți,</span> <span begin="1:43.975" end="1:46.328">atunci,</span> <span begin="1:46.328" end="1:47.001">o,</span> <span begin="1:47.001" end="1:49.354">inimă</span> <span begin="1:49.354" end="1:52.379">plăpândă,</span></p><p begin="1:52.379" end="2:05.825" ttm:agent="v1"><span begin="1:52.379" end="1:53.724">Să</span> <span begin="1:53.724" end="1:54.732">te</span> <span begin="1:54.732" end="1:55.068">mai</span> <span begin="1:55.068" end="1:57.085">temi,</span> <span begin="1:57.085" end="1:58.430">și-ades’</span> <span begin="1:58.430" end="1:59.102">să</span> <span begin="1:59.102" end="2:00.110">plângi</span> <span begin="2:00.110" end="2:03.136">de</span> <span begin="2:03.136" end="2:05.825">dor?...</span></p><p begin="2:05.825" end="2:16.582" ttm:agent="v1"><span begin="2:05.825" end="2:08.514">Tresaltă</span> <span begin="2:08.514" end="2:10.531">deci,</span> <span begin="2:10.531" end="2:11.203">fii</span> <span begin="2:11.203" end="2:13.556">veselă</span> <span begin="2:13.556" end="2:13.893">și</span> <span begin="2:13.893" end="2:16.582">cântă,</span></p><p begin="2:16.582" end="2:24.649" ttm:agent="v1"><span begin="2:16.582" end="2:17.926">Căci</span> <span begin="2:17.926" end="2:18.935">ai</span> <span begin="2:18.935" end="2:19.271">în</span> <span begin="2:19.271" end="2:21.288">cer</span> <span begin="2:21.288" end="2:21.960">un</span> <span begin="2:21.960" end="2:23.305">Tată</span> <span begin="2:23.305" end="2:24.649">iubitor!</span></p></div></body></tt>