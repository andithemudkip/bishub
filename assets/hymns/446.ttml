<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>446. N-auzi tu când zice Domnul</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:19.912"><div><p begin="0:22.810" end="0:28.160" ttm:agent="v1"><span begin="0:22.810" end="0:24.148">N-auzi</span> <span begin="0:24.148" end="0:24.816">tu</span> <span begin="0:24.816" end="0:25.485">când</span> <span begin="0:25.485" end="0:26.823">zice</span> <span begin="0:26.823" end="0:28.160">Domnul:</span></p><p begin="0:28.160" end="0:33.511" ttm:agent="v1"><span begin="0:28.160" end="0:29.498">„Unde</span> <span begin="0:29.498" end="0:30.167">sunt</span> <span begin="0:30.167" end="0:30.836">cei</span> <span begin="0:30.836" end="0:31.504">ce-Mi</span> <span begin="0:31.504" end="0:33.511">servesc?”</span></p><p begin="0:33.511" end="0:38.861" ttm:agent="v1"><span begin="0:33.511" end="0:34.180">Copt</span> <span begin="0:34.180" end="0:36.186">e-acuma</span> <span begin="0:36.186" end="0:38.861">secerișul,</span></p><p begin="0:38.861" end="0:44.212" ttm:agent="v1"><span begin="0:38.861" end="0:39.864">Dar</span> <span begin="0:39.864" end="0:42.205">secerători</span> <span begin="0:42.205" end="0:44.212">lipsesc!</span></p><p begin="0:44.212" end="0:48.224" ttm:agent="v1"><span begin="0:44.212" end="0:45.549">Domnul</span> <span begin="0:45.549" end="0:45.884">dă</span> <span begin="0:45.884" end="0:46.887">răsplată</span> <span begin="0:46.887" end="0:48.224">mare</span></p><p begin="0:48.224" end="0:52.237" ttm:agent="v1"><span begin="0:48.224" end="0:49.562">Celor</span> <span begin="0:49.562" end="0:50.231">care</span> <span begin="0:50.231" end="0:50.565">vor</span> <span begin="0:50.565" end="0:52.237">lucra!</span></p><p begin="0:52.237" e