<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>146. Spirit Sfânt, în noi așază!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:49.479"><div><p begin="0:13.170" end="0:18.819" ttm:agent="v1"><span begin="0:13.170" end="0:14.111">Spirit</span> <span begin="0:14.111" end="0:15.053">Sfânt,</span> <span begin="0:15.053" end="0:15.994">în</span> <span begin="0:15.994" end="0:16.465">noi</span> <span begin="0:16.465" end="0:18.819">așază</span></p><p begin="0:18.819" end="0:24.468" ttm:agent="v1"><span begin="0:18.819" end="0:20.702">Adevărul</span> <span begin="0:20.702" end="0:21.643">lui</span> <span begin="0:21.643" end="0:24.468">Hristos,</span></p><p begin="0:24.468" end="0:30.116" ttm:agent="v1"><span begin="0:24.468" end="0:26.351">Inima</span> <span begin="0:26.351" end="0:27.292">ne-o</span> <span begin="0:27.292" end="0:28.233">ține</span> <span begin="0:28.233" end="0:30.116">trează</span></p><p begin="0:30.116" end="0:36.965" ttm:agent="v1"><span begin="0:30.116" end="0:30.587">Pe</span> <span begin="0:30.587" end="0:31.058">al</span> <span begin="0:31.058" end="0:31.999">vieții</span> <span begin="0:31.999" end="0:32.941">drum</span> <span begin="0:32.941" end="0:36.965">spinos!</span></p><p begin="0:36.965" end="0:42.445" ttm:agent="v1"><span begin="0:36.965" end="0:37.878">Spirit</span> <span begin="0:37.878" end="0:38.792">Sfânt,</span> <span begin="0:38.792" end="0:39.705">a</span> <span begin="0:39.705" end="0:40.161">Ta</span> <span begin="0:40.161" end="0:42.445">putere</span></p><p begin="0:42.445" end="0:47.924" ttm:agent="v1"><span begin="0:42.445" end="0:43.358">Dă-ne-o</span> <span begin="0:43.358" end="0:44.271">astăzi,</span> <span begin="0:44.271" end="0:45.184">Te</span> <span begin="0:45.184" end="0:47.924">rugăm,</span></p><p begin="0:47.924" end="0:53.403" ttm:agent="v1"><span begin="0:47.924" end="0:48.380">Ca-n</span> <span begin="0:48.380" end="0:49.750">Hristos</span> <span begin="0:49.750" end="0:50.664">și-a</span> <span begin="0:50.664" end="0:51.120">Sa</span> <span begin="0:51.120" end="0:53.403">iubire,</span></p><p begin="0:53.403" end="1:00.423" ttm:agent="v1"><span begin="0:53.403" end="0:54.773">Tatălui</span> <span begin="0:54.773" end="0:55.230">să</span> <span begin="0:55.230" end="1:00.423">ne-nchinăm!</span></p><p begin="1:00.423" end="1:05.792" ttm:agent="v1"><span begin="1:00.423" end="1:01.318">Spirit</span> <span begin="1:01.318" end="1:02.212">Sfânt,</span> <span begin="1:02.212" end="1:03.107">a</span> <span begin="1:03.107" end="1:04.002">noastră</span> <span begin="1:04.002" end="1:05.792">viață</span></p><p begin="1:05.792" end="1:11.162" ttm:agent="v1"><span begin="1:05.792" end="1:07.582">Înnoiește-o</span> <span begin="1:07.582" end="1:08.477">pe</span> <span begin="1:08.477" end="1:11.162">altar,</span></p><p begin="1:11.162" end="1:16.532" ttm:agent="v1"><span begin="1:11.162" end="1:12.057">Fi-ne</span> <span begin="1:12.057" end="1:12.952">Tu</span> <span begin="1:12.952" end="1:14.294">mereu</span> <span begin="1:14.294" end="1:16.532">povață,</span></p><p begin="1:16.532" end="1:23.582" ttm:agent="v1"><span begin="1:16.532" end="1:17.427">Dă-ne</span> <span begin="1:17.427" end="1:17.874">din</span> <span begin="1:17.874" end="1:20.112">cerescul</span> <span begin="1:20.112" end="1:23.582">har!</span></p><p begin="1:23.582" end="1:29.112" ttm:agent="v1"><span begin="1:23.582" end="1:24.503">Spirit</span> <span begin="1:24.503" end="1:25.425">Sfânt,</span> <span begin="1:25.425" end="1:26.347">în</span> <span begin="1:26.347" end="1:26.808">noi</span> <span begin="1:26.808" end="1:29.112">coboară,</span></p><p begin="1:29.112" end="1:34.643" ttm:agent="v1"><span begin="1:29.112" end="1:29.573">Vrem</span> <span begin="1:29.573" end="1:30.034">să</span> <span begin="1:30.034" end="1:30.495">ne</span> <span begin="1:30.495" end="1:31.878">sfințim</span> <span begin="1:31.878" end="1:34.643">mereu!</span></p><p begin="1:34.643" end="1:40.174" ttm:agent="v1"><span begin="1:34.643" end="1:35.104">Sfânt</span> <span begin="1:35.104" end="1:35.565">e</span> <span begin="1:35.565" end="1:37.409">Tatăl,</span> <span begin="1:37.409" end="1:37.870">Sfânt</span> <span begin="1:37.870" end="1:38.330">e</span> <span begin="1:38.330" end="1:40.174">Fiul,</span></p><p begin="1:40.174" end="1:42.939" ttm:agent="v1"><span begin="1:40.174" end="1:40.635">Sfânt</span> <span begin="1:40.635" end="1:41.096">e</span> <span begin="1:41.096" end="1:42.018">Unul,</span> <span begin="1:42.018" end="1:42.939">Dumnezeu.</span></p></div></body></tt>