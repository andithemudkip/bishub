<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>704. Celui sfânt, mărire</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:08.206"><div><p begin="0:01.430" end="0:05.990" ttm:agent="v1"><span begin="0:01.430" end="0:02.570">Celui</span> <span begin="0:02.570" end="0:03.330">sfânt,</span> <span begin="0:03.330" end="0:05.990">mărire</span></p><p begin="0:05.990" end="0:10.550" ttm:agent="v1"><span begin="0:05.990" end="0:07.130">Cântă</span> <span begin="0:07.130" end="0:08.270">îngeri</span> <span begin="0:08.270" end="0:10.550">mii,</span></p><p begin="0:10.550" end="0:15.110" ttm:agent="v1"><span begin="0:10.550" end="0:11.310">Jos</span> <span begin="0:11.310" end="0:12.830">întreaga</span> <span begin="0:12.830" end="0:15.110">fire</span></p><p begin="0:15.110" end="0:19.270" ttm:agent="v1"><span begin="0:15.110" end="0:16.250">’Nalțe</span> <span begin="0:16.250" end="0:19.270">melodii!</span></p><p begin="0:19.270" end="0:23.648" ttm:agent="v1"><span begin="0:19.270" end="0:20.364">Slavă-n</span> <span begin="0:20.364" end="0:21.094">zări</span> <span begin="0:21.094" end="0:23.648">albastre,</span></p><p begin="0:23.648" end="0:28.025" ttm:agent="v1"><span begin="0:23.648" end="0:24.742">Slavă</span> <span begin="0:24.742" end="0:25.472">pe</span> <span begin="0:25.472" end="0:28.025">pământ,</span></p><p begin="0:28.025" end="0:32.403" ttm:agent="v1"><span begin="0:28.025" end="0:29.120">Cântă</span> <span begin="0:29.120" end="0:29.849">mii</span> <span begin="0:29.849" end="0:30.214">de</span> <span begin="0:30.214" end="0:32.403">astre:</span></p><p begin="0:32.403" end="0:33.500" ttm:agent="v1"><span begin="0:32.403" end="0:33.497">„Domnul</span> <span begin="0:33.497" end="0:34.592">este</span> <span begin="0:34.592" end="0:33.500">sfânt!”</span></p><p begin="0:33.500" end="0:37.812" ttm:agent="v1"><span begin="0:33.500" end="0:35.297">Ceru-ntreg</span> <span begin="0:35.297" end="0:37.812">răspunde:</span></p><p begin="0:37.812" end="0:42.124" ttm:agent="v1"><span begin="0:37.812" end="0:38.531">„Sfânt</span> <span begin="0:38.531" end="0:38.890">va</span> <span begin="0:38.890" end="0:39.609">fi</span> <span begin="0:39.609" end="0:42.124">mereu,</span></p><p begin="0:42.124" end="0:46.436" ttm:agent="v1"><span begin="0:42.124" end="0:43.202">Veșnic</span> <span begin="0:43.202" end="0:43.921">și</span> <span begin="0:43.921" end="0:46.436">oriunde,</span></p><p begin="0:46.436" end="0:48.952" ttm:agent="v1"><span begin="0:46.436" end="0:47.514">Domnul</span> <span begin="0:47.514" end="0:48.952">Dumnezeu!”</span></p></div></body></tt>