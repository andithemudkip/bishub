<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>222. Tu ești, Doamne</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:03.011"><div><p begin="0:14.680" end="0:20.980" ttm:agent="v1"><span begin="0:14.680" end="0:15.380">Tu</span> <span begin="0:15.380" end="0:15.730">ești,</span> <span begin="0:15.730" end="0:17.830">Doamne-a</span> <span begin="0:17.830" end="0:18.880">păcii</span> <span begin="0:18.880" end="0:20.980">Stâncă</span></p><p begin="0:20.980" end="0:27.280" ttm:agent="v1"><span begin="0:20.980" end="0:21.680">Prin</span> <span begin="0:21.680" end="0:24.830">furtunile</span> <span begin="0:24.830" end="0:25.180">ce</span> <span begin="0:25.180" end="0:27.280">dor;</span></p><p begin="0:27.280" end="0:33.580" ttm:agent="v1"><span begin="0:27.280" end="0:27.980">Eu</span> <span begin="0:27.980" end="0:28.330">la</span> <span begin="0:28.330" end="0:30.430">Tine</span> <span begin="0:30.430" end="0:31.480">caut</span> <span begin="0:31.480" end="0:33.580">tihnă,</span></p><p begin="0:33.580" end="0:41.360" ttm:agent="v1"><span begin="0:33.580" end="0:35.680">Obosit</span> <span begin="0:35.680" end="0:37.780">de-atâta</span> <span begin="0:37.780" end="0:41.360">zbor...</span></p><p begin="0:41.360" end="0:47.660" ttm:agent="v1"><span begin="0:41.360" end="0:42.060">Tu,</span> <span begin="0:42.060" end="0:43.460">Isus,</span> <span begin="0:43.460" end="0:44.510">ești</span> <span begin="0:44.510" end="0:45.560">apă</span> <span begin="0:45.560" end="0:47.660">vie</span></p><p begin="0:47.660" end="0:53.960" ttm:agent="v1"><span begin="0:47.660" end="0:48.710">Pentru</span> <span begin="0:48.710" end="0:49.760">toți</span> <span begin="0:49.760" end="0:50.810">cei</span> <span begin="0:50.810" end="0:53.960">osteniți...</span></p><p begin="0:53.960" end="1:00.260" ttm:agent="v1"><span begin="0:53.960" end="0:55.010">Tu</span> <span begin="0:55.010" end="0:56.060">i-aștepți</span> <span begin="0:56.060" end="0:57.110">cu</span> <span begin="0:57.110" end="1:00.260">bucurie</span></p><p begin="1:00.260" end="1:08.020" ttm:agent="v1"><span begin="1:00.260" end="1:00.960">Ca</span> <span begin="1:00.960" end="1:01.310">să</span> <span begin="1:01.310" end="1:03.410">fie</span> <span begin="1:03.410" end="1:08.020">mântuiți!</span></p><p begin="1:08.020" end="1:14.068" ttm:agent="v1"><span begin="1:08.020" end="1:09.028">Valuri</span> <span begin="1:09.028" end="1:10.036">când</span> <span begin="1:10.036" end="1:11.044">mă</span> <span begin="1:11.044" end="1:14.068">amenință</span></p><p begin="1:14.068" end="1:20.116" ttm:agent="v1"><span begin="1:14.068" end="1:14.740">Și</span> <span begin="1:14.740" end="1:16.084">lovesc</span> <span begin="1:16.084" end="1:20.116">necontenit,</span></p><p begin="1:20.116" end="1:26.164" ttm:agent="v1"><span begin="1:20.116" end="1:20.788">Eu</span> <span begin="1:20.788" end="1:21.124">Te</span> <span begin="1:21.124" end="1:22.132">prind</span> <span begin="1:22.132" end="1:23.140">mai</span> <span begin="1:23.140" end="1:23.812">cu</span> <span begin="1:23.812" end="1:26.164">credință,</span></p><p begin="1:26.164" end="1:34.172" ttm:agent="v1"><span begin="1:26.164" end="1:26.836">Tu</span> <span begin="1:26.836" end="1:27.172">ești</span> <span begin="1:27.172" end="1:29.188">Stânca</span> <span begin="1:29.188" end="1:29.860">de</span> <span begin="1:29.860" end="1:34.172">granit!</span></p><p begin="1:34.172" end="1:40.401" ttm:agent="v1"><span begin="1:34.172" end="1:34.864">Tu,</span> <span begin="1:34.864" end="1:37.287">nădejdea</span> <span begin="1:37.287" end="1:38.325">vieții</span> <span begin="1:38.325" end="1:40.401">mele,</span></p><p begin="1:40.401" end="1:46.977" ttm:agent="v1"><span begin="1:40.401" end="1:41.440">Pâinea</span> <span begin="1:41.440" end="1:44.554">sufletului</span> <span begin="1:44.554" end="1:46.977">meu,</span></p><p begin="1:46.977" end="1:52.860" ttm:agent="v1"><span begin="1:46.977" end="1:47.669">Poartă-mi</span> <span begin="1:47.669" end="1:49.746">pasul</span> <span begin="1:49.746" end="1:50.784">printre</span> <span begin="1:50.784" end="1:52.860">stele</span></p><p begin="1:52.860" end="1:57.359" ttm:agent="v1"><span begin="1:52.860" end="1:53.552">Să</span> <span begin="1:53.552" end="1:54.937">ajung</span> <span begin="1:54.937" end="1:55.975">la</span> <span begin="1:55.975" end="1:57.359">Dumnezeu!</span></p></div></body></tt>