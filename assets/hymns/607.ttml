<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>607. Apune soarele în văi</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:28.294"><div><p begin="0:12.690" end="0:18.432" ttm:agent="v1"><span begin="0:12.690" end="0:14.843">Apune</span> <span begin="0:14.843" end="0:17.356">soarele</span> <span begin="0:17.356" end="0:17.715">în</span> <span begin="0:17.715" end="0:18.432">văi,</span></p><p begin="0:18.432" end="0:24.175" ttm:agent="v1"><span begin="0:18.432" end="0:19.150">În</span> <span begin="0:19.150" end="0:20.586">urma</span> <span begin="0:20.586" end="0:21.304">sa</span> <span begin="0:21.304" end="0:24.175">privind...</span></p><p begin="0:24.175" end="0:29.917" ttm:agent="v1"><span begin="0:24.175" end="0:24.893">Și</span> <span begin="0:24.893" end="0:26.328">iarăși</span> <span begin="0:26.328" end="0:29.199">candele</span> <span begin="0:29.199" end="0:29.917">se-aprind</span></p><p begin="0:29.917" end="0:36.940" ttm:agent="v1"><span begin="0:29.917" end="0:30.635">În</span> <span begin="0:30.635" end="0:32.071">ceruri,</span> <span begin="0:32.071" end="0:33.506">pentru</span> <span begin="0:33.506" end="0:36.940">noi...</span></p><p begin="0:36.940" end="0:42.739" ttm:agent="v1"><span begin="0:36.940" end="0:37.665">O</span> <span begin="0:37.665" end="0:39.115">nouă</span> <span begin="0:39.115" end="0:39.840">zi</span> <span begin="0:39.840" end="0:40.564">de</span> <span begin="0:40.564" end="0:42.014">Sabat</span> <span begin="0:42.014" end="0:42.739">sfânt,</span></p><p begin="0:42.739" end="0:48.539" ttm:agent="v1"><span begin="0:42.739" end="0:44.914">Bogată</span> <span begin="0:44.914" end="0:45.639">în</span> <span begin="0:45.639" end="0:48.539">solii,</span></p><p begin="0:48.539" end="0:54.339" ttm:agent="v1"><span begin="0:48.539" end="0:50.352">Se</span> <span begin="0:50.352" end="0:51.439">scurge-ncet,</span> <span begin="0:51.439" end="0:52.164">spre</span> <span begin="0:52.164" end="0:54.339">veșnicii,</span></p><p begin="0:54.339" end="1:01.099" ttm:agent="v1"><span begin="0:54.339" end="0:55.789">Ducând</span> <span begin="0:55.789" end="0:56.514">al</span> <span begin="0:56.514" end="0:57.964">nostru</span> <span begin="0:57.964" end="1:01.099">cânt...</span></p><p begin="1:01.099" end="1:06.870" ttm:agent="v1"><span begin="1:01.099" end="1:01.820">Sub</span> <span begin="1:01.820" end="1:06.148">binecuvântarea</span> <span begin="1:06.148" end="1:06.870">Ta,</span></p><p begin="1:06.870" end="1:12.641" ttm:agent="v1"><span begin="1:06.870" end="1:08.312">Acum</span> <span begin="1:08.312" end="1:09.034">ne</span> <span begin="1:09.034" end="1:12.641">despărțim,</span></p><p begin="1:12.641" end="1:18.411" ttm:agent="v1"><span begin="1:12.641" end="1:13.362">Dar</span> <span begin="1:13.362" end="1:14.444">vrem</span> <span begin="1:14.444" end="1:14.805">cu</span> <span begin="1:14.805" end="1:15.526">toți</span> <span begin="1:15.526" end="1:16.247">să</span> <span begin="1:16.247" end="1:18.411">ne-ntâlnim</span></p><p begin="1:18.411" end="1:22.739" ttm:agent="v1"><span begin="1:18.411" end="1:19.133">La</span> <span begin="1:19.133" end="1:20.575">marea</span> <span begin="1:20.575" end="1:21.297">de</span> <span begin="1:21.297" end="1:22.739">cristal!</span></p></div></body></tt>