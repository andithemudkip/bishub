<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>369. Doamne, simt în piept o floare</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:52.823"><div><p begin="0:14.710" end="0:20.432" ttm:agent="v1"><span begin="0:14.710" end="0:16.140">Doamne,</span> <span begin="0:16.140" end="0:16.856">simt</span> <span begin="0:16.856" end="0:17.571">în</span> <span begin="0:17.571" end="0:18.286">piept</span> <span begin="0:18.286" end="0:19.001">o</span> <span begin="0:19.001" end="0:20.432">floare,</span></p><p begin="0:20.432" end="0:26.153" ttm:agent="v1"><span begin="0:20.432" end="0:21.862">Floarea</span> <span begin="0:21.862" end="0:24.008">inimii</span> <span begin="0:24.008" end="0:24.723">de</span> <span begin="0:24.723" end="0:26.153">jar...</span></p><p begin="0:26.153" end="0:31.875" ttm:agent="v1"><span begin="0:26.153" end="0:26.868">Tu</span> <span begin="0:26.868" end="0:27.584">mi-ești</span> <span begin="0:27.584" end="0:31.875">soarele-răsare,</span></p><p begin="0:31.875" end="0:37.176" ttm:agent="v1"><span begin="0:31.875" end="0:32.590">Dă-mi</span> <span begin="0:32.590" end="0:34.736">lumina</span> <span begin="0:34.736" end="0:35.451">Ta</span> <span begin="0:35.451" end="0:36.166">în</span> <span begin="0:36.166" end="0:37.176">dar!</span></p><p begin="0:37.176" end="0:42.812" ttm:agent="v1"><span begin="0:37.176" end="0:38.585">Pentru</span> <span begin="0:38.585" end="0:39.994">Tine</span> <span begin="0:39.994" end="0:40.699">se</span> <span begin="0:40.699" end="0:42.812">deschide</span></p><p begin="0:42.812" end="0:48.448" ttm:agent="v1"><span begin="0:42.812" end="0:44.221">Floarea</span> <span begin="0:44.221" end="0:47.039">sufletului</span> <span begin="0:47.039" end="0:48.448">meu!</span></p><p begin="0:48.448" end="0:54.084" ttm:agent="v1"><span begin="0:48.448" end="0:49.152">În</span> <span begin="0:49.152" end="0:51.266">iubirea-Ți</span> <span begin="0:51.266" end="0:51.970">mă</span> <span begin="0:51.970" end="0:54.084">ascunde,</span></p><p begin="0:54.084" end="1:02.600" ttm:agent="v1"><span begin="0:54.084" end="0:54.788">Să</span> <span begin="0:54.788" end="0:56.197">rămân</span> <span begin="0:56.197" end="0:56.902">la</span> <span begin="0:56.902" end="0:58.311">pieptul</span> <span begin="0:58.311" end="1:02.600">Tău!</span></p><p begin="1:02.600" end="1:08.292" ttm:agent="v1"><span begin="1:02.600" end="1:04.023">Dacă</span> <span begin="1:04.023" end="1:04.734">mă</span> <span begin="1:04.734" end="1:06.157">trimiți</span> <span begin="1:06.157" end="1:06.869">în</span> <span begin="1:06.869" end="1:08.292">lume</span></p><p begin="1:08.292" end="1:13.984" ttm:agent="v1"><span begin="1:08.292" end="1:09.715">Și-ntre</span> <span begin="1:09.715" end="1:10.426">spini</span> <span begin="1:10.426" end="1:11.138">mă</span> <span begin="1:11.138" end="1:13.984">răsădești,</span></p><p begin="1:13.984" end="1:19.676" ttm:agent="v1"><span begin="1:13.984" end="1:14.695">Dă-mi</span> <span begin="1:14.695" end="1:16.118">parfum</span> <span begin="1:16.118" end="1:16.830">de</span> <span begin="1:16.830" end="1:19.676">rugăciune,</span></p><p begin="1:19.676" end="1:24.948" ttm:agent="v1"><span begin="1:19.676" end="1:20.387">Ca</span> <span begin="1:20.387" end="1:21.099">să</span> <span begin="1:21.099" end="1:21.810">spun</span> <span begin="1:21.810" end="1:22.522">cât</span> <span begin="1:22.522" end="1:23.233">mă</span> <span begin="1:23.233" end="1:24.948">iubești!</span></p><p begin="1:24.948" end="1:30.583" ttm:agent="v1"><span begin="1:24.948" end="1:25.652">Tu</span> <span begin="1:25.652" end="1:26.357">ești</span> <span begin="1:26.357" end="1:27.061">plin</span> <span begin="1:27.061" end="1:27.766">de</span> <span begin="1:27.766" end="1:30.583">bunătate,</span></p><p begin="1:30.583" end="1:36.218" ttm:agent="v1"><span begin="1:30.583" end="1:31.288">Eu</span> <span begin="1:31.288" end="1:32.696">mereu</span> <span begin="1:32.696" end="1:33.401">Te</span> <span begin="1:33.401" end="1:34.105">voi</span> <span begin="1:34.105" end="1:36.218">slăvi</span></p><p begin="1:36.218" end="1:41.854" ttm:agent="v1"><span begin="1:36.218" end="1:36.923">Cu</span> <span begin="1:36.923" end="1:39.036">petale</span> <span begin="1:39.036" end="1:41.854">nepătate</span></p><p begin="1:41.854" end="1:46.080" ttm:agent="v1"><span begin="1:41.854" end="1:42.558">Și</span> <span begin="1:42.558" end="1:43.967">parfum</span> <span begin="1:43.967" end="1:44.671">de</span> <span begin="1:44.671" end="1:46.080">veșnicii!</span></p></div></body></tt>