<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>764. Cele trei solii</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:21.610"><div><p begin="0:32.093" end="0:37.145" ttm:agent="v1"><span begin="0:32.093" end="0:33.356">Slavă,</span> <span begin="0:33.356" end="0:34.619">cinste</span> <span begin="0:34.619" end="0:37.145">și-nchinare,</span></p><p begin="0:37.145" end="0:42.197" ttm:agent="v1"><span begin="0:37.145" end="0:38.408">Numai</span> <span begin="0:38.408" end="0:42.197">Creatorului!</span></p><p begin="0:42.197" end="0:47.249" ttm:agent="v1"><span begin="0:42.197" end="0:42.829">Ne</span> <span begin="0:42.829" end="0:44.092">vestesc</span> <span begin="0:44.092" end="0:45.355">pământ</span> <span begin="0:45.355" end="0:45.986">și</span> <span begin="0:45.986" end="0:47.249">mare</span></p><p begin="0:47.249" end="0:55.581" ttm:agent="v1"><span begin="0:47.249" end="0:48.512">Ceasul</span> <span begin="0:48.512" end="0:51.038">judecății</span> <span begin="0:51.038" end="0:55.581">Lui.</span></p><p begin="0:55.581" end="1:00.683" ttm:agent="v1"><span begin="0:55.581" end="0:56.856">Astăzi</span> <span begin="0:56.856" end="0:58.132">orice</span> <span begin="0:58.132" end="0:59.089">om</span> <span begin="0:59.089" end="0:59.408">să</span> <span begin="0:59.408" end="1:00.683">știe,</span></p><p begin="1:00.683" end="1:05.786" ttm:agent="v1"><span begin="1:00.683" end="1:01.959">Orice</span> <span begin="1:01.959" end="1:02.597">neam,</span> <span begin="1:02.597" end="1:03.872">orice</span> <span begin="1:03.872" end="1:05.786">popor:</span></p><p begin="1:05.786" end="1:10.888" ttm:agent="v1"><span begin="1:05.786" end="1:08.975">Evanghelia</span> <span begin="1:08.975" en