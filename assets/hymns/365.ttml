<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>365. Numai cu Isus voiesc a merge</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:58.988"><div><p begin="0:10.530" end="0:23.591" ttm:agent="v1"><span begin="0:10.530" end="0:11.346">Munți</span> <span begin="0:11.346" end="0:12.163">și</span> <span begin="0:12.163" end="0:14.612">văi,</span> <span begin="0:14.612" end="0:16.244">câmpii</span> <span begin="0:16.244" end="0:17.877">păduri</span> <span begin="0:17.877" end="0:18.693">și</span> <span begin="0:18.693" end="0:23.591">mare</span></p><p begin="0:23.591" end="0:36.653" ttm:agent="v1"><span begin="0:23.591" end="0:25.224">Sprinten</span> <span begin="0:25.224" end="0:27.673">eu</span> <span begin="0:27.673" end="0:28.489">le</span> <span begin="0:28.489" end="0:29.714">trec</span> <span begin="0:29.714" end="0:30.122">la</span> <span begin="0:30.122" end="0:31.755">brațul</span> <span begin="0:31.755" end="0:36.653">Său,</span></p><p begin="0:36.653" end="0:49.714" ttm:agent="v1"><span begin="0:36.653" end="0:37.469">Căci</span> <span begin="0:37.469" end="0:41.551">Isus</span> <span begin="0:41.551" end="0:42.775">oricând</span> <span begin="0:42.775" end="0:43.183">îmi</span> <span begin="0:43.183" end="0:44.000">e</span> <span begin="0:44.000" end="0:49.714">salvare,</span></p><p begin="0:49.714" end="1:01.143" ttm:agent="v1"><span begin="0:49.714" end="0:50.938">El</span> <span begin="0:50.938" end="0:51.347">mă</span> <span begin="0:51.347" end="0:56.245">însoțește-n</span> <span begin="0:56.245" end="0:57.877">drumul</span> <span begin="0:57.877" end="1:01.143">meu.</span></p></div></body></tt>