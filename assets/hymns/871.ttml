<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>871. Ne-adunăm cu toții</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:05.388"><div><p begin="0:11.950" end="0:17.390" ttm:agent="v1"><span begin="0:11.950" end="0:13.310">Ne-adunăm</span> <span begin="0:13.310" end="0:13.990">cu</span> <span begin="0:13.990" end="0:15.350">toții,</span> <span begin="0:15.350" end="0:16.540">iarăși</span> <span begin="0:16.540" end="0:17.390">să-nvățăm,</span></p><p begin="0:17.390" end="0:22.830" ttm:agent="v1"><span begin="0:17.390" end="0:17.900">Și</span> <span begin="0:17.900" end="0:18.070">sub</span> <span begin="0:18.070" end="0:19.430">steagul</span> <span begin="0:19.430" end="0:20.110">lui</span> <span begin="0:20.110" end="0:21.300">Isus</span> <span begin="0:21.300" end="0:21.470">să</span> <span begin="0:21.470" end="0:22.150">ne</span> <span begin="0:22.150" end="0:22.830">grupăm,</span></p><p begin="0:22.830" end="0:28.270" ttm:agent="v1"><span begin="0:22.830" end="0:23.340">Căci</span> <span begin="0:23.340" end="0:24.190">în</span> <span begin="0:24.190" end="0:27.420">lupta-Mpărăției,</span> <span begin="0:27.420" end="0:28.270">ce-așteptăm,</span></p><p begin="0:28.270" end="0:44.650" ttm:agent="v1"><span begin="0:28.270" end="0:28.780">Nu</span> <span begin="0:28.780" end="0:29.630">cedăm,</span> <span begin="0:29.630" end="0:30.310">cât</span> <span begin="0:30.310" end="0:30.990">vom</span> <span begin="0:30.990" end="0:44.650">trăi!</span></p><p begin="0:44.650" end="0:50.172" ttm:agent="v1"><span begin="0:44.650" end="0:45.340">După</span> <span begin="0:45.340" end="0:46.721">focul</span> <span begin="0:46.721" end="0:48.101">luptei,</span> <span begin="0:48.101" end="0:49.309">veșnici</span> <span begin="0:49.309" end="0:50.172">mângâieri:</span></p><p begin="0:50.172" end="0:55.693" ttm:agent="v1"><span begin="0:50.172" end="0:50.689">Pe</span> <span begin="0:50.689" end="0:52.242">câmpia</span> <span begin="0:52.242" end="0:53.623">Salem</span> <span begin="0:53.623" end="0:54.140">nu</span> <span begin="0:54.140" end="0:54.313">mai</span> <span begin="0:54.313" end="0:54.830">sunt</span> <span begin="0:54.830" end="0:55.693">dureri;</span></p><p begin="0:55.693" end="1:01.215" ttm:agent="v1"><span begin="0:55.693" end="0:57.074">Fericiți</span> <span begin="0:57.074" end="0:58.454">că-avem</span> <span begin="0:58.454" end="0:59.662">așa</span> <span begin="0:59.662" end="1:01.215">făgăduieli,</span></p><p begin="1:01.215" end="1:05.356" ttm:agent="v1"><span begin="1:01.215" end="1:01.732">Nu</span> <span begin="1:01.732" end="1:02.595">cedăm,</span> <span begin="1:02.595" end="1:03.285">cât</span> <span begin="1:03.285" end="1:03.976">vom</span> <span begin="1:03.976" end="1:05.356">trăi!</span></p></div></body></tt>