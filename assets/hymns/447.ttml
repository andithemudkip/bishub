<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>447. Așa cum Eu am fost trimis</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:12.310"><div><p begin="0:15.570" end="0:22.506" ttm:agent="v1"><span begin="0:15.570" end="0:16.437">Așa</span> <span begin="0:16.437" end="0:16.870">cum</span> <span begin="0:16.870" end="0:18.171">Eu</span> <span begin="0:18.171" end="0:18.604">am</span> <span begin="0:18.604" end="0:19.038">fost</span> <span begin="0:19.038" end="0:19.905">trimis</span> <span begin="0:19.905" end="0:20.338">în</span> <span begin="0:20.338" end="0:22.506">lume,</span></p><p begin="0:22.506" end="0:29.442" ttm:agent="v1"><span begin="0:22.506" end="0:22.939">La</span> <span begin="0:22.939" end="0:23.373">fel</span> <span begin="0:23.373" end="0:23.806">si</span> <span begin="0:23.806" end="0:25.107">voi,</span> <span begin="0:25.107" end="0:25.974">porniți</span> <span begin="0:25.974" end="0:26.407">pe</span> <span begin="0:26.407" end="0:27.274">urma</span> <span begin="0:27.274" end="0:29.442">Mea,</span></p><p begin="0:29.442" end="0:36.378" ttm:agent="v1"><span begin="0:29.442" end="0:32.043">Nerăsplătiți</span> <span begin="0:32.043" end="0:32.476">și</span> <span begin="0:32.476" end="0:33.343">fără</span> <span begin="0:33.343" end="0:33.777">de</span> <span begin="0:33.777" end="0:36.378">renume,</span></p><p begin="0:36.378" end="0:44.714" ttm:agent="v1"><span begin="0:36.378" end="0:36.811">Dar</span> <span begin="0:36.811" end="0:37.678">singuri,</span> <span begin="0:37.678" end="0:38.979">nu,</span> <span begin="0:38.979" end="0:39.412">Eu</span> <span begin="0:39.412" end="0:39.846">nu</span> <span begin="0:39.846" end="0:40.279">vă</span> <span begin="0:40.279" end="0:40.930">voi</span> <span begin="0:40.930" end="0:44.714">lăsa!</span></p><p begin="0:44.714" end="0:51.511" ttm:agent="v1"><span begin="0:44.714" end="0:45.139">Eu</span> <span begin="0:45.139" end="0:45.564">vă</span> <span begin="0:45.564" end="0:47.263">trimit</span> <span begin="0:47.263" end="0:47.688">în</span> <span begin="0:47.688" end="0:48.537">valea</span> <span begin="0:48.537" end="0:51.511">suferinței,</span></p><p begin="0:51.511" end="0:58.309" ttm:agent="v1"><span begin="0:51.511" end="0:51.936">La</span> <span begin="0:51.936" end="0:52.361">cei</span> <span begin="0:52.361" end="0:54.060">pierduți,</span> <span begin="0:54.060" end="0:54.485">la</span> <span begin="0:54.485" end="0:54.910">cei</span> <span begin="0:54.910" end="0:55.760">sărmani</span> <span begin="0:55.760" end="0:56.184">și</span> <span begin="0:56.184" end="0:58.309">goi</span></p><p begin="0:58.309" end="1:05.106" ttm:agent="v1"><span begin="0:58.309" end="0:58.733">Să</span> <span begin="0:58.733" end="0:59.158">le</span> <span begin="0:59.158" end="1:01.282">aprindeți</span> <span begin="1:01.282" end="1:02.557">flacăra</span> <span begin="1:02.557" end="1:05.106">credinței</span></p><p begin="1:05.106" end="1:12.883" ttm:agent="v1"><span begin="1:05.106" end="1:05.531">Ca</span> <span begin="1:05.531" end="1:05.956">să</span> <span begin="1:05.956" end="1:08.080">se-ntoarcă-n</span> <span begin="1:08.080" end="1:08.929">staul,</span> <span begin="1:08.929" end="1:12.883">înapoi.</span></p><p begin="1:12.883" end="1:19.748" ttm:agent="v1"><span begin="1:12.883" end="1:13.741">Așa</span> <span begin="1:13.741" end="1:14.170">cum</span> <span begin="1:14.170" end="1:15.458">Eu</span> <span begin="1:15.458" end="1:15.887">am</span> <span begin="1:15.887" end="1:16.316">fost</span> <span begin="1:16.316" end="1:17.174">privit</span> <span begin="1:17.174" end="1:17.603">cu</span> <span begin="1:17.603" end="1:19.748">ură,</span></p><p begin="1:19.748" end="1:26.614" ttm:agent="v1"><span begin="1:19.748" end="1:20.607">Purtați</span> <span begin="1:20.607" end="1:21.036">și</span> <span begin="1:21.036" end="1:22.323">voi</span> <span begin="1:22.323" end="1:22.752">al</span> <span begin="1:22.752" end="1:23.610">crucii</span> <span begin="1:23.610" end="1:24.039">greu</span> <span begin="1:24.039" end="1:26.614">calvar,</span></p><p begin="1:26.614" end="1:33.479" ttm:agent="v1"><span begin="1:26.614" end="1:27.043">Dar</span> <span begin="1:27.043" end="1:27.472">veți</span> <span begin="1:27.472" end="1:29.188">primi</span> <span begin="1:29.188" end="1:29.617">Duh</span> <span begin="1:29.617" end="1:30.046">Sfânt</span> <span begin="1:30.046" end="1:30.904">fără</span> <span begin="1:30.904" end="1:33.479">măsură</span></p><p begin="1:33.479" end="1:41.604" ttm:agent="v1"><span begin="1:33.479" end="1:33.908">Ca</span> <span begin="1:33.908" end="1:34.337">să</span> <span begin="1:34.337" end="1:36.053">vestiți</span> <span begin="1:36.053" end="1:36.482">al</span> <span begin="1:36.482" end="1:38.199">mântuirii</span> <span begin="1:38.199" end="1:41.604">har!</span></p><p begin="1:41.604" end="1:48.332" ttm:agent="v1"><span begin="1:41.604" end="1:42.445">Așa</span> <span begin="1:42.445" end="1:42.866">cum</span> <span begin="1:42.866" end="1:44.127">Eu</span> <span begin="1:44.127" end="1:44.548">am</span> <span begin="1:44.548" end="1:45.809">părăsit</span> <span begin="1:45.809" end="1:48.332">mărirea</span></p><p begin="1:48.332" end="1:55.060" ttm:agent="v1"><span begin="1:48.332" end="1:48.753">Și-am</span> <span begin="1:48.753" end="1:49.173">dat</span> <span begin="1:49.173" end="1:49.594">la</span> <span begin="1:49.594" end="1:50.855">toți</span> <span begin="1:50.855" end="1:51.276">ca</span> <span begin="1:51.276" end="1:52.117">jertfă</span> <span begin="1:52.117" end="1:52.958">viața</span> <span begin="1:52.958" end="1:55.060">Mea,</span></p><p begin="1:55.060" end="2:01.788" ttm:agent="v1"><span begin="1:55.060" end="1:55.481">La</span> <span begin="1:55.481" end="1:55.901">fel</span> <span begin="1:55.901" end="1:56.322">și</span> <span begin="1:56.322" end="1:57.583">voi</span> <span begin="1:57.583" end="1:58.004">să</span> <span begin="1:58.004" end="1:59.265">vă-mpliniți</span> <span begin="1:59.265" end="2:01.788">menirea</span></p><p begin="2:01.788" end="2:07.254" ttm:agent="v1"><span begin="2:01.788" end="2:02.208">Pe</span> <span begin="2:02.208" end="2:02.629">drum</span> <span begin="2:02.629" end="2:03.049">de</span> <span begin="2:03.049" end="2:04.311">cer,</span> <span begin="2:04.311" end="2:05.152">suind</span> <span begin="2:05.152" end="2:05.572">prin</span> <span begin="2:05.572" end="2:07.254">Golgota!</span></p></div></body></tt>