<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>288. Mica picătură</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:11.944"><div><p begin="0:11.020" end="0:15.872" ttm:agent="v1"><span begin="0:11.020" end="0:12.233">Mica</span> <span begin="0:12.233" end="0:15.872">picătură</span></p><p begin="0:15.872" end="0:20.724" ttm:agent="v1"><span begin="0:15.872" end="0:17.085">Naște</span> <span begin="0:17.085" end="0:17.691">un</span> <span begin="0:17.691" end="0:20.724">ocean;</span></p><p begin="0:20.724" end="0:25.576" ttm:agent="v1"><span begin="0:20.724" end="0:21.330">Fir</span> <span begin="0:21.330" end="0:21.937">cu</span> <span begin="0:21.937" end="0:22.543">fir,</span> <span begin="0:22.543" end="0:25.576">se-adună</span></p><p begin="0:25.576" end="0:30.687" ttm:agent="v1"><span begin="0:25.576" end="0:26.789">Stânca</span> <span begin="0:26.789" end="0:27.395">de</span> <span begin="0:27.395" end="0:30.687">mărgean...</span></p><p begin="0:30.687" end="0:35.539" ttm:agent="v1"><span begin="0:30.687" end="0:31.900">Scurta</span> <span begin="0:31.900" end="0:33.113">clipă</span> <span begin="0:33.113" end="0:35.539">zboară,</span></p><p begin="0:35.539" end="0:40.391" ttm:agent="v1"><span begin="0:35.539" end="0:36.146">Chiar</span> <span begin="0:36.146" end="0:36.752">de</span> <span begin="0:36.752" end="0:37.359">n-ai</span> <span begin="0:37.359" end="0:40.391">dori,</span></p><p begin="0:40.391" end="0:45.243" ttm:agent="v1"><span begin="0:40.391" end="0:41.604">Însă</span> <span begin="0:41.604" end="0:42.211">ea</span> <span begin="0:42.211" end="0:45.243">măsoară</span></p><p begin="0:45.243" end="0:51.655" ttm:agent="v1"><span begin="0:45.243" end="0:45.850">Drum</span> <span begin="0:45.850" end="0:46.456">de</span> <span begin="0:46.456" end="0:51.655">veșnicii...</span></p><p begin="0:51.655" end="0:56.483" ttm:agent="v1"><span begin="0:51.655" end="0:52.560">Mici</span> <span begin="0:52.560" end="0:54.069">ispite</span> <span begin="0:54.069" end="0:56.483">cheamă</span></p><p begin="0:56.483" end="1:01.310" ttm:agent="v1"><span begin="0:56.483" end="0:58.293">Inima-n</span> <span begin="0:58.293" end="1:01.310">păcat.</span></p><p begin="1:01.310" end="1:06.138" ttm:agent="v1"><span begin="1:01.310" end="1:02.517">Dacă</span> <span begin="1:02.517" end="1:03.121">nu</span> <span begin="1:03.121" end="1:03.724">iei</span> <span begin="1:03.724" end="1:06.138">seamă,</span></p><p begin="1:06.138" end="1:10.205" ttm:agent="v1"><span begin="1:06.138" end="1:06.741">Poți</span> <span begin="1:06.741" end="1:07.345">să</span> <span begin="1:07.345" end="1:07.948">fii</span> <span begin="1:07.948" end="1:10.205">pătat...</span></p><p begin="1:10.205" end="1:14.985" ttm:agent="v1"><span begin="1:10.205" end="1:11.400">Fapte</span> <span begin="1:11.400" end="1:11.998">mici</span> <span begin="1:11.998" end="1:12.595">de</span> <span begin="1:12.595" end="1:14.985">milă,</span></p><p begin="1:14.985" end="1:19.764" ttm:agent="v1"><span begin="1:14.985" end="1:16.180">Vorbe</span> <span begin="1:16.180" end="1:16.777">de</span> <span begin="1:16.777" end="1:19.764">zidit</span></p><p begin="1:19.764" end="1:24.543" ttm:agent="v1"><span begin="1:19.764" end="1:20.362">Pot</span> <span begin="1:20.362" end="1:20.959">să</span> <span begin="1:20.959" end="1:21.556">dea</span> <span begin="1:21.556" end="1:24.543">lumină</span></p><p begin="1:24.543" end="1:29.703" ttm:agent="v1"><span begin="1:24.543" end="1:25.738">Celui</span> <span begin="1:25.738" end="1:29.703">rătăcit...</span></p><p begin="1:29.703" end="1:34.530" ttm:agent="v1"><span begin="1:29.703" end="1:30.910">Boabe</span> <span begin="1:30.910" end="1:34.530">semănate</span></p><p begin="1:34.530" end="1:39.357" ttm:agent="v1"><span begin="1:34.530" end="1:35.133">De</span> <span begin="1:35.133" end="1:36.943">gingașe</span> <span begin="1:36.943" end="1:39.357">mâini,</span></p><p begin="1:39.357" end="1:44.184" ttm:agent="v1"><span begin="1:39.357" end="1:44.184">Binecuvântate,</span></p><p begin="1:44.184" end="1:49.531" ttm:agent="v1"><span begin="1:44.184" end="1:44.788">Se</span> <span begin="1:44.788" end="1:45.391">vor</span> <span begin="1:45.391" end="1:46.598">face</span> <span begin="1:46.598" end="1:49.531">pâini...</span></p><p begin="1:49.531" end="1:54.334" ttm:agent="v1"><span begin="1:49.531" end="1:50.432">Fii</span> <span begin="1:50.432" end="1:50.732">cu</span> <span begin="1:50.732" end="1:51.933">mintea</span> <span begin="1:51.933" end="1:54.334">trează,</span></p><p begin="1:54.334" end="1:59.137" ttm:agent="v1"><span begin="1:54.334" end="1:54.935">Vezi</span> <span begin="1:54.935" end="1:55.535">ce-i</span> <span begin="1:55.535" end="1:56.135">bun</span> <span begin="1:56.135" end="1:56.736">sau</span> <span begin="1:56.736" end="1:59.137">rău!</span></p><p begin="1:59.137" end="2:03.940" ttm:agent="v1"><span begin="1:59.137" end="2:00.338">Domnul</span> <span begin="2:00.338" end="2:03.940">sigilează</span></p><p begin="2:03.940" end="2:07.543" ttm:agent="v1"><span begin="2:03.940" end="2:06.342">Caracterul</span> <span begin="2:06.342" end="2:07.543">tău!</span></p></div></body></tt>