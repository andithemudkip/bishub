<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>598. Dispară griji lumești!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:41.146"><div><p begin="0:12.590" end="0:18.134" ttm:agent="v1"><span begin="0:12.590" end="0:14.669">Dispară</span> <span begin="0:14.669" end="0:15.362">griji</span> <span begin="0:15.362" end="0:17.094">lumești,</span> <span begin="0:17.094" end="0:17.441">căci</span> <span begin="0:17.441" end="0:18.134">eu</span></p><p begin="0:18.134" end="0:23.678" ttm:agent="v1"><span begin="0:18.134" end="0:19.520">Încep</span> <span begin="0:19.520" end="0:21.599">Sabatul</span> <span begin="0:21.599" end="0:23.678">sfânt,</span></p><p begin="0:23.678" end="0:29.222" ttm:agent="v1"><span begin="0:23.678" end="0:24.371">Dat</span> <span begin="0:24.371" end="0:26.450">omului</span> <span begin="0:26.450" end="0:27.143">de</span> <span begin="0:27.143" end="0:29.222">Dumnezeu</span></p><p begin="0:29.222" end="0:41.370" ttm:agent="v1"><span begin="0:29.222" end="0:29.915">De</span> <span begin="0:29.915" end="0:30.608">când</span> <span begin="0:30.608" end="0:31.301">e</span> <span begin="0:31.301" end="0:31.994">pe</span> <span begin="0:31.994" end="0:41.370">pământ!</span></p><p begin="0:41.370" end="0:46.886" ttm:agent="v1"><span begin="0:41.370" end="0:44.128">Ascultă-ne</span> <span begin="0:44.128" end="0:44.818">când</span> <span begin="0:44.818" end="0:45.852">Te</span> <span begin="0:45.852" end="0:46.886">chemăm</span></p><p begin="0:46.886" end="0:52.403" ttm:agent="v1"><span begin="0:46.886" end="0:47.576">Prin</span> <span begin="0:47.576" end="0:48.955">rugă</span> <span begin="0:48.955" end="0:49.644">și</span> <span begin="0:49.644" end="0:52.403">cântări,</span></p><p begin="0:52.403" end="0:57.919" ttm:agent="v1"><span begin="0:52.403" end="0:55.161">Ne-acoperă</span> <span begin="0:55.161" end="0:55.850">azi,</span> <span begin="0:55.850" end="0:56.885">Te</span> <span begin="0:56.885" end="0:57.919">rugăm,</span></p><p begin="0:57.919" end="0:59.987" ttm:agent="v1"><span begin="0:57.919" end="0:58.608">Cu</span> <span begin="0:58.608" end="0:59.987">binecuvântări.</span></p></div></body></tt>