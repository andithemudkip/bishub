<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>628. Doamne sfinte, plin de milă</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:33.518"><div><p begin="0:07.550" end="0:11.657" ttm:agent="v1"><span begin="0:07.550" end="0:08.577">Doamne</span> <span begin="0:08.577" end="0:09.603">sfinte</span> <span begin="0:09.603" end="0:10.117">plin</span> <span begin="0:10.117" end="0:10.630">de</span> <span begin="0:10.630" end="0:11.657">milă,</span></p><p begin="0:11.657" end="0:15.764" ttm:agent="v1"><span begin="0:11.657" end="0:13.197">Umiliți</span> <span begin="0:13.197" end="0:13.710">noi</span> <span begin="0:13.710" end="0:14.224">Te</span> <span begin="0:14.224" end="0:15.764">rugăm:</span></p><p begin="0:15.764" end="0:19.871" ttm:agent="v1"><span begin="0:15.764" end="0:16.277">Să</span> <span begin="0:16.277" end="0:16.790">ne</span> <span begin="0:16.790" end="0:17.304">ierți</span> <span begin="0:17.304" end="0:17.817">de</span> <span begin="0:17.817" end="0:18.844">orice</span> <span begin="0:18.844" end="0:19.871">vină</span></p><p begin="0:19.871" end="0:21.378" ttm:agent="v1"><span begin="0:19.871" end="0:20.384">Când</span> <span begin="0:20.384" end="0:20.897">spre</span> <span begin="0:20.897" end="0:21.924">Tine</span> <span begin="0:21.924" end="0:21.378">ne-ndreptăm!</span></p><p begin="0:21.378" end="0:25.464" ttm:agent="v1"><span begin="0:21.378" end="0:22.399">Doamne,</span> <span begin="0:22.399" end="0:22.910">Tu</span> <span begin="0:22.910" end="0:23.421">ne</span> <span begin="0:23.421" end="0:23.931">ești</span> <span begin="0:23.931" end="0:25.464">Părinte,</span></p><p begin="0:25.464" end="0:29.550" ttm:agent="v1"><span begin="0:25.464" end="0:25.975">Ca</span> <span begin="0:25.975" end="0:27.507">Părinte</span> <span begin="0:27.507" end="0:28.018">să</span> <span begin="0:28.018" end="0:28.529">ne</span> <span begin="0:28.529" end="0:29.550">cerți,</span></p><p begin="0:29.550" end="0:33.637" ttm:agent="v1"><span begin="0:29.550" end="0:30.061">Dar</span> <span begin="0:30.061" end="0:30.572">în</span> <span begin="0:30.572" end="0:31.593">mila</span> <span begin="0:31.593" end="0:32.104">Ta,</span> <span begin="0:32.104" end="0:33.637">Preasfinte,</span></p><p begin="0:33.637" end="0:36.663" ttm:agent="v1"><span begin="0:33.637" end="0:35.680">Cu-ndurare</span> <span begin="0:35.680" end="0:36.191">să</span> <span begin="0:36.191" end="0:36.701">ne</span> <span begin="0:36.701" end="0:36.663">ierți.</span></p><p begin="0:36.663" end="0:40.647" ttm:agent="v1"><span begin="0:36.663" end="0:37.659">Dă-ne-un</span> <span begin="0:37.659" end="0:38.655">spirit</span> <span begin="0:38.655" end="0:39.153">de</span> <span begin="0:39.153" end="0:40.647">jertfire,</span></p><p begin="0:40.647" end="0:44.631" ttm:agent="v1"><span begin="0:40.647" end="0:41.145">Să</span> <span begin="0:41.145" end="0:42.141">trăim</span> <span begin="0:42.141" end="0:43.635">viața</span> <span begin="0:43.635" end="0:44.631">Ta;</span></p><p begin="0:44.631" end="0:48.615" ttm:agent="v1"><span begin="0:44.631" end="0:46.125">Umple-ne</span> <span begin="0:46.125" end="0:46.623">cu-a</span> <span begin="0:46.623" end="0:47.121">Ta</span> <span begin="0:47.121" end="0:48.615">iubire,</span></p><p begin="0:48.615" end="0:49.080" ttm:agent="v1"><span begin="0:48.615" end="0:49.113">Să</span> <span begin="0:49.113" end="0:50.110">putem</span> <span begin="0:50.110" end="0:50.608">și</span> <span begin="0:50.608" end="0:51.106">noi</span> <span begin="0:51.106" end="0:49.080">ierta.</span></p><p begin="0:49.080" end="0:53.104" ttm:agent="v1"><span begin="0:49.080" end="0:51.595">Doamne-ajută-ne</span> <span begin="0:51.595" end="0:53.104">întruna</span></p><p begin="0:53.104" end="0:57.128" ttm:agent="v1"><span begin="0:53.104" end="0:53.607">Să</span> <span begin="0:53.607" end="0:54.110">fim</span> <span begin="0:54.110" end="0:55.619">iubitori</span> <span begin="0:55.619" end="0:56.122">și</span> <span begin="0:56.122" end="0:57.128">buni,</span></p><p begin="0:57.128" end="1:01.152" ttm:agent="v1"><span begin="0:57.128" end="0:57.631">Ca</span> <span begin="0:57.631" end="0:58.134">să</span> <span begin="0:58.134" end="0:59.643">dobândim</span> <span begin="0:59.643" end="1:01.152">cununa</span></p><p begin="1:01.152" end="1:04.170" ttm:agent="v1"><span begin="1:01.152" end="1:01.655">Ce-ai</span> <span begin="1:01.655" end="1:03.164">promis-o</span> <span begin="1:03.164" end="1:03.667">din</span> <span begin="1:03.667" end="1:04.170">străbuni!</span></p></div></body></tt>