4.987">Dumnezeul,</span></p><p begin="0:44.987" end="0:46.590" ttm:agent="v1"><span begin="0:44.987" end="0:45.659">Și</span> <span begin="0:45.659" end="0:46.331">nu</span> <span begin="0:46.331" end="0:47.003">vom</span> <span begin="0:47.003" end="0:46.590">pieri!</span></p><p begin="0:46.590" end="0:50.543" ttm:agent="v1"><span begin="0:46.590" end="0:47.249">Când</span> <span begin="0:47.249" end="0:47.908">vin</span> <span begin="0:47.908" end="0:50.543">încercări</span></p><p begin="0:50.543" end="0:54.496" ttm:agent="v1"><span begin="0:50.543" end="0:51.202">Și</span> <span begin="0:51.202" end="0:51.861">pier</span> <span begin="0:51.861" end="0:54.496">bucurii,</span></p><p begin="0:54.496" end="0:58.449" ttm:agent="v1"><span begin="0:54.496" end="0:56.472">Rămânem</span> <span begin="0:56.472" end="0:57.131">cu</span> <span begin="0:57.131" end="0:58.449">El,</span></p><p begin="0:58.449" end="1:02.401" ttm:agent="v1"><span begin="0:58.449" end="0:59.107">Chiar</span> <span begin="0:59.107" end="1:00.425">lacrimi</span> <span begin="1:00.425" end="1:01.084">de-or</span> <span begin="1:01.084" end="1:02.401">fi!</span></p><p begin="1:02.401" end="1:06.354" ttm:agent="v1"><span begin="1:02.401" end="1:03.060">Spre</span> <span begin="1:03.060" end="1:04.378">Domnul</span> <span begin="1:04.378" end="1:06.354">ne-ntoarcem</span></p><p begin="1:06.354" end="1:10.307" ttm:agent="v1"><span begin="1:06.354" end="1:07.672">Cerând</span> <span begin="1:07.672" end="1:10.307">ajutor,</span></p><p begin="1:10.307" end="1:13.601" ttm:agent="v1"><span begin="1:10.307" end="1:12.283">Ne-ncredem</span> <span begin="1:12.283" end="1:12.942">în</span> <span begin="1:12.942" end="1:13.601">El,</span></p><p begin="1:13.601" end="1:19.992" ttm:agent="v1"><span begin="1:13.601" end="1:14.918">Bunul</span> <span begin="1:14.918" end="1:16.236">nostru</span> <span begin="1:16.236" end="1:19.992">Păstor!</span></p><p begin="1:19.992" end="1:24.004" ttm:agent="v1"><span begin="1:19.992" end="1:21.998">Rămânem</span> <span begin="1:21.998" end="1:22.667">în</span> <span begin="1:22.667" end="1:24.004">El,</span></p><p begin="1:24.004" end="1:28.016" ttm:agent="v1"><span begin="1:24.004" end="1:24.673">Căci</span> <span begin="1:24.673" end="1:25.342">El</span> <span begin="1:25.342" end="1:26.010">ne-a</span> <span begin="1:26.010" end="1:28.016">iubit:</span></p><p begin="1:28.016" end="1:32.028" ttm:agent="v1"><span begin="1:28.016" end="1:28.685">Pe</span> <span begin="1:28.685" end="1:29.354">când</span> <span begin="1:29.354" end="1:30.022">ca</span> <span begin="1:30.022" end="1:32.028">vrăjmași</span></p><p begin="1:32.028" end="1:36.040" ttm:agent="v1"><span begin="1:32.028" end="1:32.697">Noi</span> <span begin="1:32.697" end="1:33.366">L-am</span> <span begin="1:33.366" end="1:36.040">răstignit;</span></p><p begin="1:36.040" end="1:40.052" ttm:agent="v1"><span begin="1:36.040" end="1:37.378">Slăvit</span> <span begin="1:37.378" end="1:38.715">fie</span> <span begin="1:38.715" end="1:40.052">Domnul</span></p><p begin="1:40.052" end="1:44.065" ttm:agent="v1"><span begin="1:40.052" end="1:40.721">De</span> <span begin="1:40.721" end="1:42.059">orice</span> <span begin="1:42.059" end="1:44.065">popor!</span></p><p begin="1:44.065" end="1:48.077" ttm:agent="v1"><span begin="1:44.065" end="1:44.733">Ce</span> <span begin="1:44.733" end="1:46.071">viață</span> <span begin="1:46.071" end="1:48.077">bogată</span></p><p begin="1:48.077" end="1:49.749" ttm:agent="v1"><span begin="1:48.077" end="1:48.745">Dă</span> <span begin="1:48.745" end="1:49.414">El</span> <span begin="1:49.414" end="1:49.749">tuturor!</span></p><p begin="1:49.749" end="1:53.821" ttm:agent="v1"><span begin="1:49.749" end="1:53.821">De-aceea-ndrăzniți,</span></p><p begin="1:53.821" end="1:57.893" ttm:agent="v1"><span begin="1:53.821" end="1:55.178">Luptați,</span> <span begin="1:55.178" end="1:55.857">nu</span> <span begin="1:55.857" end="1:57.893">cedați,</span></p><p begin="1:57.893" end="2:01.965" ttm:agent="v1"><span begin="1:57.893" end="1:58.572">Și</span> <span begin="1:58.572" end="1:59.929">orice-ar</span> <span begin="1:59.929" end="2:01.965">veni,</span></p><p begin="2:01.965" end="2:06.037" ttm:agent="v1"><span begin="2:01.965" end="2:02.644">La</span> <span begin="2:02.644" end="2:04.001">Domnul</span> <span begin="2:04.001" end="2:06.037">strigați!</span></p><p begin="2:06.037" end="2:10.110" ttm:agent="v1"><span begin="2:06.037" end="2:07.395">Isus</span> <span begin="2:07.395" end="2:08.074">e</span> <span begin="2:08.074" end="2:08.752">în</span> <span begin="2:08.752" end="2:10.110">stare</span></p><p begin="2:10.110" end="2:14.182" ttm:agent="v1"><span begin="2:10.110" end="2:12.146">S-ajute-n</span> <span begin="2:12.146" end="2:14.182">nevoi,</span></p><p begin="2:14.182" end="2:18.254" ttm:agent="v1"><span begin="2:14.182" end="2:14.861">El</span> <span begin="2:14.861" end="2:18.254">făgăduiește:</span></p><p begin="2:18.254" end="2:22.326" ttm:agent="v1"><span begin="2:18.254" end="2:18.933">„În</span> <span begin="2:18.933" end="2:19.611">veci</span> <span begin="2:19.611" end="2:20.290">sunt</span> <span begin="2:20.290" end="2:20.969">cu</span> <span begin="2:20.969" end="2:22.326">voi!”</span></p></div></body></tt>