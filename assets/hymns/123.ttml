<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>123. Privește marea suferință</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:31.171"><div><p begin="0:17.370" end="0:25.127" ttm:agent="v1"><span begin="0:17.370" end="0:19.309">Privește</span> <span begin="0:19.309" end="0:21.248">marea</span> <span begin="0:21.248" end="0:25.127">suferință</span></p><p begin="0:25.127" end="0:32.884" ttm:agent="v1"><span begin="0:25.127" end="0:26.096">A</span> <span begin="0:26.096" end="0:26.581">lui</span> <span begin="0:26.581" end="0:28.036">Isus,</span> <span begin="0:28.036" end="0:29.005">pe</span> <span begin="0:29.005" end="0:32.884">Golgota,</span></p><p begin="0:32.884" end="0:40.640" ttm:agent="v1"><span begin="0:32.884" end="0:33.853">Și</span> <span begin="0:33.853" end="0:34.338">te</span> <span begin="0:34.338" end="0:36.762">apleacă-n</span> <span begin="0:36.762" end="0:40.640">umilință,</span></p><p begin="0:40.640" end="0:49.557" ttm:agent="v1"><span begin="0:40.640" end="0:42.580">Sărmane</span> <span begin="0:42.580" end="0:43.549">om,</span> <span begin="0:43.549" end="0:44.519">la</span> <span begin="0:44.519" end="0:46.458">crucea</span> <span begin="0:46.458" end="0:49.557">Sa!</span></p><p begin="0:49.557" end="0:57.198" ttm:agent="v1"><span begin="0:49.557" end="0:51.467">Acolo</span> <span begin="0:51.467" end="0:53.377">afli</span> <span begin="0:53.377" end="0:57.198">vindecare</span></p><p begin="0:57.198" end="1:04.838" ttm:agent="v1"><span begin="0:57.198" end="0:58.153">Și</span> <span begin="0:58.153" end="1:01.018">izbăvire</span> <span begin="1:01.018" end="1:01.973">de</span> <span begin="1:01.973" end="1:04.838">păcat!</span></p><p begin="1:04.838" end="1:12.479" ttm:agent="v1"><span begin="1:04.838" end="1:06.748">Primește</span> <span begin="1:06.748" end="1:09.613">singura</span> <span begin="1:09.613" end="1:12.479">salvare,</span></p><p begin="1:12.479" end="1:22.919" ttm:agent="v1"><span begin="1:12.479" end="1:14.389">Predă-te</span> <span begin="1:14.389" end="1:15.344">Lui</span> <span begin="1:15.344" end="1:16.299">și</span> <span begin="1:16.299" end="1:17.254">ești</span> <span begin="1:17.254" end="1:22.919">iertat!</span></p><p begin="1:22.919" end="1:30.559" ttm:agent="v1"><span begin="1:22.919" end="1:25.784">Primește-mă</span> <span begin="1:25.784" end="1:26.739">cu-a</span> <span begin="1:26.739" end="1:27.694">Ta</span> <span begin="1:27.694" end="1:30.559">iubire,</span></p><p begin="1:30.559" end="1:38.200" ttm:agent="v1"><span begin="1:30.559" end="1:31.514">Sfânt</span> <span begin="1:31.514" end="1:31.992">Miel</span> <span begin="1:31.992" end="1:32.470">de</span> <span begin="1:32.470" end="1:34.380">jertfă,</span> <span begin="1:34.380" end="1:38.200">nepătat!</span></p><p begin="1:38.200" end="1:45.840" ttm:agent="v1"><span begin="1:38.200" end="1:39.155">În</span> <span begin="1:39.155" end="1:40.110">sânge</span> <span begin="1:40.110" end="1:41.065">scump,</span> <span begin="1:41.065" end="1:42.020">spre</span> <span begin="1:42.020" end="1:45.840">mântuire,</span></p><p begin="1:45.840" end="1:53.041" ttm:agent="v1"><span begin="1:45.840" end="1:47.273">Doresc</span> <span begin="1:47.273" end="1:47.750">să</span> <span begin="1:47.750" end="1:48.706">fiu</span> <span begin="1:48.706" end="1:49.661">și</span> <span begin="1:49.661" end="1:50.616">eu</span> <span begin="1:50.616" end="1:53.041">spălat!</span></p><p begin="1:53.041" end="2:00.796" ttm:agent="v1"><span begin="1:53.041" end="1:54.010">În</span> <span begin="1:54.010" end="1:55.949">inimă,</span> <span begin="1:55.949" end="1:57.888">pentru</span> <span begin="1:57.888" end="2:00.796">vecie,</span></p><p begin="2:00.796" end=