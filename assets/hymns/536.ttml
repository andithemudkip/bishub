<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>536. Când Isus, Domnul vieții, revine</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="3:27.987"><div><p begin="1:01.110" end="1:07.010" ttm:agent="v1"><span begin="1:01.110" end="1:01.663">Când</span> <span begin="1:01.663" end="1:02.585">Isus,</span> <span begin="1:02.585" end="1:03.323">Domnul</span> <span begin="1:03.323" end="1:04.613">vieții,</span> <span begin="1:04.613" end="1:07.010">revine</span></p><p begin="1:07.010" end="1:12.911" ttm:agent="v1"><span begin="1:07.010" end="1:07.748">În</span> <span begin="1:07.748" end="1:09.038">haină</span> <span begin="1:09.038" end="1:09.223">de</span> <span begin="1:09.223" end="1:12.911">judecător,</span></p><p begin="1:12.911" end="1:18.811" ttm:agent="v1"><span begin="1:12.911" end="1:13.464">Va</span> <span begin="1:13.464" end="1:14.386">rosti</span> <span begin="1:14.386" end="1:14.939">o</span> <span begin="1:14.939" end="1:16.414">sentință</span> <span begin="1:16.414" end="1:16.598">de</span> <span begin="1:16.598" end="1:18.811">bine,</span></p><p begin="1:18.811" end="1:24.779" ttm:agent="v1"><span begin="1:18.811" end="1:19.548">Sau</span> <span begin="1:19.548" end="1:20.286">doar</span> <span begin="1:20.286" end="1:20.839">un</span> <span begin="1:20.839" end="1:21.761">cuvânt</span> <span begin="1:21.761" end="1:24.779">arzător?...</span></p><p begin="1:24.779" end="1:30.738" ttm:agent="v1"><span begin="1:24.779" end="1:25.337">De-ai</span> <span begin="1:25.337" end="1:26.269">slujit</span> <span begin="1:26.269" end="1:26.827">pe</span> <span begin="1:26.827" end="1:27.758">Isus,</span> <span begin="1:27.758" end="1:28.317">El</span> <span begin="1:28.317" end="1:28.503">va</span> <span begin="1:28.503" end="1:30.738">spune:</span></p><p begin="1:30.738" end="1:36.697" ttm:agent="v1"><span begin="1:30.738" end="1:31.483">„Ai</span> <span begin="1:31.483" end="1:32.228">fost</span> <span begin="1:32.228" end="1:32.973">robul</span> <span begin="1:32.973" end="1:33.718">bun,</span> <span begin="1:33.718" end="1:36.697">credincios”!</span></p><p begin="1:36.697" end="1:42.657" ttm:agent="v1"><span begin="1:36.697" end="1:37.256">Dar</span> <span begin="1:37.256" end="1:38.187">nespus</span> <span begin="1:38.187" end="1:38.746">de</span> <span begin="1:38.746" end="1:39.677">cumplit</span> <span begin="1:39.677" end="1:40.236">o</span> <span begin="1:40.236" end="1:40.422">să</span> <span begin="1:40.422" end="1:42.657">sune:</span></p><p begin="1:42.657" end="1:49.920" ttm:agent="v1"><span begin="1:42.657" end="1:43.401">„În</span> <span begin="1:43.401" end="1:44.146">foc</span> <span begin="1:44.146" end="1:44.891">cu-acest</span> <span begin="1:44.891" end="1:45.636">rob</span> <span begin="1:45.636" end="1:49.920">ticălos!”</span></p><p begin="1:49.920" end="1:55.850" ttm:agent="v1"><span begin="1:49.920" end="1:50.662">Celor</span> <span begin="1:50.662" end="1:51.403">sfinți</span> <span begin="1:51.403" end="1:52.885">împărțind</span> <span begin="1:52.885" end="1:53.626">haine</span> <span begin="1:53.626" end="1:55.850">albe,</span></p><p begin="1:55.850" end="2:01.779" ttm:agent="v1"><span begin="1:55.850" end="1:57.332">Isus</span> <span begin="1:57.332" end="1:58.815">bucuros</span> <span begin="1:58.815" end="1:59.370">va</span> <span begin="1:59.370" end="2:01.779">zâmbi</span></p><p begin="2:01.779" end="2:07.709" ttm:agent="v1"><span begin="2:01.779" end="2:02.335">Și</span> <span begin="2:02.335" end="2:02.520">din</span> <span begin="2:02.520" end="2:03.262">piept</span> <span begin="2:03.262" end="2:05.300">osanale,</span> <span begin="2:05.300" end="2:05.485">ca</span> <span begin="2:05.485" end="2:07.709">salve,</span></p><p begin="2:07.709" end="2:13.684" ttm:agent="v1"><span begin="2:07.709" end="2:09.747">Deodată</span> <span begin="2:09.747" end="2:09.932">spre</span> <span begin="2:09.932" end="2:10.674">El</span> <span begin="2:10.674" end="2:11.229">vor</span> <span begin="2:11.229" end="2:13.684">porni!</span></p><p begin="2:13.684" end="2:19.614" ttm:agent="v1"><span begin="2:13.684" end="2:14.425">Poate-n</span> <span begin="2:14.425" end="2:15.167">somn</span> <span begin="2:15.167" end="2:17.205">așteptarea</span> <span begin="2:17.205" end="2:17.390">ni-i</span> <span begin="2:17.390" end="2:19.614">frântă,</span></p><p begin="2:19.614" end="2:25.543" ttm:agent="v1"><span begin="2:19.614" end="2:20.355">Dar</span> <span begin="2:20.355" end="2:21.652">vasul</span> <span begin="2:21.652" end="2:23.134">răbdării</span> <span begin="2:23.134" end="2:23.320">e</span> <span begin="2:23.320" end="2:25.543">plin?</span></p><p begin="2:25.543" end="2:31.473" ttm:agent="v1"><span begin="2:25.543" end="2:26.099">Când</span> <span begin="2:26.099" end="2:27.025">Isus</span> <span begin="2:27.025" end="2:27.581">ne</span> <span begin="2:27.581" end="2:29.064">invită</span> <span begin="2:29.064" end="2:29.249">la</span> <span begin="2:29.249" end="2:31.473">nuntă,</span></p><p begin="2:31.473" end="2:36.476" ttm:agent="v1"><span begin="2:31.473" end="2:32.955">Ulei</span> <span begin="2:32.955" end="2:33.511">să</span> <span begin="2:33.511" end="2:33.696">nu</span> <span begin="2:33.696" end="2:34.993">fie</span> <span begin="2:34.993" end="2:36.476">puțin!</span></p></div></body></tt>