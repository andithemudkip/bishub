<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>624. Iar, Isuse, ne-adunași</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:19.416"><div><p begin="0:14.310" end="0:20.092" ttm:agent="v1"><span begin="0:14.310" end="0:15.033">Iar</span> <span begin="0:15.033" end="0:17.201">Isuse</span> <span begin="0:17.201" end="0:20.092">ne-adunași</span></p><p begin="0:20.092" end="0:27.319" ttm:agent="v1"><span begin="0:20.092" end="0:20.815">Să</span> <span begin="0:20.815" end="0:21.537">ne</span> <span begin="0:21.537" end="0:22.260">dai</span> <span begin="0:22.260" end="0:27.319">învățăminte;</span></p><p begin="0:27.319" end="0:33.101" ttm:agent="v1"><span begin="0:27.319" end="0:28.042">Fă</span> <span begin="0:28.042" end="0:28.765">să</span> <span begin="0:28.765" end="0:29.487">ne</span> <span begin="0:29.487" end="0:30.933">simțim</span> <span begin="0:30.933" end="0:33.101">atrași</span></p><p begin="0:33.101" end="0:40.328" ttm:agent="v1"><span begin="0:33.101" end="0:33.824">De</span> <span begin="0:33.824" end="0:36.715">cereștile-Ți</span> <span begin="0:36.715" end="0:40.328">cuvinte,</span></p><p begin="0:40.328" end="0:46.110" ttm:agent="v1"><span begin="0:40.328" end="0:42.497">Și-narmați</span> <span begin="0:42.497" end="0:43.219">cu-a</span> <span begin="0:43.219" end="0:43.942">Ta</span> <span begin="0:43.942" end="0:46.110">putere</span></p><p begin="0:46.110" end="0:54.898" ttm:agent="v1"><span begin="0:46.110" end="0:48.278">Să-mplinim</span> <span begin="0:48.278" end="0:49.001">ce</span> <span begin="0:49.001" end="0:49.724">ne</span> <span begin="0:49.724" end="0:50.447">vei</span> <span begin="0:50.447" end="0:54.898">cere.</span></p><p begin="0:54.898" end="1:00.766" ttm:agent="v1"><span begin="0:54.898" end="0:56.365">Mintea</span> <span begin="0:56.365" end="0:57.832">noastră-al</span> <span begin="0:57.832" end="0:59.299">nostru</span> <span begin="0:59.299" end="1:00.766">gând</span></p><p begin="1:00.766" end="1:08.102" ttm:agent="v1"><span begin="1:00.766" end="1:03.700">Rătăcește</span> <span begin="1:03.700" end="1:05.168">fără</span> <span begin="1:05.168" end="1:08.102">Tine,</span></p><p begin="1:08.102" end="1:13.971" ttm:agent="v1"><span begin="1:08.102" end="1:09.569">Dacă</span> <span begin="1:09.569" end="1:11.770">Spiritul</span> <span begin="1:11.770" end="1:12.503">cel</span> <span begin="1:12.503" end="1:13.971">Sfânt</span></p><p begin="1:13.971" end="1:21.306" ttm:agent="v1"><span begin="1:13.971" end="1:14.704">Nu</span> <span begin="1:14.704" end="1:15.438">ni-L</span> <span begin="1:15.438" end="1:16.171">dai</span> <span begin="1:16.171" end="1:16.905">să</span> <span begin="1:16.905" end="1:17.638">ne</span> <span begin="1:17.638" end="1:21.306">lumine.</span></p><p begin="1:21.306" end="1:27.175" ttm:agent="v1"><span begin="1:21.306" end="1:22.773">Dă-ne</span> <span begin="1:22.773" end="1:24.974">cugete</span> <span begin="1:24.974" end="1:27.175">curate</span></p><p begin="1:27.175" end="1:35.611" ttm:agent="v1"><span begin="1:27.175" end="1:30.109">Și-mplinește-n</span> <span begin="1:30.109" end="1:30.843">noi,</span> <span begin="1:30.843" end="1:31.576">Tu,</span> <span begin="1:31.576" end="1:35.611">toate!</span></p><p begin="1:35.611" end="1:41.567" ttm:agent="v1"><span begin="1:35.611" end="1:36.355">Tu,</span> <span begin="1:36.355" end="1:37.844">născut</span> <span begin="1:37.844" end="1:38.589">din</span> <span begin="1:38.589" end="1:41.567">Dumnezeu,</span></p><p begin="1:41.567" end="1:49.013" ttm:agent="v1"><span begin="1:41.567" end="1:42.312">Ca</span> <span begin="1:42.312" end="1:44.546">lumină</span> <span begin="1:44.546" end="1:45.290">din</span> <span begin="1:45.290" end="1:49.013">lumină,</span></p><p begin="1:49.013" end="1:54.970" ttm:agent="v1"><span begin="1:49.013" end="1:50.502">Fă-ne</span> <span begin="1:50.502" end="1:51.991">după</span> <span begin="1:51.991" end="1:53.480">chipul</span> <span begin="1:53.480" end="1:54.970">Tău,</span></p><p begin="1:54.970" end="2:02.415" ttm:agent="v1"><span begin="1:54.970" end="1:57.203">Spală-ne</span> <span begin="1:57.203" end="1:58.693">de-orice</span> <span begin="1:58.693" end="2:02.415">ne-ntină</span></p><p begin="2:02.415" end="2:08.372" ttm:agent="v1"><span begin="2:02.415" end="2:03.160">Și</span> <span begin="2:03.160" end="2:03.905">ne</span> <span begin="2:03.905" end="2:05.394">du</span> <span begin="2:05.394" end="2:08.372">spre-ndreptățire,</span></p><p begin="2:08.372" end="2:13.584" ttm:agent="v1"><span begin="2:08.372" end="2:09.117">Din</span> <span begin="2:09.117" end="2:11.350">mărire</span> <span begin="2:11.350" end="2:12.095">la</span> <span begin="2:12.095" end="2:13.584">mărire!</span></p></div></body></tt>