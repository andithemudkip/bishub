<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>645. Binecuvântarea Ta</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="0:58.958"><div><p begin="0:16.260" end="0:23.134" ttm:agent="v1"><span begin="0:16.260" end="0:20.843">Binecuvântarea</span> <span begin="0:20.843" end="0:23.134">Ta</span></p><p begin="0:23.134" end="0:30.008" ttm:agent="v1"><span begin="0:23.134" end="0:23.898">Dă-ne-o,</span> <span begin="0:23.898" end="0:25.426">Doamne,</span> <span begin="0:25.426" end="0:26.189">la</span> <span begin="0:26.189" end="0:30.008">plecare,</span></p><p begin="0:30.008" end="0:36.119" ttm:agent="v1"><span begin="0:30.008" end="0:30.772">Și</span> <span begin="0:30.772" end="0:33.064">Cuvântul</span> <span begin="0:33.064" end="0:36.119">predicat</span></p><p begin="0:36.119" end="0:43.757" ttm:agent="v1"><span begin="0:36.119" end="0:36.883">În</span> <span begin="0:36.883" end="0:39.174">această</span> <span begin="0:39.174" end="0:43.757">adunare</span></p><p begin="0:43.757" end="0:49.867" ttm:agent="v1"><span begin="0:43.757" end="0:44.521">Să</span> <span begin="0:44.521" end="0:45.284">ne</span> <span begin="0:45.284" end="0:47.576">fie</span> <span begin="0:47.576" end="0:49.867">spre-ndrumare,</span></p><p begin="0:49.867" end="0:55.214" ttm:agent="v1"><span begin="0:49.867" end="0:50.631">O</span> <span begin="0:50.631" end="0:52.922">lumină</span> <span begin="0:52.922" end="0:53.686">pe</span> <span begin="0:53.686" end="0:55.214">cărare!...</span></p></div></body></tt>