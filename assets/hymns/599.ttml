<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>599. Când umbra serii cade iar</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:38.612"><div><p begin="0:08.109" end="0:14.209" ttm:agent="v1"><span begin="0:08.109" end="0:08.872">Când</span> <span begin="0:08.872" end="0:10.397">umbra</span> <span begin="0:10.397" end="0:11.922">serii</span> <span begin="0:11.922" end="0:13.447">cade</span> <span begin="0:13.447" end="0:14.209">iar,</span></p><p begin="0:14.209" end="0:22.060" ttm:agent="v1"><span begin="0:14.209" end="0:15.734">Venim</span> <span begin="0:15.734" end="0:16.497">în</span> <span begin="0:16.497" end="0:17.259">sfânt</span> <span begin="0:17.259" end="0:18.785">locaș</span> <span begin="0:18.785" end="0:19.547">de</span> <span begin="0:19.547" end="0:22.060">har;</span></p><p begin="0:22.060" end="0:28.160" ttm:agent="v1"><span begin="0:22.060" end="0:23.585">Prinos</span> <span begin="0:23.585" end="0:24.347">de</span> <span begin="0:24.347" end="0:25.872">rugă</span> <span begin="0:25.872" end="0:26.635">și</span> <span begin="0:26.635" end="0:28.160">cântări</span></p><p begin="0:28.160" end="0:39.370" ttm:agent="v1"><span begin="0:28.160" end="0:30.447">Aprindă</span> <span begin="0:30.447" end="0:31.973">stele-n</span> <span begin="0:31.973" end="0:39.370">depărtări.</span></p><p begin="0:39.370" end="0:45.348" ttm:agent="v1"><span begin="0:39.370" end="0:41.612">Întinde,</span> <span begin="0:41.612" end="0:43.107">Doamne,</span> <span begin="0:43.107" end="0:44.601">mâna</span> <span begin="0:44.601" end="0:45.348">Ta</span></p><p begin="0:45.348" end="0:53.077" ttm:agent="v1"><span begin="0:45.348" end="0:46.096">Și</span> <span begin="0:46.096" end="0:46.843">ne</span> <span begin="0:46.843" end="0:49.085">deschide</span> <span begin="0:49.085" end="0:53.077">inima,</span></p><p begin="0:53.077" end="0:59.055" ttm:agent="v1"><span begin="0:53.077" end="0:53.824">În</span> <span begin="0:53.824" end="0:55.318">pacea</span> <span begin="0:55.318" end="0:56.813">serii,</span> <span begin="0:56.813" end="0:57.560">să</span> <span begin="0:57.560" end="0:59.055">primim</span></p><p begin="0:59.055" end="1:08.443" ttm:agent="v1"><span begin="0:59.055" end="1:01.297">Lumina</span> <span begin="1:01.297" end="1:03.539">sfatului</span> <span begin="1:03.539" end="1:08.443">divin.</span></p><p begin="1:08.443" end="1:14.541" ttm:agent="v1"><span begin="1:08.443" end="1:09.205">Cu</span> <span begin="1:09.205" end="1:10.730">glasul</span> <span begin="1:10.730" end="1:11.492">Tău,</span> <span begin="1:11.492" end="1:12.254">cel</span> <span begin="1:12.254" end="1:14.541">preaiubit,</span></p><p begin="1:14.541" end="1:22.389" ttm:agent="v1"><span begin="1:14.541" end="1:16.828">Alungă-al</span> <span begin="1:16.828" end="1:18.352">nopții</span> <span begin="1:18.352" end="1:19.114">văl</span> <span begin="1:19.114" end="1:22.389">cernit,</span></p><p begin="1:22.389" end="1:28.487" ttm:agent="v1"><span begin="1:22.389" end="1:23.913">Lumini</span> <span begin="1:23.913" end="1:24.675">de</span> <span begin="1:24.675" end="1:25.819">har</span> <span begin="1:25.819" end="1:28.487">mântuitor</span></p><p begin="1:28.487" end="1:33.822" ttm:agent="v1"><span begin="1:28.487" end="1:30.011">S-aprinzi</span> <span begin="1:30.011" end="1:30.773">în</span> <span begin="1:30.773" end="1:32.298">viața</span> <span begin="1:32.298" end="1:33.822">tuturor!</span></p></div></body></tt>