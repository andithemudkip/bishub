<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>697. Dimineața a sosit</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:53.554"><div><p begin="0:10.710" end="0:15.430" ttm:agent="v1"><span begin="0:10.710" end="0:13.070">Dimineața</span> <span begin="0:13.070" end="0:13.660">a</span> <span begin="0:13.660" end="0:15.430">sosit,</span></p><p begin="0:15.430" end="0:20.150" ttm:agent="v1"><span begin="0:15.430" end="0:16.610">Vrăbii</span> <span begin="0:16.610" end="0:17.790">cântă-n</span> <span begin="0:17.790" end="0:20.150">răsărit,</span></p><p begin="0:20.150" end="0:24.870" ttm:agent="v1"><span begin="0:20.150" end="0:21.330">Toată</span> <span begin="0:21.330" end="0:22.510">casa</span> <span begin="0:22.510" end="0:23.034">ne-am</span> <span begin="0:23.034" end="0:24.870">trezit</span></p><p begin="0:24.870" end="0:31.030" ttm:agent="v1"><span begin="0:24.870" end="0:25.755">Să-L</span> <span begin="0:25.755" end="0:26.640">slăvim</span> <span begin="0:26.640" end="0:27.230">pe</span> <span begin="0:27.230" end="0:31.030">Domnul.</span></p><p begin="0:31.030" end="0:35.726" ttm:agent="v1"><span begin="0:31.030" end="0:31.911">Tu,</span> <span begin="0:31.911" end="0:32.791">Izvor</span> <span begin="0:32.791" end="0:33.378">de</span> <span begin="0:33.378" end="0:34.552">daruri</span> <span begin="0:34.552" end="0:35.726">vii,</span></p><p begin="0:35.726" end="0:40.423" ttm:agent="v1"><span begin="0:35.726" end="0:37.488">Dă-ne</span> <span begin="0:37.488" end="0:38.075">pâine-n</span> <span begin="0:38.075" end="0:39.249">astă</span> <span begin="0:39.249" end="0:40.423">zi,</span></p><p begin="0:40.423" end="0:45.119" ttm:agent="v1"><span begin="0:40.423" end="0:41.597">Viața</span> <span begin="0:41.597" end="0:42.771">noastră</span> <span begin="0:42.771" end="0:43.293">s-o</span> <span begin="0:43.293" end="0:45.119">susții,</span></p><p begin="0:45.119" end="0:51.456" ttm:agent="v1"><span begin="0:45.119" end="0:46.000">Căci</span> <span begin="0:46.000" end="0:46.293">doar</span> <span begin="0:46.293" end="0:46.880">Tu</span> <span begin="0:46.880" end="0:47.467">ești</span> <span begin="0:47.467" end="0:51.456">Domnul!</span></p><p begin="0:51.456" end="0:56.129" ttm:agent="v1"><span begin="0:51.456" end="0:52.332">Ne</span> <span begin="0:52.332" end="0:53.792">păzește</span> <span begin="0:53.792" end="0:56.129">ne-ncetat</span></p><p begin="0:56.129" end="1:00.801" ttm:agent="v1"><span begin="0:56.129" end="0:57.005">Și</span> <span begin="0:57.005" end="0:58.465">condu-ne</span> <span begin="0:58.465" end="0:59.049">cu-al</span> <span begin="0:59.049" end="0:59.633">Tău</span> <span begin="0:59.633" end="1:00.801">sfat!</span></p><p begin="1:00.801" end="1:05.474" ttm:agent="v1"><span begin="1:00.801" end="1:01.678">Să</span> <span begin="1:01.678" end="1:01.970">ne</span> <span begin="1:01.970" end="1:02.554">ții</span> <span begin="1:02.554" end="1:03.657">fără</span> <span begin="1:03.657" end="1:05.474">păcat</span></p><p begin="1:05.474" end="1:11.587" ttm:agent="v1"><span begin="1:05.474" end="1:06.643">Lângă</span> <span begin="1:06.643" end="1:07.811">Tine,</span> <span begin="1:07.811" end="1:11.587">Doamne!</span></p><p begin="1:11.587" end="1:16.237" ttm:agent="v1"><span begin="1:11.587" end="1:13.331">Să-nvățăm,</span> <span begin="1:13.331" end="1:13.912">prin</span> <span begin="1:13.912" end="1:15.074">Duhul</span> <span begin="1:15.074" end="1:16.237">Sfânt,</span></p><p begin="1:16.237" end="1:20.886" ttm:agent="v1"><span begin="1:16.237" end="1:17.399">Voia</span> <span begin="1:17.399" end="1:17.980">Ta-n</span> <span begin="1:17.980" end="1:18.562">al</span> <span begin="1:18.562" end="1:19.143">Tău</span> <span begin="1:19.143" end="1:20.886">Cuvânt,</span></p><p begin="1:20.886" end="1:25.536" ttm:agent="v1"><span begin="1:20.886" end="1:21.758">Zi</span> <span begin="1:21.758" end="1:22.049">de</span> <span begin="1:22.049" end="1:22.630">zi</span> <span begin="1:22.630" end="1:23.211">în</span> <span begin="1:23.211" end="1:23.728">har</span> <span begin="1:23.728" end="1:25.536">umblând,</span></p><p begin="1:25.536" end="1:31.705" ttm:agent="v1"><span begin="1:25.536" end="1:26.698">După</span> <span begin="1:26.698" end="1:27.861">Tine,</span> <span begin="1:27.861" end="1:31.705">Doamne!</span></p><p begin="1:31.705" end="1:36.332" ttm:agent="v1"><span begin="1:31.705" end="1:32.573">Cu</span> <span begin="1:32.573" end="1:32.862">tot</span> <span begin="1:32.862" end="1:34.019">cerul</span> <span begin="1:34.019" end="1:34.597">Te</span> <span begin="1:34.597" end="1:36.332">slăvim,</span></p><p begin="1:36.332" end="1:40.958" ttm:agent="v1"><span begin="1:36.332" end="1:37.488">Tată,</span> <span begin="1:37.488" end="1:38.067">Fiu</span> <span begin="1:38.067" end="1:38.645">și</span> <span begin="1:38.645" end="1:39.223">Duh</span> <span begin="1:39.223" end="1:40.958">divin,</span></p><p begin="1:40.958" end="1:45.584" ttm:agent="v1"><span begin="1:40.958" end="1:43.271">Într-același</span> <span begin="1:43.271" end="1:43.785">gând,</span> <span begin="1:43.785" end="1:45.584">Amin,</span></p><p begin="1:45.584" end="1:49.054" ttm:agent="v1"><span begin="1:45.584" end="1:46.452">Doar</span> <span begin="1:46.452" end="1:46.741">pe</span> <span begin="1:46.741" end="1:47.898">Tine,</span> <span begin="1:47.898" end="1:49.054">Doamne!</span></p></div></body></tt>