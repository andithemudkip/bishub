<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>468. Spre-acele țărmuri</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:56.849"><div><p begin="0:18.240" end="0:24.742" ttm:agent="v1"><span begin="0:18.240" end="0:19.324">Spre-acele</span> <span begin="0:19.324" end="0:21.491">țărmuri</span> <span begin="0:21.491" end="0:21.852">din</span> <span begin="0:21.852" end="0:24.742">veșnicii,</span></p><p begin="0:24.742" end="0:31.243" ttm:agent="v1"><span begin="0:24.742" end="0:25.464">Domnul</span> <span begin="0:25.464" end="0:25.825">îi</span> <span begin="0:25.825" end="0:27.992">cheamă</span> <span begin="0:27.992" end="0:28.354">și</span> <span begin="0:28.354" end="0:28.715">pe</span> <span begin="0:28.715" end="0:31.243">copii!</span></p><p begin="0:31.243" end="0:37.745" ttm:agent="v1"><span begin="0:31.243" end="0:31.966">Îngeri</span> <span begin="0:31.966" end="0:32.327">cu</span> <span begin="0:32.327" end="0:34.494">harpe</span> <span begin="0:34.494" end="0:35.216">cântă</span> <span begin="0:35.216" end="0:35.578">cu</span> <span begin="0:35.578" end="0:37.745">dor,</span></p><p begin="0:37.745" end="0:50.581" ttm:agent="v1"><span begin="0:37.745" end="0:38.467">Ia-auzi</span> <span begin="0:38.467" end="0:38.828">cum</span> <span begin="0:38.828" end="0:40.996">sună</span> <span begin="0:40.996" end="0:42.079">cântecul</span> <span begin="0:42.079" end="0:50.581">lor:</span></p><p begin="0:50.581" end="0:57.115" ttm:agent="v1"><span begin="0:50.581" end="0:51.670">Spre-acele</span> <span begin="0:51.670" end="0:53.848">țărmuri</span> <span begin="0:53.848" end="0:54.211">din</span> <span begin="0:54.211" end="0:57.115">veșnicii,</span></p><p begin="0:57.115" end="1:03.649" ttm:agent="v1"><span begin="0:57.115" end="1:00.382">Părinții-ndeamnă</span> <span begin="1:00.382" end="1:00.745">pe-ai</span> <span begin="1:00.745" end="1:01.108">lor</span> <span begin="1:01.108" end="1:03.649">copii:</span></p><p begin="1:03.649" end="1:10.183" ttm:agent="v1"><span begin="1:03.649" end="1:04.375">Vino</span> <span begin="1:04.375" end="1:06.916">acasă,</span> <span begin="1:06.916" end="1:07.642">copil</span> <span begin="1:07.642" end="1:10.183">pierdut,</span></p><p begin="1:10.183" end="1:24.253" ttm:agent="v1"><span begin="1:10.183" end="1:10.546">Nu</span> <span begin="1:10.546" end="1:10.909">te</span> <span begin="1:10.909" end="1:13.450">iubește</span> <span begin="1:13.450" end="1:14.176">nimeni</span> <span begin="1:14.176" end="1:14.539">mai</span> <span begin="1:14.539" end="1:24.253">mult!</span></p><p begin="1:24.253" end="1:30.657" ttm:agent="v1"><span begin="1:24.253" end="1:25.321">Patria</span> <span begin="1:25.321" end="1:26.388">mea,</span> <span begin="1:26.388" end="1:27.455">ce</span> <span begin="1:27.455" end="1:27.811">mult</span> <span begin="1:27.811" end="1:28.167">te</span> <span begin="1:28.167" end="1:30.657">doresc!</span></p><p begin="1:30.657" end="1:37.060" ttm:agent="v1"><span begin="1:30.657" end="1:31.012">Știu</span> <span begin="1:31.012" end="1:31.368">că</span> <span begin="1:31.368" end="1:33.858">acolo</span> <span begin="1:33.858" end="1:34.214">toți</span> <span begin="1:34.214" end="1:34.570">mă</span> <span begin="1:34.570" end="1:37.060">iubesc!</span></p><p begin="1:37.060" end="1:43.464" ttm:agent="v1"><span begin="1:37.060" end="1:37.772">Este</span> <span begin="1:37.772" end="1:39.195">deja</span> <span begin="1:39.195" end="1:40.262">un</span> <span begin="1:40.262" end="1:40.618">loc</span> <span begin="1:40.618" end="1:43.464">pregătit,</span></p><p begin="1:43.464" end="1:48.444" ttm:agent="v1"><span begin="1:43.464" end="1:44.175">Vino</span> <span begin="1:44.175" end="1:44.531">și</span> <span begin="1:44.531" end="1:45.598">tu</span> <span begin="1:45.598" end="1:46.665">să</span> <span begin="1:46.665" end="1:47.021">fii</span> <span begin="1:47.021" end="1:48.444">fericit!</span></p></div></body></tt>