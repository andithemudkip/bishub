<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>639. Deschide-mi ochii!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="3:10.981"><div><p begin="0:22.960" end="0:32.844" ttm:agent="v1"><span begin="0:22.960" end="0:23.819">Deschide-mi</span> <span begin="0:23.819" end="0:27.257">ochii,</span> <span begin="0:27.257" end="0:27.687">să-Ți</span> <span begin="0:27.687" end="0:28.117">văd</span> <span begin="0:28.117" end="0:28.976">fața</span> <span begin="0:28.976" end="0:32.844">sfântă,</span></p><p begin="0:32.844" end="0:43.157" ttm:agent="v1"><span begin="0:32.844" end="0:33.703">Doamne,</span> <span begin="0:33.703" end="0:37.571">deschide</span> <span begin="0:37.571" end="0:38.000">și</span> <span begin="0:38.000" end="0:39.290">inima</span> <span begin="0:39.290" end="0:43.157">mea!</span></p><p begin="0:43.157" end="0:53.901" ttm:agent="v1"><span begin="0:43.157" end="0:44.017">Astăzi</span> <span begin="0:44.017" end="0:44.446">Te</span> <span begin="0:44.446" end="0:47.884">caut</span> <span begin="0:47.884" end="0:48.314">cu</span> <span begin="0:48.314" end="0:49.603">inima</span> <span begin="0:49.603" end="0:53.901">frântă,</span></p><p begin="0:53.901" end="1:04.572" ttm:agent="v1"><span begin="0:53.901" end="0:54.330">Pleacă-mi</span> <span begin="0:54.330" end="0:58.198">urechea</span> <span begin="0:58.198" end="0:59.057">s-aud</span> <span begin="0:59.057" end="0:59.917">vocea</span> <span begin="0:59.917" end="1:04.572">Ta!</span></p><p begin="1:04.572" end="1:14.406" ttm:agent="v1"><span begin="1:04.572" end="1:05.427">Deschide-mi</span> <span begin="1:05.427" end="1:08.848">gura</span> <span begin="1:08.848" end="1:09.275">să</span> <span begin="1:09.275" end="1:09.7