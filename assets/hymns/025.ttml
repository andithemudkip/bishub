<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>25. Voi, credincioși, veniți!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:12.441"><div><p begin="0:13.660" end="0:22.986" ttm:agent="v1"><span begin="0:13.660" end="0:17.157">Creștini,</span> <span begin="0:17.157" end="0:18.323">vă</span> <span begin="0:18.323" end="0:22.986">ridicați!</span></p><p begin="0:22.986" end="0:32.313" ttm:agent="v1"><span begin="0:22.986" end="0:27.650">Aleluia,</span> <span begin="0:27.650" end="0:32.313">amin!</span></p><p begin="0:32.313" end="0:41.639" ttm:agent="v1"><span begin="0:32.313" end="0:34.644">Spre</span> <span begin="0:34.644" end="0:36.976">slava</span> <span begin="0:36.976" end="0:38.142">Lui</span> <span begin="0:38.142" end="0:41.639">cântați!</span></p><p begin="0:41.639" end="0:50.966" ttm:agent="v1"><span begin="0:41.639" end="0:46.302">Aleluia,</span> <span begin="0:46.302" end="0:50.966">amin!</span></p><p begin="0:50.966" end="1:00.292" ttm:agent="v1"><span begin="0:50.966" end="0:54.463">Isus</span> <span begin="0:54.463" end="0:55.629">e</span> <span begin="0:55.629" end="1:00.292">Salvator,</span></p><p begin="1:00.292" end="1:09.618" ttm:agent="v1"><span begin="1:00.292" end="1:02.624">Domn</span> <span begin="1:02.624" end="1:03.789">al</span> <span begin="1:03.789" end="1:09.618">oștirilor</span></p><p begin="1:09.618" end="1:18.945" ttm:agent="v1"><span begin="1:09.618" end="1:11.950">Și</span> <span begin="1:11.950" end="1:14.282">Frate</span> <span begin="1:14.282" end="1:18.945">iubitor!</span></p><p begin="1:18.945" end="1:25.940" ttm:agent="v1"><span begin="1:18.945" end="1:23.608">Aleluia,</span> <span begin="1:23.608" end="1:25.940">amin!</span></p></div></body></