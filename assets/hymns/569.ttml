<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>569. Cine-mi este frate?</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:56.219"><div><p begin="0:10.960" end="0:20.715" ttm:agent="v1"><span begin="0:10.960" end="0:12.180">Cine-mi</span> <span begin="0:12.180" end="0:13.399">este</span> <span begin="0:13.399" end="0:15.838">frate</span> <span begin="0:15.838" end="0:17.057">Cine-i</span> <span begin="0:17.057" end="0:18.277">sora</span> <span begin="0:18.277" end="0:20.715">mea?</span></p><p begin="0:20.715" end="0:31.251" ttm:agent="v1"><span begin="0:20.715" end="0:21.630">Cel</span> <span begin="0:21.630" end="0:21.935">ce</span> <span begin="0:21.935" end="0:22.545">se</span> <span begin="0:22.545" end="0:25.593">decide</span> <span begin="0:25.593" end="0:26.813">Legea</span> <span begin="0:26.813" end="0:27.422">a</span> <span begin="0:27.422" end="0:31.251">păstra!</span></p><p begin="0:31.251" end="0:41.201" ttm:agent="v1"><span begin="0:31.251" end="0:32.184">Cei</span> <span begin="0:32.184" end="0:33.116">săraci</span> <span begin="0:33.116" end="0:33.738">cu</span> <span begin="0:33.738" end="0:36.226">duhul,</span> <span begin="0:36.226" end="0:37.159">cei</span> <span begin="0:37.159" end="0:41.201">nemângâiați,</span></p><p begin="0:41.201" end="0:51.892" ttm:agent="v1"><span begin="0:41.201" end="0:42.134">Toți</span> <span begin="0:42.134" end="0:42.445">cei</span> <span begin="0:42.445" end="0:43.067">blânzi</span> <span begin="0:43.067" end="0:43.689">ca</span> <span begin="0:43.689" end="0:46.176">mieii,</span> <span begin="0:46.176" end="0:47.109">sfinți</span> <span begin="0:47.109" end="0:47.420">și</span> <span begin="0:47.420" end="0:51.892">nepătați.</span></p><p begin="0:51.892" end="1:01.892" ttm:agent="v1"><span begin="0:51.892" end="0:54.392">Turma-aceea</span> <span begin="0:54.392" end="0:56.892">mică,</span> <span begin="0:56.892" end="0:58.142">și-orice</span> <span begin="0:58.142" end="1:01.892">muritor</span></p><p begin="1:01.892" end="1:12.672" ttm:agent="v1"><span begin="1:01.892" end="1:04.392">Care-ascultă</span> <span begin="1:04.392" end="1:06.892">glasul</span> <span begin="1:06.892" end="1:08.767">blândului</span> <span begin="1:08.767" end="1:12.672">Păstor.</span></p><p begin="1:12.672" end="1:22.672" ttm:agent="v1"><span begin="1:12.672" end="1:13.610">Toți</span> <span begin="1:13.610" end="1:17.672">dreptcredincioșii</span> <span begin="1:17.672" end="1:18.610">slabi</span> <span begin="1:18.610" end="1:18.922">și</span> <span begin="1:18.922" end="1:22.672">prigoniți</span></p><p begin="1:22.672" end="1:33.472" ttm:agent="v1"><span begin="1:22.672" end="1:23.922">Care</span> <span begin="1:23.922" end="1:24.547">chiar</span> <span begin="1:24.547" end="1:25.172">de</span> <span begin="1:25.172" end="1:27.672">Domnul</span> <span begin="1:27.672" end="1:28.922">fi-vor</span> <span begin="1:28.922" end="1:33.472">răsplătiți.</span></p><p begin="1:33.472" end="1:43.573" ttm:agent="v1"><span begin="1:33.472" end="1:34.735">Asta</span> <span begin="1:34.735" end="1:35.366">mi-e</span> <span begin="1:35.366" end="1:38.522">frăția,</span> <span begin="1:38.522" end="1:39.469">cu</span> <span begin="1:39.469" end="1:39.785">ei</span> <span begin="1:39.785" end="1:43.573">mă-nrudesc,</span></p><p begin="1:43.573" end="1:51.779" ttm:agent="v1"><span begin="1:43.573" end="1:44.519">Noi</span> <span begin="1:44.519" end="1:45.466">suntem</span> <span begin="1:45.466" end="1:48.623">poporul</span> <span begin="1:48.623" end="1:50.516">Tatălui</span> <span begin="1:50.516" end="1:51.779">ceresc!</span></p></div></body></tt>