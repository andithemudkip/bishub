<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>549. Ne așteaptă-un cămin strălucit</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="3:31.984"><div><p begin="1:02.820" end="1:08.920" ttm:agent="v1"><span begin="1:02.820" end="1:03.392">Ne</span> <span begin="1:03.392" end="1:04.726">așteaptă-un</span> <span begin="1:04.726" end="1:05.870">cămin</span> <span begin="1:05.870" end="1:08.920">strălucit,</span></p><p begin="1:08.920" end="1:15.021" ttm:agent="v1"><span begin="1:08.920" end="1:09.492">În</span> <span begin="1:09.492" end="1:10.827">credință</span> <span begin="1:10.827" end="1:11.970">și-acum</span> <span begin="1:11.970" end="1:12.542">Îl</span> <span begin="1:12.542" end="1:15.021">vedeți;</span></p><p begin="1:15.021" end="1:21.121" ttm:agent="v1"><span begin="1:15.021" end="1:15.592">Un</span> <span begin="1:15.592" end="1:16.546">cămin</span> <span begin="1:16.546" end="1:16.927">de</span> <span begin="1:16.927" end="1:18.071">Isus</span> <span begin="1:18.071" end="1:21.121">pregătit,</span></p><p begin="1:21.121" end="1:30.167" ttm:agent="v1"><span begin="1:21.121" end="1:22.646">Luminos,</span> <span begin="1:22.646" end="1:24.171">fericit</span> <span begin="1:24.171" end="1:24.552">și</span> <span begin="1:24.552" end="1:30.167">măreț!</span></p><p begin="1:30.167" end="1:36.251" ttm:agent="v1"><span begin="1:30.167" end="1:30.737">Sus</span> <span begin="1:30.737" end="1:32.068">cântarea</span> <span begin="1:32.068" end="1:33.779">răsună</span> <span begin="1:33.779" end="1:36.251">frumos</span></p><p begin="1:36.251" end="1:42.336" ttm:agent="v1"><span begin="1:36.251" end="1:36.822">Pe</span> <span begin="1:36.822" end="1:37.772">Hristos</span> <span begin="1:37.772" end="1:39.293">preamărind</span> <span begin="1:39.293" end="1:42.336">ne-ncetat!</span></p><p begin="1:42.336" end="1:48.420" ttm:agent="v1"><span begin="1:42.336" end="1:44.237">Fericiții</span> <span begin="1:44.237" end="1:45.948">tresaltă</span> <span begin="1:45.948" end="1:48.420">voios,</span></p><p begin="1:48.420" end="1:58.336" ttm:agent="v1"><span begin="1:48.420" end="1:48.990">Căci</span> <span begin="1:48.990" end="1:50.321">păcatul</span> <span begin="1:50.321" end="1:50.702">s-a</span> <span begin="1:50.702" end="1:51.462">dus,</span> <span begin="1:51.462" end="1:51.842">e</span> <span begin="1:51.842" end="1:58.336">uitat!</span></p><p begin="1:58.336" end="2:04.315" ttm:agent="v1"><span begin="1:58.336" end="1:58.897">Pe</span> <span begin="1:58.897" end="2:00.205">pământul</span> <span begin="2:00.205" end="2:00.578">cel</span> <span begin="2:00.578" end="2:01.325">nou,</span> <span begin="2:01.325" end="2:04.315">proslăvit,</span></p><p begin="2:04.315" end="2:10.293" ttm:agent="v1"><span begin="2:04.315" end="2:05.062">Într-un</span> <span begin="2:05.062" end="2:06.183">spirit</span> <span begin="2:06.183" end="2:06.556">și-un</span> <span begin="2:06.556" end="2:07.304">gând</span> <span begin="2:07.304" end="2:07.864">toți</span> <span begin="2:07.864" end="2:10.293">servim,</span></p><p begin="2:10.293" end="2:16.271" ttm:agent="v1"><span begin="2:10.293" end="2:10.853">Lui</span> <span begin="2:10.853" end="2:11.787">Isus</span> <span begin="2:11.787" end="2:13.282">care-atât</span> <span begin="2:13.282" end="2:13.842">ne-a</span> <span begin="2:13.842" end="2:16.271">iubit,</span></p><p begin="2:16.271" end="2:22.246" ttm:agent="v1"><span begin="2:16.271" end="2:17.766">Pătimind</span> <span begin="2:17.766" end="2:18.139">ca</span> <span begin="2:18.139" end="2:18.513">să</span> <span begin="2:18.513" end="2:19.260">ne</span> <span begin="2:19.260" end="2:22.246">mântuim!</span></p><p begin="2:22.246" end="2:28.285" ttm:agent="v1"><span begin="2:22.246" end="2:22.812">În</span> <span begin="2:22.812" end="2:24.133">căminul</span> <span begin="2:24.133" end="2:25.266">măreț,</span> <span begin="2:25.266" end="2:28.285">uimitor</span></p><p begin="2:28.285" end="2:34.324" ttm:agent="v1"><span begin="2:28.285" end="2:29.795">Odihnesc</span> <span begin="2:29.795" end="2:31.871">fericiții</span> <span begin="2:31.871" end="2:34.324">tihniți...</span></p><p begin="2:34.324" end="2:40.363" ttm:agent="v1"><span begin="2:34.324" end="2:34.890">A</span> <span begin="2:34.890" end="2:35.834">venit</span> <span begin="2:35.834" end="2:36.589">iată</span> <span begin="2:36.589" end="2:37.344">și</span> <span begin="2:37.344" end="2:38.098">rândul</span> <span begin="2:38.098" end="2:40.363">lor,</span></p><p begin="2:40.363" end="2:44.892" ttm:agent="v1"><span begin="2:40.363" end="2:40.929">Căci</span> <span begin="2:40.929" end="2:41.873">destul</span> <span begin="2:41.873" end="2:42.250">cât</span> <span begin="2:42.250" end="2:42.628">au</span> <span begin="2:42.628" end="2:43.382">fost</span> <span begin="2:43.382" end="2:44.892">prigoniți!</span></p></div></body></tt>