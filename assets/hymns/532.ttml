<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>532. Neguri destrămate</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="3:07.115"><div><p begin="0:34.089" end="0:39.290" ttm:agent="v1"><span begin="0:34.089" end="0:34.739">Neguri</span> <span begin="0:34.739" end="0:36.689">destrămate</span> <span begin="0:36.689" end="0:37.701">zorilor</span> <span begin="0:37.701" end="0:39.290">se-nclină,</span></p><p begin="0:39.290" end="0:44.491" ttm:agent="v1"><span begin="0:39.290" end="0:39.777">Ceas</span> <span begin="0:39.777" end="0:40.590">profetic</span> <span begin="0:40.590" end="0:41.890">bate,</span> <span begin="0:41.890" end="0:42.612">Domnul</span> <span begin="0:42.612" end="0:42.901">stă</span> <span begin="0:42.901" end="0:43.190">să</span> <span begin="0:43.190" end="0:44.491">vină;</span></p><p begin="0:44.491" end="0:49.691" ttm:agent="v1"><span begin="0:44.491" end="0:45.068">Trei</span> <span begin="0:45.068" end="0:45.357">solii</span> <span begin="0:45.357" end="0:45.502">azi</span> <span begin="0:45.502" end="0:47.091">trâmbițează</span> <span begin="0:47.091" end="0:47.813">pe</span> <span begin="0:47.813" end="0:48.102">pământ</span> <span begin="0:48.102" end="0:48.391">și</span> <span begin="0:48.391" end="0:49.691">mare:</span></p><p begin="0:49.691" end="0:49.643" ttm:agent="v1"><span begin="0:49.691" end="0:50.269">Dați</span> <span begin="0:50.269" end="0:50.703">mărire</span> <span begin="0:50.703" end="0:50.992">Celui</span> <span begin="0:50.992" end="0:52.292">veșnic,</span> <span begin="0:52.292" end="0:53.014">slavă</span> <span begin="0:53.014" end="0:49.643">și-nchinare!</span></p><p begin="0:49.643" end="0:54.821" ttm:agent="v1"><span begin="0:49.643" end="0:50.290">Duceți</span> <span begin="0:50.290" end="0:50.937">marea</span> <span begin="0:50.937" end="0:52.232">veste,</span> <span begin="0:52.232" end="0:53.239">holdele</span> <span begin="0:53.239" end="0:53.527">sunt</span> <span begin="0:53.527" end="0:54.821">gata,</span></p><p begin="0:54.821" end="0:59.999" ttm:agent="v1"><span begin="0:54.821" end="0:55.307">Mult</span> <span begin="0:55.307" end="0:55.468">timp</span> <span begin="0:55.468" end="0:55.792">nu</span> <span begin="0:55.792" end="0:56.116">mai</span> <span begin="0:56.116" end="0:57.410">este,</span> <span begin="0:57.410" end="0:58.129">vine</span> <span begin="0:58.129" end="0:59.999">judecata!</span></p><p begin="0:59.999" end="1:05.178" ttm:agent="v1"><span begin="0:59.999" end="1:00.575">Dați</span> <span begin="1:00.575" end="1:00.862">de</span> <span begin="1:00.862" end="1:01.006">știre-n</span> <span begin="1:01.006" end="1:01.294">larga</span> <span begin="1:01.294" end="1:02.588">zare,</span> <span begin="1:02.588" end="1:03.164">toți</span> <span begin="1:03.164" end="1:03.308">să</span> <span begin="1:03.308" end="1:03.595">ia</span> <span begin="1:03.595" end="1:05.178">aminte:</span></p><p begin="1:05.178" end="1:07.082" ttm:agent="v1"><span begin="1:05.178" end="1:05.753">Să-I</span> <span begin="1:05.753" end="1:06.184">aduceți</span> <span begin="1:06.184" end="1:07.767">închinare</span> <span begin="1:07.767" end="1:08.774">bunului</span> <span begin="1:08.774" end="1:07.082">Părinte.</span></p><p begin="1:07.082" end="1:12.257" ttm:agent="v1"><span begin="1:07.082" end="1:07.729">Cade</span> <span begin="1:07.729" end="1:09.670">Babilonul,</span> <span begin="1:09.670" end="1:10.389">demoni</span> <span begin="1:10.389" end="1:10.676">ies</span> <span begin="1:10.676" end="1:10.964">din</span> <span begin="1:10.964" end="1:12.257">fire,</span></p><p begin="1:12.257" end="1:17.432" ttm:agent="v1"><span begin="1:12.257" end="1:12.743">Tot</span> <span begin="1:12.743" end