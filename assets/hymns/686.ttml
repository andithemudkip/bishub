<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>686. Doamne, noaptea s-a lăsat</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:30.126"><div><p begin="0:10.012" end="0:17.767" ttm:agent="v1"><span begin="0:10.012" end="0:11.950">Doamne,</span> <span begin="0:11.950" end="0:13.889">noaptea</span> <span begin="0:13.889" end="0:14.858">s-a</span> <span begin="0:14.858" end="0:17.767">lăsat,</span></p><p begin="0:17.767" end="0:25.522" ttm:agent="v1"><span begin="0:17.767" end="0:18.736">Eu</span> <span begin="0:18.736" end="0:19.705">mă</span> <span begin="0:19.705" end="0:20.675">simt</span> <span begin="0:20.675" end="0:25.522">împovărat...</span></p><p begin="0:25.522" end="0:33.277" ttm:agent="v1"><span begin="0:25.522" end="0:26.491">Tu</span> <span begin="0:26.491" end="0:27.460">ești</span> <span begin="0:27.460" end="0:29.399">astru</span> <span begin="0:29.399" end="0:33.277">preacurat,</span></p><p begin="0:33.277" end="0:42.397" ttm:agent="v1"><span begin="0:33.277" end="0:34.246">Fii</span> <span begin="0:34.246" end="0:35.215">cu</span> <span begin="0:35.215" end="0:37.154">mine</span> <span begin="0:37.154" end="0:42.397">ne-ncetat!</span></p><p begin="0:42.397" end="0:50.038" ttm:agent="v1"><span begin="0:42.397" end="0:44.307">Munca</span> <span begin="0:44.307" end="0:46.217">zilei</span> <span begin="0:46.217" end="0:47.172">s-a</span> <span begin="0:47.172" end="0:50.038">sfârșit,</span></p><p begin="0:50.038" end="0:57.678" ttm:agent="v1"><span begin="0:50.038" end="0:50.993">Fii,</span> <span begin="0:50.993" end="0:53.858">Isuse,</span> <span begin="0:53.858" end="0:57.678">preamărit!</span></p><p begin="0:57.678" end="1:05.319" ttm:agent="v1"><span begin="0:57.678" end="0:58.633">Știu</span> <span begin="0:58.633" end="0:59.588">că</span> <span begin="0:59.588" end="1:00.543">Tu</span> <span begin="1:00.543" end="1:01.498">mi-ai</span> <span begin="1:01.498" end="1:05.319">dăruit</span></p><p begin="1:05.319" end="1:14.248" ttm:agent="v1"><span begin="1:05.319" end="1:07.229">Noaptea</span> <span begin="1:07.229" end="1:09.139">pentru</span> <span begin="1:09.139" end="1:14.248">odihnit.</span></p><p begin="1:14.248" end="1:21.812" ttm:agent="v1"><span begin="1:14.248" end="1:16.139">Iată,</span> <span begin="1:16.139" end="1:18.976">stele-acum</span> <span begin="1:18.976" end="1:21.812">zăresc,</span></p><p begin="1:21.812" end="1:29.376" ttm:agent="v1"><span begin="1:21.812" end="1:22.757">O,</span> <span begin="1:22.757" end="1:23.703">cât</span> <span begin="1:23.703" end="1:24.648">de</span> <span begin="1:24.648" end="1:26.539">frumos</span> <span begin="1:26.539" end="1:29.376">lucesc,</span></p><p begin="1:29.376" end="1:36.940" ttm:agent="v1"><span begin="1:29.376" end="1:32.212">Parcă-aud</span> <span begin="1:32.212" end="1:33.158">cum</span> <span begin="1:33.158" end="1:36.940">povestesc:</span></p><p begin="1:36.940" end="1:43.903" ttm:agent="v1"><span begin="1:36.940" end="1:37.885">„Cât</span> <span begin="1:37.885" end="1:38.831">de</span> <span begin="1:38.831" end="1:39.776">mult</span> <span begin="1:39.776" end="1:40.722">Eu</span> <span begin="1:40.722" end="1:41.667">te</span> <span begin="1:41.667" end="1:43.903">iubesc!”</span></p><p begin="1:43.903" end="1:51.505" ttm:agent="v1"><span begin="1:43.903" end="1:48.179">Amândouă</span> <span begin="1:48.179" end="1:48.654">mâini</span> <span begin="1:48.654" end="1:51.505">le-adun</span></p><p begin="1:51.505" end="1:59.108" ttm:agent="v1"><span begin="1:51.505" end="1:55.306">Rugăciunea</span> <span begin="1:55.306" end="1:56.257">să</span> <span begin="1:56.257" end="1:57.207">mi-o</span> <span begin="1:57.207" end="1:59.108">spun:</span></p><p begin="1:59.108" end="2:06.710" ttm:agent="v1"><span begin="1:59.108" end="2:03.859">Odihnește-mă</span> <span begin="2:03.859" end="2:06.710">acum</span></p><p begin="2:06.710" end="2:12.411" ttm:agent="v1"><span begin="2:06.710" end="2:11.461">Dumnezeule</span> <span begin="2:11.461" end="2:12.411">Preabun!</span></p></div></body></tt>