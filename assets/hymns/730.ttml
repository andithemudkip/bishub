<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>730. Inima e plină</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:28.323"><div><p begin="0:23.880" end="0:34.810" ttm:agent="v1"><span begin="0:23.880" end="0:25.930">Inima</span> <span begin="0:25.930" end="0:26.613">e</span> <span begin="0:26.613" end="0:29.345">plină,</span> <span begin="0:29.345" end="0:30.711">plină</span> <span begin="0:30.711" end="0:31.394">de</span> <span begin="0:31.394" end="0:34.810">avânt,</span></p><p begin="0:34.810" end="0:45.740" ttm:agent="v1"><span begin="0:34.810" end="0:35.835">Căci</span> <span begin="0:35.835" end="0:36.176">ne</span> <span begin="0:36.176" end="0:37.542">cheamă</span> <span begin="0:37.542" end="0:40.275">munții</span> <span begin="0:40.275" end="0:41.299">să</span> <span begin="0:41.299" end="0:42.324">pornim,</span> <span begin="0:42.324" end="0:45.740">cântând;</span></p><p begin="0:45.740" end="0:56.669" ttm:agent="v1"><span begin="0:45.740" end="0:47.106">Către</span> <span begin="0:47.106" end="0:47.789">zări</span> <span begin="0:47.789" end="0:51.204">senine</span> <span begin="0:51.204" end="0:52.571">vulturi</span> <span begin="0:52.571" end="0:53.937">suie-n</span> <span begin="0:53.937" end="0:56.669">zbor,</span></p><p begin="0:56.669" end="1:18.828" ttm:agent="v1"><span begin="0:56.669" end="0:57.694">Hai</span> <span begin="0:57.694" end="0:58.035">și</span> <span begin="0:58.035" end="0:58.718">noi</span> <span begin="0:58.718" end="0:59.402">pe</span> <span begin="0:59.402" end="1:02.134">urma</span> <span begin="1:02.134" end="1:18.828">lor!</span></p><p begin="1:18.828" end="1:29.977" ttm:agent="v1"><span begin="1:18.828" end="1:20.222">Șoapte</span> <span begin="1:20.222" end="1:20.919">de</span> <span begin="1:20.919" end="1:24.402">iubire</span> <span begin="1:24.402" end="1:25.448">se</span> <span begin="1:25.448" end="1:26.493">aud</span> <span begin="1:26.493" end="1:27.190">în</span> <span begin="1:27.190" end="1:29.977">flori</span></p><p begin="1:29.977" end="1:41.125" ttm:agent="v1"><span begin="1:29.977" end="1:31.022">Ca</span> <span begin="1:31.022" end="1:31.370">să</span> <span begin="1:31.370" end="1:35.551">ne-nsoțească</span> <span begin="1:35.551" end="1:36.944">pașii</span> <span begin="1:36.944" end="1:41.125">călători,</span></p><p begin="1:41.125" end="1:53.318" ttm:agent="v1"><span begin="1:41.125" end="1:42.170">Prin</span> <span begin="1:42.170" end="1:43.215">păduri</span> <span begin="1:43.215" end="1:46.699">înalte,</span> <span begin="1:46.699" end="1:48.092">iată,</span> <span begin="1:48.092" end="1:48.789">s-au</span> <span begin="1:48.789" end="1:53.318">deschis</span></p><p begin="1:53.318" end="1:57.847" ttm:agent="v1"><span begin="1:53.318" end="1:53.666">Drumuri</span> <span begin="1:53.666" end="1:55.060">către</span> <span begin="1:55.060" end="1:57.847">Paradis!...</span></p></div></body></tt>