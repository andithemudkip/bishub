<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>769. Sfinte Părinte, Părinte-al iubirii</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:37.593"><div><p begin="0:17.159" end="0:26.593" ttm:agent="v1"><span begin="0:17.159" end="0:18.928">Sfinte</span> <span begin="0:18.928" end="0:21.286">Părinte,</span> <span begin="0:21.286" end="0:23.645">Părinte-al</span> <span begin="0:23.645" end="0:26.593">iubirii,</span></p><p begin="0:26.593" end="0:36.028" ttm:agent="v1"><span begin="0:26.593" end="0:27.773">Din</span> <span begin="0:27.773" end="0:30.721">orbitoarea</span> <span begin="0:30.721" end="0:33.080">lumină-a</span> <span begin="0:33.080" end="0:36.028">slăvirii</span></p><p begin="0:36.028" end="0:45.463" ttm:agent="v1"><span begin="0:36.028" end="0:40.745">Privește-asupră-ne</span> <span begin="0:40.745" end="0:42.514">ceasul</span> <span begin="0:42.514" end="0:45.463">unirii!</span></p><p begin="0:45.463" end="0:53.416" ttm:agent="v1"><span begin="0:45.463" end="0:47.821">Părinte,</span> <span begin="0:47.821" end="0:50.180">iată,</span> <span begin="0:50.180" end="0:53.416">vin!</span></p><p begin="0:53.416" end="1:02.756" ttm:agent="v1"><span begin="0:53.416" end="0:54.584">Tu</span> <span begin="0:54.584" end="0:57.503">frământarea,</span> <span begin="0:57.503" end="0:58.086">Te</span> <span begin="0:58.086" end="0:59.254">rog,</span> <span begin="0:59.254" end="1:02.756">liniștește,</span></p><p begin="1:02.756" end="1:12.097" ttm:agent="v1"><span begin="1:02.756" end="1:03.924">Tu</span> <span begin="1:03.924" end="1:06.843">fericirea,</span> <span begin="1:06.843" end="1:07.427">Te</span> <span begin="1:07.427" end="1:09.178">rog,</span> <span begin="1:09.178" end="1:12.097">păzește,</span></p><p begin="1:12.097" end="1:21.437" ttm:agent="v1"><span begin="1:12.097" end="1:13.264">O,</span> <span begin="1:13.264" end="1:13.848">și</span> <span begin="1:13.848" end="1:16.183">iubirea,</span> <span begin="1:16.183" end="1:16.767">Te</span> <span begin="1:16.767" end="1:17.934">rog,</span> <span begin="1:17.934" end="1:21.437">o-nnoiește!</span></p><p begin="1:21.437" end="1:29.610" ttm:agent="v1"><span begin="1:21.437" end="1:23.772">Părinte,</span> <span begin="1:23.772" end="1:26.107">iată,</span> <span begin="1:26.107" end="1:28.442">vin!</span> <span begin="1:28.442" end="1:29.610">Amin.</span></p></div></body></tt>