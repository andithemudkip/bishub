<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>292. Sus, oaste-a lui Hristos</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:19.259"><div><p begin="0:20.320" end="0:24.492" ttm:agent="v1"><span begin="0:20.320" end="0:21.214">Sus,</span> <span begin="0:21.214" end="0:21.512">oaste-a</span> <span begin="0:21.512" end="0:22.108">lui</span> <span begin="0:22.108" end="0:24.492">Hristos,</span></p><p begin="0:24.492" end="0:29.260" ttm:agent="v1"><span begin="0:24.492" end="0:25.684">Grăbiți</span> <span begin="0:25.684" end="0:26.280">și</span> <span begin="0:26.280" end="0:29.260">vă-narmați!</span></p><p begin="0:29.260" end="0:34.028" ttm:agent="v1"><span begin="0:29.260" end="0:29.856">Sub</span> <span begin="0:29.856" end="0:31.048">steagul</span> <span begin="0:31.048" end="0:31.644">Său</span> <span begin="0:31.644" end="0:34.028">victorios</span></p><p begin="0:34.028" end="0:38.796" ttm:agent="v1"><span begin="0:34.028" end="0:34.624">La</span> <span begin="0:34.624" end="0:35.816">luptă</span> <span begin="0:35.816" end="0:38.796">v-avântați!</span></p><p begin="0:38.796" end="0:43.564" ttm:agent="v1"><span begin="0:38.796" end="0:40.584">Vă-ncingeți</span> <span begin="0:40.584" end="0:43.564">ne-ncetat</span></p><p begin="0:43.564" end="0:48.332" ttm:agent="v1"><span begin="0:43.564" end="0:44.160">Cu</span> <span begin="0:44.160" end="0:46.544">adevărul</span> <span begin="0:46.544" end="0:48.332">sfânt,</span></p><p begin="0:48.332" end="0:53.100" ttm:agent="v1"><span begin="0:48.332" end="0:48.928">Și</span> <span begin="0:48.928" end="0:49.822">nu</span> <span begin="0:49.822" end="0:50.120">vă</span> <span begin="0:50.120" end="0:51.312">temeți</span> <span begin="0:51.312" end="0:51.908">de</span> <span begin="0:51.908" end="0:53.100">luptat</span></p><p begin="0:53.100" end="0:59.164" ttm:agent="v1"><span begin="0:53.100" end="0:53.696">Cu</span> <span begin="0:53.696" end="0:54.292">un</span> <span begin="0:54.292" end="0:55.484">vrăjmaș</span> <span begin="0:55.484" end="0:59.164">înfrânt!</span></p><p begin="0:59.164" end="1:03.294" ttm:agent="v1"><span begin="0:59.164" end="0:59.754">Stați</span> <span begin="0:59.754" end="1:00.049">tari</span> <span begin="1:00.049" end="1:00.344">și</span> <span begin="1:00.344" end="1:00.934">vă</span> <span begin="1:00.934" end="1:03.294">rugați,</span></p><p begin="1:03.294" end="1:08.015" ttm:agent="v1"><span begin="1:03.294" end="1:04.474">Isus</span> <span begin="1:04.474" end="1:05.064">vă</span> <span begin="1:05.064" end="1:08.015">v-ajuta!</span></p><p begin="1:08.015" end="1:12.735" ttm:agent="v1"><span begin="1:08.015" end="1:08.605">Ca</span> <span begin="1:08.605" end="1:10.375">pavăză</span> <span begin="1:10.375" end="1:10.965">și</span> <span begin="1:10.965" end="1:11.555">coif</span> <span begin="1:11.555" end="1:12.735">luați</span></p><p begin="1:12.735" end="1:17.455" ttm:agent="v1"><span begin="1:12.735" end="1:15.685">Neprihănirea</span> <span begin="1:15.685" end="1:17.455">Sa!</span></p><p begin="1:17.455" end="1:22.176" ttm:agent="v1"><span begin="1:17.455" end="1:18.045">Cu</span> <span begin="1:18.045" end="1:19.815">dragoste</span> <span begin="1:19.815" end="1:20.405">și</span> <span begin="1:20.405" end="1:22.176">zel</span></p><p begin="1:22.176" end="1:26.896" ttm:agent="v1"><span begin="1:22.176" end="1:26.896">Picioarele-ncălțați</span></p><p begin="1:26.896" end="1:31.616" ttm:agent="v1"><span begin="1:26.896" end="1:27.486">Și</span> <span begin="1:27.486" end="1:28.371">nu</span> <span begin="1:28.371" end="1:28.666">veți</span> <span begin="1:28.666" end="1:30.436">obosi</span> <span begin="1:30.436" end="1:31.616">defel</span></p><p begin="1:31.616" end="1:37.667" ttm:agent="v1"><span begin="1:31.616" end="1:32.206">Când</span> <span begin="1:32.206" end="1:33.386">steagul</span> <span begin="1:33.386" end="1:33.976">Lui</span> <span begin="1:33.976" end="1:37.667">purtați!</span></p><p begin="1:37.667" end="1:41.776" ttm:agent="v1"><span begin="1:37.667" end="1:38.254">Un</span> <span begin="1:38.254" end="1:38.841">singur</span> <span begin="1:38.841" end="1:39.428">scut</span> <span begin="1:39.428" end="1:41.776">aveți:</span></p><p begin="1:41.776" end="1:46.473" ttm:agent="v1"><span begin="1:41.776" end="1:43.537">Credința-n</span> <span begin="1:43.537" end="1:44.712">jertfa</span> <span begin="1:44.712" end="1:46.473">Sa,</span></p><p begin="1:46.473" end="1:51.170" ttm:agent="v1"><span begin="1:46.473" end="1:47.060">Căci</span> <span begin="1:47.060" end="1:49.995">arzătoarele</span> <span begin="1:49.995" end="1:51.170">săgeți</span></p><p begin="1:51.170" end="1:55.866" ttm:agent="v1"><span begin="1:51.170" end="1:51.757">Le</span> <span begin="1:51.757" end="1:52.931">stingeți</span> <span begin="1:52.931" end="1:53.518">doar</span> <span begin="1:53.518" end="1:54.105">cu</span> <span begin="1:54.105" end="1:55.866">ea!</span></p><p begin="1:55.866" end="2:00.563" ttm:agent="v1"><span begin="1:55.866" end="1:56.453">În</span> <span begin="1:56.453" end="1:57.628">luptă</span> <span begin="1:57.628" end="1:58.215">când</span> <span begin="1:58.215" end="1:58.802">e</span> <span begin="1:58.802" end="2:00.563">greu</span></p><p begin="2:00.563" end="2:05.260" ttm:agent="v1"><span begin="2:00.563" end="2:01.150">Nu</span> <span begin="2:01.150" end="2:01.737">stați</span> <span begin="2:01.737" end="2:05.260">descumpăniți,</span></p><p begin="2:05.260" end="2:09.369" ttm:agent="v1"><span begin="2:05.260" end="2:05.847">Cu</span> <span begin="2:05.847" end="2:07.021">sabia</span> <span begin="2:07.021" end="2:07.608">lui</span> <span begin="2:07.608" end="2:09.369">Dumnezeu</span></p><p begin="2:09.369" end="2:12.305" ttm:agent="v1"><span begin="2:09.369" end="2:10.544">Luptați</span> <span begin="2:10.544" end="2:11.131">și</span> <span begin="2:11.131" end="2:12.305">biruiți!</span></p></div></body></tt>