<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>370. Mai mult să Te iubesc</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="3:01.838"><div><p begin="0:01.120" end="0:11.570" ttm:agent="v1"><span begin="0:01.120" end="0:03.732">Mai</span> <span begin="0:03.732" end="0:05.038">mult</span> <span begin="0:05.038" end="0:06.345">să</span> <span begin="0:06.345" end="0:08.304">Te</span> <span begin="0:08.304" end="0:11.570">iubesc,</span></p><p begin="0:11.570" end="0:22.020" ttm:agent="v1"><span begin="0:11.570" end="0:14.183">Vreau,</span> <span begin="0:14.183" end="0:16.795">Domnul</span> <span begin="0:16.795" end="0:22.020">meu!</span></p><p begin="0:22.020" end="0:32.471" ttm:agent="v1"><span begin="0:22.020" end="0:24.633">De-ai</span> <span begin="0:24.633" end="0:25.939">ști</span> <span begin="0:25.939" end="0:27.246">ce</span> <span begin="0:27.246" end="0:29.205">mult</span> <span begin="0:29.205" end="0:32.471">doresc</span></p><p begin="0:32.471" end="0:54.272" ttm:agent="v1"><span begin="0:32.471" end="0:35.083">Să</span> <span begin="0:35.083" end="0:36.390">fiu</span> <span begin="0:36.390" end="0:37.696">al</span> <span begin="0:37.696" end="0:54.272">Tău!</span></p><p begin="0:54.272" end="1:04.618" ttm:agent="v1"><span begin="0:54.272" end="0:59.445">Necazuri</span> <span begin="0:59.445" end="1:01.385">de-ar</span> <span begin="1:01.385" end="1:04.618">veni</span></p><p begin="1:04.618" end="1:14.964" ttm:agent="v1"><span begin="1:04.618" end="1:07.204">În</span> <span begin="1:07.204" end="1:09.791">calea</span> <span begin="1:09.791" end="1:14.964">mea,</span></p><p begin="1:14.964" end="1:25.310" ttm:agent="v1"><span begin="1:14.964" end="1:18.843">Primesc</span> <span begin="1:18.843" end="1:25.310">încrezător</span></p><p begin="1:25.310" end="1:48.061" ttm:agent="v1"><span begin="1:25.310" end="1:27.896">Tot</span> <span begin="1:27.896" end="1:29.189">ce-mi</span> <span begin="1:29.189" end="1:30.483">vei</span> <span begin="1:30.483" end="1:48.061">da...</span></p><p begin="1:48.061" end="1:58.353" ttm:agent="v1"><span begin="1:48.061" end="1:51.921">Și-atunci</span> <span begin="1:51.921" end="1:53.207">când</span> <span begin="1:53.207" end="1:55.137">voi</span> <span begin="1:55.137" end="1:58.353">muri,</span></p><p begin="1:58.353" end="2:08.644" ttm:agent="v1"><span begin="1:58.353" end="2:00.925">Un</span> <span begin="2:00.925" end="2:03.498">ultim</span> <span begin="2:03.498" end="2:08.644">dor</span></p><p begin="2:08.644" end="2:18.935" ttm:agent="v1"><span begin="2:08.644" end="2:11.216">Din</span> <span begin="2:11.216" end="2:13.789">suflet</span> <span begin="2:13.789" end="2:15.719">voi</span> <span begin="2:15.719" end="2:18.935">șopti</span></p><p begin="2:18.935" end="2:21.508" ttm:agent="v1"><span begin="2:18.935" end="2:21.508">Biruitor:</span></p></div></body></tt>