<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>693. Lasă harpa ta să sune</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:51.882"><div><p begin="0:12.500" end="0:18.279" ttm:agent="v1"><span begin="0:12.500" end="0:13.945">Lasă</span> <span begin="0:13.945" end="0:15.390">harpa</span> <span begin="0:15.390" end="0:16.112">ta</span> <span begin="0:16.112" end="0:16.834">să</span> <span begin="0:16.834" end="0:18.279">sune</span></p><p begin="0:18.279" end="0:24.058" ttm:agent="v1"><span begin="0:18.279" end="0:19.002">Chiar</span> <span begin="0:19.002" end="0:19.724">din</span> <span begin="0:19.724" end="0:20.446">zori</span> <span begin="0:20.446" end="0:21.530">cum</span> <span begin="0:21.530" end="0:21.891">te-ai</span> <span begin="0:21.891" end="0:24.058">trezit,</span></p><p begin="0:24.058" end="0:29.838" ttm:agent="v1"><span begin="0:24.058" end="0:25.503">Vesel</span> <span begin="0:25.503" end="0:26.226">vin’</span> <span begin="0:26.226" end="0:26.948">la</span> <span begin="0:26.948" end="0:29.838">rugăciune</span></p><p begin="0:29.838" end="0:37.657" ttm:agent="v1"><span begin="0:29.838" end="0:32.005">Mulțumind</span> <span begin="0:32.005" end="0:32.727">Cui</span> <span begin="0:32.727" end="0:33.450">te-a</span> <span begin="0:33.450" end="0:37.657">păzit...</span></p><p begin="0:37.657" end="0:43.378" ttm:agent="v1"><span begin="0:37.657" end="0:38.372">Da,</span> <span begin="0:38.372" end="0:41.233">înalță-acum</span> <span begin="0:41.233" end="0:43.378">cântare</span></p><p begin="0:43.378" end="0:49.100" ttm:agent="v1"><span begin="0:43.378" end="0:44.093">Pân’</span> <span begin="0:44.093" end="0:44.809">la</span> <span begin="0:44.809" end="0:46.239">tronul</span> <span begin="0:46.239" end="0:46.954">cel</span> <span begin="0:46.954" end="0:47.669">de</span> <span begin="0:47.669" end="0:49.100">har:</span></p><p begin="0:49.100" end="0:54.821" ttm:agent="v1"><span begin="0:49.100" end="0:50.530">Domnu-ți</span> <span begin="0:50.530" end="0:51.245">dă</span> <span begin="0:51.245" end="0:51.960">din</span> <span begin="0:51.960" end="0:54.821">îndurare</span></p><p begin="0:54.821" end="1:01.382" ttm:agent="v1"><span begin="0:54.821" end="0:56.251">Viața,</span> <span begin="0:56.251" end="0:59.112">mântuirea-n</span> <span begin="0:59.112" end="1:01.382">dar!</span></p><p begin="1:01.382" end="1:07.047" ttm:agent="v1"><span begin="1:01.382" end="1:02.090">Ce</span> <span begin="1:02.090" end="1:03.507">plăcut</span> <span begin="1:03.507" end="1:04.215">e</span> <span begin="1:04.215" end="1:07.047">dimineața,</span></p><p begin="1:07.047" end="1:12.711" ttm:agent="v1"><span begin="1:07.047" end="1:07.755">Când</span> <span begin="1:07.755" end="1:08.463">din</span> <span begin="1:08.463" end="1:10.587">inimă</span> <span begin="1:10.587" end="1:12.711">adus,</span></p><p begin="1:12.711" end="1:18.375" ttm:agent="v1"><span begin="1:12.711" end="1:14.127">Cântu-ți</span> <span begin="1:14.127" end="1:16.959">veselește</span> <span begin="1:16.959" end="1:18.375">fața</span></p><p begin="1:18.375" end="1:24.839" ttm:agent="v1"><span begin="1:18.375" end="1:19.083">Și</span> <span begin="1:19.083" end="1:19.791">te</span> <span begin="1:19.791" end="1:21.207">‘nalță</span> <span begin="1:21.207" end="1:21.915">spre</span> <span begin="1:21.915" end="1:24.839">Isus!</span></p><p begin="1:24.839" end="1:30.588" ttm:agent="v1"><span begin="1:24.839" end="1:25.558">O,</span> <span begin="1:25.558" end="1:27.714">Isuse,</span> <span begin="1:27.714" end="1:29.151">fă-mă-n</span> <span begin="1:29.151" end="1:30.588">stare</span></p><p begin="1:30.588" end="1:36.338" ttm:agent="v1"><span begin="1:30.588" end="1:31.307">Ca</span> <span begin="1:31.307" end="1:32.026">de</span> <span begin="1:32.026" end="1:32.744">cum</span> <span begin="1:32.744" end="1:33.463">m-am</span> <span begin="1:33.463" end="1:36.338">deșteptat</span></p><p begin="1:36.338" end="1:42.087" ttm:agent="v1"><span begin="1:36.338" end="1:37.056">Cât</span> <span begin="1:37.056" end="1:37.775">va</span> <span begin="1:37.775" end="1:38.493">fi</span> <span begin="1:38.493" end="1:39.931">ziua</span> <span begin="1:39.931" end="1:40.649">de</span> <span begin="1:40.649" end="1:42.087">mare</span></p><p begin="1:42.087" end="1:45.680" ttm:agent="v1"><span begin="1:42.087" end="1:42.805">Eu</span> <span begin="1:42.805" end="1:43.524">să-Ți</span> <span begin="1:43.524" end="1:44.243">cânt</span> <span begin="1:44.243" end="1:45.680">neîncetat!</span></p></div></body></tt>