<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>272. Vă-ndreptați spre Ghetsemani</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:59.536"><div><p begin="0:13.300" end="0:18.721" ttm:agent="v1"><span begin="0:13.300" end="0:15.333">Vă-ndreptați</span> <span begin="0:15.333" end="0:16.010">spre</span> <span begin="0:16.010" end="0:18.721">Ghetsemani</span></p><p begin="0:18.721" end="0:24.142" ttm:agent="v1"><span begin="0:18.721" end="0:19.398">Când</span> <span begin="0:19.398" end="0:20.754">simțiți</span> <span begin="0:20.754" end="0:22.786">ispita</span> <span begin="0:22.786" end="0:24.142">grea!</span></p><p begin="0:24.142" end="0:29.562" ttm:agent="v1"><span begin="0:24.142" end="0:24.819">Stați</span> <span begin="0:24.819" end="0:25.497">în</span> <span begin="0:25.497" end="0:26.852">luptă</span> <span begin="0:26.852" end="0:27.530">cu</span> <span begin="0:27.530" end="0:29.562">Isus,</span></p><p begin="0:29.562" end="0:34.983" ttm:agent="v1"><span begin="0:29.562" end="0:30.240">Nu</span> <span begin="0:30.240" end="0:31.595">priviți</span> <span begin="0:31.595" end="0:33.289">decât</span> <span begin="0:33.289" end="0:33.628">în</span> <span begin="0:33.628" end="0:34.983">sus,</span></p><p begin="0:34.983" end="0:40.404" ttm:agent="v1"><span begin="0:34.983" end="0:35.661">De</span> <span begin="0:35.661" end="0:36.338">la</span> <span begin="0:36.338" end="0:37.694">Domnul</span> <span begin="0:37.694" end="0:40.404">învățați</span></p><p begin="0:40.404" end="0:48.205" ttm:agent="v1"><span begin="0:40.404" end="0:41.082">Rugi</span> <span begin="0:41.082" end="0:42.437">fierbinți</span> <span begin="0:42.437" end="0:43.114">să</span> <span begin="0:43.114" end="0:48.205">înălțați!</span></p><p begin="0:48.205" end="0:53.517" ttm:agent="v1"><span begin="0:48.205" end="0:49.533">Mergeți</span> <span begin="0:49.533" end="0:50.861">iarăși</span> <span begin="0:50.861" end="0:51.857">să-L</span> <span begin="0:51.857" end="0:53.517">vedeți</span></p><p begin="0:53.517" end="0:58.830" ttm:agent="v1"><span begin="0:53.517" end="0:55.509">Judecat,</span> <span begin="0:55.509" end="0:56.837">lovit,</span> <span begin="0:56.837" end="0:58.830">legat;</span></p><p begin="0:58.830" end="1:04.142" ttm:agent="v1"><span begin="0:58.830" end="0:59.494">Ce</span> <span begin="0:59.494" end="1:01.486">durere-a</span> <span begin="1:01.486" end="1:04.142">suferit</span></p><p begin="1:04.142" end="1:09.454" ttm:agent="v1"><span begin="1:04.142" end="1:05.470">Pentru</span> <span begin="1:05.470" end="1:06.134">voi,</span> <span begin="1:06.134" end="1:06.798">căci</span> <span begin="1:06.798" end="1:07.794">v-a</span> <span begin="1:07.794" end="1:09.454">iubit!</span></p><p begin="1:09.454" end="1:14.767" ttm:agent="v1"><span begin="1:09.454" end="1:10.118">De</span> <span begin="1:10.118" end="1:10.782">la</span> <span begin="1:10.782" end="1:12.111">Domnul</span> <span begin="1:12.111" end="1:14.767">învățați</span></p><p begin="1:14.767" end="1:17.279" ttm:agent="v1"><span begin="1:14.767" end="1:16.095">Crucea</span> <span begin="1:16.095" end="1:16.759">Lui</span> <span begin="1:16.759" end="1:17.423">cum</span> <span begin="1:17.423" end="1:18.087">s-o</span> <span begin="1:18.087" end="1:17.279">purtați!</span></p><p begin="1:17.279" end="1:22.618" ttm:agent="v1"><span begin="1:17.279" end="1:17.946">Vă</span> <span begin="1:17.946" end="1:19.281">suiți</span> <span begin="1:19.281" end="1:19.949">la</span> <span begin="1:19.949" end="1:22.618">Golgota</span></p><p begin="1:22.618" end="1:27.957" ttm:agent="v1"><span begin="1:22.618" end="1:23.285">Să-I</span> <span begin="1:23.285" end="1:25.288">aduceți</span> <span begin="1:25.288" end="1:27.957">mulțumiri;</span></p><p begin="1:27.957" end="1:33.296" ttm:agent="v1"><span begin="1:27.957" end="1:28.624">Când</span> <span begin="1:28.624" end="1:29.292">El</span> <span begin="1:29.292" end="1:30.626">spune</span> <span begin="1:30.626" end="1:31.294">„S-a</span> <span begin="1:31.294" end="1:33.296">sfârșit,”</span></p><p begin="1:33.296" end="1:38.635" ttm:agent="v1"><span begin="1:33.296" end="1:34.631">Planul</span> <span begin="1:34.631" end="1:35.298">Său</span> <span begin="1:35.298" end="1:35.965">e</span> <span begin="1:35.965" end="1:38.635">împlinit;</span></p><p begin="1:38.635" end="1:43.974" ttm:agent="v1"><span begin="1:38.635" end="1:39.302">Cu</span> <span begin="1:39.302" end="1:40.637">Isus,</span> <span begin="1:40.637" end="1:43.974">nedespărțiți,</span></p><p begin="1:43.974" end="1:48.645" ttm:agent="v1"><span begin="1:43.974" end="1:45.976">Învățați</span> <span begin="1:45.976" end="1:46.643">cum</span> <span begin="1:46.643" end="1:47.311">să</span> <span begin="1:47.311" end="1:48.645">trăiți!</span></p></div></body></tt>