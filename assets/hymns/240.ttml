4">către</span> <span begin="0:50.524" end="0:52.593">cer!</span></p><p begin="0:52.593" end="0:58.109" ttm:agent="v1"><span begin="0:52.593" end="0:53.282">Căci</span> <span begin="0:53.282" end="0:55.351">Domnului</span> <span begin="0:55.351" end="0:56.040">Îi</span> <span begin="0:56.040" end="0:58.109">place</span></p><p begin="0:58.109" end="1:03.625" ttm:agent="v1"><span begin="0:58.109" end="0:58.798">Să</span> <span begin="0:58.798" end="1:00.867">vindece</span> <span begin="1:00.867" end="1:03.625">dureri,</span></p><p begin="1:03.625" end="1:10.441" ttm:agent="v1"><span begin="1:03.625" end="1:04.315">Să</span> <span begin="1:04.315" end="1:06.383">vindece</span> <span begin="1:06.383" end="1:10.441">dureri!</span></p><p begin="1:10.441" end="1:15.820" ttm:agent="v1"><span begin="1:10.441" end="1:11.114">Când</span> <span begin="1:11.114" end="1:12.122">simți</span> <span begin="1:12.122" end="1:12.458">că</span> <span begin="1:12.458" end="1:13.803">viața-i</span> <span begin="1:13.803" end="1:15.820">goală,</span></p><p begin="1:15.820" end="1:21.198" ttm:agent="v1"><span begin="1:15.820" end="1:17.837">Privește</span> <span begin="1:17.837" end="1:19.181">către</span> <span begin="1:19.181" end="1:21.198">cer!</span></p><p begin="1:21.198" end="1:26.577" ttm:agent="v1"><span begin="1:21.198" end="1:22.879">Isus</span> <span begin="1:22.879" end="1:23.215">nu</span> <span begin="1:23.215" end="1:23.887">te</span> <span begin="1:23.887" end="1:26.577">înșală,</span></p><p begin="1:26.577" end="1:31.955" ttm:agent="v1"><span begin="1:26.577" end="1:27.249">Când</span> <span begin="1:27.249" end="1:29.266">inima</span> <span begin="1:29.266" end="1:31.955">I-oferi,</span></p><p begin="1:31.955" end="1:38.833" ttm:agent="v1"><span begin="1:31.955" end="1:32.627">Când</span> <span begin="1:32.627" end="1:34.644">inima</span> <span begin="1:34.644" end="1:38.833">I-oferi!</span></p><p begin="1:38.833" end="1:44.292" ttm:agent="v1"><span begin="1:38.833" end="