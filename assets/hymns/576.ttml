<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>576. Dumnezeu e numai dragoste</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:58.230"><div><p begin="0:10.213" end="0:16.400" ttm:agent="v1"><span begin="0:10.213" end="0:11.760">Dumnezeu</span> <span begin="0:11.760" end="0:12.533">e</span> <span begin="0:12.533" end="0:14.080">numai</span> <span begin="0:14.080" end="0:16.400">dragoste,</span></p><p begin="0:16.400" end="0:22.587" ttm:agent="v1"><span begin="0:16.400" end="0:16.787">Un</span> <span begin="0:16.787" end="0:17.947">izvor</span> <span begin="0:17.947" end="0:22.587">îmbelșugat,</span></p><p begin="0:22.587" end="0:28.773" ttm:agent="v1"><span begin="0:22.587" end="0:22.973">Ce-Și</span> <span begin="0:22.973" end="0:24.907">revarsă</span> <span begin="0:24.907" end="0:26.453">viața</span> <span begin="0:26.453" end="0:28.000">fără</span> <span begin="0:28.000" end="0:28.773">preț</span></p><p begin="0:28.773" end="0:36.040" ttm:agent="v1"><span begin="0:28.773" end="0:30.320">Săturând</span> <span begin="0:30.320" end="0:36.040">orice-nsetat.</span></p><p begin="0:36.040" end="0:42.258" ttm:agent="v1"><span begin="0:36.040" end="0:36.429">Să</span> <span begin="0:36.429" end="0:36.817">ne</span> <span begin="0:36.817" end="0:38.372">fie,</span> <span begin="0:38.372" end="0:39.926">Doamne,</span> <span begin="0:39.926" end="0:42.258">dragostea</span></p><p begin="0:42.258" end="0:48.475" ttm:agent="v1"><span begin="0:42.258" end="0:42.646">Un</span> <span begin="0:42.646" end="0:44.589">sigiliu</span> <span begin="0:44.589" end="0:46.144">veșnic</span> <span begin="0:46.144" end="0:48.475">sfânt!</span></p><p begin="0:48.475" end="0:54.693" ttm:agent="v1"><span begin="0:48.475" end="0:48.864">Pe</span> <span begin="0:48.864" end="0:50.030">pământ,</span> <span begin="0:50.030" end="0:50.807">mai</span> <span begin="0:50.807" end="0:52.361">tare</span> <span begin="0:52.361" end="0:53.916">decât</span> <span begin="0:53.916" end="0:54.693">ea,</span></p><p begin="0:54.693" end="1:03.630" ttm:agent="v1"><span begin="0:54.693" end="0:55.081">Nu-i</span> <span begin="0:55.081" end="0:55.470">nici</span> <span begin="0:55.470" end="0:57.024">moarte,</span> <span begin="0:57.024" end="0:57.802">nici</span> <span begin="0:57.802" end="1:03.630">mormânt...</span></p><p begin="1:03.630" end="1:09.848" ttm:agent="v1"><span begin="1:03.630" end="1:04.019">Prin</span> <span begin="1:04.019" end="1:05.962">necazul</span> <span begin="1:05.962" end="1:07.516">lumii,</span> <span begin="1:07.516" end="1:08.294">prin</span> <span begin="1:08.294" end="1:09.848">pustiu,</span></p><p begin="1:09.848" end="1:16.066" ttm:agent="v1"><span begin="1:09.848" end="1:10.625">Doamne,</span> <span begin="1:10.625" end="1:11.402">Tu</span> <span begin="1:11.402" end="1:12.180">să</span> <span begin="1:12.180" end="1:12.957">ne</span> <span begin="1:12.957" end="1:16.066">mângâi,</span></p><p begin="1:16.066" end="1:22.283" ttm:agent="v1"><span begin="1:16.066" end="1:16.454">Să</span> <span begin="1:16.454" end="1:17.620">aprinzi</span> <span begin="1:17.620" end="1:18.397">în</span> <span begin="1:18.397" end="1:19.174">noi,</span> <span begin="1:19.174" end="1:19.952">cât</span> <span begin="1:19.952" end="1:20.729">nu-i</span> <span begin="1:20.729" end="1:22.283">târziu,</span></p><p begin="1:22.283" end="1:31.261" ttm:agent="v1"><span begin="1:22.283" end="1:23.060">Focul</span> <span begin="1:23.060" end="1:25.392">dragostei</span> <span begin="1:25.392" end="1:31.261">dintâi!</span></p><p begin="1:31.261" end="1:37.416" ttm:agent="v1"><span begin="1:31.261" end="1:31.646">O</span> <span begin="1:31.646" end="1:33.569">poruncă</span> <span begin="1:33.569" end="1:35.108">mare</span> <span begin="1:35.108" end="1:35.877">am</span> <span begin="1:35.877" end="1:37.416">primit</span></p><p begin="1:37.416" end="1:43.572" ttm:agent="v1"><span begin="1:37.416" end="1:39.725">Moștenire</span> <span begin="1:39.725" end="1:40.494">de</span> <span begin="1:40.494" end="1:41.263">la</span> <span begin="1:41.263" end="1:43.572">El;</span></p><p begin="1:43.572" end="1:49.727" ttm:agent="v1"><span begin="1:43.572" end="1:43.956">Ca</span> <span begin="1:43.956" end="1:45.111">așa</span> <span begin="1:45.111" end="1:45.880">cum</span> <span begin="1:45.880" end="1:47.419">Domnul</span> <span begin="1:47.419" end="1:48.188">ne-a</span> <span begin="1:48.188" end="1:49.727">iubit,</span></p><p begin="1:49.727" end="1:55.113" ttm:agent="v1"><span begin="1:49.727" end="1:50.112">Să</span> <span begin="1:50.112" end="1:51.266">iubim</span> <span begin="1:51.266" end="1:52.035">și</span> <span begin="1:52.035" end="1:52.805">noi</span> <span begin="1:52.805" end="1:53.574">la</span> <span begin="1:53.574" end="1:55.113">fel!</span></p></div></body></tt>