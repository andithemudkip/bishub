<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>154. Ia și citește Scriptura!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:00.529"><div><p begin="0:26.200" end="0:34.246" ttm:agent="v1"><span begin="0:26.200" end="0:27.206">Ia</span> <span begin="0:27.206" end="0:27.709">și</span> <span begin="0:27.709" end="0:29.720">citește</span> <span begin="0:29.720" end="0:31.732">Scriptura</span> <span begin="0:31.732" end="0:32.235">cea</span> <span begin="0:32.235" end="0:34.246">sfântă,</span></p><p begin="0:34.246" end="0:42.293" ttm:agent="v1"><span begin="0:34.246" end="0:35.252">Vezi</span> <span begin="0:35.252" end="0:35.755">ce</span> <span begin="0:35.755" end="0:36.258">stă</span> <span begin="0:36.258" end="0:37.264">scris</span> <span begin="0:37.264" end="0:37.767">și</span> <span begin="0:37.767" end="0:39.275">așa</span> <span begin="0:39.275" end="0:42.293">să-mplinești!</span></p><p begin="0:42.293" end="0:50.339" ttm:agent="v1"><span begin="0:42.293" end="0:43.299">Plin</span> <span begin="0:43.299" end="0:43.802">de</span> <span begin="0:43.802" end="0:45.813">credință</span> <span begin="0:45.813" end="0:46.316">spre</span> <span begin="0:46.316" end="0:47.322">cer</span> <span begin="0:47.322" end="0:47.825">te</span> <span begin="0:47.825" end="0:50.339">avântă,</span></p><p begin="0:50.339" end="0:57.826" ttm:agent="v1"><span begin="0:50.339" end="0:51.345">Pe</span> <span begin="0:51.345" end="0:53.357">adevăr</span> <span begin="0:53.357" end="0:54.362">viață</span> <span begin="0:54.362" end="0:55.368">sfântă</span> <span begin="0:55.368" end="0:55.871">să-ți</span> <span begin="0:55.871" end="0:57.826">clădești!</span></p><p begin="0:57.826" end="1:05.792" ttm:agent="v1"><span begin="0:57.826" end="0:58.821">Ia</span> <span begin="0:58.821" end="0:59.319">și</span> <span begin="0:59.319" end="1:01.311">citește</span> <span begin="1:01.311" end="1:03.302">scrisoarea</span> <span begin="1:03.302" end="1:05.792">divină,</span></p><p begin="1:05.792" end="1:13.757" ttm:agent="v1"><span begin="1:05.792" end="1:07.285">Scrisă</span> <span begin="1:07.285" end="1:07.783">cu</span> <span begin="1:07.783" end="1:09.775">lacrima</span> <span begin="1:09.775" end="1:11.268">milei</span> <span begin="1:11.268" end="1:13.757">cerești!</span></p><p begin="1:13.757" end="1:21.723" ttm:agent="v1"><span begin="1:13.757" end="1:14.753">Ea</span> <span begin="1:14.753" end="1:15.251">îți</span> <span begin="1:15.251" end="1:17.243">aduce</span> <span begin="1:17.243" end="1:17.740">în</span> <span begin="1:17.740" end="1:19.234">suflet</span> <span begin="1:19.234" end="1:21.723">lumină,</span></p><p begin="1:21.723" end="1:29.189" ttm:agent="v1"><span begin="1:21.723" end="1:22.719">Și</span> <span begin="1:22.719" end="1:25.209">mântuirea</span> <span begin="1:25.209" end="1:25.706">în</span> <span begin="1:25.706" end="1:26.204">dar</span> <span begin="1:26.204" end="1:26.702">să</span> <span begin="1:26.702" end="1:27.200">o</span> <span begin="1:27.200" end="1:29.189">primești.</span></p><p begin="1:29.189" end="1:37.036" ttm:agent="v1"><span begin="1:29.189" end="1:30.170">Ia</span> <span begin="1:30.170" end="1:30.661">și</span> <span begin="1:30.661" end="1:32.622">citește</span> <span begin="1:32.622" end="1:35.074">cuvintele</span> <span begin="1:35.074" end="1:37.036">sfinte,</span></p><p begin="1:37.036" end="1:44.882" ttm:agent="v1"><span begin="1:37.036" end="1:38.017">În</span> <span begin="1:38.017" end="1:40.469">profeție</span> <span begin="1:40.469" end="1:40.959">de</span> <span begin="1:40.959" end="1:41.940">crezi,</span> <span begin="1:41.940" end="1:42.430">nu</span> <span begin="1:42.430" end="1:44.882">greșești!</span></p><p begin="1:44.882" end="1:52.729" ttm:agent="v1"><span begin="1:44.882" end="1:45.863">Mergi</span> <span begin="1:45.863" end="1:46.353">prin</span> <span begin="1:46.353" end="1:48.315">credință</span> <span begin="1:48.315" end="1:49.786">oricând</span> <span begin="1:49.786" end="1:52.729">înainte,</span></p><p begin="1:52.729" end="2:00.085" ttm:agent="v1"><span begin="1:52.729" end="1:53.709">În</span> <span begin="1:53.709" end="1:54.690">vadul</span> <span begin="1:54.690" end="1:56.162">lumii</span> <span begin="1:56.162" end="1:57.142">nicicând</span> <span begin="1:57.142" end="1:57.633">să</span> <span begin="1:57.633" end="1:58.123">nu</span> <span begin="1:58.123" end="2:00.085">te-oprești!</span></p></div></body></tt>