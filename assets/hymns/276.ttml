<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>276. Îl văd adesea și-l admir</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:21.375"><div><p begin="0:12.020" end="0:16.722" ttm:agent="v1"><span begin="0:12.020" end="0:12.608">Îl</span> <span begin="0:12.608" end="0:13.195">văd</span> <span begin="0:13.195" end="0:14.959">adesea</span> <span begin="0:14.959" end="0:15.546">și-l</span> <span begin="0:15.546" end="0:16.722">admir</span></p><p begin="0:16.722" end="0:21.424" ttm:agent="v1"><span begin="0:16.722" end="0:18.485">Pe-urmașul</span> <span begin="0:18.485" end="0:19.073">lui</span> <span begin="0:19.073" end="0:20.248">Isus</span> <span begin="0:20.248" end="0:21.424">Hristos,</span></p><p begin="0:21.424" end="0:26.126" ttm:agent="v1"><span begin="0:21.424" end="0:22.599">Sorbind</span> <span begin="0:22.599" end="0:23.187">al</span> <span begin="0:23.187" end="0:24.950">lacrimii</span> <span begin="0:24.950" end="0:26.126">potir</span></p><p begin="0:26.126" end="0:32.327" ttm:agent="v1"><span begin="0:26.126" end="0:26.713">Cu</span> <span begin="0:26.713" end="0:27.301">pași</span> <span begin="0:27.301" end="0:28.477">trudiți,</span> <span begin="0:28.477" end="0:29.064">pe</span> <span begin="0:29.064" end="0:30.240">drum</span> <span begin="0:30.240" end="0:32.327">spinos...</span></p><p begin="0:32.327" end="0:37.617" ttm:agent="v1"><span begin="0:32.327" end="0:32.915">„De</span> <span begin="0:32.915" end="0:34.091">unde</span> <span begin="0:34.091" end="0:34.678">ai</span> <span begin="0:34.678" end="0:35.854">primit</span> <span begin="0:35.854" end="0:37.617">puteri</span></p><p begin="0:37.617" end="0:43.231" ttm:agent="v1"><span begin="0:37.617" end="0:38.205">Să-nfrunți</span> <span begin="0:38.205" end="0:39.968">atâtea</span> <span begin="0:39.968" end="0:41.143">mari</span> <span begin="0:41.143" end="0:43.231">dureri?”</span></p><p begin="0:43.231" end="0:47.933" ttm:agent="v1"><span begin="0:43.231" end="0:43.819">Iar</span> <span begin="0:43.819" end="0:44.407">el</span> <span begin="0:44.407" end="0:44.994">mi-a</span> <span begin="0:44.994" end="0:45.582">spus:</span> <span begin="0:45.582" end="0:47.345">„Nădejdea</span> <span begin="0:47.345" end="0:47.933">mea-i</span></p><p begin="0:47.933" end="0:52.495" ttm:agent="v1"><span begin="0:47.933" end="0:49.109">Hristos</span> <span begin="0:49.109" end="0:49.696">și</span> <span begin="0:49.696" end="0:52.047">biruința</span> <span begin="0:52.047" end="0:52.495">Sa!”</span></p><p begin="0:52.495" end="0:57.267" ttm:agent="v1"><span begin="0:52.495" end="0:53.091">Îl</span> <span begin="0:53.091" end="0:53.688">văd</span> <span begin="0:53.688" end="0:54.285">în</span> <span begin="0:54.285" end="0:55.478">luptă,</span> <span begin="0:55.478" end="0:57.267">deseori,</span></p><p begin="0:57.267" end="1:02.040" ttm:agent="v1"><span begin="0:57.267" end="0:57.864">O</span> <span begin="0:57.864" end="0:59.654">sabie</span> <span begin="0:59.654" end="1:00.847">purtând</span> <span begin="1:00.847" end="1:01.443">și</span> <span begin="1:01.443" end="1:02.040">scut,</span></p><p begin="1:02.040" end="1:06.812" ttm:agent="v1"><span begin="1:02.040" end="1:02.636">Ah,</span> <span begin="1:02.636" end="1:03.233">simt</span> <span begin="1:03.233" end="1:03.829">cum</span> <span begin="1:03.829" end="1:05.619">rănile</span> <span begin="1:05.619" end="1:06.216">îl</span> <span begin="1:06.216" end="1:06.812">dor,</span></p><p begin="1:06.812" end="1:13.085" ttm:agent="v1"><span begin="1:06.812" end="1:07.409">Dar</span> <span begin="1:07.409" end="1:08.005">văd</span> <span begin="1:08.005" end="1:08.602">că</span> <span begin="1:08.602" end="1:09.198">nu</span> <span begin="1:09.198" end="1:09.795">se</span> <span begin="1:09.795" end="1:10.391">dă</span> <span begin="1:10.391" end="1:13.085">bătut!</span></p><p begin="1:13.085" end="1:17.857" ttm:agent="v1"><span begin="1:13.085" end="1:13.681">„De</span> <span begin="1:13.681" end="1:14.874">unde</span> <span begin="1:14.874" end="1:15.471">ai</span> <span begin="1:15.471" end="1:16.664">așa</span> <span begin="1:16.664" end="1:17.857">curaj,</span></p><p begin="1:17.857" end="1:24.129" ttm:agent="v1"><span begin="1:17.857" end="1:18.453">Să</span> <span begin="1:18.453" end="1:19.050">speri,</span> <span begin="1:19.050" end="1:19.647">să</span> <span begin="1:19.647" end="1:20.243">lupți,</span> <span begin="1:20.243" end="1:20.840">să</span> <span begin="1:20.840" end="1:21.436">nu</span> <span begin="1:21.436" end="1:22.033">te</span> <span begin="1:22.033" end="1:24.129">lași?”</span></p><p begin="1:24.129" end="1:28.902" ttm:agent="v1"><span begin="1:24.129" end="1:24.726">Iar</span> <span begin="1:24.726" end="1:25.322">el</span> <span begin="1:25.322" end="1:25.919">mi-a</span> <span begin="1:25.919" end="1:26.515">spus:</span> <span begin="1:26.515" end="1:28.305">„Nădejdea</span> <span begin="1:28.305" end="1:28.902">mea-i</span></p><p begin="1:28.902" end="1:32.834" ttm:agent="v1"><span begin="1:28.902" end="1:30.095">Hristos</span> <span begin="1:30.095" end="1:30.691">și</span> <span begin="1:30.691" end="1:33.078">biruința</span> <span begin="1:33.078" end="1:32.834">Sa!”</span></p><p begin="1:32.834" end="1:37.750" ttm:agent="v1"><span begin="1:32.834" end="1:34.063">Suntem</span> <span begin="1:34.063" end="1:34.677">cu</span> <span begin="1:34.677" end="1:35.906">toții</span> <span begin="1:35.906" end="1:37.750">peregrini</span></p><p begin="1:37.750" end="1:42.665" ttm:agent="v1"><span begin="1:37.750" end="1:38.364">Prin</span> <span begin="1:38.364" end="1:39.593">valea</span> <span begin="1:39.593" end="1:41.436">negrelor</span> <span begin="1:41.436" end="1:42.665">dureri;</span></p><p begin="1:42.665" end="1:47.581" ttm:agent="v1"><span begin="1:42.665" end="1:43.894">Deși</span> <span begin="1:43.894" end="1:45.737">îngustă</span> <span begin="1:45.737" end="1:46.352">și</span> <span begin="1:46.352" end="1:46.966">cu</span> <span begin="1:46.966" end="1:47.581">spini,</span></p><p begin="1:47.581" end="1:53.996" ttm:agent="v1"><span begin="1:47.581" end="1:49.424">Cărarea</span> <span begin="1:49.424" end="1:50.653">duce</span> <span begin="1:50.653" end="1:51.267">sus,</span> <span begin="1:51.267" end="1:51.882">la</span> <span begin="1:51.882" end="1:53.996">cer!</span></p><p begin="1:53.996" end="1:58.912" ttm:agent="v1"><span begin="1:53.996" end="1:54.611">La</span> <span begin="1:54.611" end="1:55.840">Tine,</span> <span begin="1:55.840" end="1:57.069">Doamne,</span> <span begin="1:57.069" end="1:57.683">am</span> <span begin="1:57.683" end="1:58.912">găsit</span></p><p begin="1:58.912" end="2:05.327" ttm:agent="v1"><span begin="1:58.912" end="2:00.755">Putere</span> <span begin="2:00.755" end="2:01.984">până</span> <span begin="2:01.984" end="2:02.599">la</span> <span begin="2:02.599" end="2:05.327">sfârșit!</span></p><p begin="2:05.327" end="2:10.243" ttm:agent="v1"><span begin="2:05.327" end="2:07.171">Păstrează-n</span> <span begin="2:07.171" end="2:07.785">noi</span> <span begin="2:07.785" end="2:09.629">nădejdea</span> <span begin="2:09.629" end="2:10.243">Ta</span></p><p begin="2:10.243" end="2:15.159" ttm:agent="v1"><span begin="2:10.243" end="2:11.472">S-avem</span> <span begin="2:11.472" end="2:13.315">putere</span> <span begin="2:13.315" end="2:13.930">a</span> <span begin="2:13.930" end="2:15.159">lupta!</span></p></div></body></tt>