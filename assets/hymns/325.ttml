<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>325. Tată, toți Te rugăm!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="3:20.333"><div><p begin="0:34.390" end="0:45.074" ttm:agent="v1"><span begin="0:34.390" end="0:38.397">Tată,</span> <span begin="0:38.397" end="0:39.732">toți</span> <span begin="0:39.732" end="0:42.403">Te</span> <span begin="0:42.403" end="0:45.074">rugăm,</span></p><p begin="0:45.074" end="0:55.759" ttm:agent="v1"><span begin="0:45.074" end="0:47.745">În</span> <span begin="0:47.745" end="0:50.416">Tine</span> <span begin="0:50.416" end="0:52.420">doar</span> <span begin="0:52.420" end="0:55.759">sperăm,</span></p><p begin="0:55.759" end="1:06.443" ttm:agent="v1"><span begin="0:55.759" end="1:01.101">Ne-ajută</span> <span begin="1:01.101" end="1:03.772">când</span> <span begin="1:03.772" end="1:06.443">strigăm</span></p><p begin="1:06.443" end="1:28.991" ttm:agent="v1"><span begin="1:06.443" end="1:09.114">Azi</span> <span begin="1:09.114" end="1:10.449">în</span> <span begin="1:10.449" end="1:28.991">nevoi!</span></p><p begin="1:28.991" end="1:39.622" ttm:agent="v1"><span begin="1:28.991" end="1:31.649">Al</span> <span begin="1:31.649" end="1:32.978">Tău</span> <span begin="1:32.978" end="1:34.307">har</span> <span begin="1:34.307" end="1:36.964">dă-ni-l</span> <span begin="1:36.964" end="1:39.622">Tu,</span></p><p begin="1:39.622" end="1:50.253" ttm:agent="v1"><span begin="1:39.622" end="1:42.280">Cu</span> <span begin="1:42.280" end="1:44.938">dreapta-Ți</span> <span begin="1:44.938" end="1:46.931">ne</span> <span begin="1:46.931" end="1:50.253">condu,</span></p><p begin="1:50.253" end="2:00.884" ttm:agent="v1"><span begin="1:50.253" end="1:52.911">Să</span> <span begin="1:52.911" end="1:54.240">fim</span> <span begin="1:54.240" end="1:57.562">purtați</span> <span begin="1:57.562" end="2:00.884">de-acu’</span></p><p begin="2:00.884" end="2:18.926" ttm:agent="v1"><span begin="2:00.884" end="2:03.542">Pe</span> <span begin="2:03.542" end="2:06.199">netezi</span> <span begin="2:06.199" end="2:18.926">căi.</span></p><p begin="2:18.926" end="2:29.556" ttm:agent="v1"><span begin="2:18.926" end="2:21.583">Pe</span> <span begin="2:21.583" end="2:24.241">Tine</span> <span begin="2:24.241" end="2:26.234">Te</span> <span begin="2:26.234" end="2:29.556">mărim</span></p><p begin="2:29.556" end="2:40.187" ttm:agent="v1"><span begin="2:29.556" end="2:32.214">Chiar</span> <span begin="2:32.214" end="2:34.872">dacă</span> <span begin="2:34.872" end="2:40.187">suferim,</span></p><p begin="2:40.187" end="2:50.818" ttm:agent="v1"><span begin="2:40.187" end="2:45.503">Ne-nvață</span> <span begin="2:45.503" end="2:48.160">să</span> <span begin="2:48.160" end="2:50.818">primim</span></p><p begin="2:50.818" end="2:58.791" ttm:agent="v1"><span begin="2:50.818" end="2:56.134">Răbdarea</span> <span begin="2:56.134" end="2:58.791">Ta!</span></p></div></body></tt>