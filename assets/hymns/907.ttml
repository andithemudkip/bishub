<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>907. De n-aș avea în Domnul mângâiere...</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:51.886"><div><p begin="0:14.352" end="0:23.811" ttm:agent="v1"><span begin="0:14.352" end="0:15.535">De</span> <span begin="0:15.535" end="0:16.126">n-aș</span> <span begin="0:16.126" end="0:17.899">avea</span> <span begin="0:17.899" end="0:19.082">în</span> <span begin="0:19.082" end="0:20.264">Domnul</span> <span begin="0:20.264" end="0:23.811">mângâiere,</span></p><p begin="0:23.811" end="0:33.269" ttm:agent="v1"><span begin="0:23.811" end="0:25.584">Aici,</span> <span begin="0:25.584" end="0:26.176">în</span> <span begin="0:26.176" end="0:27.358">a</span> <span begin="0:27.358" end="0:29.722">durerii</span> <span begin="0:29.722" end="0:32.087">tristă</span> <span begin="0:32.087" end="0:33.269">vale,</span></p><p begin="0:33.269" end="0:42.728" ttm:agent="v1"><span begin="0:33.269" end="0:34.452">Prin</span> <span begin="0:34.452" end="0:35.634">harul</span> <span begin="0:35.634" end="0:36.816">Lui</span> <span begin="0:36.816" end="0:37.999">de</span> <span begin="0:37.999" end="0:38.885">nu</span> <span begin="0:38.885" end="0:39.181">mi-ar</span> <span begin="0:39.181" end="0:39.772">da</span> <span begin="0:39.772" end="0:42.728">putere,</span></p><p begin="0:42.728" end="0:54.130" ttm:agent="v1"><span begin="0:42.728" end="0:43.910">N-ar</span> <span begin="0:43.910" end="0:43.910">fi</span> <span begin="0:43.910" end="0:54.130">scăpare!</span></p><p begin="0:54.130" end="1:03.981" ttm:agent="v1"><span begin="0:54.130" end="0:55.361">În</span> <span begin="0:55.361" end="0:56.593">noaptea</span> <span begin="0:56.593" end="0:59.055">lumii,</span> <span begin="0:59.055" end="1:00.902">rătăcind,</span> <span begin="1:00.902" end="1:01.518">m-aș</span> <span begin="1:01.518" end="1:03.981">pierde,</span></p><p begin="1:03.981" end="1:13.832" ttm:agent="v1"><span begin="1:03.981" end="1:05.212">Căci</span> <span begin="1:05.212" end="1:05.828">pe</span> <span begin="1:05.828" end="1:08.906">oriunde-aș</span> <span begin="1:08.906" end="1:10.138">merge</span> <span begin="1:10.138" end="1:10.753">și-aș</span> <span begin="1:10.753" end="1:13.832">căta,</span></p><p begin="1:13.832" end="1:23.683" ttm:agent="v1"><span begin="1:13.832" end="1:15.063">Tot</span> <span begin="1:15.063" end="1:15.679">n-aș</span> <span begin="1:15.679" end="1:17.526">găsi</span> <span begin="1:17.526" end="1:20.604">iubire-așa</span> <span begin="1:20.604" end="1:23.683">deplină</span></p><p begin="1:23.683" end="1:32.945" ttm:agent="v1"><span begin="1:23.683" end="1:24.914">Cum</span> <span begin="1:24.914" end="1:26.145">e</span> <span begin="1:26.145" end="1:28.608">a</span> <span begin="1:28.608" end="1:32.945">Sa!</span></p><p begin="1:32.945" end="1:42.844" ttm:agent="v1"><span begin="1:32.945" end="1:35.420">De-aceea-Ți</span> <span begin="1:35.420" end="1:38.513">mulțumesc</span> <span begin="1:38.513" end="1:39.132">din</span> <span begin="1:39.132" end="1:40.370">suflet,</span> <span begin="1:40.370" end="1:42.844">Doamne,</span></p><p begin="1:42.844" end="1:52.744" ttm:agent="v1"><span begin="1:42.844" end="1:44.082">Că</span> <span begin="1:44.082" end="1:44.701">Tu</span> <span begin="1:44.701" end="1:45.319">din</span> <span begin="1:45.319" end="1:46.557">har</span> <span begin="1:46.557" end="1:47.794">prin</span> <span begin="1:47.794" end="1:49.032">veșnic</span> <span begin="1:49.032" end="1:52.744">legământ,</span></p><p begin="1:52.744" end="2:02.644" ttm:agent="v1"><span begin="1:52.744" end="1:53.982">Ca</span> <span begin="1:53.982" end="1:55.219">membru</span> <span begin="1:55.219" end="1:56.456">m-ai</span> <span begin="1:56.456" end="1:58.622">primit</span> <span begin="1:58.622" end="1:58.931">în</span> <span begin="1:58.931" end="1:59.550">a</span> <span begin="1:59.550" end="2:00.169">Ta</span> <span begin="2:00.169" end="2:02.644">obște,</span></p><p begin="2:02.644" end="2:06.162" ttm:agent="v1"><span begin="2:02.644" end="2:03.881">În</span> <span begin="2:03.881" end="2:07.593">trupu-Ți</span> <span begin="2:07.593" end="2:06.162">sfânt!</span></p><p begin="2:06.162" end="2:15.915" ttm:agent="v1"><span begin="2:06.162" end="2:07.381">În</span> <span begin="2:07.381" end="2:08.601">Legea</span> <span begin="2:08.601" end="2:09.820">Ta</span> <span begin="2:09.820" end="2:12.258">ajută-mi</span> <span begin="2:12.258" end="2:12.867">ca</span> <span begin="2:12.867" end="2:13.477">să</span> <span begin="2:13.477" end="2:15.915">umblu,</span></p><p begin="2:15.915" end="2:25.668" ttm:agent="v1"><span begin="2:15.915" end="2:17.134">Pân’</span> <span begin="2:17.134" end="2:17.744">vei</span> <span begin="2:17.744" end="2:19.572">veni</span> <span begin="2:19.572" end="2:20.791">Tu</span> <span begin="2:20.791" end="2:22.010">iarăși</span> <span begin="2:22.010" end="2:22.620">în</span> <span begin="2:22.620" end="2:25.668">mărire:</span></p><p begin="2:25.668" end="2:35.420" ttm:agent="v1"><span begin="2:25.668" end="2:27.496">Atunci</span> <span begin="2:27.496" end="2:28.106">voi</span> <span begin="2:28.106" end="2:29.325">fi</span> <span begin="2:29.325" end="2:30.544">cu</span> <span begin="2:30.544" end="2:31.763">Tine</span> <span begin="2:31.763" end="2:32.372">pe</span> <span begin="2:32.372" end="2:35.420">vecie,</span></p><p begin="2:35.420" end="2:37.858" ttm:agent="v1"><span begin="2:35.420" end="2:36.639">În</span> <span begin="2:36.639" end="2:37.858">fericire!</span></p></div></body></tt>