<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>376. Bunul Isus ne-a învățat</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:58.570"><div><p begin="0:14.120" end="0:20.349" ttm:agent="v1"><span begin="0:14.120" end="0:15.158">Bunul</span> <span begin="0:15.158" end="0:17.235">Isus</span> <span begin="0:17.235" end="0:17.754">ne-a</span> <span begin="0:17.754" end="0:20.349">învățat,</span></p><p begin="0:20.349" end="0:26.579" ttm:agent="v1"><span begin="0:20.349" end="0:21.907">Exemplul</span> <span begin="0:21.907" end="0:22.945">Său</span> <span begin="0:22.945" end="0:23.464">ne-a</span> <span begin="0:23.464" end="0:26.579">arătat:</span></p><p begin="0:26.579" end="0:32.289" ttm:agent="v1"><span begin="0:26.579" end="0:27.098">Să</span> <span begin="0:27.098" end="0:29.174">ajutăm</span> <span begin="0:29.174" end="0:29.693">pe</span> <span begin="0:29.693" end="0:30.732">cel</span> <span begin="0:30.732" end="0:32.289">lipsit,</span></p><p begin="0:32.289" end="0:40.078" ttm:agent="v1"><span begin="0:32.289" end="0:33.846">Sărman</span> <span begin="0:33.846" end="0:34.366">și</span> <span begin="0:34.366" end="0:40.078">umilit.</span></p><p begin="0:40.078" end="0:46.245" ttm:agent="v1"><span begin="0:40.078" end="0:41.105">Așa</span> <span begin="0:41.105" end="0:41.619">a</span> <span begin="0:41.619" end="0:43.161">fost</span> <span begin="0:43.161" end="0:43.675">la</span> <span begin="0:43.675" end="0:46.245">început,</span></p><p begin="0:46.245" end="0:52.412" ttm:agent="v1"><span begin="0:46.245" end="0:47.273">Primii</span> <span begin="0:47.273" end="0:48.814">creștini</span> <span begin="0:48.814" end="0:50.356">așa-au</span> <span begin="0:50.356" end="0:52.412">făcut:</span></p><p begin="0:52.412" end="0:58.065" ttm:agent="v1"><span begin="0:52.412" end="0:52.926">Tot</span> <span begin="0:52.926" end="0:53.440">ce-au</span> <span begin="0:53.440" end="0:54.981">avut</span> <span begin="0:54.981" end="0:58.065">agonisit,</span></p><p begin="0:58.065" end="1:05.706" ttm:agent="v1"><span begin="0:58.065" end="0:58.579">Cu</span> <span begin="0:58.579" end="0:59.607">toți</span> <span begin="0:59.607" end="1:00.121">au</span> <span begin="1:00.121" end="1:05.706">folosit!</span></p><p begin="1:05.706" end="1:11.935" ttm:agent="v1"><span begin="1:05.706" end="1:06.225">La</span> <span begin="1:06.225" end="1:07.263">masa</span> <span begin="1:07.263" end="1:08.820">lor,</span> <span begin="1:08.820" end="1:09.339">de</span> <span begin="1:09.339" end="1:09.858">buni</span> <span begin="1:09.858" end="1:11.935">creștini,</span></p><p begin="1:11.935" end="1:18.163" ttm:agent="v1"><span begin="1:11.935" end="1:14.530">Se-ndestulau</span> <span begin="1:14.530" end="1:15.049">chiar</span> <span begin="1:15.049" end="1:16.087">și</span> <span begin="1:16.087" end="1:18.163">străini,</span></p><p begin="1:18.163" end="1:23.873" ttm:agent="v1"><span begin="1:18.163" end="1:18.683">Se</span> <span begin="1:18.683" end="1:20.759">bucurau</span> <span begin="1:20.759" end="1:21.278">toți</span> <span begin="1:21.278" end="1:22.316">cei</span> <span begin="1:22.316" end="1:23.873">sărmani</span></p><p begin="1:23.873" end="1:31.381" ttm:agent="v1"><span begin="1:23.873" end="1:24.392">Și</span> <span begin="1:24.392" end="1:26.988">văduve</span> <span begin="1:26.988" end="1:31.381">și-orfani...</span></p><p begin="1:31.381" end="1:37.548" ttm:agent="v1"><span begin="1:31.381" end="1:32.923">Coboară</span> <span begin="1:32.923" end="1:34.464">Tu,</span> <span begin="1:34.464" end="1:36.006">Doamne-ntre</span> <span begin="1:36.006" end="1:37.548">noi,</span></p><p begin="1:37.548" end="1:43.714" ttm:agent="v1"><span begin="1:37.548" end="1:39.089">Sădește-al</span> <span begin="1:39.089" end="1:41.659">dragostei</span> <span begin="1:41.659" end="1:43.714">altoi,</span></p><p begin="1:43.714" end="1:49.367" ttm:agent="v1"><span begin="1:43.714" end="1:44.228">Să</span> <span begin="1:44.228" end="1:44.742">fim</span> <span begin="1:44.742" end="1:46.797">lumină</span> <span begin="1:46.797" end="1:47.825">pe</span> <span begin="1:47.825" end="1:49.367">pământ,</span></p><p begin="1:49.367" end="1:53.478" ttm:agent="v1"><span begin="1:49.367" end="1:49.880">În</span> <span begin="1:49.880" end="1:51.422">fapte</span> <span begin="1:51.422" end="1:52.450">și-n</span> <span begin="1:52.450" end="1:53.478">cuvânt!</span></p></div></body></tt>