<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>641. Harul lui Isus</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="0:58.410"><div><p begin="0:11.530" end="0:16.757" ttm:agent="v1"><span begin="0:11.530" end="0:12.837">Harul</span> <span begin="0:12.837" end="0:13.490">lui</span> <span begin="0:13.490" end="0:14.797">Isus</span> <span begin="0:14.797" end="0:15.450">cel</span> <span begin="0:15.450" end="0:16.757">tare</span></p><p begin="0:16.757" end="0:21.984" ttm:agent="v1"><span begin="0:16.757" end="0:17.411">Și</span> <span begin="0:17.411" end="0:19.371">iubirea</span> <span begin="0:19.371" end="0:21.984">Tatălui</span></p><p begin="0:21.984" end="0:27.212" ttm:agent="v1"><span begin="0:21.984" end="0:23.291">Fie</span> <span begin="0:23.291" end="0:27.212">binecuvântare</span></p><p begin="0:27.212" end="0:33.919" ttm:agent="v1"><span begin="0:27.212" end="0:28.518">Peste</span> <span begin="0:28.518" end="0:29.172">noi,</span> <span begin="0:29.172" end="0:31.132">copiii</span> <span begin="0:31.132" end="0:33.919">Lui!</span></p><p begin="0:33.919" end="0:39.172" ttm:agent="v1"><span begin="0:33.919" end="0:34.575">Să</span> <span begin="0:34.575" end="0:36.545">rămânem</span> <span begin="0:36.545" end="0:37.202">în</span> <span begin="0:37.202" end="0:39.172">unire,</span></p><p begin="0:39.172" end="0:44.425" ttm:agent="v1"><span begin="0:39.172" end="0:39.829">Frați</span> <span begin="0:39.829" end="0:40.485">ai</span> <span begin="0:40.485" end="0:42.455">Mielului</span> <span begin="0:42.455" end="0:43.112">cel</span> <span begin="0:43.112" end="0:44.425">blând,</span></p><p begin="0:44.425" end="0:49.679" ttm:agent="v1"><span begin="0:44.425" end="0:45.082">Plini</sp