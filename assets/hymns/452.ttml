<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>452. Purtăm cu noi lumini</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:41.407"><div><p begin="0:11.500" end="0:16.722" ttm:agent="v1"><span begin="0:11.500" end="0:12.806">Purtăm</span> <span begin="0:12.806" end="0:13.458">cu</span> <span begin="0:13.458" end="0:14.111">noi</span> <span begin="0:14.111" end="0:16.722">lumini,</span></p><p begin="0:16.722" end="0:21.945" ttm:agent="v1"><span begin="0:16.722" end="0:17.375">Prin</span> <span begin="0:17.375" end="0:18.681">lume</span> <span begin="0:18.681" end="0:21.945">călători,</span></p><p begin="0:21.945" end="0:27.167" ttm:agent="v1"><span begin="0:21.945" end="0:22.598">Ca</span> <span begin="0:22.598" end="0:23.250">să</span> <span begin="0:23.250" end="0:23.903">se</span> <span begin="0:23.903" end="0:25.209">vadă,</span> <span begin="0:25.209" end="0:26.188">pe</span> <span begin="0:26.188" end="0:27.167">’nălțimi,</span></p><p begin="0:27.167" end="0:33.290" ttm:agent="v1"><span begin="0:27.167" end="0:27.820">Ai</span> <span begin="0:27.820" end="0:30.431">mântuirii</span> <span begin="0:30.431" end="0:33.290">zori!</span></p><p begin="0:33.290" end="0:38.538" ttm:agent="v1"><span begin="0:33.290" end="0:33.946">În</span> <span begin="0:33.946" end="0:35.258">cântec</span> <span begin="0:35.258" end="0:35.914">noi</span> <span begin="0:35.914" end="0:36.570">am</span> <span begin="0:36.570" end="0:38.538">strâns</span></p><p begin="0:38.538" end="0:43.787" ttm:agent="v1"><span begin="0:38.538" end="0:40.506">Durerea</span> <span begin="0:40.506" end="0:43.787">tuturor,</span></p><p begin="0:43.787" end="0:49.035" ttm:agent="v1"><span begin="0:43.787" end="0:44.443">Ca</span> <span begin="0:44.443" end="0:45.755">să</span> <span begin="0:45.755" end="0:47.067">se-oprească</span> <span begin="0:47.067" end="0:48.379">orice</span> <span begin="0:48.379" end="0:49.035">plâns</span></p><p begin="0:49.035" end="0:55.364" ttm:agent="v1"><span begin="0:49.035" end="0:49.691">În</span> <span begin="0:49.691" end="0:51.003">harul</span> <span begin="0:51.003" end="0:55.364">salvator.</span></p><p begin="0:55.364" end="1:00.507" ttm:agent="v1"><span begin="0:55.364" end="0:56.007">Cu</span> <span begin="0:56.007" end="0:57.292">trâmbiți</span> <span begin="0:57.292" end="0:57.935">și</span> <span begin="0:57.935" end="1:00.507">făclii,</span></p><p begin="1:00.507" end="1:05.651" ttm:agent="v1"><span begin="1:00.507" end="1:01.150">În</span> <span begin="1:01.150" end="1:03.079">ultimul</span> <span begin="1:03.079" end="1:05.651">apus,</span></p><p begin="1:05.651" end="1:10.794" ttm:agent="v1"><span begin="1:05.651" end="1:06.294">Pe</span> <span begin="1:06.294" end="1:06.937">tot</span> <span begin="1:06.937" end="1:09.187">întinsul</span> <span begin="1:09.187" end="1:09.508">vom</span> <span begin="1:09.508" end="1:10.794">vesti</span></p><p begin="1:10.794" end="1:17.138" ttm:agent="v1"><span begin="1:10.794" end="1:11.437">Că</span> <span begin="1:11.437" end="1:12.723">vine</span> <span begin="1:12.723" end="1:13.366">iar</span> <span begin="1:13.366" end="1:17.138">Isus!</span></p><p begin="1:17.138" end="1:22.281" ttm:agent="v1"><span begin="1:17.138" end="1:17.781">Tu,</span> <span begin="1:17.781" end="1:19.067">Doamne,</span> <span begin="1:19.067" end="1:19.710">ne-ai</span> <span begin="1:19.710" end="1:22.281">chemat</span></p><p begin="1:22.281" end="1:27.425" ttm:agent="v1"><span begin="1:22.281" end="1:22.924">Din</span> <span begin="1:22.924" end="1:23.567">veac,</span> <span begin="1:23.567" end="1:24.853">popor</span> <span begin="1:24.853" end="1:25.496">să-Ți</span> <span begin="1:25.496" end="1:27.425">fim;</span></p><p begin="1:27.425" end="1:32.568" ttm:agent="v1"><span begin="1:27.425" end="1:28.068">Pe</span> <span begin="1:28.068" end="1:28.711">toți</span> <span begin="1:28.711" end="1:29.354">ce-n</span> <span begin="1:29.354" end="1:30.961">cruce</span> <span begin="1:30.961" end="1:31.283">ne-ai</span> <span begin="1:31.283" end="1:32.568">salvat,</span></p><p begin="1:32.568" end="1:36.426" ttm:agent="v1"><span begin="1:32.568" end="1:34.497">Ne-adună-n</span> <span begin="1:34.497" end="1:35.140">cer,</span> <span begin="1:35.140" end="1:36.426">amin!</span></p></div></body></tt>