<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>849. Locui-vom noi vreodată</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:13.878"><div><p begin="0:15.910" end="0:23.032" ttm:agent="v1"><span begin="0:15.910" end="0:19.471">Locui-vom</span> <span begin="0:19.471" end="0:20.065">noi</span> <span begin="0:20.065" end="0:23.032">vreodată</span></p><p begin="0:23.032" end="0:30.155" ttm:agent="v1"><span begin="0:23.032" end="0:23.626">Cu</span> <span begin="0:23.626" end="0:23.923">al</span> <span begin="0:23.923" end="0:26.594">nostru</span> <span begin="0:26.594" end="0:27.187">Domn</span> <span begin="0:27.187" end="0:30.155">Isus?</span></p><p begin="0:30.155" end="0:37.277" ttm:agent="v1"><span begin="0:30.155" end="0:30.748">Cu</span> <span begin="0:30.748" end="0:31.045">toți</span> <span begin="0:31.045" end="0:33.716">drepții</span> <span begin="0:33.716" end="0:37.277">laolaltă,</span></p><p begin="0:37.277" end="0:44.480" ttm:agent="v1"><span begin="0:37.277" end="0:38.167">Fi-vom</span> <span begin="0:38.167" end="0:40.542">noi</span> <span begin="0:40.542" end="0:40.838">în</span> <span begin="0:40.838" end="0:41.729">ceruri</span> <span begin="0:41.729" end="0:44.480">sus?</span></p><p begin="0:44.480" end="0:51.460" ttm:agent="v1"><span begin="0:44.480" end="0:45.352">Dă-ne,</span> <span begin="0:45.352" end="0:47.970">Doamne,</span> <span begin="0:47.970" end="0:48.842">voie</span> <span begin="0:48.842" end="0:51.460">bună,</span></p><p begin="0:51.460" end="0:58.730" ttm:agent="v1"><span begin="0:51.460" end="0:52.332">Legea</span> <span begin="0:52.332" end="0:54.659">Ta</span> <span begin="0:54.659" end="0:54.950">să</span> <span begin="0:54.950" end="0:55.531">o</spa