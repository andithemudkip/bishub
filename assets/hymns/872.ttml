<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>872. O, mamă scumpă!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="3:01.420"><div><p begin="0:20.300" end="0:30.028" ttm:agent="v1"><span begin="0:20.300" end="0:21.516">O,</span> <span begin="0:21.516" end="0:22.732">mamă</span> <span begin="0:22.732" end="0:25.164">scumpă,</span> <span begin="0:25.164" end="0:25.772">prin</span> <span begin="0:25.772" end="0:27.596">cântarea</span> <span begin="0:27.596" end="0:30.028">mea,</span></p><p begin="0:30.028" end="0:39.756" ttm:agent="v1"><span begin="0:30.028" end="0:32.460">Iubirea-ți</span> <span begin="0:32.460" end="0:34.892">dulce</span> <span begin="0:34.892" end="0:36.716">s-onorez</span> <span begin="0:36.716" end="0:37.324">aș</span> <span begin="0:37.324" end="0:39.756">vrea</span></p><p begin="0:39.756" end="0:49.484" ttm:agent="v1"><span begin="0:39.756" end="0:40.972">Și</span> <span begin="0:40.972" end="0:42.188">s-aduc</span> <span begin="0:42.188" end="0:44.620">slavă-n</span> <span begin="0:44.620" end="0:45.228">veci</span> <span begin="0:45.228" end="0:45.836">lui</span> <span begin="0:45.836" end="0:49.484">Dumnezeu,</span></p><p begin="0:49.484" end="1:00.052" ttm:agent="v1"><span begin="0:49.484" end="0:50.700">Că</span> <span begin="0:50.700" end="0:51.916">lângă</span> <span begin="0:51.916" end="0:54.348">Tine</span> <span begin="0:54.348" end="0:55.260">pot</span> <span begin="0:55.260" end="0:55.564">să-I</span> <span begin="0:55.564" end="0:56.172">cânt</span> <span begin="0:56.172" end="1:00.052">mereu.</span></p><p begin="1:00.052" end="1:09.877" ttm:agent="v1"><span begin="1:00.052" end="1:01.894">Unde,</span> <span begin="1:01.894" end="1:02.508">pe</span> <span begin="1:02.508" end="1:04.965">lume,</span> <span begin="1:04.965" end="1:05.579">voi</span> <span begin="1:05.579" end="1:06.807">putea</span> <span begin="1:06.807" end="1:09.877">găsi</span></p><p begin="1:09.877" end="1:19.703" ttm:agent="v1"><span begin="1:09.877" end="1:11.720">Jertfă</span> <span begin="1:11.720" end="1:12.334">mai</span> <span begin="1:12.334" end="1:14.790">scumpă</span> <span begin="1:14.790" end="1:15.711">ce</span> <span begin="1:15.711" end="1:16.018">s-ar</span> <span begin="1:16.018" end="1:19.703">oferi?</span></p><p begin="1:19.703" end="1:29.528" ttm:agent="v1"><span begin="1:19.703" end="1:21.545">Ziua</span> <span begin="1:21.545" end="1:22.159">și</span> <span begin="1:22.159" end="1:24.615">noaptea</span> <span begin="1:24.615" end="1:25.843">grija</span> <span begin="1:25.843" end="1:26.457">ta</span> <span begin="1:26.457" end="1:27.072">am</span> <span begin="1:27.072" end="1:29.528">fost,</span></p><p begin="1:29.528" end="1:39.933" ttm:agent="v1"><span begin="1:29.528" end="1:30.756">Noi</span> <span begin="1:30.756" end="1:31.370">la</span> <span begin="1:31.370" end="1:33.212">Isus</span> <span begin="1:33.212" end="1:35.669">găsit-am</span> <span begin="1:35.669" end="1:39.933">adăpost.</span></p><p begin="1:39.933" end="1:49.611" ttm:agent="v1"><span begin="1:39.933" end="1:41.143">O,</span> <span begin="1:41.143" end="1:42.353">Doamne</span> <span begin="1:42.353" end="1:44.772">Sfinte,</span> <span begin="1:44.772" end="1:45.377">mult</span> <span begin="1:45.377" end="1:45.982">Te</span> <span begin="1:45.982" end="1:46.587">voi</span> <span begin="1:46.587" end="1:49.611">ruga:</span></p><p begin="1:49.611" end="1:59.289" ttm:agent="v1"><span begin="1:49.611" end="1:50.821">Dă-mi</span> <span begin="1:50.821" end="1:51.426">Tu</span> <span begin="1:51.426" end="1:54.450">iubire</span> <span begin="1:54.450" end="1:55.660">pentru</span> <span begin="1:55.660" end="1:56.869">mama</span> <span begin="1:56.869" end="1:59.289">mea!</span></p><p begin="1:59.289" end="2:08.967" ttm:agent="v1"><span begin="1:59.289" end="2:01.708">Ajută-mi,</span> <span begin="2:01.708" end="2:05.338">Doamne-ntruna</span> <span begin="2:05.338" end="2:05.942">s-o</span> <span begin="2:05.942" end="2:08.967">ascult</span></p><p begin="2:08.967" end="2:19.365" ttm:agent="v1"><span begin="2:08.967" end="2:10.177">Și</span> <span begin="2:10.177" end="2:13.806">mângâiere</span> <span begin="2:13.806" end="2:15.016">multă</span> <span begin="2:15.016" end="2:15.620">să-i</span> <span begin="2:15.620" end="2:19.365">aduc!</span></p><p begin="2:19.365" end="2:28.897" ttm:agent="v1"><span begin="2:19.365" end="2:21.152">Ție,</span> <span begin="2:21.152" end="2:24.131">Părinte</span> <span begin="2:24.131" end="2:24.727">Sfânt,</span> <span begin="2:24.727" end="2:25.323">Îți</span> <span begin="2:25.323" end="2:28.897">mulțumesc;</span></p><p begin="2:28.897" end="2:38.430" ttm:agent="v1"><span begin="2:28.897" end="2:31.281">Numele</span> <span begin="2:31.281" end="2:32.472">Tău</span> <span begin="2:32.472" end="2:33.664">eu</span> <span begin="2:33.664" end="2:34.558">vreau</span> <span begin="2:34.558" end="2:34.855">să-L</span> <span begin="2:34.855" end="2:38.430">preamăresc,</span></p><p begin="2:38.430" end="2:47.963" ttm:agent="v1"><span begin="2:38.430" end="2:39.622">Căci</span> <span begin="2:39.622" end="2:40.218">Tu</span> <span begin="2:40.218" end="2:43.197">de-aproape</span> <span begin="2:43.197" end="2:44.388">astfel</span> <span begin="2:44.388" end="2:44.984">m-ai</span> <span begin="2:44.984" end="2:47.963">iubit:</span></p><p begin="2:47.963" end="2:54.815" ttm:agent="v1"><span begin="2:47.963" end="2:49.155">Mi-ai</span> <span begin="2:49.155" end="2:49.750">dat</span> <span begin="2:49.750" end="2:50.346">o</span> <span begin="2:50.346" end="2:52.729">mamă,</span> <span begin="2:52.729" end="2:53.623">dar</span> <span begin="2:53.623" end="2:54.815">neprețuit!</span></p></div></body></tt>