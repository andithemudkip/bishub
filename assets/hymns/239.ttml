<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>239. Ce te frămânți, inima mea?</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:42.949"><div><p begin="0:15.478" end="0:22.015" ttm:agent="v1"><span begin="0:15.478" end="0:16.023">Ce</span> <span begin="0:16.023" end="0:16.568">te</span> <span begin="0:16.568" end="0:18.747">frămânți,</span> <span begin="0:18.747" end="0:20.381">inima</span> <span begin="0:20.381" end="0:22.015">mea,</span></p><p begin="0:22.015" end="0:28.552" ttm:agent="v1"><span begin="0:22.015" end="0:23.649">Singură</span> <span begin="0:23.649" end="0:24.739">și</span> <span begin="0:24.739" end="0:28.552">pustie?</span></p><p begin="0:28.552" end="0:35.089" ttm:agent="v1"><span begin="0:28.552" end="0:29.097">Stai</span> <span begin="0:29.097" end="0:29.642">în</span> <span begin="0:29.642" end="0:31.821">credință,</span> <span begin="0:31.821" end="0:32.365">nu</span> <span begin="0:32.365" end="0:35.089">dispera,</span></p><p begin="0:35.089" end="0:43.026" ttm:agent="v1"><span begin="0:35.089" end="0:36.179">Toate</span> <span begin="0:36.179" end="0:37.813">Isus</span> <span begin="0:37.813" end="0:38.358">le</span> <span begin="0:38.358" end="0:43.026">știe!</span></p><p begin="0:43.026" end="0:49.596" ttm:agent="v1"><span begin="0:43.026" end="0:44.669">Oamenii</span> <span begin="0:44.669" end="0:46.311">trec</span> <span begin="0:46.311" end="0:46.859">tot</span> <span begin="0:46.859" end="0:47.406">mai</span> <span begin="0:47.406" end="0:49.596">grăbiți,</span></p><p begin="0:49.596" end="0:56.166" ttm:agent="v1"><span begin="0:49.596" end="0:50.143">N-au</span> <span begin="0:50.143" end="0:50.691">timp</span> <span begin="0:50.691" end="0:51.238">să</span> <span begin="0:51.238" end="0:52.333">te</span> <span begin="0:52.333" end="0:56.166">asculte;</span></p><p begin="0:56.166" end="1:02.735" ttm:agent="v1"><span begin="0:56.166" end="0:56.713">El</span> <span begin="0:56.713" end="0:57.261">ți-e</span> <span begin="0:57.261" end="0:59.451">aproape</span> <span begin="0:59.451" end="0:59.998">și-n</span> <span begin="0:59.998" end="1:02.735">suferinți,</span></p><p begin="1:02.735" end="1:11.225" ttm:agent="v1"><span begin="1:02.735" end="1:03.830">Oricât</span> <span begin="1:03.830" end="1:04.378">ar</span> <span begin="1:04.378" end="1:05.473">fi</span> <span begin="1:05.473" end="1:06.020">de</span> <span begin="1:06.020" end="1:11.225">multe...</span></p><p begin="1:11.225" end="1:17.828" ttm:agent="v1"><span begin="1:11.225" end="1:12.326">Doamne,</span> <span begin="1:12.326" end="1:14.526">auzi</span> <span begin="1:14.526" end="1:16.177">strigătul</span> <span begin="1:16.177" end="1:17.828">meu,</span></p><p begin="1:17.828" end="1:24.430" ttm:agent="v1"><span begin="1:17.828" end="1:18.378">Nu</span> <span begin="1:18.378" end="1:18.928">mă</span> <span begin="1:18.928" end="1:20.579">lăsa</span> <span begin="1:20.579" end="1:24.430">pieirii;</span></p><p begin="1:24.430" end="1:31.033" ttm:agent="v1"><span begin="1:24.430" end="1:24.980">Fă</span> <span begin="1:24.980" end="1:25.531">ca</span> <span begin="1:25.531" end="1:26.081">să</span> <span begin="1:26.081" end="1:27.181">cânt</span> <span begin="1:27.181" end="1:27.731">pe</span> <span begin="1:27.731" end="1:28.832">cale,</span> <span begin="1:28.832" end="1:31.033">mereu,</span></p><p begin="1:31.033" end="1:34.884" ttm:agent="v1"><span begin="1:31.033" end="1:32.683">Cântecul</span> <span begin="1:32.683" end="1:34.884">mântuirii!</span></p></div></body></tt>