<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>52. Să fie harul Domnului Hristos</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="0:51.722"><div><p begin="0:12.310" end="0:21.145" ttm:agent="v1"><span begin="0:12.310" end="0:12.899">Să</span> <span begin="0:12.899" end="0:15.255">fie</span> <span begin="0:15.255" end="0:17.611">harul</span> <span begin="0:17.611" end="0:19.378">Domnului</span> <span begin="0:19.378" end="0:21.145">Hristos</span></p><p begin="0:21.145" end="0:27.624" ttm:agent="v1"><span begin="0:21.145" end="0:21.734">Și</span> <span begin="0:21.734" end="0:24.679">iubirea</span> <span begin="0:24.679" end="0:27.624">Tatălui</span></p><p begin="0:27.624" end="0:35.869" ttm:agent="v1"><span begin="0:27.624" end="0:31.746">Și-mpărtășirea</span> <span begin="0:31.746" end="0:33.513">Duhului</span> <span begin="0:33.513" end="0:35.869">Preasfânt</span></p><p begin="0:35.869" end="0:38.225" ttm:agent="v1"><span begin="0:35.869" end="0:36.458">Cu</span> <span begin="0:36.458" end="0:37.047">noi</span> <span begin="0:37.047" end="0:37.636">cu</span> <span begin="0:37.636" end="0:38.225">toți,</span></p><p begin="0:38.225" end="0:41.170" ttm:agent="v1"><span begin="0:38.225" end="0:39.403">Acum</span> <span begin="0:39.403" end="0:39.992">și</span> <span begin="0:39.992" end="0:41.170">pururi.</span></p><p begin="0:41.170" end="0:42.348" ttm:agent="v1"><span begin="0:41.170" end="0:42.348">Amin!</span></p></div></body></tt>