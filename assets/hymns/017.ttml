<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>17. Doamne, sfinte, Te mărim!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:45.904"><div><p begin="0:16.750" end="0:24.430" ttm:agent="v1"><span begin="0:16.750" end="0:18.670">Doamne,</span> <span begin="0:18.670" end="0:20.590">sfinte,</span> <span begin="0:20.590" end="0:21.870">Te</span> <span begin="0:21.870" end="0:24.430">mărim!</span></p><p begin="0:24.430" end="0:32.110" ttm:agent="v1"><span begin="0:24.430" end="0:25.710">De</span> <span begin="0:25.710" end="0:28.270">puterea</span> <span begin="0:28.270" end="0:29.550">Ta</span> <span begin="0:29.550" end="0:32.110">măiastră</span></p><p begin="0:32.110" end="0:39.790" ttm:agent="v1"><span begin="0:32.110" end="0:35.310">Povestesc</span> <span begin="0:35.310" end="0:35.950">când</span> <span begin="0:35.950" end="0:37.230">le</span> <span begin="0:37.230" end="0:39.790">privim,</span></p><p begin="0:39.790" end="0:47.470" ttm:agent="v1"><span begin="0:39.790" end="0:42.990">Stelele</span> <span begin="0:42.990" end="0:43.630">din</span> <span begin="0:43.630" end="0:47.470">bolta-albastră;</span></p><p begin="0:47.470" end="0:55.150" ttm:agent="v1"><span begin="0:47.470" end="0:48.750">Tu,</span> <span begin="0:48.750" end="0:49.390">ce</span> <span begin="0:49.390" end="0:51.310">haru-Ți</span> <span begin="0:51.310" end="0:52.590">spre</span> <span begin="0:52.590" end="0:53.230">noi</span> <span begin="0:53.230" end="0:55.150">pleci,</span></p><p begin="0:55.150" end="1:04.530" ttm:agent="v1"><span begin="0:55.150" end="0:58.350">Neschimbat</span> <span begin="0:58.350" end="1:00.270">rămâi</span> <span begin="1:00.270" end="1:00.910">în</span> <span begin="1:00.910" end="1:04.530">veci!</span></p><p begin="1:04.530" end="1:12.364" ttm:agent="v1"><span begin="1:04.530" end="1:05.836">Tot</span> <span begin="1:05.836" end="1:06.488">ce</span> <span begin="1:06.488" end="1:08.447">poartă</span> <span begin="1:08.447" end="1:10.405">slava</span> <span begin="1:10.405" end="1:12.364">Ta,</span></p><p begin="1:12.364" end="1:20.197" ttm:agent="v1"><span begin="1:12.364" end="1:15.628">Îngerii</span> <span begin="1:15.628" end="1:16.280">în</span> <span begin="1:16.280" end="1:17.586">mii</span> <span begin="1:17.586" end="1:18.239">de</span> <span begin="1:18.239" end="1:20.197">cete,</span></p><p begin="1:20.197" end="1:28.031" ttm:agent="v1"><span begin="1:20.197" end="1:23.461">Adunați</span> <span begin="1:23.461" end="1:24.114">spre</span> <span begin="1:24.114" end="1:25.420">a-Ți</span> <span begin="1:25.420" end="1:28.031">cânta,</span></p><p begin="1:28.031" end="1:35.864" ttm:agent="v1"><span begin="1:28.031" end="1:31.948">Nu-ncetează</span> <span begin="1:31.948" end="1:33.253">să</span> <span begin="1:33.253" end="1:35.864">repete:</span></p><p begin="1:35.864" end="1:43.698" ttm:agent="v1"><span begin="1:35.864" end="1:37.170">„Sfânt</span> <span begin="1:37.170" end="1:37.823">e</span> <span begin="1:37.823" end="1:39.781">peste</span> <span begin="1:39.781" end="1:41.740">toate-n</span> <span begin="1:41.740" end="1:43.698">tot</span></p><p begin="1:43.698" end="1:53.972" ttm:agent="v1"><span begin="1:43.698" end="1:47.615">Dumnezeul</span> <span begin="1:47.615" end="1:53.972">Savaot!”</span></p><p begin="1:53.972" end="2:01.492" ttm:agent="v1"><span begin="1:53.972" end="1:55.225">Dar</span> <span begin="1:55.225" end="1:55.852">mai</span> <span begin="1:55.852" end="1:57.732">scumpă</span> <span begin="1:57.732" end="1:59.612">decât</span> <span begin="1:59.612" end="2:01.492">tot</span></p><p begin="2:01.492" end="2:09.012" ttm:agent="v1"><span begin="2:01.492" end="2:03.372">Ți-este</span> <span begin="2:03.372" end="2:05.252">slaba</span> <span begin="2:05.252" end="2:06.505">mea</span> <span begin="2:06.505" end="2:09.012">cântare</span></p><p begin="2:09.012" end="2:16.532" ttm:agent="v1"><span begin="2:09.012" end="2:10.265">Ce-o</span> <span begin="2:10.265" end="2:12.146">înalț,</span> <span begin="2:12.146" end="2:14.026">așa</span> <span begin="2:14.026" end="2:14.652">cum</span> <span begin="2:14.652" end="2:16.532">pot,</span></p><p begin="2:16.532" end="2:24.053" ttm:agent="v1"><span begin="2:16.532" end="2:17.786">În</span> <span begin="2:17.786" end="2:20.292">această</span> <span begin="2:20.292" end="2:24.053">adunare;</span></p><p begin="2:24.053" end="2:31.573" ttm:agent="v1"><span begin="2:24.053" end="2:25.933">Numai</span> <span begin="2:25.933" end="2:27.186">noi</span> <span begin="2:27.186" end="2:27.813">știm</span> <span begin="2:27.813" end="2:29.066">a</span> <span begin="2:29.066" end="2:31.573">cânta:</span></p><p begin="2:31.573" end="2:38.466" ttm:agent="v1"><span begin="2:31.573" end="2:33.453">„Mare</span> <span begin="2:33.453" end="2:34.706">e</span> <span begin="2:34.706" end="2:37.213">iubirea</span> <span begin="2:37.213" end="2:38.466">Ta!”</span></p></div></body></tt>