<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>432. Peste munți, peste mări</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:27.536"><div><p begin="0:13.030" end="0:18.752" ttm:agent="v1"><span begin="0:13.030" end="0:13.745">Peste</span> <span begin="0:13.745" end="0:14.460">munți,</span> <span begin="0:14.460" end="0:15.176">peste</span> <span begin="0:15.176" end="0:15.891">mări,</span> <span begin="0:15.891" end="0:16.427">cu</span> <span begin="0:16.427" end="0:17.321">Isus,</span> <span begin="0:17.321" end="0:17.858">voi</span> <span begin="0:17.858" end="0:18.752">pleca,</span></p><p begin="0:18.752" end="0:24.473" ttm:agent="v1"><span begin="0:18.752" end="0:19.467">Unde</span> <span begin="0:19.467" end="0:20.718">Vestea</span> <span begin="0:20.718" end="0:21.612">deloc</span> <span begin="0:21.612" end="0:22.149">n-a</span> <span begin="0:22.149" end="0:24.473">ajuns,</span></p><p begin="0:24.473" end="0:30.195" ttm:agent="v1"><span begin="0:24.473" end="0:26.440">Milioane</span> <span begin="0:26.440" end="0:26.619">ce</span> <span begin="0:26.619" end="0:27.334">n-au</span> <span begin="0:27.334" end="0:28.764">cunoscut</span> <span begin="0:28.764" end="0:30.195">dragostea</span></p><p begin="0:30.195" end="0:37.576" ttm:agent="v1"><span begin="0:30.195" end="0:30.731">Să</span> <span begin="0:30.731" end="0:32.162">audă</span> <span begin="0:32.162" end="0:32.340">și</span> <span begin="0:32.340" end="0:33.056">ei</span> <span begin="0:33.056" end="0:33.592">de</span> <span begin="0:33.592" end="0:37.576">Isus.</span></p><p begin="0:37.576" end="0:43.384" ttm:agent="v1"><span begin="0:37.576" end="0:38.302">Domnul</span> <span begin="0:38.302" end="0:39.573">are</span> <span begin="0:39.573" end="0:39.754">cu</span> <span begin="0:39.754" end="0:40.480">El,</span> <span begin="0:40.480" end="0:41.206">turma</span> <span begin="0:41.206" end="0:42.476">scumpă</span> <span begin="0:42.476" end="0:42.658">de</span> <span begin="0:42.658" end="0:43.384">oi,</span></p><p begin="0:43.384" end="0:49.191" ttm:agent="v1"><span begin="0:43.384" end="0:43.928">Dar</span> <span begin="0:43.928" end="0:44.110">mai</span> <span begin="0:44.110" end="0:44.836">sunt</span> <span begin="0:44.836" end="0:45.562">încă</span> <span begin="0:45.562" end="0:46.832">multe-n</span> <span begin="0:46.832" end="0:49.191">abis,</span></p><p begin="0:49.191" end="0:54.999" ttm:agent="v1"><span begin="0:49.191" end="0:49.736">Să-L</span> <span begin="0:49.736" end="0:50.643">ajut,</span> <span begin="0:50.643" end="0:51.188">să</span> <span begin="0:51.188" end="0:52.639">le-aducă</span> <span begin="0:52.639" end="0:52.821">în</span> <span begin="0:52.821" end="0:54.091">staul</span> <span begin="0:54.091" end="0:54.999">‘napoi</span></p><p begin="0:54.999" end="1:02.146" ttm:agent="v1"><span begin="0:54.999" end="0:55.543">Și</span> <span begin="0:55.543" end="0:55.725">pe</span> <span begin="0:55.725" end="0:56.995">mine</span> <span begin="0:56.995" end="0:57.902">Isus</span> <span begin="0:57.902" end="0:58.447">m-a</span> <span begin="0:58.447" end="1:02.146">trimis.</span></p><p begin="1:02.146" end="1:07.866" ttm:agent="v1"><span begin="1:02.146" end="1:02.682">Voi</span> <span begin="1:02.682" end="1:02.861">ce-ați</span> <span begin="1:02.861" end="1:03.576">stat</span> <span begin="1:03.576" end="1:05.006">risipind</span> <span begin="1:05.006" end="1:05.543">timp</span> <span begin="1:05.543" end="1:05.721">și</span> <span begin="1:05.721" end="1:06.436">bani</span> <span begin="1:06.436" end="1:06.973">în</span> <span begin="1:06.973" end="1:07.866">plăceri,</span></p><p begin="1:07.866" end="1:13.587" ttm:agent="v1"><span begin="1:07.866" end="1:09.296">Împlinind</span> <span begin="1:09.296" end="1:10.012">vis</span> <span begin="1:10.012" end="1:10.727">lumesc,</span> <span begin="1:10.727" end="1:13.587">mincinos,</span></p><p begin="1:13.587" end="1:19.307" ttm:agent="v1"><span begin="1:13.587" end="1:14.123">Vă</span> <span begin="1:14.123" end="1:15.017">sculați</span> <span begin="1:15.017" end="1:15.553">chiar</span> <span begin="1:15.553" end="1:16.447">acum</span> <span begin="1:16.447" end="1:16.983">să</span> <span begin="1:16.983" end="1:17.877">plecați</span> <span begin="1:17.877" end="1:18.592">peste</span> <span begin="1:18.592" end="1:19.307">zări</span></p><p begin="1:19.307" end="1:24.134" ttm:agent="v1"><span begin="1:19.307" end="1:19.843">Și</span> <span begin="1:19.843" end="1:20.737">slujind,</span> <span begin="1:20.737" end="1:21.273">să</span> <span begin="1:21.273" end="1:22.167">urmați</span> <span begin="1:22.167" end="1:22.703">lui</span> <span begin="1:22.703" end="1:24.134">Hristos!</span></p></div></body></tt>