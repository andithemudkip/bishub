<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>472. Trâmbiți răsună</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:53.215"><div><p begin="0:00.720" end="0:06.403" ttm:agent="v1"><span begin="0:00.720" end="0:01.667">Trâmbiți</span> <span begin="0:01.667" end="0:03.088">răsună</span> <span begin="0:03.088" end="0:03.562">prin</span> <span begin="0:03.562" end="0:04.982">negura</span> <span begin="0:04.982" end="0:06.403">vremii,</span></p><p begin="0:06.403" end="0:12.086" ttm:agent="v1"><span begin="0:06.403" end="0:07.350">Strigă</span> <span begin="0:07.350" end="0:08.771">profeții-n</span> <span begin="0:08.771" end="0:12.086">Sion.</span></p><p begin="0:12.086" end="0:17.770" ttm:agent="v1"><span begin="0:12.086" end="0:13.034">Cerul</span> <span begin="0:13.034" end="0:14.454">așteaptă</span> <span begin="0:14.454" end="0:14.928">de</span> <span begin="0:14.928" end="0:15.875">șase</span> <span begin="0:15.875" end="0:17.770">milenii</span></p><p begin="0:17.770" end="0:25.273" ttm:agent="v1"><span begin="0:17.770" end="0:18.243">Să</span> <span begin="0:18.243" end="0:20.611">mântuiască-orice</span> <span begin="0:20.611" end="0:25.273">om.</span></p><p begin="0:25.273" end="0:30.729" ttm:agent="v1"><span begin="0:25.273" end="0:25.727">Voi</span> <span begin="0:25.727" end="0:26.182">ce</span> <span begin="0:26.182" end="0:27.091">simțiți,</span> <span begin="0:27.091" end="0:27.546">că</span> <span begin="0:27.546" end="0:28.910">durerea</span> <span begin="0:28.910" end="0:30.729">vă-nvinge,</span></p><p begin="0:30.729" end="0:36.185" ttm:agent="v1"><span begin="0:30.729" end="0:31.183">Și</span> <span begin="0:31.183" end="0:31.638">nu</span> <span begin="0:31.638" end="0:32.093">sunt</span> <span begin="0:32.093" end="0:32.547">căi</span> <span begin="0:32.547" end="0:33.002">de</span> <span begin="0:33.002" end="0:36.185">scăpat,</span></p><p begin="0:36.185" end="0:41.640" ttm:agent="v1"><span begin="0:36.185" end="0:37.094">Iată,</span> <span begin="0:37.094" end="0:37.549">pe</span> <span begin="0:37.549" end="0:38.458">cruce,</span> <span begin="0:38.458" end="0:39.367">Isus</span> <span begin="0:39.367" end="0:39.822">cum</span> <span begin="0:39.822" end="0:40.276">Se</span> <span begin="0:40.276" end="0:41.640">frânge</span></p><p begin="0:41.640" end="0:49.856" ttm:agent="v1"><span begin="0:41.640" end="0:42.550">Pentru</span> <span begin="0:42.550" end="0:43.004">al</span> <span begin="0:43.004" end="0:43.914">vostru</span> <span begin="0:43.914" end="0:49.856">păcat!</span></p><p begin="0:49.856" end="0:55.421" ttm:agent="v1"><span begin="0:49.856" end="0:50.320">Azi</span> <span begin="0:50.320" end="0:51.711">Dumnezeu</span> <span begin="0:51.711" end="0:52.175">mai</span> <span begin="0:52.175" end="0:53.566">împarte</span> <span begin="0:53.566" end="0:55.421">iertare,</span></p><p begin="0:55.421" end="1:00.986" ttm:agent="v1"><span begin="0:55.421" end="0:56.349">Încă</span> <span begin="0:56.349" end="0:57.276">avem</span> <span begin="0:57.276" end="1:00.986">Salvator.</span></p><p begin="1:00.986" end="1:06.551" ttm:agent="v1"><span begin="1:00.986" end="1:01.914">Încă</span> <span begin="1:01.914" end="1:02.378">o</span> <span begin="1:02.378" end="1:03.305">clipă</span> <span begin="1:03.305" end="1:03.769">de</span> <span begin="1:03.769" end="1:06.551">sfântă-ndurare,</span></p><p begin="1:06.551" end="1:13.736" ttm:agent="v1"><span begin="1:06.551" end="1:07.479">Cerul</span> <span begin="1:07.479" end="1:07.943">azi</span> <span begin="1:07.943" end="1:08.406">e-al</span> <span begin="1:08.406" end="1:13.736">tuturor.</span></p><p begin="1:13.736" end="1:19.385" ttm:agent="v1"><span begin="1:13.736" end="1:14.678">Doamne,</span> <span begin="1:14.678" end="1:16.090">ajută</span> <span begin="1:16.090" end="1:16.560">a</span> <span begin="1:16.560" end="1:17.031">mea</span> <span begin="1:17.031" end="1:19.385">pregătire,</span></p><p begin="1:19.385" end="1:25.033" ttm:agent="v1"><span begin="1:19.385" end="1:19.855">Cât</span> <span begin="1:19.855" end="1:20.797">încă</span> <span begin="1:20.797" end="1:21.268">nu-i</span> <span begin="1:21.268" end="1:21.738">prea</span> <span begin="1:21.738" end="1:25.033">târziu,</span></p><p begin="1:25.033" end="1:30.682" ttm:agent="v1"><span begin="1:25.033" end="1:25.504">Vreau</span> <span begin="1:25.504" end="1:25.975">ca,</span> <span begin="1:25.975" end="1:26.916">apoi,</span> <span begin="1:26.916" end="1:28.328">îmbrăcat</span> <span begin="1:28.328" end="1:28.799">în</span> <span begin="1:28.799" end="1:30.682">mărire,</span></p><p begin="1:30.682" end="1:34.447" ttm:agent="v1"><span begin="1:30.682" end="1:31.623">Veșnic</span> <span begin="1:31.623" end="1:32.094">cu</span> <span begin="1:32.094" end="1:33.035">Tine</span> <span begin="1:33.035" end="1:33.506">să</span> <span begin="1:33.506" end="1:34.447">fiu!</span></p></div></body></tt>