<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>523. Sfârșitul veacului trăim!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:31.484"><div><p begin="0:24.610" end="0:35.526" ttm:agent="v1"><span begin="0:24.610" end="0:28.704">Sfârșitul</span> <span begin="0:28.704" end="0:31.092">veacului</span> <span begin="0:31.092" end="0:35.526">trăim:</span></p><p begin="0:35.526" end="0:46.443" ttm:agent="v1"><span begin="0:35.526" end="0:36.891">Un</span> <span begin="0:36.891" end="0:38.938">veac</span> <span begin="0:38.938" end="0:39.620">de</span> <span begin="0:39.620" end="0:40.984">ură</span> <span begin="0:40.984" end="0:42.008">și</span> <span begin="0:42.008" end="0:46.443">război,</span></p><p begin="0:46.443" end="0:57.359" ttm:agent="v1"><span begin="0:46.443" end="0:47.807">Dar,</span> <span begin="0:47.807" end="0:51.166">fericiți,</span> <span begin="0:51.166" end="0:51.586">la</span> <span begin="0:51.586" end="0:52.845">cer</span> <span begin="0:52.845" end="0:57.359">privim!</span></p><p begin="0:57.359" end="1:19.856" ttm:agent="v1"><span begin="0:57.359" end="0:58.041">Nu</span> <span begin="0:58.041" end="0:58.723">e</span> <span begin="0:58.723" end="0:59.406">mult</span> <span begin="0:59.406" end="1:00.088">și</span> <span begin="1:00.088" end="1:01.452">vine</span> <span begin="1:01.452" end="1:02.817">Domnul</span> <span begin="1:02.817" end="1:03.840">iar</span> <span begin="1:03.840" end="1:04.181">la</span> <span begin="1:04.181" end="1:19.856">noi!</span></p><p begin="1:19.856" end="1:30.881" ttm:agent="v1"><span begin="1:19.856" end="1:21.234">Ce</span> <span begin="1:21.234" end="1:23.301">zi</span> <span begin="1:23.301" end="1:25.369">măreață,</span> <span begin="1:25.369" end="1:26.402">ce</span> <span begin="1:26.402" end="1:30.881">splendori,</span></p><p begin="1:30.881" end="1:41.907" ttm:agent="v1"><span begin="1:30.881" end="1:32.259">Când</span> <span begin="1:32.259" end="1:35.705">trâmbița</span> <span begin="1:35.705" end="1:36.394">va</span> <span begin="1:36.394" end="1:41.907">răsuna</span></p><p begin="1:41.907" end="1:52.932" ttm:agent="v1"><span begin="1:41.907" end="1:43.285">Și</span> <span begin="1:43.285" end="1:45.405">Domnul</span> <span begin="1:45.405" end="1:46.677">va</span> <span begin="1:46.677" end="1:48.374">veni</span> <span begin="1:48.374" end="1:48.798">pe</span> <span begin="1:48.798" end="1:52.932">nori!</span></p><p begin="1:52.932" end="2:02.235" ttm:agent="v1"><span begin="1:52.932" end="1:54.999">Fericiți</span> <span begin="1:54.999" end="1:55.689">și</span> <span begin="1:55.689" end="1:56.378">plini</span> <span begin="1:56.378" end="1:57.067">de</span> <span begin="1:57.067" end="1:58.445">slavă-I</span> <span begin="1:58.445" end="1:59.479">vom</span> <span begin="1:59.479" end="2:02.235">cânta!</span></p></div></body></tt>