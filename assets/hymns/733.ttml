<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>733. Azi, cântarea bucuriei</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:22.393"><div><p begin="0:11.440" end="0:16.628" ttm:agent="v1"><span begin="0:11.440" end="0:11.926">Azi,</span> <span begin="0:11.926" end="0:13.386">cântarea</span> <span begin="0:13.386" end="0:16.628">bucuriei,</span></p><p begin="0:16.628" end="0:21.817" ttm:agent="v1"><span begin="0:16.628" end="0:17.277">Cântul</span> <span begin="0:17.277" end="0:19.222">laudei</span> <span begin="0:19.222" end="0:21.817">‘nălțați,</span></p><p begin="0:21.817" end="0:27.005" ttm:agent="v1"><span begin="0:21.817" end="0:22.465">Orice</span> <span begin="0:22.465" end="0:23.114">gând</span> <span begin="0:23.114" end="0:23.762">de</span> <span begin="0:23.762" end="0:27.005">întristare</span></p><p begin="0:27.005" end="0:32.193" ttm:agent="v1"><span begin="0:27.005" end="0:27.491">Și</span> <span begin="0:27.491" end="0:28.950">povara,</span> <span begin="0:28.950" end="0:32.193">alungați!</span></p><p begin="0:32.193" end="0:37.381" ttm:agent="v1"><span begin="0:32.193" end="0:32.679">Să-I</span> <span begin="0:32.679" end="0:33.490">cântați</span> <span begin="0:33.490" end="0:34.139">cu</span> <span begin="0:34.139" end="0:34.787">mic,</span> <span begin="0:34.787" end="0:35.436">cu</span> <span begin="0:35.436" end="0:37.381">mare,</span></p><p begin="0:37.381" end="0:42.570" ttm:agent="v1"><span begin="0:37.381" end="0:38.030">Celui</span> <span begin="0:38.030" end="0:39.327">veșnic</span> <span begin="0:39.327" end="0:42.570">adorat,</span></p><p begin="0:42.570" end="0:47.758" ttm:agent="v1"><span begin="0:42.570" end="0:43.056">Că,</span> <span begin="0:43.056" end="0:43.218">prin</span> <span begin="0:43.218" end="0:44.515">marea</span> <span begin="0:44.515" end="0:47.758">Sa-ndurare,</span></p><p begin="0:47.758" end="0:54.286" ttm:agent="v1"><span begin="0:47.758" end="0:48.406">Ne-a</span> <span begin="0:48.406" end="0:49.055">condus</span> <span begin="0:49.055" end="0:54.286">neîncetat!</span></p><p begin="0:54.286" end="0:59.474" ttm:agent="v1"><span begin="0:54.286" end="0:54.935">Prin</span> <span begin="0:54.935" end="0:55.583">cântări</span> <span begin="0:55.583" end="0:56.232">de</span> <span begin="0:56.232" end="0:59.474">bucurie</span></p><p begin="0:59.474" end="1:04.663" ttm:agent="v1"><span begin="0:59.474" end="1:00.771">Viața</span> <span begin="1:00.771" end="1:04.663">noastră-mpodobim;</span></p><p begin="1:04.663" end="1:09.851" ttm:agent="v1"><span begin="1:04.663" end="1:06.608">Aducându-I</span> <span begin="1:06.608" end="1:09.851">preamărire,</span></p><p begin="1:09.851" end="1:15.039" ttm:agent="v1"><span begin="1:09.851" end="1:10.337">Lui</span> <span begin="1:10.337" end="1:11.148">Isus</span> <span begin="1:11.148" end="1:11.797">Îi</span> <span begin="1:11.797" end="1:15.039">mulțumim!</span></p><p begin="1:15.039" end="1:20.227" ttm:agent="v1"><span begin="1:15.039" end="1:16.985">Mântuirea</span> <span begin="1:16.985" end="1:20.227">minunată,</span></p><p begin="1:20.227" end="1:25.416" ttm:agent="v1"><span begin="1:20.227" end="1:22.173">Providența-I</span> <span begin="1:22.173" end="1:25.416">admirăm,</span></p><p begin="1:25.416" end="1:30.604" ttm:agent="v1"><span begin="1:25.416" end="1:26.064">Clipe</span> <span begin="1:26.064" end="1:30.604">binecuvântate,</span></p><p begin="1:30.604" end="1:32.072" ttm:agent="v1"><span begin="1:30.604" end="1:31.090">Vechi</span> <span begin="1:31.090" end="1:32.550">istorii</span> <span begin="1:32.550" end="1:32.072">evocăm!</span></p><p begin="1:32.072" end="1:37.235" ttm:agent="v1"><span begin="1:32.072" end="1:33.363">Mulțumiri,</span> <span begin="1:33.363" end="1:34.653">ceresc</span> <span begin="1:34.653" end="1:37.235">Părinte,</span></p><p begin="1:37.235" end="1:42.397" ttm:agent="v1"><span begin="1:37.235" end="1:37.719">Îți</span> <span begin="1:37.719" end="1:38.525">aduc</span> <span begin="1:38.525" end="1:39.170">ai</span> <span begin="1:39.170" end="1:39.816">Tăi</span> <span begin="1:39.816" end="1:42.397">copii</span></p><p begin="1:42.397" end="1:47.559" ttm:agent="v1"><span begin="1:42.397" end="1:43.042">Pentru</span> <span begin="1:43.042" end="1:44.333">timpul</span> <span begin="1:44.333" end="1:47.559">de-ndurare</span></p><p begin="1:47.559" end="1:52.722" ttm:agent="v1"><span begin="1:47.559" end="1:48.043">Ce-a</span> <span begin="1:48.043" end="1:48.850">trecut</span> <span begin="1:48.850" end="1:49.495">în</span> <span begin="1:49.495" end="1:52.722">veșnicii!</span></p><p begin="1:52.722" end="1:57.884" ttm:agent="v1"><span begin="1:52.722" end="1:54.012">Mulțumiri,</span> <span begin="1:54.012" end="1:57.884">recunoștință,</span></p><p begin="1:57.884" end="2:03.046" ttm:agent="v1"><span begin="1:57.884" end="1:58.529">Ție,</span> <span begin="1:58.529" end="1:59.174">scump</span> <span begin="1:59.174" end="2:03.046">Mântuitor,</span></p><p begin="2:03.046" end="2:08.209" ttm:agent="v1"><span begin="2:03.046" end="2:04.337">Pentru</span> <span begin="2:04.337" end="2:05.627">dragostea-Ți</span> <span begin="2:05.627" end="2:08.209">fierbinte,</span></p><p begin="2:08.209" end="2:11.435" ttm:agent="v1"><span begin="2:08.209" end="2:08.854">Pentru</span> <span begin="2:08.854" end="2:10.144">harul</span> <span begin="2:10.144" end="2:11.435">salvator!</span></p></div></body></tt>