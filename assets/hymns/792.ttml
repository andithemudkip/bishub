<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>792. De multe ori, pustie</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:13.747"><div><p begin="0:35.470" end="0:44.974" ttm:agent="v1"><span begin="0:35.470" end="0:36.658">Căci</span> <span begin="0:36.658" end="0:39.034">Domnul</span> <span begin="0:39.034" end="0:40.222">Își</span> <span begin="0:40.222" end="0:44.974">rezervă</span></p><p begin="0:44.974" end="0:54.478" ttm:agent="v1"><span begin="0:44.974" end="0:48.538">Momentul</span> <span begin="0:48.538" end="0:49.726">Său</span> <span begin="0:49.726" end="0:50.914">când</span> <span begin="0:50.914" end="0:54.478">vrea:</span></p><p begin="0:54.478" end="1:03.982" ttm:agent="v1"><span begin="0:54.478" end="0:55.666">Te</span> <span begin="0:55.666" end="1:03.982">binecuvântează</span></p><p begin="1:03.982" end="1:13.486" ttm:agent="v1"><span begin="1:03.982" end="1:05.170">Prin</span> <span begin="1:05.170" end="1:06.358">ce</span> <span begin="1:06.358" end="1:07.546">n-ai</span> <span begin="1:07.546" end="1:13.486">aștepta.</span></p><p begin="1:13.486" end="1:22.990" ttm:agent="v1"><span begin="1:13.486" end="1:14.674">În</span> <span begin="1:14.674" end="1:17.050">valuri</span> <span begin="1:17.050" end="1:19.426">varsă</span> <span begin="1:19.426" end="1:22.990">harul</span></p><p begin="1:22.990" end="1:32.494" ttm:agent="v1"><span begin="1:22.990" end="1:24.178">În</span> <span begin="1:24.178" end="1:26.554">pieptu-ți</span> <span begin="1:26.554" end="1:27.742">plin</span> <span begin="1:27.742" end="1:32.494">de-oftat:</span></p><p begin="1:32.494" end="1:41.998" ttm:agent="v1"><span begin="1:32.494" end="1:34.870">Amar</span> <span begin="1:34.870" end="1:36.058">o</span> <span begin="1:36.058" end="1:37.246">fi</span> <span begin="1:37.246" end="1:41.998">paharul,</span></p><p begin="1:41.998" end="1:45.562" ttm:agent="v1"><span begin="1:41.998" end="1:43.186">Dar</span> <span begin="1:43.186" end="1:45.562">binecuvântat!</span></p></div></body></tt>