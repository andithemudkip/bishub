<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>585. Frumos e-al păcii sfânt sălaș!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:29.051"><div><p begin="0:10.104" end="0:15.617" ttm:agent="v1"><span begin="0:10.104" end="0:11.482">Frumos</span> <span begin="0:11.482" end="0:12.171">e-al</span> <span begin="0:12.171" end="0:13.549">păcii</span> <span begin="0:13.549" end="0:14.238">sfânt</span> <span begin="0:14.238" end="0:15.617">sălaș,</span></p><p begin="0:15.617" end="0:21.129" ttm:agent="v1"><span begin="0:15.617" end="0:16.306">În</span> <span begin="0:16.306" end="0:18.373">liniște</span> <span begin="0:18.373" end="0:21.129">deplină!</span></p><p begin="0:21.129" end="0:26.642" ttm:agent="v1"><span begin="0:21.129" end="0:21.818">Din</span> <span begin="0:21.818" end="0:22.507">cer</span> <span begin="0:22.507" end="0:24.575">coboară</span> <span begin="0:24.575" end="0:26.642">armonii</span></p><p begin="0:26.642" end="0:37.935" ttm:agent="v1"><span begin="0:26.642" end="0:27.331">Și</span> <span begin="0:27.331" end="0:28.709">raze</span> <span begin="0:28.709" end="0:29.398">de</span> <span begin="0:29.398" end="0:37.935">lumină!</span></p><p begin="0:37.935" end="0:43.447" ttm:agent="v1"><span begin="0:37.935" end="0:39.313">Așa</span> <span begin="0:39.313" end="0:40.002">va</span> <span begin="0:40.002" end="0:40.691">fi</span> <span begin="0:40.691" end="0:41.380">și</span> <span begin="0:41.380" end="0:42.069">mai</span> <span begin="0:42.069" end="0:43.447">frumos,</span></p><p begin="0:43.447" end="0:48.960" ttm:agent="v1"><span begin="0:43.447" end="0:45.515">Cuvinte</span> <span begin="0:45.515" end="0:46.204">n-am</span> <span begin="0:46.204" end="0:46.893">a</