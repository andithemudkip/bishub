<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>164. La Domnul e pace</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:49.923"><div><p begin="0:11.090" end="0:14.943" ttm:agent="v1"><span begin="0:11.090" end="0:11.732">La</span> <span begin="0:11.732" end="0:13.016">Domnul</span> <span begin="0:13.016" end="0:13.659">e</span> <span begin="0:13.659" end="0:14.943">pace,</span></p><p begin="0:14.943" end="0:18.796" ttm:agent="v1"><span begin="0:14.943" end="0:15.585">E</span> <span begin="0:15.585" end="0:16.227">har</span> <span begin="0:16.227" end="0:16.869">din</span> <span begin="0:16.869" end="0:18.796">belșug,</span></p><p begin="0:18.796" end="0:22.648" ttm:agent="v1"><span begin="0:18.796" end="0:20.722">Furtuna</span> <span begin="0:20.722" end="0:21.364">grea</span> <span begin="0:21.364" end="0:22.648">tace</span></p><p begin="0:22.648" end="0:26.501" ttm:agent="v1"><span begin="0:22.648" end="0:23.291">Și</span> <span begin="0:23.291" end="0:25.217">umbrele</span> <span begin="0:25.217" end="0:26.501">fug.</span></p><p begin="0:26.501" end="0:30.354" ttm:agent="v1"><span begin="0:26.501" end="0:27.143">La</span> <span begin="0:27.143" end="0:28.428">Tine,</span> <span begin="0:28.428" end="0:30.354">Părinte,</span></p><p begin="0:30.354" end="0:34.207" ttm:agent="v1"><span begin="0:30.354" end="0:31.638">Găsesc</span> <span begin="0:31.638" end="0:32.280">iar</span> <span begin="0:32.280" end="0:34.207">puteri,</span></p><p begin="0:34.207" end="0:38.060" ttm:agent="v1"><span begin="0:34.207" end="0:34.849">Din</span> <span begin="0:34.849" end="0:36.775">mâinile-Ți</span> <span begin="0:36.775" end="0:38.060">sfinte</span></p><p begin="0:38.060" end="0:42.052" ttm:agent="v1"><span begin="0:38.060" end="0:39.344">Primesc</span> <span begin="0:39.344" end="0:42.052">mângâieri...</span></p><p begin="0:42.052" end="0:46.143" ttm:agent="v1"><span begin="0:42.052" end="0:42.682">La</span> <span begin="0:42.682" end="0:43.940">Tine-i</span> <span begin="0:43.940" end="0:46.143">scăpare</span></p><p begin="0:46.143" end="0:49.604" ttm:agent="v1"><span begin="0:46.143" end="0:46.457">Când</span> <span begin="0:46.457" end="0:47.087">sunt</span> <span begin="0:47.087" end="0:49.604">apăsat,</span></p><p begin="0:49.604" end="0:53.380" ttm:agent="v1"><span begin="0:49.604" end="0:50.233">Tu-mi</span> <span begin="0:50.233" end="0:50.862">dai</span> <span begin="0:50.862" end="0:53.380">vindecare</span></p><p begin="0:53.380" end="0:57.155" ttm:agent="v1"><span begin="0:53.380" end="0:54.009">Din</span> <span begin="0:54.009" end="0:55.268">greul</span> <span begin="0:55.268" end="0:57.155">păcat!</span></p><p begin="0:57.155" end="1:00.931" ttm:agent="v1"><span begin="0:57.155" end="0:57.785">La</span> <span begin="0:57.785" end="0:59.043">Tine-i</span> <span begin="0:59.043" end="1:00.931">lumină</span></p><p begin="1:00.931" end="1:04.707" ttm:agent="v1"><span begin="1:00.931" end="1:01.560">Când</span> <span begin="1:01.560" end="1:02.819">noaptea</span> <span begin="1:02.819" end="1:03.448">e</span> <span begin="1:03.448" end="1:04.707">grea</span></p><p begin="1:04.707" end="1:08.483" ttm:agent="v1"><span begin="1:04.707" end="1:05.336">Și</span> <span begin="1:05.336" end="1:06.595">mâna-Ți</span> <span begin="1:06.595" end="1:08.483">divină</span></p><p begin="1:08.483" end="1:14.118" ttm:agent="v1"><span begin="1:08.483" end="1:09.112">Mă</span> <span begin="1:09.112" end="1:10.370">poate</span> <span begin="1:10.370" end="1:14.118">salva!</span></p><p begin="1:14.118" end="1:18.168" ttm:agent="v1"><span begin="1:14.118" end="1:14.741">La</span> <span begin="1:14.741" end="1:15.987">Tine</span> <span begin="1:15.987" end="1:16.610">e</span> <span begin="1:16.610" end="1:18.168">viața,</span></p><p begin="1:18.168" end="1:21.594" ttm:agent="v1"><span begin="1:18.168" end="1:18.479">Când</span> <span begin="1:18.479" end="1:19.725">pasu-i</span> <span begin="1:19.725" end="1:21.594">trudit;</span></p><p begin="1:21.594" end="1:25.332" ttm:agent="v1"><span begin="1:21.594" end="1:22.217">Doar</span> <span begin="1:22.217" end="1:22.840">Tu</span> <span begin="1:22.840" end="1:24.086">spulberi</span> <span begin="1:24.086" end="1:25.332">ceața,</span></p><p begin="1:25.332" end="1:29.070" ttm:agent="v1"><span begin="1:25.332" end="1:25.955">De-i</span> <span begin="1:25.955" end="1:27.201">cerul</span> <span begin="1:27.201" end="1:29.070">umbrit...</span></p><p begin="1:29.070" end="1:32.808" ttm:agent="v1"><span begin="1:29.070" end="1:29.693">Cu</span> <span begin="1:29.693" end="1:30.939">Tine,</span> <span begin="1:30.939" end="1:31.562">o,</span> <span begin="1:31.562" end="1:32.808">Tată,</span></p><p begin="1:32.808" end="1:36.546" ttm:agent="v1"><span begin="1:32.808" end="1:33.431">În</span> <span begin="1:33.431" end="1:34.677">slavă</span> <span begin="1:34.677" end="1:35.300">voi</span> <span begin="1:35.300" end="1:36.546">sta,</span></p><p begin="1:36.546" end="1:40.284" ttm:agent="v1"><span begin="1:36.546" end="1:37.169">În</span> <span begin="1:37.169" end="1:38.415">țara</span> <span begin="1:38.415" end="1:40.284">visată,</span></p><p begin="1:40.284" end="1:42.776" ttm:agent="v1"><span begin="1:40.284" end="1:41.530">Cântând:</span> <span begin="1:41.530" end="1:42.776">„Osana!”</span></p></div></body></tt>