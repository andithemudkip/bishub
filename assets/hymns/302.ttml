<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>302. Voi, creștini, sculați!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:32.451"><div><p begin="0:16.220" end="0:21.787" ttm:agent="v1"><span begin="0:16.220" end="0:17.612">Voi,</span> <span begin="0:17.612" end="0:20.047">creștini,</span> <span begin="0:20.047" end="0:21.787">sculați,</span></p><p begin="0:21.787" end="0:27.354" ttm:agent="v1"><span begin="0:21.787" end="0:24.570">Steagul</span> <span begin="0:24.570" end="0:27.354">ridicați,</span></p><p begin="0:27.354" end="0:32.921" ttm:agent="v1"><span begin="0:27.354" end="0:30.137">Gata</span> <span begin="0:30.137" end="0:31.181">să</span> <span begin="0:31.181" end="0:32.921">luptați</span></p><p begin="0:32.921" end="0:38.488" ttm:agent="v1"><span begin="0:32.921" end="0:35.704">Pentru</span> <span begin="0:35.704" end="0:38.488">El!</span></p><p begin="0:38.488" end="0:44.055" ttm:agent="v1"><span begin="0:38.488" end="0:41.271">Faceți</span> <span begin="0:41.271" end="0:42.663">din</span> <span begin="0:42.663" end="0:44.055">Cuvânt</span></p><p begin="0:44.055" end="0:49.622" ttm:agent="v1"><span begin="0:44.055" end="0:45.446">Și</span> <span begin="0:45.446" end="0:46.838">din</span> <span begin="0:46.838" end="0:48.230">Spirit</span> <span begin="0:48.230" end="0:49.622">Sfânt</span></p><p begin="0:49.622" end="1:07.746" ttm:agent="v1"><span begin="0:49.622" end="0:53.797">Strălucite</span> <span begin="0:53.797" end="0:55.189">săbii</span> <span begin="0:55.189" end="0:56.580">de</span> <span begin="0:56.580" end="1:07.746">oțel!</span></p><p begin="1:07.746" end="1:13.285" ttm:agent="v1"><span begin="1:07.746" end="1:09.131">Doar</span> <span begin="1:09.131" end="1:10.515">în</span> <span begin="1:10.515" end="1:13.285">Dumnezeu</span></p><p begin="1:13.285" end="1:18.824" ttm:agent="v1"><span begin="1:13.285" end="1:14.670">Mă</span> <span begin="1:14.670" end="1:17.093">încred</span> <span begin="1:17.093" end="1:17.439">și</span> <span begin="1:17.439" end="1:18.824">eu</span></p><p begin="1:18.824" end="1:24.363" ttm:agent="v1"><span begin="1:18.824" end="1:20.209">Și</span> <span begin="1:20.209" end="1:22.632">primesc</span> <span begin="1:22.632" end="1:24.363">mereu</span></p><p begin="1:24.363" end="1:29.902" ttm:agent="v1"><span begin="1:24.363" end="1:29.902">Ajutor!</span></p><p begin="1:29.902" end="1:36.826" ttm:agent="v1"><span begin="1:29.902" end="1:32.672">Printre</span> <span begin="1:32.672" end="1:36.826">luptători,</span></p><p begin="1:36.826" end="1:40.980" ttm:agent="v1"><span begin="1:36.826" end="1:40.980">Printre-nvingători</span></p><p begin="1:40.980" end="1:50.674" ttm:agent="v1"><span begin="1:40.980" end="1:42.365">Vreau</span> <span begin="1:42.365" end="1:43.750">să</span> <span begin="1:43.750" end="1:44.789">cânt</span> <span begin="1:44.789" end="1:45.135">cu-al</span> <span begin="1:45.135" end="1:47.904">Domnului</span> <span begin="1:47.904" end="1:50.674">popor!</span></p></div></body></tt>