<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>80. O, Isus, ce dulce Nume</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="3:15.683"><div><p begin="0:25.240" end="0:35.467" ttm:agent="v1"><span begin="0:25.240" end="0:26.518">O,</span> <span begin="0:26.518" end="0:28.756">Isus,</span> <span begin="0:28.756" end="0:29.075">ce</span> <span begin="0:29.075" end="0:30.354">dulce</span> <span begin="0:30.354" end="0:35.467">Nume,</span></p><p begin="0:35.467" end="0:45.694" ttm:agent="v1"><span begin="0:35.467" end="0:38.983">Liniștind</span> <span begin="0:38.983" end="0:40.261">orice</span> <span begin="0:40.261" end="0:45.694">dureri,</span></p><p begin="0:45.694" end="0:55.922" ttm:agent="v1"><span begin="0:45.694" end="0:46.973">Ne</span> <span begin="0:46.973" end="0:48.251">dă</span> <span begin="0:48.251" end="0:49.530">pace,</span> <span begin="0:49.530" end="0:55.922">bucurie,</span></p><p begin="0:55.922" end="1:07.470" ttm:agent="v1"><span begin="0:55.922" end="0:58.478">Celor</span> <span begin="0:58.478" end="0:59.437">slabi</span> <span begin="0:59.437" end="0:59.757">le</span> <span begin="0:59.757" end="1:00.716">dă</span> <span begin="1:00.716" end="1:07.470">puteri!</span></p><p begin="1:07.470" end="1:18.056" ttm:agent="v1"><span begin="1:07.470" end="1:08.794">Deci</span> <span begin="1:08.794" end="1:11.109">porniți</span> <span begin="1:11.109" end="1:12.432">cu-Isus</span> <span begin="1:12.432" end="1:18.056">‘nainte,</span></p><p begin="1:18.056" end="1:28.641" ttm:agent="v1"><span begin="1:18.056" end="1:19.379">Nu</span> <span begin="1:19.379" end="1:20.702">vă</span> <span begin="1:20.702" end="1:22.025">temeți</span> <span begin="1:22.025" end="1:23.017">de</span> <span begin="1:23.017" end="1:28.641">nimic!</span></p><p begin="1:28.641" end="1:39.226" ttm:agent="v1"><span begin="1:28.641" end="1:32.610">Birui-veți</span> <span begin="1:32.610" end="1:39.226">totdeauna,</span></p><p begin="1:39.226" end="1:44.728" ttm:agent="v1"><span begin="1:39.226" end="1:40.549">Cu</span> <span begin="1:40.549" end="1:41.872">El,</span> <span begin="1:41.872" end="1:43.195">orice</span> <span begin="1:43.195" end="1:44.728">inamic.</span></p><p begin="1:44.728" end="1:55.472" ttm:agent="v1"><span begin="1:44.728" end="1:46.071">O,</span> <span begin="1:46.071" end="1:48.421">Isus,</span> <span begin="1:48.421" end="1:49.764">cuvânt</span> <span begin="1:49.764" end="1:50.100">scump</span> <span begin="1:50.100" end="1:55.472">nouă,</span></p><p begin="1:55.472" end="2:06.216" ttm:agent="v1"><span begin="1:55.472" end="1:56.815">Cât</span> <span begin="1:56.815" end="1:58.158">ne</span> <span begin="1:58.158" end="1:59.165">faci</span> <span begin="1:59.165" end="1:59.501">de</span> <span begin="1:59.501" end="2:06.216">fericiți!</span></p><p begin="2:06.216" end="2:16.960" ttm:agent="v1"><span begin="2:06.216" end="2:08.902">Pacea</span> <span begin="2:08.902" end="2:09.909">Ta</span> <span begin="2:09.909" end="2:11.252">gustăm</span> <span begin="2:11.252" end="2:16.960">de-acuma</span></p><p begin="2:16.960" end="2:27.381" ttm:agent="v1"><span begin="2:16.960" end="2:18.303">Știind</span> <span begin="2:18.303" end="2:19.646">că</span> <span begin="2:19.646" end="2:20.989">suntem</span> <span begin="2:20.989" end="2:27.381">mântuiți.</span></p><p begin="2:27.381" end="2:38.125" ttm:agent="v1"><span begin="2:27.381" end="2:28.724">Deci</span> <span begin="2:28.724" end="2:31.074">cântați</span> <span begin="2:31.074" end="2:32.417">lui-Isus</span> <span begin="2:32.417" end="2:38.125">întruna,</span></p><p begin="2:38.125" end="2:48.868" ttm:agent="v1"><span begin="2:38.125" end="2:39.468">Dați</span> <span begin="2:39.468" end="2:40.811">de</span> <span begin="2:40.811" end="2:42.153">veste</span> <span begin="2:42.153" end="2:48.868">orișicui</span></p><p begin="2:48.868" end="2:59.612" ttm:agent="v1"><span begin="2:48.868" end="2:52.897">Bucuria</span> <span begin="2:52.897" end="2:53.905">că</span> <span begin="2:53.905" end="2:54.240">El</span> <span begin="2:54.240" end="2:59.612">vine,</span></p><p begin="2:59.612" end="3:07.670" ttm:agent="v1"><span begin="2:59.612" end="3:00.955">Ca</span> <span begin="3:00.955" end="3:02.298">să-Și</span> <span begin="3:02.298" end="3:03.306">ia</span> <span begin="3:03.306" end="3:03.641">cu</span> <span begin="3:03.641" end="3:04.649">El</span> <span begin="3:04.649" end="3:04.984">pe-ai</span> <span begin="3:04.984" end="3:07.670">Lui.</span></p></div></body></tt>