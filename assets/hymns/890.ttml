<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>890. Doamne sfinte și-ndurate!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:30.540"><div><p begin="0:12.697" end="0:18.611" ttm:agent="v1"><span begin="0:12.697" end="0:14.176">Doamne</span> <span begin="0:14.176" end="0:15.654">sfinte</span> <span begin="0:15.654" end="0:18.611">și-ndurate,</span></p><p begin="0:18.611" end="0:24.524" ttm:agent="v1"><span begin="0:18.611" end="0:20.828">Umiliți</span> <span begin="0:20.828" end="0:21.568">noi</span> <span begin="0:21.568" end="0:22.307">Te</span> <span begin="0:22.307" end="0:24.524">rugăm</span></p><p begin="0:24.524" end="0:30.438" ttm:agent="v1"><span begin="0:24.524" end="0:25.264">Să</span> <span begin="0:25.264" end="0:26.003">ne</span> <span begin="0:26.003" end="0:26.742">ierți</span> <span begin="0:26.742" end="0:28.220">de-orice</span> <span begin="0:28.220" end="0:30.438">păcate,</span></p><p begin="0:30.438" end="0:37.012" ttm:agent="v1"><span begin="0:30.438" end="0:31.177">Când</span> <span begin="0:31.177" end="0:31.916">spre</span> <span begin="0:31.916" end="0:33.395">Tine</span> <span begin="0:33.395" end="0:37.012">ne-ndreptăm.</span></p><p begin="0:37.012" end="0:42.807" ttm:agent="v1"><span begin="0:37.012" end="0:38.460">Doamne,</span> <span begin="0:38.460" end="0:39.185">Tu</span> <span begin="0:39.185" end="0:39.909">ne</span> <span begin="0:39.909" end="0:40.634">ești</span> <span begin="0:40.634" end="0:42.807">Părinte,</span></p><p begin="0:42.807" end="0:48.602" ttm:agent="v1"><span begin="0:42.807" end="0:43.531">Ca</span> <span begin="0:43.531" end="0:45.705">Părinte</span> <span begin="0:45.705" end="0:46.429">să</span> <span begin="0:46.429" end="0:47.153">ne</span> <span begin="0:47.153" end="0:48.602">cerți;</span></p><p begin="0:48.602" end="0:54.398" ttm:agent="v1"><span begin="0:48.602" end="0:49.327">Dar</span> <span begin="0:49.327" end="0:50.051">când</span> <span begin="0:50.051" end="0:50.776">Te</span> <span begin="0:50.776" end="0:52.224">rugăm,</span> <span begin="0:52.224" end="0:54.398">Preasfinte,</span></p><p begin="0:54.398" end="0:56.333" ttm:agent="v1"><span begin="0:54.398" end="0:57.295">Cu-ndurare</span> <span begin="0:57.295" end="0:58.020">să</span> <span begin="0:58.020" end="0:58.744">ne</span> <span begin="0:58.744" end="0:56.333">ierți.</span></p><p begin="0:56.333" end="1:02.099" ttm:agent="v1"><span begin="0:56.333" end="0:57.775">Doamne,</span> <span begin="0:57.775" end="0:59.216">fă-ne</span> <span begin="0:59.216" end="0:59.937">blânzi</span> <span begin="0:59.937" end="1:02.099">întruna,</span></p><p begin="1:02.099" end="1:07.866" ttm:agent="v1"><span begin="1:02.099" end="1:02.820">Să</span> <span begin="1:02.820" end="1:03.541">fim</span> <span begin="1:03.541" end="1:05.703">iertători</span> <span begin="1:05.703" end="1:06.424">și</span> <span begin="1:06.424" end="1:07.866">buni,</span></p><p begin="1:07.866" end="1:13.632" ttm:agent="v1"><span begin="1:07.866" end="1:08.586">Ca</span> <span begin="1:08.586" end="1:09.307">să</span> <span begin="1:09.307" end="1:11.470">merităm</span> <span begin="1:11.470" end="1:13.632">cununa,</span></p><p begin="1:13.632" end="1:17.957" ttm:agent="v1"><span begin="1:13.632" end="1:14.353">Ce-ai</span> <span begin="1:14.353" end="1:16.515">promis-o</span> <span begin="1:16.515" end="1:17.236">din</span> <span begin="1:17.236" end="1:17.957">străbuni.</span></p></div></body></tt>