<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>261. Voința și îndeplinirea</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:28.454"><div><p begin="0:30.146" end="0:37.003" ttm:agent="v1"><span begin="0:30.146" end="0:32.053">Voința</span> <span begin="0:32.053" end="0:32.689">și</span> <span begin="0:32.689" end="0:37.003">îndeplinirea,</span></p><p begin="0:37.003" end="0:43.360" ttm:agent="v1"><span begin="0:37.003" end="0:38.910">Dă-mi-le,</span> <span begin="0:38.910" end="0:39.546">Tu,</span> <span begin="0:39.546" end="0:41.453">Părinte</span> <span begin="0:41.453" end="0:43.360">sfânt</span></p><p begin="0:43.360" end="0:51.218" ttm:agent="v1"><span begin="0:43.360" end="0:43.996">Și</span> <span begin="0:43.996" end="0:46.539">dirijează-mi</span> <span begin="0:46.539" end="0:48.175">Tu</span> <span begin="0:48.175" end="0:51.218">pornirea,</span></p><p begin="0:51.218" end="0:57.575" ttm:agent="v1"><span begin="0:51.218" end="0:51.853">Prin</span> <span begin="0:51.853" end="0:53.125">Duhul</span> <span begin="0:53.125" end="0:53.761">Tău</span> <span begin="0:53.761" end="0:54.396">și-al</span> <span begin="0:54.396" end="0:55.032">Tău</span> <span begin="0:55.032" end="0:57.575">Cuvânt,</span></p><p begin="0:57.575" end="1:04.432" ttm:agent="v1"><span begin="0:57.575" end="0:58.211">Ca-n</span> <span begin="0:58.211" end="0:59.982">toate</span> <span begin="0:59.982" end="1:00.618">să</span> <span begin="1:00.618" end="1:01.889">ajung</span> <span begin="1:01.889" end="1:02.525">să-Ți</span> <span begin="1:02.525" end="1:04.432">plac</span></p><p begin="1:04.432" end="1:08.263" ttm:agent="v1"><span begin="1:04.432" end="1:05.068">Și</span> <span begin="1:05.068" end="1:06.340">numai</span> <span begin="1:06.340" end="1:07.611">voia</span> <span begin="1:07.611" end="1:08.247">Ta</span> <span begin="1:08.247" end="1:08.883">s-o</span> <span begin="1:08.883" end="1:08.263">fac!</span></p><p begin="1:08.263" end="1:15.057" ttm:agent="v1"><span begin="1:08.263" end="1:10.152">Voința-mi</span> <span begin="1:10.152" end="1:10.781">stă</span> <span begin="1:10.781" end="1:12.040">mereu</span> <span begin="1:12.040" end="1:12.669">în</span> <span begin="1:12.669" end="1:15.057">cale</span></p><p begin="1:15.057" end="1:21.351" ttm:agent="v1"><span begin="1:15.057" end="1:15.687">Să</span> <span begin="1:15.687" end="1:16.316">nu</span> <span begin="1:16.316" end="1:16.945">fac</span> <span begin="1:16.945" end="1:17.575">ce</span> <span begin="1:17.575" end="1:18.204">mi-ai</span> <span begin="1:18.204" end="1:21.351">poruncit</span></p><p begin="1:21.351" end="1:29.145" ttm:agent="v1"><span begin="1:21.351" end="1:21.980">Și</span> <span begin="1:21.980" end="1:23.239">pofta</span> <span begin="1:23.239" end="1:29.145">cărnii-nșelătoare</span></p><p begin="1:29.145" end="1:35.438" ttm:agent="v1"><span begin="1:29.145" end="1:29.774">Mă</span> <span begin="1:29.774" end="1:31.662">duce-ades’</span> <span begin="1:31.662" end="1:32.292">pe-un</span> <span begin="1:32.292" end="1:32.921">drum</span> <span begin="1:32.921" end="1:35.438">greșit...</span></p><p begin="1:35.438" end="1:42.232" ttm:agent="v1"><span begin="1:35.438" end="1:36.068">Am</span> <span begin="1:36.068" end="1:38.456">meritat</span> <span begin="1:38.456" end="1:40.344">de-atâtea</span> <span begin="1:40.344" end="1:42.232">ori</span></p><p begin="1:42.232" end="1:46.024" ttm:agent="v1"><span begin="1:42.232" end="1:43.491">Blestem,</span> <span begin="1:43.491" end="1:44.120">nu</span> <span begin="1:44.120" end="1:46.024">binecuvântări.</span></p><p begin="1:46.024" end="1:53.195" ttm:agent="v1"><span begin="1:46.024" end="1:46.691">Eu</span> <span begin="1:46.691" end="1:47.358">știu</span> <span begin="1:47.358" end="1:48.025">că</span> <span begin="1:48.025" end="1:48.692">mă</span> <span begin="1:48.692" end="1:50.027">conduci</span> <span begin="1:50.027" end="1:50.694">mai</span> <span begin="1:50.694" end="1:53.195">bine</span></p><p begin="1:53.195" end="1:59.866" ttm:agent="v1"><span begin="1:53.195" end="1:54.529">Decât</span> <span begin="1:54.529" end="1:55.196">eu</span> <span begin="1:55.196" end="1:56.531">însumi</span> <span begin="1:56.531" end="1:57.198">aș</span> <span begin="1:57.198" end="1:59.866">putea,</span></p><p begin="1:59.866" end="2:08.038" ttm:agent="v1"><span begin="1:59.866" end="2:01.868">De-aceea</span> <span begin="2:01.868" end="2:02.535">mă</span> <span begin="2:02.535" end="2:05.536">încred</span> <span begin="2:05.536" end="2:08.038">Tine,</span></p><p begin="2:08.038" end="2:14.709" ttm:agent="v1"><span begin="2:08.038" end="2:08.705">Să</span> <span begin="2:08.705" end="2:10.706">stăpânești</span> <span begin="2:10.706" end="2:12.708">ființa</span> <span begin="2:12.708" end="2:14.709">mea;</span></p><p begin="2:14.709" end="2:21.881" ttm:agent="v1"><span begin="2:14.709" end="2:16.044">Așa</span> <span begin="2:16.044" end="2:17.211">vreau</span> <span begin="2:17.211" end="2:17.878">să-Ți</span> <span begin="2:17.878" end="2:19.212">urmez</span> <span begin="2:19.212" end="2:21.881">mereu,</span></p><p begin="2:21.881" end="2:27.885" ttm:agent="v1"><span begin="2:21.881" end="2:23.882">Ajută-mi</span> <span begin="2:23.882" end="2:24.549">Tu,</span> <span begin="2:24.549" end="2:26.551">Isuse-al</span> <span begin="2:26.551" end="2:27.885">meu!</span></p></div></body></tt>