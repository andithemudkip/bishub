<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>362. Tată, azi, Te rugăm</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:51.337"><div><p begin="0:33.717" end="0:45.029" ttm:agent="v1"><span begin="0:33.717" end="0:36.949">Tată,</span> <span begin="0:36.949" end="0:38.565">azi,</span> <span begin="0:38.565" end="0:39.373">Te</span> <span begin="0:39.373" end="0:45.029">rugăm,</span></p><p begin="0:45.029" end="0:57.957" ttm:agent="v1"><span begin="0:45.029" end="0:48.261">Inima</span> <span begin="0:48.261" end="0:51.493">dorim</span> <span begin="0:51.493" end="0:52.301">să-Ți</span> <span begin="0:52.301" end="0:57.957">predăm</span></p><p begin="0:57.957" end="1:10.885" ttm:agent="v1"><span begin="0:57.957" end="0:58.765">Pe</span> <span begin="0:58.765" end="1:01.997">altarul</span> <span begin="1:01.997" end="1:05.229">Golgotei</span> <span begin="1:05.229" end="1:10.885">spălați,</span></p><p begin="1:10.885" end="1:38.397" ttm:agent="v1"><span begin="1:10.885" end="1:11.693">În</span> <span begin="1:11.693" end="1:15.733">iubirea</span> <span begin="1:15.733" end="1:17.349">Ta</span> <span begin="1:17.349" end="1:38.397">curățați!</span></p><p begin="1:38.397" end="1:49.370" ttm:agent="v1"><span begin="1:38.397" end="1:41.532">Vină</span> <span begin="1:41.532" end="1:43.883">orice</span> <span begin="1:43.883" end="1:49.370">necaz,</span></p><p begin="1:49.370" end="2:01.910" ttm:agent="v1"><span begin="1:49.370" end="1:52.505">Dumnezeu</span> <span begin="1:52.505" end="1:54.072">ne</span> <span begin="1:54.072" end="1:57.207">apără</span> <span begin="1:57.207" end="2:01.910">azi!</span></p><p begin="2:01.910" end="2:14.450" ttm:agent="v1"><span begin="2:01.910" end="2:02.694">Prin</span> <span begin="2:02.694" end="2:05.829">credință,</span> <span begin="2:05.829" end="2:06.613">de</span> <span begin="2:06.613" end="2:08.180">El</span> <span begin="2:08.180" end="2:14.450">pregătiți,</span></p><p begin="2:14.450" end="2:23.855" ttm:agent="v1"><span begin="2:14.450" end="2:15.234">Vrem</span> <span begin="2:15.234" end="2:16.018">în</span> <span begin="2:16.018" end="2:17.585">cer</span> <span begin="2:17.585" end="2:19.153">să</span> <span begin="2:19.153" end="2:20.720">fim</span> <span begin="2:20.720" end="2:23.855">mântuiți!</span></p></div></body></tt>