<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>212. Isus îmi zice blând</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:19.024"><div><p begin="0:07.572" end="0:12.432" ttm:agent="v1"><span begin="0:07.572" end="0:09.597">Isus</span> <span begin="0:09.597" end="0:10.002">îmi</span> <span begin="0:10.002" end="0:10.812">zice</span> <span begin="0:10.812" end="0:12.432">blând:</span></p><p begin="0:12.432" end="0:17.697" ttm:agent="v1"><span begin="0:12.432" end="0:13.242">„Fiu</span> <span begin="0:13.242" end="0:14.457">scump,</span> <span begin="0:14.457" end="0:14.862">tu</span> <span begin="0:14.862" end="0:15.267">ești</span> <span begin="0:15.267" end="0:15.672">prea</span> <span begin="0:15.672" end="0:17.697">slab,</span></p><p begin="0:17.697" end="0:22.151" ttm:agent="v1"><span begin="0:17.697" end="0:18.101">Deci</span> <span begin="0:18.101" end="0:19.316">vin’</span> <span begin="0:19.316" end="0:19.721">la</span> <span begin="0:19.721" end="0:22.151">Mine-oricând,</span></p><p begin="0:22.151" end="0:27.900" ttm:agent="v1"><span begin="0:22.151" end="0:22.961">Eu</span> <span begin="0:22.961" end="0:24.176">îți</span> <span begin="0:24.176" end="0:24.986">ajut</span> <span begin="0:24.986" end="0:25.391">cu</span> <span begin="0:25.391" end="0:27.900">drag!”</span></p><p begin="0:27.900" end="0:32.813" ttm:agent="v1"><span begin="0:27.900" end="0:29.947">Sângele-Ți</span> <span begin="0:29.947" end="0:32.813">vărsat</span></p><p begin="0:32.813" end="0:37.726" ttm:agent="v1"><span begin="0:32.813" end="0:34.451">Spală-al</span> <span begin="0:34.451" end="0:34.860">meu</span> <span begin="0:34.860" end="0:37.726">păcat,</span></p><p begin="0:37.726" end="0:41.821" ttm:age