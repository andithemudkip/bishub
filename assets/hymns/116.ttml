<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>116. La cruce voi rămâne</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:58.883"><div><p begin="0:11.918" end="0:18.168" ttm:agent="v1"><span begin="0:11.918" end="0:12.699">La</span> <span begin="0:12.699" end="0:14.261">cruce</span> <span begin="0:14.261" end="0:15.043">voi</span> <span begin="0:15.043" end="0:18.168">rămâne</span></p><p begin="0:18.168" end="0:24.418" ttm:agent="v1"><span begin="0:18.168" end="0:18.949">Și-n</span> <span begin="0:18.949" end="0:21.293">sângele-Ți</span> <span begin="0:21.293" end="0:24.418">vărsat,</span></p><p begin="0:24.418" end="0:30.668" ttm:agent="v1"><span begin="0:24.418" end="0:25.199">Îmi</span> <span begin="0:25.199" end="0:25.981">voi</span> <span begin="0:25.981" end="0:27.543">spăla,</span> <span begin="0:27.543" end="0:30.668">Isuse,</span></p><p begin="0:30.668" end="0:36.918" ttm:agent="v1"><span begin="0:30.668" end="0:33.012">Veșmântul</span> <span begin="0:33.012" end="0:33.793">prea</span> <span begin="0:33.793" end="0:36.918">pătat!</span></p><p begin="0:36.918" end="0:43.169" ttm:agent="v1"><span begin="0:36.918" end="0:37.700">Din</span> <span begin="0:37.700" end="0:40.044">razele</span> <span begin="0:40.044" end="0:43.169">iubirii,</span></p><p begin="0:43.169" end="0:49.419" ttm:agent="v1"><span begin="0:43.169" end="0:45.512">Purtate-n</span> <span begin="0:45.512" end="0:46.294">mii</span> <span begin="0:46.294" end="0:47.075">de</span> <span begin="0:47.075" end="0:49.419">spini,</span></p><p begin="0:49.419" end="0:55.669" ttm:agent="v1"><span begin="0:49.419" end="0:50.200">Voi</span> <span begin="0:50.200" end="0:52.544">împleti-n</span> <span begin="0:52.544" end="0:55.669">vecie</span></p><p begin="0:55.669" end="1:04.859" ttm:agent="v1"><span begin="0:55.669" end="0:58.013">Coroane</span> <span begin="0:58.013" end="0:58.794">de</span> <span begin="0:58.794" end="1:04.859">lumini!</span></p><p begin="1:04.859" end="1:11.141" ttm:agent="v1"><span begin="1:04.859" end="1:07.215">Durere</span> <span begin="1:07.215" end="1:08.000">și</span> <span begin="1:08.000" end="1:11.141">iubire</span></p><p begin="1:11.141" end="1:17.422" ttm:agent="v1"><span begin="1:11.141" end="1:11.926">Cum</span> <span begin="1:11.926" end="1:13.496">nimeni</span> <span begin="1:13.496" end="1:14.281">n-a</span> <span begin="1:14.281" end="1:17.422">știut,</span></p><p begin="1:17.422" end="1:23.704" ttm:agent="v1"><span begin="1:17.422" end="1:18.207">În</span> <span begin="1:18.207" end="1:19.778">prețul</span> <span begin="1:19.778" end="1:21.348">jertfei</span> <span begin="1:21.348" end="1:23.704">Tale,</span></p><p begin="1:23.704" end="1:29.985" ttm:agent="v1"><span begin="1:23.704" end="1:26.059">Isuse-am</span> <span begin="1:26.059" end="1:29.985">cunoscut...</span></p><p begin="1:29.985" end="1:36.266" ttm:agent="v1"><span begin="1:29.985" end="1:30.770">La</span> <span begin="1:30.770" end="1:32.341">cruce</span> <span begin="1:32.341" end="1:33.126">voi</span> <span begin="1:33.126" end="1:36.266">rămâne,</span></p><p begin="1:36.266" end="1:42.548" ttm:agent="v1"><span begin="1:36.266" end="1:37.837">Uimit</span> <span begin="1:37.837" end="1:40.192">de-atâta</span> <span begin="1:40.192" end="1:42.548">har,</span></p><p begin="1:42.548" end="1:48.829" ttm:agent="v1"><span begin="1:42.548" end="1:43.333">În</span> <span begin="1:43.333" end="1:44.903">mine</span> <span begin="1:44.903" end="1:45.689">să</span> <span begin="1:45.689" end="1:48.829">pătrundă</span></p><p begin="1:48.829" end="1:54.326" ttm:agent="v1"><span begin="1:48.829" end="1:52.755">Nemărginitu-Ți</span> <span begin="1:52.755" end="1:54.326">dar!</span></p></div></body></tt>