<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>223. Ce face Domnul, totu-i bun</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:32.477"><div><p begin="0:15.130" end="0:26.648" ttm:agent="v1"><span begin="0:15.130" end="0:16.550">Ce</span> <span begin="0:16.550" end="0:19.390">face</span> <span begin="0:19.390" end="0:22.230">Domnul,</span> <span begin="0:22.230" end="0:25.386">totu-i</span> <span begin="0:25.386" end="0:26.648">bun,</span></p><p begin="0:26.648" end="0:38.100" ttm:agent="v1"><span begin="0:26.648" end="0:27.910">În</span> <span begin="0:27.910" end="0:32.170">inima</span> <span begin="0:32.170" end="0:38.100">smerită...</span></p><p begin="0:38.100" end="0:49.618" ttm:agent="v1"><span begin="0:38.100" end="0:39.520">Chiar</span> <span begin="0:39.520" end="0:40.940">de</span> <span begin="0:40.940" end="0:42.360">nu</span> <span begin="0:42.360" end="0:43.780">poți</span> <span begin="0:43.780" end="0:47.724">vedea</span> <span begin="0:47.724" end="0:49.618">acum,</span></p><p begin="0:49.618" end="1:16.200" ttm:agent="v1"><span begin="0:49.618" end="0:52.503">Izbânda-i</span> <span begin="0:52.503" end="1:16.200">pregătită!</span></p><p begin="1:16.200" end="1:27.775" ttm:agent="v1"><span begin="1:16.200" end="1:17.627">Ce</span> <span begin="1:17.627" end="1:20.481">face</span> <span begin="1:20.481" end="1:23.335">Domnul,</span> <span begin="1:23.335" end="1:26.507">totu-i</span> <span begin="1:26.507" end="1:27.775">bun,</span></p><p begin="1:27.775" end="1:39.284" ttm:agent="v1"><span begin="1:27.775" end="1:29.044">Căci</span> <span begin="1:29.044" end="1:31.898">totu-i</span> <span begin="1:31.898" end="1:33.325">din</span> <span begin="1:33.325" end="1:39.284">iubire...</span></p><p begin="1:39.284" end="1:50.859" ttm:agent="v1"><span begin="1:39.284" end="1:40.711">Când</span> <span begin="1:40.711" end="1:43.565">ale</span> <span begin="1:43.565" end="1:46.419">lumii</span> <span begin="1:46.419" end="1:50.859">raze-apun,</span></p><p begin="1:50.859" end="1:56.613" ttm:agent="v1"><span begin="1:50.859" end="1:52.127">În</span> <span begin="1:52.127" end="1:52.943">El</span> <span begin="1:52.943" end="1:53.759">e</span> <span begin="1:53.759" end="1:56.613">strălucire!</span></p></div></body></tt>