<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>586. O, zi, popas divin!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:43.105"><div><p begin="0:00.780" end="0:06.078" ttm:agent="v1"><span begin="0:00.780" end="0:01.442">O,</span> <span begin="0:01.442" end="0:02.104">zi,</span> <span begin="0:02.104" end="0:03.429">popas</span> <span begin="0:03.429" end="0:06.078">divin,</span></p><p begin="0:06.078" end="0:11.375" ttm:agent="v1"><span begin="0:06.078" end="0:06.740">În</span> <span begin="0:06.740" end="0:08.726">sufletul</span> <span begin="0:08.726" end="0:11.375">trudit,</span></p><p begin="0:11.375" end="0:16.673" ttm:agent="v1"><span begin="0:11.375" end="0:13.362">Cuvântul</span> <span begin="0:13.362" end="0:14.024">sfânt,</span> <span begin="0:14.024" end="0:14.686">de</span> <span begin="0:14.686" end="0:16.011">rouă</span> <span begin="0:16.011" end="0:16.673">plin,</span></p><p begin="0:16.673" end="0:24.430" ttm:agent="v1"><span begin="0:16.673" end="0:17.335">Să</span> <span begin="0:17.335" end="0:18.659">cadă</span> <span begin="0:18.659" end="0:24.430">liniștit!</span></p><p begin="0:24.430" end="0:29.569" ttm:agent="v1"><span begin="0:24.430" end="0:25.073">E</span> <span begin="0:25.073" end="0:26.357">ziua</span> <span begin="0:26.357" end="0:27.642">păcii</span> <span begin="0:27.642" end="0:29.569">Lui!...</span></p><p begin="0:29.569" end="0:34.708" ttm:agent="v1"><span begin="0:29.569" end="0:31.496">Alină-al</span> <span begin="0:31.496" end="0:32.781">nostru</span> <span begin="0:32.781" end="0:34.708">dor,</span></p><p begin="0:34.708" end="0:39.846" ttm:agent="v1"><span begin="0:34.708" end="0:35.350">Și</span> <span begin="0:35.350" end="0:36.635">valul</span> <span begin="0:36.635" end="0:37.919">urii</span> <span begin="0:37.919" end="0:38.562">să-l</span> <span begin="0:38.562" end="0:39.846">supui,</span></p><p begin="0:39.846" end="0:46.625" ttm:agent="v1"><span begin="0:39.846" end="0:40.489">O,</span> <span begin="0:40.489" end="0:41.131">scump</span> <span begin="0:41.131" end="0:46.625">Mântuitor!</span></p><p begin="0:46.625" end="0:51.764" ttm:agent="v1"><span begin="0:46.625" end="0:47.267">E</span> <span begin="0:47.267" end="0:47.910">zi</span> <span begin="0:47.910" end="0:48.552">de</span> <span begin="0:48.552" end="0:49.837">rugă</span> <span begin="0:49.837" end="0:51.764">iar;</span></p><p begin="0:51.764" end="0:56.902" ttm:agent="v1"><span begin="0:51.764" end="0:52.406">Cu</span> <span begin="0:52.406" end="0:53.048">dor</span> <span begin="0:53.048" end="0:53.691">de</span> <span begin="0:53.691" end="0:56.902">veșnicii,</span></p><p begin="0:56.902" end="1:02.041" ttm:agent="v1"><span begin="0:56.902" end="0:58.187">Suim</span> <span begin="0:58.187" end="0:58.829">spre-al</span> <span begin="0:58.829" end="1:00.756">cerului</span> <span begin="1:00.756" end="1:02.041">altar,</span></p><p begin="1:02.041" end="1:08.720" ttm:agent="v1"><span begin="1:02.041" end="1:03.326">Isus,</span> <span begin="1:03.326" end="1:03.968">la</span> <span begin="1:03.968" end="1:04.610">noi</span> <span begin="1:04.610" end="1:05.253">să</span> <span begin="1:05.253" end="1:08.720">vii!</span></p><p begin="1:08.720" end="1:13.858" ttm:agent="v1"><span begin="1:08.720" end="1:09.362">În</span> <span begin="1:09.362" end="1:10.004">cea</span> <span begin="1:10.004" end="1:10.647">mai</span> <span begin="1:10.647" end="1:11.931">sfântă</span> <span begin="1:11.931" end="1:13.858">zi,</span></p><p begin="1:13.858" end="1:18.997" ttm:agent="v1"><span begin="1:13.858" end="1:15.785">Trimite</span> <span begin="1:15.785" end="1:17.070">raza</span> <span begin="1:17.070" end="1:18.997">Ta,</span></p><p begin="1:18.