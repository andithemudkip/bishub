<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>35. Tată ceresc, ce mult am vrea</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:59.850"><div><p begin="0:10.279" end="0:16.329" ttm:agent="v1"><span begin="0:10.279" end="0:11.288">Tată</span> <span begin="0:11.288" end="0:12.800">ceresc,</span> <span begin="0:12.800" end="0:13.304">ce</span> <span begin="0:13.304" end="0:14.312">mult</span> <span begin="0:14.312" end="0:14.817">am</span> <span begin="0:14.817" end="0:16.329">vrea</span></p><p begin="0:16.329" end="0:22.379" ttm:agent="v1"><span begin="0:16.329" end="0:16.833">Să-Ți</span> <span begin="0:16.833" end="0:19.354">înțelegem</span> <span begin="0:19.354" end="0:22.379">dragostea,</span></p><p begin="0:22.379" end="0:28.428" ttm:agent="v1"><span begin="0:22.379" end="0:22.883">Ea</span> <span begin="0:22.883" end="0:23.387">se</span> <span begin="0:23.387" end="0:25.403">întinde-n</span> <span begin="0:25.403" end="0:28.428">infinit,</span></p><p begin="0:28.428" end="0:35.964" ttm:agent="v1"><span begin="0:28.428" end="0:28.932">Din</span> <span begin="0:28.932" end="0:30.949">răsărit</span> <span begin="0:30.949" end="0:31.453">în</span> <span begin="0:31.453" end="0:35.964">asfințit...</span></p><p begin="0:35.964" end="0:42.013" ttm:agent="v1"><span begin="0:35.964" end="0:36.972">Veche</span> <span begin="0:36.972" end="0:37.476">de</span> <span begin="0:37.476" end="0:38.484">când</span> <span begin="0:38.484" end="0:38.988">nu</span> <span begin="0:38.988" end="0:39.997">știm</span> <span begin="0:39.997" end="0:40.501">a</span> <span begin="0:40.501" end="0:42.013">fi</span></p><p begin="0:42.013" end="0:48.063" ttm:agent="v1"><span begin="0:42.013" end="0:42.517">Și</span> <span begin="0:42.517" end="0:43.526">totuși</span> <span begin="0:43.526" end="0:45.038">nouă-n</span> <span begin="0:45.038" end="0:46.550">orice</span> <span begin="0:46.550" end="0:48.063">zi,</span></p><p begin="0:48.063" end="0:54.112" ttm:agent="v1"><span begin="0:48.063" end="0:48.567">În</span> <span begin="0:48.567" end="0:49.575">ciuda</span> <span begin="0:49.575" end="0:51.088">urii</span> <span begin="0:51.088" end="0:54.112">omenești,</span></p><p begin="0:54.112" end="0:59.232" ttm:agent="v1"><span begin="0:54.112" end="0:54.617">Tu</span> <span begin="0:54.617" end="0:55.121">tot</span> <span begin="0:55.121" end="0:55.625">mai</span> <span begin="0:55.625" end="0:56.633">mult</span> <span begin="0:56.633" end="0:57.137">Te</span> <span begin="0:57.137" end="0:59.232">dăruiești...</span></p><p begin="0:59.232" end="1:05.221" ttm:agent="v1"><span begin="0:59.232" end="0:59.731">Îți</span> <span begin="0:59.731" end="1:01.728">mulțumim</span> <span begin="1:01.728" end="1:02.227">c-ai</span> <span begin="1:02.227" end="1:05.221">dăruit,</span></p><p begin="1:05.221" end="1:11.210" ttm:agent="v1"><span begin="1:05.221" end="1:05.720">Pe</span> <span begin="1:05.720" end="1:06.718">Fiul</span> <span begin="1:06.718" end="1:07.716">Tău</span> <span begin="1:07.716" end="1:08.216">cel</span> <span begin="1:08.216" end="1:11.210">preaiubit,</span></p><p begin="1:11.210" end="1:17.199" ttm:agent="v1"><span begin="1:11.210" end="1:11.709">Ca</span> <span begin="1:11.709" end="1:12.208">să-Ți</span> <span begin="1:12.208" end="1:14.204">cunoaștem</span> <span begin="1:14.204" end="1:17.199">dragostea</span></p><p begin="1:17.199" end="1:21.457" ttm:agent="v1"><span begin="1:17.199" end="1:17.698">Și</span> <span begin="1:17.698" end="1:18.197">să</span> <span begin="1:18.197" end="1:19.694">trăim</span> <span begin="1:19.694" end="1:20.193">prin</span> <span begin="1:20.193" end="1:21.690">jertfa</span> <span begin="1:21.690" end="1:21.457">Sa.</span></p><p begin="1:21.457" end="1:27.978" ttm:agent="v1"><span begin="1:21.457" end="1:21.959">Să</span> <span begin="1:21.959" end="1:24.467">izvorască</span> <span begin="1:24.467" end="1:25.470">în</span> <span begin="1:25.470" end="1:27.978">șuvoi</span></p><p begin="1:27.978" end="1:33.496" ttm:agent="v1"><span begin="1:27.978" end="1:28.981">Dragostea</span> <span begin="1:28.981" end="1:31.489">Domnului</span> <span begin="1:31.489" end="1:31.991">și-n</span> <span begin="1:31.991" end="1:33.496">noi,</span></p><p begin="1:33.496" end="1:39.515" ttm:agent="v1"><span begin="1:33.496" end="1:33.997">Să</span> <span begin="1:33.997" end="1:34.499">fim</span> <span begin="1:34.499" end="1:36.505">lumină</span> <span begin="1:36.505" end="1:39.515">orișicui</span></p><p begin="1:39.515" end="1:43.528" ttm:agent="v1"><span begin="1:39.515" end="1:40.016">Și</span> <span begin="1:40.016" end="1:42.023">mesageri</span> <span begin="1:42.023" end="1:42.524">ai</span> <span begin="1:42.524" end="1:43.528">cerului!</span></p></div></body></tt>