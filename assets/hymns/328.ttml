<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>328. Deși e lumea plină de minuni</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:55.618"><div><p begin="0:09.870" end="0:18.337" ttm:agent="v1"><span begin="0:09.870" end="0:10.928">Deși</span> <span begin="0:10.928" end="0:11.458">e</span> <span begin="0:11.458" end="0:12.516">lumea</span> <span begin="0:12.516" end="0:13.574">plină</span> <span begin="0:13.574" end="0:14.104">de</span> <span begin="0:14.104" end="0:15.162">minuni</span> <span begin="0:15.162" end="0:15.691">în</span> <span begin="0:15.691" end="0:16.750">jurul</span> <span begin="0:16.750" end="0:18.337">său,</span></p><p begin="0:18.337" end="0:26.804" ttm:agent="v1"><span begin="0:18.337" end="0:19.925">Nebunul</span> <span begin="0:19.925" end="0:20.983">totuși</span> <span begin="0:20.983" end="0:22.042">zice:</span> <span begin="0:22.042" end="0:22.571">„Nu</span> <span begin="0:22.571" end="0:24.158">există</span> <span begin="0:24.158" end="0:26.804">Dumnezeu!”</span></p><p begin="0:26.804" end="0:35.272" ttm:agent="v1"><span begin="0:26.804" end="0:27.334">Dar</span> <span begin="0:27.334" end="0:28.392">Tatăl</span> <span begin="0:28.392" end="0:28.921">bun,</span> <span begin="0:28.921" end="0:29.980">privind</span> <span begin="0:29.980" end="0:30.509">spre</span> <span begin="0:30.509" end="0:31.038">noi</span> <span begin="0:31.038" end="0:31.567">cu</span> <span begin="0:31.567" end="0:32.096">ochi</span> <span begin="0:32.096" end="0:35.272">pătrunzători,</span></p><p begin="0:35.272" end="0:44.959" ttm:agent="v1"><span begin="0:35.272" end="0:36.859">Așteaptă</span> <span begin="0:36.859" end="0:37.918">oameni</span> <span begin="0:37.918" end="0:39.505">înțelepți,</span> <span begin="0:39.505" end="0:40.034">de</span> <span begin="0:40.034" end="0:40.564">El</span> <span begin="0:40.564" end="0:44.959">căutători...</span></p><p begin="0:44.959" end="0:53.341" ttm:agent="v1"><span begin="0:44.959" end="0:45.483">El</span> <span begin="0:45.483" end="0:46.531">vede</span> <span begin="0:46.531" end="0:47.054">că</span> <span begin="0:47.054" end="0:47.578">s-au</span> <span begin="0:47.578" end="0:49.150">abătut</span> <span begin="0:49.150" end="0:49.674">cu</span> <span begin="0:49.674" end="0:50.198">toți</span> <span begin="0:50.198" end="0:50.722">din</span> <span begin="0:50.722" end="0:51.770">drumul</span> <span begin="0:51.770" end="0:53.341">drept,</span></p><p begin="0:53.341" end="1:01.724" ttm:agent="v1"><span begin="0:53.341" end="0:53.865">Toți</span> <span begin="0:53.865" end="0:54.389">în</span> <span begin="0:54.389" end="0:55.437">păcat</span> <span begin="0:55.437" end="0:55.961">s-au</span> <span begin="0:55.961" end="0:57.533">rătăcit,</span> <span begin="0:57.533" end="0:58.057">nu-i</span> <span begin="0:58.057" end="0:58.580">nici</span> <span begin="0:58.580" end="0:59.104">un</span> <span begin="0:59.104" end="1:01.724">înțelept;</span></p><p begin="1:01.724" end="1:10.106" ttm:agent="v1"><span begin="1:01.724" end="1:02.248">N-au</span> <span begin="1:02.248" end="1:03.296">minte</span> <span begin="1:03.296" end="1:04.867">oare-acești</span> <span begin="1:04.867" end="1:05.915">mișei</span> <span begin="1:05.915" end="1:06.439">de</span> <span begin="1:06.439" end="1:06.963">rod</span> <span begin="1:06.963" end="1:07.487">pe</span> <span begin="1:07.487" end="1:08.011">cei</span> <span begin="1:08.011" end="1:10.106">smeriți</span></p><p begin="1:10.106" end="1:19.649" ttm:agent="v1"><span begin="1:10.106" end="1:10.630">Și</span> <span begin="1:10.630" end="1:11.154">nu</span> <span begin="1:11.154" end="1:12.726">se-nchină</span> <span begin="1:12.726" end="1:13.250">lui</span> <span begin="1:13.250" end="1:14.298">Hristos</span> <span begin="1:14.298" end="1:14.822">să</span> <span begin="1:14.822" end="1:15.869">fie</span> <span begin="1:15.869" end="1:19.649">mântuiți?</span></p><p begin="1:19.649" end="1:27.948" ttm:agent="v1"><span begin="1:19.649" end="1:20.168">Dar</span> <span begin="1:20.168" end="1:20.686">ei</span> <span begin="1:20.686" end="1:21.205">s-or</span> <span begin="1:21.205" end="1:22.761">îngrozi</span> <span begin="1:22.761" end="1:23.280">cu</span> <span begin="1:23.280" end="1:23.798">toți,</span> <span begin="1:23.798" end="1:24.317">căci</span> <span begin="1:24.317" end="1:25.873">Dumnezeu</span> <span begin="1:25.873" end="1:26.392">e</span> <span begin="1:26.392" end="1:27.948">Domn,</span></p><p begin="1:27.948" end="1:36.246" ttm:agent="v1"><span begin="1:27.948" end="1:28.466">Chiar</span> <span begin="1:28.466" end="1:29.504">dacă</span> <span begin="1:29.504" end="1:30.541">răii</span> <span begin="1:30.541" end="1:32.097">propășesc</span> <span begin="1:32.097" end="1:32.616">pe</span> <span begin="1:32.616" end="1:33.134">culmi</span> <span begin="1:33.134" end="1:33.653">de</span> <span begin="1:33.653" end="1:36.246">Babilon...</span></p><p begin="1:36.246" end="1:44.545" ttm:agent="v1"><span begin="1:36.246" end="1:36.765">O,</span> <span begin="1:36.765" end="1:37.802">Doamne,</span> <span begin="1:37.802" end="1:38.840">dă-ne</span> <span begin="1:38.840" end="1:40.396">izbăviri,</span> <span begin="1:40.396" end="1:42.470">zidește-ne</span> <span begin="1:42.470" end="1:42.989">din</span> <span begin="1:42.989" end="1:44.545">nou,</span></p><p begin="1:44.545" end="1:52.325" ttm:agent="v1"><span begin="1:44.545" end="1:45.064">Și</span> <span begin="1:45.064" end="1:46.620">bucurii</span> <span begin="1:46.620" end="1:48.176">revarsă</span> <span begin="1:48.176" end="1:49.213">peste</span> <span begin="1:49.213" end="1:49.732">tot</span> <span begin="1:49.732" end="1:51.288">poporul</span> <span begin="1:51.288" end="1:52.325">Tău!</span></p></div></body></tt>