<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>430. Mergeți la cei pierduți</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:34.331"><div><p begin="0:15.980" end="0:19.648" ttm:agent="v1"><span begin="0:15.980" end="0:17.355">Mergeți</span> <span begin="0:17.355" end="0:17.814">la</span> <span begin="0:17.814" end="0:18.272">cei</span> <span begin="0:18.272" end="0:19.648">pierduți!</span></p><p begin="0:19.648" end="0:23.315" ttm:agent="v1"><span begin="0:19.648" end="0:20.565">Sunt</span> <span begin="0:20.565" end="0:21.482">frații</span> <span begin="0:21.482" end="0:23.315">voștri</span></p><p begin="0:23.315" end="0:26.066" ttm:agent="v1"><span begin="0:23.315" end="0:24.232">Cei</span> <span begin="0:24.232" end="0:25.149">care</span> <span begin="0:25.149" end="0:26.066">pier</span></p><p begin="0:26.066" end="0:30.651" ttm:agent="v1"><span begin="0:26.066" end="0:26.525">În</span> <span begin="0:26.525" end="0:27.900">mormânt</span> <span begin="0:27.900" end="0:28.359">de</span> <span begin="0:28.359" end="0:30.651">păcat!</span></p><p begin="0:30.651" end="0:34.319" ttm:agent="v1"><span begin="0:30.651" end="0:32.026">Plângeți</span> <span begin="0:32.026" end="0:32.485">cu</span> <span begin="0:32.485" end="0:32.943">cei</span> <span begin="0:32.943" end="0:34.319">greșiți,</span></p><p begin="0:34.319" end="0:37.986" ttm:agent="v1"><span begin="0:34.319" end="0:35.694">Spuneți</span> <span begin="0:35.694" end="0:36.153">în</span> <span begin="0:36.153" end="0:37.986">noapte</span></p><p begin="0:37.986" end="0:40.737" ttm:agent="v1"><span begin="0:37.986" end="0:38.903">Să</span> <span begin="0:38.903" end="0:39.820">știe</span> <span begin="0:39.820" end="0:40.737">toți</span></p><p begin="0:40.737" end="0:52.330" ttm:agent="v1"><span begin="0:40.737" end="0:41.196">Că</span> <span begin="0:41.196" end="0:42.571">Isus</span> <span begin="0:42.571" end="0:43.030">i-a</span> <span begin="0:43.030" end="0:52.330">salvat!</span></p><p begin="0:52.330" end="0:55.942" ttm:agent="v1"><span begin="0:52.330" end="0:54.136">Inima</span> <span begin="0:54.136" end="0:55.039">lor,</span> <span begin="0:55.039" end="0:55.942">plângând,</span></p><p begin="0:55.942" end="0:59.555" ttm:agent="v1"><span begin="0:55.942" end="0:57.749">Zace</span> <span begin="0:57.749" end="0:59.555">înfrântă</span></p><p begin="0:59.555" end="1:02.716" ttm:agent="v1"><span begin="0:59.555" end="1:00.458">Și</span> <span begin="1:00.458" end="1:01.361">vă</span> <span begin="1:01.361" end="1:02.716">așteaptă</span></p><p begin="1:02.716" end="1:06.780" ttm:agent="v1"><span begin="1:02.716" end="1:03.168">Cu-al</span> <span begin="1:03.168" end="1:04.974">dragostei</span> <span begin="1:04.974" end="1:06.780">har;</span></p><p begin="1:06.780" end="1:10.393" ttm:agent="v1"><span begin="1:06.780" end="1:08.135">Faceți</span> <span begin="1:08.135" end="1:09.490">s-audă</span> <span begin="1:09.490" end="1:10.393">clar</span></p><p begin="1:10.393" end="1:14.006" ttm:agent="v1"><span begin="1:10.393" end="1:11.748">Vocea</span> <span begin="1:11.748" end="1:14.006">speranței,</span></p><p begin="1:14.006" end="1:26.584" ttm:agent="v1"><span begin="1:14.006" end="1:15.812">Coardele</span> <span begin="1:15.812" end="1:19.425">rupte-nstrunați-le</span> <span begin="1:19.425" end="1:26.584">iar!</span></p><p begin="1:26.584" end="1:30.161" ttm:agent="v1"><span begin="1:26.584" end="1:27.478">Chiar</span> <span begin="1:27.478" end="1:28.372">dacă</span> <span begin="1:28.372" end="1:28.819">ei</span> <span begin="1:28.819" end="1:29.266">nu-L</span> <span begin="1:29.266" end="1:30.161">vor,</span></p><p begin="1:30.161" end="1:33.737" ttm:agent="v1"><span begin="1:30.161" end="1:31.502">Domnu-i</span> <span begin="1:31.502" end="1:33.737">iubește,</span></p><p begin="1:33.737" end="1:36.867" ttm:agent="v1"><span begin="1:33.737" end="1:35.078">Este</span> <span begin="1:35.078" end="1:36.867">solia</span></p><p begin="1:36.867" end="1:40.890" ttm:agent="v1"><span begin="1:36.867" end="1:38.208">Ce-avem</span> <span begin="1:38.208" end="1:38.655">azi</span> <span begin="1:38.655" end="1:39.102">de</span> <span begin="1:39.102" end="1:40.890">dus!</span></p><p begin="1:40.890" end="1:44.467" ttm:agent="v1"><span begin="1:40.890" end="1:42.232">Duhul</span> <span begin="1:42.232" end="1:42.679">Său</span> <span begin="1:42.679" end="1:43.126">Bun</span> <span begin="1:43.126" end="1:43.573">și</span> <span begin="1:43.573" end="1:44.467">Sfânt</span></p><p begin="1:44.467" end="1:48.044" ttm:agent="v1"><span begin="1:44.467" end="1:45.361">Ne</span> <span begin="1:45.361" end="1:48.044">întărește</span></p><p begin="1:48.044" end="1:50.726" ttm:agent="v1"><span begin="1:48.044" end="1:48.938">Ca</span> <span begin="1:48.938" end="1:49.385">să</span> <span begin="1:49.385" end="1:50.726">salvăm</span></p><p begin="1:50.726" end="1:54.750" ttm:agent="v1"><span begin="1:50.726" end="1:51.620">Lumea</span> <span begin="1:51.620" end="1:52.961">pentru</span> <span begin="1:52.961" end="1:54.750">Isus!</span></p></div></body></tt>