<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>520. Sculați, frați, toți!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:45.564"><div><p begin="0:13.530" end="0:25.370" ttm:agent="v1"><span begin="0:13.530" end="0:16.490">Sculați</span> <span begin="0:16.490" end="0:17.970">frați</span> <span begin="0:17.970" end="0:19.450">toți</span> <span begin="0:19.450" end="0:20.930">și</span> <span begin="0:20.930" end="0:23.890">capul</span> <span begin="0:23.890" end="0:25.370">sus,</span></p><p begin="0:25.370" end="0:37.210" ttm:agent="v1"><span begin="0:25.370" end="0:28.330">Zoriți</span> <span begin="0:28.330" end="0:29.810">în</span> <span begin="0:29.810" end="0:37.210">pregătire!</span></p><p begin="0:37.210" end="0:49.050" ttm:agent="v1"><span begin="0:37.210" end="0:38.690">Ca</span> <span begin="0:38.690" end="0:41.650">mâine</span> <span begin="0:41.650" end="0:43.130">va</span> <span begin="0:43.130" end="0:46.090">veni</span> <span begin="0:46.090" end="0:49.050">Isus</span></p><p begin="0:49.050" end="1:10.670" ttm:agent="v1"><span begin="0:49.050" end="0:50.530">În</span> <span begin="0:50.530" end="0:53.490">toată-a</span> <span begin="0:53.490" end="0:54.970">Sa</span> <span begin="0:54.970" end="1:10.670">mărire!</span></p><p begin="1:10.670" end="1:22.155" ttm:agent="v1"><span begin="1:10.670" end="1:12.106">Și</span> <span begin="1:12.106" end="1:14.977">dacă</span> <span begin="1:14.977" end="1:17.848">lumea</span> <span begin="1:17.848" end="1:19.284">te-a</span> <span begin="1:19.284" end="1:22.155">urât,</span></p><p begin="1:22.155" end="1:33.640" ttm:agent="v1"><span begin="1:22.155" end="1:26.462">Ocara-i</span> <span begin="1:26.462" end="1:27.897">ți-e</span> <span begin="1:27.897" end="1:33.640">onoare...</span></p><p begin="1:33.640" end="1:45.124" ttm:agent="v1"><span begin="1:33.640" end="1:39.382">Statornică</span> <span begin="1:39.382" end="1:40.818">să</span> <span begin="1:40.818" end="1:42.253">fii,</span> <span begin="1:42.253" end="1:45.124">și-atât:</span></p><p begin="1:45.124" end="1:53.738" ttm:agent="v1"><span begin="1:45.124" end="1:47.996">Isus</span> <span begin="1:47.996" end="1:49.431">îți</span> <span begin="1:49.431" end="1:50.867">e</span> <span begin="1:50.867" end="1:53.738">scăpare!</span></p></div></body></tt>