<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>732. Cântec plin de bucurie</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:47.912"><div><p begin="0:12.180" end="0:17.602" ttm:agent="v1"><span begin="0:12.180" end="0:13.535">Cântec</span> <span begin="0:13.535" end="0:14.213">plin</span> <span begin="0:14.213" end="0:14.891">de</span> <span begin="0:14.891" end="0:17.602">bucurie:</span></p><p begin="0:17.602" end="0:23.024" ttm:agent="v1"><span begin="0:17.602" end="0:18.618">„La</span> <span begin="0:18.618" end="0:18.957">mulți</span> <span begin="0:18.957" end="0:19.635">ani</span> <span begin="0:19.635" end="0:20.313">de</span> <span begin="0:20.313" end="0:21.668">ziua</span> <span begin="0:21.668" end="0:23.024">ta!”</span></p><p begin="0:23.024" end="0:28.446" ttm:agent="v1"><span begin="0:23.024" end="0:23.701">Și</span> <span begin="0:23.701" end="0:24.379">mai</span> <span begin="0:24.379" end="0:25.057">mult,</span> <span begin="0:25.057" end="0:25.735">o</span> <span begin="0:25.735" end="0:28.446">veșnicie</span></p><p begin="0:28.446" end="0:35.347" ttm:agent="v1"><span begin="0:28.446" end="0:29.801">Bunul</span> <span begin="0:29.801" end="0:31.834">Dumnezeu</span> <span begin="0:31.834" end="0:32.512">să-ți</span> <span begin="0:32.512" end="0:35.347">dea!</span></p><p begin="0:35.347" end="0:40.769" ttm:agent="v1"><span begin="0:35.347" end="0:36.025">Pe</span> <span begin="0:36.025" end="0:38.058">cărarea</span> <span begin="0:38.058" end="0:40.769">datoriei</span></p><p begin="0:40.769" end="0:46.191" ttm:agent="v1"><span begin="0:40.769" end="0:43.480">Fericirea</span> <span begin="0:43.480" end="0:44.158">s-o</span> <span begin="0:44.158" end="0:46.191">găsești,</span></p><p begin="0:46.191" end="0:51.613" ttm:agent="v1"><span begin="0:46.191" end="0:46.869">La</span> <span begin="0:46.869" end="0:47.547">mulți</span> <span begin="0:47.547" end="0:48.224">ani</span> <span begin="0:48.224" end="0:48.902">în</span> <span begin="0:48.902" end="0:51.613">veșnicie,</span></p><p begin="0:51.613" end="0:58.695" ttm:agent="v1"><span begin="0:51.613" end="0:52.969">Lângă</span> <span begin="0:52.969" end="0:54.324">Domnul</span> <span begin="0:54.324" end="0:55.002">să</span> <span begin="0:55.002" end="0:58.695">trăiești!</span></p><p begin="0:58.695" end="1:04.090" ttm:agent="v1"><span begin="0:58.695" end="1:00.044">Zile</span> <span begin="1:00.044" end="1:01.392">multe</span> <span begin="1:01.392" end="1:02.067">și</span> <span begin="1:02.067" end="1:04.090">senine,</span></p><p begin="1:04.090" end="1:09.484" ttm:agent="v1"><span begin="1:04.090" end="1:05.438">Asta</span> <span begin="1:05.438" end="1:06.787">fie</span> <span begin="1:06.787" end="1:08.136">partea</span> <span begin="1:08.136" end="1:09.484">ta,</span></p><p begin="1:09.484" end="1:14.879" ttm:agent="v1"><span begin="1:09.484" end="1:10.159">Sub</span> <span begin="1:10.159" end="1:12.856">privirile</span> <span begin="1:12.856" end="1:14.879">divine</span></p><p begin="1:14.879" end="1:21.854" ttm:agent="v1"><span begin="1:14.879" end="1:16.902">Fericit</span> <span begin="1:16.902" end="1:17.577">să</span> <span begin="1:17.577" end="1:18.251">poți</span> <span begin="1:18.251" end="1:21.854">umbla!</span></p><p begin="1:21.854" end="1:27.249" ttm:agent="v1"><span begin="1:21.854" end="1:23.203">Strânge</span> <span begin="1:23.203" end="1:23.877">de</span> <span begin="1:23.877" end="1:24.551">pe</span> <span begin="1:24.551" end="1:25.900">calea</span> <span begin="1:25.900" end="1:27.249">dreaptă</span></p><p begin="1:27.249" end="1:32.643" ttm:agent="v1"><span begin="1:27.249" end="1:27.923">O</span> <span begin="1:27.923" end="1:29.946">recoltă</span> <span begin="1:29.946" end="1:30.620">de</span> <span begin="1:30.620" end="1:32.643">minuni,</span></p><p begin="1:32.643" end="1:38.038" ttm:agent="v1"><span begin="1:32.643" end="1:33.318">Și</span> <span begin="1:33.318" end="1:35.341">răsplata</span> <span begin="1:35.341" end="1:36.015">te</span> <span begin="1:36.015" end="1:38.038">așteaptă,</span></p><p begin="1:38.038" end="1:43.433" ttm:agent="v1"><span begin="1:38.038" end="1:38.713">Ani</span> <span begin="1:38.713" end="1:40.736">ferice</span> <span begin="1:40.736" end="1:41.410">mulți</span> <span begin="1:41.410" end="1:42.084">și</span> <span begin="1:42.084" end="1:43.433">buni!</span></p></div></body></tt>