<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>449. În amurgul ce se lasă</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:18.188"><div><p begin="0:00.780" end="0:05.964" ttm:agent="v1"><span begin="0:00.780" end="0:01.234">În</span> <span begin="0:01.234" end="0:03.502">amurgul</span> <span begin="0:03.502" end="0:03.955">ce</span> <span begin="0:03.955" end="0:04.409">se</span> <span begin="0:04.409" end="0:05.964">lasă</span></p><p begin="0:05.964" end="0:11.666" ttm:agent="v1"><span begin="0:05.964" end="0:08.945">Peste-ntinsele</span> <span begin="0:08.945" end="0:11.666">câmpii,</span></p><p begin="0:11.666" end="0:16.850" ttm:agent="v1"><span begin="0:11.666" end="0:13.934">Zăbovesc</span> <span begin="0:13.934" end="0:16.850">secerătorii</span></p><p begin="0:16.850" end="0:21.973" ttm:agent="v1"><span begin="0:16.850" end="0:17.239">La</span> <span begin="0:17.239" end="0:18.470">hotar</span> <span begin="0:18.470" end="0:18.924">de</span> <span begin="0:18.924" end="0:21.973">veșnicii.</span></p><p begin="0:21.973" end="0:27.035" ttm:agent="v1"><span begin="0:21.973" end="0:22.816">Glasul</span> <span begin="0:22.816" end="0:24.926">Domnului</span> <span begin="0:24.926" end="0:25.348">ne</span> <span begin="0:25.348" end="0:27.035">cheamă,</span></p><p begin="0:27.035" end="0:32.097" ttm:agent="v1"><span begin="0:27.035" end="0:29.566">Secerișul</span> <span begin="0:29.566" end="0:29.988">e</span> <span begin="0:29.988" end="0:30.410">în</span> <span begin="0:30.410" end="0:32.097">toi!</span></p><p begin="0:32.097" end="0:37.159" ttm:agent="v1"><span begin="0:32.097" end="0:32.941">Cine-i</span> <span begin="0:32.941" end="0:34.628">gata</span> <span begin="0:34.628" end="0:35.050">să</span> <span begin="0:35.050" end="0:37.159">răspundă?</span></p><p begin="0:37.159" end="0:42.062" ttm:agent="v1"><span begin="0:37.159" end="0:38.003">„Iată,</span> <span begin="0:38.003" end="0:38.847">Doamne,</span> <span begin="0:38.847" end="0:40.534">suntem</span> <span begin="0:40.534" end="0:42.062">noi!”</span></p><p begin="0:42.062" end="0:46.714" ttm:agent="v1"><span begin="0:42.062" end="0:42.876">Iată,</span> <span begin="0:42.876" end="0:44.911">spicele</span> <span begin="0:44.911" end="0:45.318">sunt</span> <span begin="0:45.318" end="0:46.714">coapte,</span></p><p begin="0:46.714" end="0:51.832" ttm:agent="v1"><span begin="0:46.714" end="0:48.168">Holdele</span> <span begin="0:48.168" end="0:49.389">abia</span> <span begin="0:49.389" end="0:50.203">se</span> <span begin="0:50.203" end="0:51.832">țin!</span></p><p begin="0:51.832" end="0:56.484" ttm:agent="v1"><span begin="0:51.832" end="0:54.274">Secerișul</span> <span begin="0:54.274" end="0:55.088">este</span> <span begin="0:55.088" end="0:56.484">mare,</span></p><p begin="0:56.484" end="1:04.042" ttm:agent="v1"><span begin="0:56.484" end="0:56.833">Dar</span> <span begin="0:56.833" end="0:59.159">secerători</span> <span begin="0:59.159" end="1:04.042">puțini!</span></p><p begin="1:04.042" end="1:08.853" ttm:agent="v1"><span begin="1:04.042" end="1:04.843">Glasul</span> <span begin="1:04.843" end="1:06.848">Domnului</span> <span begin="1:06.848" end="1:07.249">ne</span> <span begin="1:07.249" end="1:08.853">cheamă,</span></p><p begin="1:08.853" end="1:13.665" ttm:agent="v1"><span begin="1:08.853" end="1:11.259">Secerișul</span> <span begin="1:11.259" end="1:11.660">e</span> <span begin="1:11.660" end="1:12.061">în</span> <span begin="1:12.061" end="1:13.665">toi!</span></p><p begin="1:13.665" end="1:18.477" ttm:agent="v1"><span begin="1:13.665" end="1:14.467">Cine-i</span> <span begin="1:14.467" end="1:16.071">gata</span> <span begin="1:16.071" end="1:16.472">să</span> <span begin="1:16.472" end="1:18.477">răspundă?</span></p><p begin="1:18.477" end="1:23.408" ttm:agent="v1"><span begin="1:18.477" end="1:19.279">„Iată,</span> <span begin="1:19.279" end="1:20.081">Doamne,</span> <span begin="1:20.081" end="1:21.684">suntem</span> <span begin="1:21.684" end="1:23.408">noi!”</span></p><p begin="1:23.408" end="1:28.106" ttm:agent="v1"><span begin="1:23.408" end="1:23.819">Cei</span> <span begin="1:23.819" end="1:24.230">ce</span> <span begin="1:24.230" end="1:25.463">merg,</span> <span begin="1:25.463" end="1:25.874">azi,</span> <span begin="1:25.874" end="1:26.285">în</span> <span begin="1:26.285" end="1:28.106">lucrare,</span></p><p begin="1:28.106" end="1:33.272" ttm:agent="v1"><span begin="1:28.106" end="1:29.984">Răsplătire</span> <span begin="1:29.984" end="1:30.806">vor</span> <span begin="1:30.806" end="1:33.272">primi:</span></p><p begin="1:33.272" end="1:37.970" ttm:agent="v1"><span begin="1:33.272" end="1:33.683">Ca</span> <span begin="1:33.683" end="1:34.094">și</span> <span begin="1:34.094" end="1:36.149">stelele</span> <span begin="1:36.149" end="1:36.560">pe</span> <span begin="1:36.560" end="1:37.970">boltă</span></p><p begin="1:37.970" end="1:44.736" ttm:agent="v1"><span begin="1:37.970" end="1:38.322">Vor</span> <span begin="1:38.322" end="1:39.437">sclipi,</span> <span begin="1:39.437" end="1:39.848">în</span> <span begin="1:39.848" end="1:44.736">veșnicii.</span></p><p begin="1:44.736" end="1:49.595" ttm:agent="v1"><span begin="1:44.736" end="1:45.546">Glasul</span> <span begin="1:45.546" end="1:47.570">Domnului</span> <span begin="1:47.570" end="1:47.975">ne</span> <span begin="1:47.975" end="1:49.595">cheamă,</span></p><p begin="1:49.595" end="1:54.453" ttm:agent="v1"><span begin="1:49.595" end="1:52.024">Secerișul</span> <span begin="1:52.024" end="1:52.428">e</span> <span begin="1:52.428" end="1:52.833">în</span> <span begin="1:52.833" end="1:54.453">toi!</span></p><p begin="1:54.453" end="1:59.311" ttm:agent="v1"><span begin="1:54.453" end="1:55.262">Cine-i</span> <span begin="1:55.262" end="1:56.882">gata</span> <span begin="1:56.882" end="1:57.286">să</span> <span begin="1:57.286" end="1:59.311">răspundă?</span></p><p begin="1:59.311" end="2:04.169" ttm:agent="v1"><span begin="1:59.311" end="2:00.120">„Iată,</span> <span begin="2:00.120" end="2:00.930">Doamne,</span> <span begin="2:00.930" end="2:02.549">suntem</span> <span begin="2:02.549" end="2:04.169">noi!”</span></p></div></body></tt>