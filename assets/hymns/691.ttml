<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>691. Pacea serii cade lin</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:33.179"><div><p begin="0:13.649" end="0:19.790" ttm:agent="v1"><span begin="0:13.649" end="0:15.184">Pacea</span> <span begin="0:15.184" end="0:16.720">serii</span> <span begin="0:16.720" end="0:18.255">cade</span> <span begin="0:18.255" end="0:19.790">lin,</span></p><p begin="0:19.790" end="0:25.931" ttm:agent="v1"><span begin="0:19.790" end="0:21.325">Dinspre</span> <span begin="0:21.325" end="0:22.860">stele</span> <span begin="0:22.860" end="0:24.396">îngeri</span> <span begin="0:24.396" end="0:25.931">vin;</span></p><p begin="0:25.931" end="0:32.072" ttm:agent="v1"><span begin="0:25.931" end="0:26.698">Las</span> <span begin="0:26.698" end="0:27.466">al</span> <span begin="0:27.466" end="0:29.001">lumii</span> <span begin="0:29.001" end="0:29.769">greu</span> <span begin="0:29.769" end="0:32.072">tumult,</span></p><p begin="0:32.072" end="0:39.872" ttm:agent="v1"><span begin="0:32.072" end="0:33.607">Șoapta</span> <span begin="0:33.607" end="0:35.910">cerului</span> <span begin="0:35.910" end="0:39.872">s-ascult...</span></p><p begin="0:39.872" end="0:45.921" ttm:agent="v1"><span begin="0:39.872" end="0:40.628">Prin</span> <span begin="0:40.628" end="0:42.897">Cuvântul</span> <span begin="0:42.897" end="0:43.653">Tău</span> <span begin="0:43.653" end="0:45.921">curat,</span></p><p begin="0:45.921" end="0:51.970" ttm:agent="v1"><span begin="0:45.921" end="0:46.677">Eu</span> <span begin="0:46.677" end="0:47.433">mă</span> <span begin="0:47.433" end="0:48.189">simt</span> <span begin="0:48.189" end="0:48.945">la</span> <span begin="0:48.945" end="0:49.701">cer</span> <span begin="0:49.701" end="0:51.970">‘nălțat...</span></p><p begin="0:51.970" end="0:58.018" ttm:agent="v1"><span begin="0:51.970" end="0:52.726">Sunt</span> <span begin="0:52.726" end="0:53.482">al</span> <span begin="0:53.482" end="0:54.238">Tău,</span> <span begin="0:54.238" end="0:56.506">Isuse</span> <span begin="0:56.506" end="0:58.018">bun,</span></p><p begin="0:58.018" end="1:05.907" ttm:agent="v1"><span begin="0:58.018" end="0:59.531">Într-o</span> <span begin="0:59.531" end="1:01.043">lume</span> <span begin="1:01.043" end="1:01.799">de</span> <span begin="1:01.799" end="1:05.907">minuni!</span></p><p begin="1:05.907" end="1:11.895" ttm:agent="v1"><span begin="1:05.907" end="1:07.404">Doamne,</span> <span begin="1:07.404" end="1:08.153">din</span> <span begin="1:08.153" end="1:10.398">seninul</span> <span begin="1:10.398" end="1:11.895">cer,</span></p><p begin="1:11.895" end="1:17.884" ttm:agent="v1"><span begin="1:11.895" end="1:13.392">Toarnă-n</span> <span begin="1:13.392" end="1:14.889">suflet</span> <span begin="1:14.889" end="1:17.884">mângâieri,</span></p><p begin="1:17.884" end="1:23.872" ttm:agent="v1"><span begin="1:17.884" end="1:20.878">Luminează</span> <span begin="1:20.878" end="1:22.375">noaptea</span> <span begin="1:22.375" end="1:23.872">mea</span></p><p begin="1:23.872" end="1:28.363" ttm:agent="v1"><span begin="1:23.872" end="1:26.866">Și-ncălzește-mi</span> <span begin="1:26.866" end="1:28.363">inima!</span></p></div></body></tt>