<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>781. Tu mi-ești speranța</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:56.898"><div><p begin="0:16.800" end="0:20.720" ttm:agent="v1"><span begin="0:16.800" end="0:17.780">Tu</span> <span begin="0:17.780" end="0:18.270">mi-ești</span> <span begin="0:18.270" end="0:20.720">speranța,</span></p><p begin="0:20.720" end="0:24.640" ttm:agent="v1"><span begin="0:20.720" end="0:21.700">Tu</span> <span begin="0:21.700" end="0:22.190">mi-ești</span> <span begin="0:22.190" end="0:22.680">chiar</span> <span begin="0:22.680" end="0:24.640">viața</span></p><p begin="0:24.640" end="0:32.480" ttm:agent="v1"><span begin="0:24.640" end="0:25.620">Și</span> <span begin="0:25.620" end="0:26.600">fața</span> <span begin="0:26.600" end="0:27.580">Ta</span> <span begin="0:27.580" end="0:29.540">privesc</span> <span begin="0:29.540" end="0:32.480">mereu;</span></p><p begin="0:32.480" end="0:40.320" ttm:agent="v1"><span begin="0:32.480" end="0:33.460">În</span> <span begin="0:33.460" end="0:36.400">tinerețe</span> <span begin="0:36.400" end="0:37.380">și-n</span> <span begin="0:37.380" end="0:40.320">bătrânețe</span></p><p begin="0:40.320" end="0:49.080" ttm:agent="v1"><span begin="0:40.320" end="0:41.300">Tu</span> <span begin="0:41.300" end="0:42.280">fi-vei,</span> <span begin="0:42.280" end="0:44.240">Doamne,</span> <span begin="0:44.240" end="0:46.200">scutul</span> <span begin="0:46.200" end="0:49.080">meu!</span></p><p begin="0:49.080" end="0:53.059" ttm:agent="v1"><span begin="0:49.080" end="0:50.075">Ah,</span> <span begin="0:50.075" end="0:50.572">ce</span> <span begin="0:50.572" end="0:53.059">iubire</span></p><p begin="0:53.059" end="0:57.038" ttm:agent="v1"><span begin="0:53.059" end="0:54.551">Aflu</span> <span begin="0:54.551" end="0:55.048">în</span> <span begin="0:55.048" end="0:57.038">Tine:</span></p><p begin="0:57.038" end="1:04.995" ttm:agent="v1"><span begin="0:57.038" end="0:58.032">În</span> <span begin="0:58.032" end="0:59.027">cale-mi</span> <span begin="0:59.027" end="1:01.016">semeni</span> <span begin="1:01.016" end="1:04.995">fericiri!</span></p><p begin="1:04.995" end="1:08.974" ttm:agent="v1"><span begin="1:04.995" end="1:06.487">Drumul</span> <span begin="1:06.487" end="1:06.985">e</span> <span begin="1:06.985" end="1:08.974">sigur,</span></p><p begin="1:08.974" end="1:12.953" ttm:agent="v1"><span begin="1:08.974" end="1:09.969">Când</span> <span begin="1:09.969" end="1:10.963">ochiu-Ți</span> <span begin="1:10.963" end="1:12.953">singur</span></p><p begin="1:12.953" end="1:21.810" ttm:agent="v1"><span begin="1:12.953" end="1:13.948">Mă</span> <span begin="1:13.948" end="1:14.942">are-n</span> <span begin="1:14.942" end="1:17.926">pașnice</span> <span begin="1:17.926" end="1:21.810">priviri!</span></p><p begin="1:21.810" end="1:25.769" ttm:agent="v1"><span begin="1:21.810" end="1:22.800">Plin</span> <span begin="1:22.800" end="1:23.295">de</span> <span begin="1:23.295" end="1:25.769">tărie,</span></p><p begin="1:25.769" end="1:29.728" ttm:agent="v1"><span begin="1:25.769" end="1:27.254">Graiu-Ți</span> <span begin="1:27.254" end="1:29.728">mă-mbie,</span></p><p begin="1:29.728" end="1:37.646" ttm:agent="v1"><span begin="1:29.728" end="1:30.718">Să</span> <span begin="1:30.718" end="1:32.697">’naintez</span> <span begin="1:32.697" end="1:33.687">în</span> <span begin="1:33.687" end="1:37.646">viitor!</span></p><p begin="1:37.646" end="1:41.605" ttm:agent="v1"><span begin="1:37.646" end="1:39.625">Laudă</span> <span begin="1:39.625" end="1:41.605">Ție</span></p><p begin="1:41.605" end="1:45.564" ttm:agent="v1"><span begin="1:41.605" end="1:43.090">Pentru</span> <span begin="1:43.090" end="1:45.564">vecie,</span></p><p begin="1:45.564" end="1:50.512" ttm:agent="v1"><span begin="1:45.564" end="1:47.543">Cânta-voi,</span> <span begin="1:47.543" end="1:48.533">drag</span> <span begin="1:48.533" end="1:50.512">Mântuitor!</span></p></div></body></tt>