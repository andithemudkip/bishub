<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>490. Voi, servii Domnului</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:36.993"><div><p begin="0:11.477" end="0:16.322" ttm:agent="v1"><span begin="0:11.477" end="0:12.083">Voi,</span> <span begin="0:12.083" end="0:13.294">servii</span> <span begin="0:13.294" end="0:16.322">Domnului,</span></p><p begin="0:16.322" end="0:21.166" ttm:agent="v1"><span begin="0:16.322" end="0:17.533">Vestiți</span> <span begin="0:17.533" end="0:18.139">al</span> <span begin="0:18.139" end="0:18.744">Său</span> <span begin="0:18.744" end="0:21.166">Cuvânt,</span></p><p begin="0:21.166" end="0:26.011" ttm:agent="v1"><span begin="0:21.166" end="0:21.772">Căci</span> <span begin="0:21.772" end="0:22.378">voi</span> <span begin="0:22.378" end="0:23.589">sunteți</span> <span begin="0:23.589" end="0:25.405">străjerii</span> <span begin="0:25.405" end="0:26.011">Lui</span></p><p begin="0:26.011" end="0:32.556" ttm:agent="v1"><span begin="0:26.011" end="0:27.155">Pe-acest</span> <span begin="0:27.155" end="0:28.770">străin</span> <span begin="0:28.770" end="0:32.556">pământ.</span></p><p begin="0:32.556" end="0:37.400" ttm:agent="v1"><span begin="0:32.556" end="0:33.161">Cu</span> <span begin="0:33.161" end="0:34.978">lămpile</span> <span begin="0:34.978" end="0:37.400">arzând</span></p><p begin="0:37.400" end="0:42.245" ttm:agent="v1"><span begin="0:37.400" end="0:38.611">Vegheați</span> <span begin="0:38.611" end="0:39.520">în</span> <span begin="0:39.520" end="0:40.428">noaptea</span> <span begin="0:40.428" end="0:42.245">grea,</span></p><p begin="0:42.245" end="0:47.089" ttm:agent="v1"><span begin="0:42.245" end="0:42.850">Vă</span> <span begin="0:42.850" end="0:44.667">pregătiți</span> <span begin="0:44.667" end="0:45.273">un</span> <span begin="0:45.273" end="0:46.484">alb</span> <span begin="0:46.484" end="0:47.089">veșmânt,</span></p><p begin="0:47.089" end="0:52.154" ttm:agent="v1"><span begin="0:47.089" end="0:48.233">Ieșiți</span> <span begin="0:48.233" end="0:50.117">‘naintea</span> <span begin="0:50.117" end="0:52.154">Sa!</span></p><p begin="0:52.154" end="0:56.974" ttm:agent="v1"><span begin="0:52.154" end="0:52.757">Va</span> <span begin="0:52.757" end="0:53.359">fi</span> <span begin="0:53.359" end="0:55.167">venirea</span> <span begin="0:55.167" end="0:56.974">Sa</span></p><p begin="0:56.974" end="1:01.795" ttm:agent="v1"><span begin="0:56.974" end="0:57.577">Un</span> <span begin="0:57.577" end="0:58.782">fulger</span> <span begin="0:58.782" end="0:59.385">în</span> <span begin="0:59.385" end="1:01.795">apus</span></p><p begin="1:01.795" end="1:06.615" ttm:agent="v1"><span begin="1:01.795" end="1:02.397">Și</span> <span begin="1:02.397" end="1:03.602">orice</span> <span begin="1:03.602" end="1:04.205">ochi</span> <span begin="1:04.205" end="1:04.807">Îl</span> <span begin="1:04.807" end="1:05.410">va</span> <span begin="1:05.410" end="1:06.615">vedea</span></p><p begin="1:06.615" end="1:14.395" ttm:agent="v1"><span begin="1:06.615" end="1:07.218">Pe-al</span> <span begin="1:07.218" end="1:08.289">păcii</span> <span begin="1:08.289" end="1:09.360">Domn,</span> <span begin="1:09.360" end="1:14.395">Isus.</span></p><p begin="1:14.395" end="1:19.240" ttm:agent="v1"><span begin="1:14.395" end="1:15.001">O,</span> <span begin="1:15.001" end="1:16.212">frate,</span> <span begin="1:16.212" end="1:17.423">intră-n</span> <span begin="1:17.423" end="1:19.240">rând,</span></p><p begin="1:19.240" end="1:24.084" ttm:agent="v1"><span begin="1:19.240" end="1:19.845">Spre</span> <span begin="1:19.845" end="1:21.057">slava</span> <span begin="1:21.057" end="1:21.662">lui</span> <span begin="1:21.662" end="1:24.084">Hristos,</span></p><p begin="1:24.084" end="1:28.929" ttm:agent="v1"><span begin="1:24.084" end="1:24.690">Să</span> <span begin="1:24.690" end="1:25.296">fii</span> <span begin="1:25.296" end="1:25.901">și</span> <span begin="1:25.901" end="1:26.507">tu</span> <span begin="1:26.507" end="1:27.718">numit,</span> <span begin="1:27.718" end="1:28.929">curând,</span></p><p begin="1:28.929" end="1:31.822" ttm:agent="v1"><span begin="1:28.929" end="1:29.534">„Rob</span> <span begin="1:29.534" end="1:30.073">bun</span> <span begin="1:30.073" end="1:30.611">și</span> <span begin="1:30.611" end="1:31.822">credincios”!</span></p></div></body></tt>