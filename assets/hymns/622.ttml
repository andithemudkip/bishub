<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>622. Imn de laudă</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:31.507"><div><p begin="0:04.950" end="0:10.318" ttm:agent="v1"><span begin="0:04.950" end="0:05.621">Imn</span> <span begin="0:05.621" end="0:06.292">de</span> <span begin="0:06.292" end="0:08.305">laudă</span> <span begin="0:08.305" end="0:10.318">’nălțăm</span></p><p begin="0:10.318" end="0:21.054" ttm:agent="v1"><span begin="0:10.318" end="0:11.660">Către</span> <span begin="0:11.660" end="0:13.002">Tine,</span> <span begin="0:13.002" end="0:13.673">sfânt</span> <span begin="0:13.673" end="0:21.054">Părinte,</span></p><p begin="0:21.054" end="0:26.422" ttm:agent="v1"><span begin="0:21.054" end="0:21.725">Și,</span> <span begin="0:21.725" end="0:22.396">din</span> <span begin="0:22.396" end="0:23.738">suflet,</span> <span begin="0:23.738" end="0:25.080">Te</span> <span begin="0:25.080" end="0:26.422">rugăm</span></p><p begin="0:26.422" end="0:37.158" ttm:agent="v1"><span begin="0:26.422" end="0:27.093">Să</span> <span begin="0:27.093" end="0:28.435">ne-nveți</span> <span begin="0:28.435" end="0:30.448">cuvinte</span> <span begin="0:30.448" end="0:37.158">sfinte!</span></p><p begin="0:37.158" end="0:42.526" ttm:agent="v1"><span begin="0:37.158" end="0:39.171">Tuturor</span> <span begin="0:39.171" end="0:39.842">să</span> <span begin="0:39.842" end="0:42.526">dăruiești</span></p><p begin="0:42.526" end="0:44.554" ttm:agent="v1"><span begin="0:42.526" end="0:45.881">Binecuvântări</span> <span begin="0:45.881" end="0:44.554">cerești!</span></p><p begin="0:44.554" end="0:50.190" ttm:agent="v1"><span begin="0:44.554" end="0:45.259">Cer,</span> <span begin="0:45.259" end="0:46.668">pământ,</span> <span begin="0:46.668" end="0:47.372">azi</span> <span begin="0:47.372" end="0:48.077">se</span> <span begin="0:48.077" end="0:50.190">unesc</span></p><p begin="0:50.190" end="1:01.463" ttm:agent="v1"><span begin="0:50.190" end="0:50.895">În</span> <span begin="0:50.895" end="0:53.009">această</span> <span begin="0:53.009" end="1:01.463">adunare</span></p><p begin="1:01.463" end="1:07.100" ttm:agent="v1"><span begin="1:01.463" end="1:02.168">Când</span> <span begin="1:02.168" end="1:03.577">Cuvânt</span> <span begin="1:03.577" end="1:07.100">dumnezeiesc</span></p><p begin="1:07.100" end="1:18.372" ttm:agent="v1"><span begin="1:07.100" end="1:07.804">Vrei</span> <span begin="1:07.804" end="1:09.213">să-mparți</span> <span begin="1:09.213" end="1:09.918">la</span> <span begin="1:09.918" end="1:18.372">fiecare;</span></p><p begin="1:18.372" end="1:24.009" ttm:agent="v1"><span begin="1:18.372" end="1:19.782">Roua</span> <span begin="1:19.782" end="1:21.895">Duhului</span> <span begin="1:21.895" end="1:22.600">Tău</span> <span begin="1:22.600" end="1:24.009">Sfânt</span></p><p begin="1:24.009" end="1:28.941" ttm:agent="v1"><span begin="1:24.009" end="1:26.827">Să-ntărească-al</span> <span begin="1:26.827" end="1:27.532">Tău</span> <span begin="1:27.532" end="1:28.941">Cuvânt!</span></p></div></body></tt>