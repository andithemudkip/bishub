<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>478. Mai sus de-albastre zări</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:28.480"><div><p begin="0:05.480" end="0:11.156" ttm:agent="v1"><span begin="0:05.480" end="0:06.180">Mai</span> <span begin="0:06.180" end="0:06.879">sus</span> <span begin="0:06.879" end="0:08.979">de-albastre</span> <span begin="0:08.979" end="0:10.223">zări,</span> <span begin="0:10.223" end="0:11.156">lăsăm</span></p><p begin="0:11.156" end="0:16.676" ttm:agent="v1"><span begin="0:11.156" end="0:13.022">Privirea</span> <span begin="0:13.022" end="0:13.955">să</span> <span begin="0:13.955" end="0:14.577">ne</span> <span begin="0:14.577" end="0:16.676">zboare,</span></p><p begin="0:16.676" end="0:22.352" ttm:agent="v1"><span begin="0:16.676" end="0:17.376">De</span> <span begin="0:17.376" end="0:18.775">unde,</span> <span begin="0:18.775" end="0:20.175">grabnic,</span> <span begin="0:20.175" end="0:22.352">așteptăm</span></p><p begin="0:22.352" end="0:27.872" ttm:agent="v1"><span begin="0:22.352" end="0:22.974">Pe</span> <span begin="0:22.974" end="0:24.218">Domnul,</span> <span begin="0:24.218" end="0:25.151">să</span> <span begin="0:25.151" end="0:27.872">coboare</span></p><p begin="0:27.872" end="0:33.470" ttm:agent="v1"><span begin="0:27.872" end="0:28.572">În</span> <span begin="0:28.572" end="0:29.971">slava</span> <span begin="0:29.971" end="0:30.671">Lui,</span> <span begin="0:30.671" end="0:31.371">pe</span> <span begin="0:31.371" end="0:32.770">norul</span> <span begin="0:32.770" end="0:33.470">alb,</span></p><p begin="0:33.470" end="0:39.068" ttm:agent="v1"><span begin="0:33.470" end="0:34.170">Pe</span> <span begin="0:34.170" end="0:34.869">cei</span> <span begin="0:34.869" end="0:36.269">aleși</span> <span begin="0:36.269" end="0:39.068">s-adune!</span></p><p begin="0:39.068" end="0:47.306" ttm:agent="v1"><span begin="0:39.068" end="0:40.467">Așa</span> <span begin="0:40.467" end="0:42.566">Cuvântul</span> <span begin="0:42.566" end="0:47.306">spune!</span></p><p begin="0:47.306" end="0:52.953" ttm:agent="v1"><span begin="0:47.306" end="0:49.394">Trecut-au</span> <span begin="0:49.394" end="0:50.091">ani</span> <span begin="0:50.091" end="0:50.787">de</span> <span begin="0:50.787" end="0:52.953">suferinți,</span></p><p begin="0:52.953" end="0:58.446" ttm:agent="v1"><span begin="0:52.953" end="0:53.572">Cu</span> <span begin="0:53.572" end="0:55.738">pribegiri</span> <span begin="0:55.738" end="0:58.446">amare</span></p><p begin="0:58.446" end="1:04.093" ttm:agent="v1"><span begin="0:58.446" end="0:59.142">Și-n</span> <span begin="0:59.142" end="1:00.534">dorul</span> <span begin="1:00.534" end="1:03.165">lacrimii</span> <span begin="1:03.165" end="1:04.093">fierbinți</span></p><p begin="1:04.093" end="1:09.586" ttm:agent="v1"><span begin="1:04.093" end="1:05.950">E-atâta</span> <span begin="1:05.950" end="1:09.586">așteptare...</span></p><p begin="1:09.586" end="1:15.155" ttm:agent="v1"><span begin="1:09.586" end="1:10.282">De</span> <span begin="1:10.282" end="1:12.370">ce-ntârzii,</span> <span begin="1:12.370" end="1:14.459">Isuse</span> <span begin="1:14.459" end="1:15.155">bun?</span></p><p begin="1:15.155" end="1:20.725" ttm:agent="v1"><span begin="1:15.155" end="1:15.852">Ni-e</span> <span begin="1:15.852" end="1:17.940">inima</span> <span begin="1:17.940" end="1:20.725">pustie!</span></p><p begin="1:20.725" end="1:25.695" ttm:agent="v1"><span begin="1:20.725" end="1:21.422">O,</span> <span begin="1:21.422" end="1:22.118">vin’</span> <span begin="1:22.118" end="1:22.814">și</span> <span begin="1:22.814" end="1:23.859">ne</span> <span begin="1:23.859" end="1:25.695">mângâie!</span></p><p begin="1:25.69