<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>293. Nu ceda ispitei!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="3:04.398"><div><p begin="0:28.180" end="0:37.095" ttm:agent="v1"><span begin="0:28.180" end="0:29.016">Nu</span> <span begin="0:29.016" end="0:29.852">ceda</span> <span begin="0:29.852" end="0:32.638">ispitei,</span> <span begin="0:32.638" end="0:33.752">luptă</span> <span begin="0:33.752" end="0:34.866">tot</span> <span begin="0:34.866" end="0:37.095">mereu,</span></p><p begin="0:37.095" end="0:46.010" ttm:agent="v1"><span begin="0:37.095" end="0:38.210">Coste</span> <span begin="0:38.210" end="0:41.553">biruința</span> <span begin="0:41.553" end="0:42.667">prețul</span> <span begin="0:42.667" end="0:43.224">cel</span> <span begin="0:43.224" end="0:43.782">mai</span> <span begin="0:43.782" end="0:46.010">greu!</span></p><p begin="0:46.010" end="0:54.926" ttm:agent="v1"><span begin="0:46.010" end="0:47.125">Dacă</span> <span begin="0:47.125" end="0:47.682">chiar</span> <span begin="0:47.682" end="0:50.468">Satana</span> <span begin="0:50.468" end="0:51.304">ți-ar</span> <span begin="0:51.304" end="0:52.140">porni</span> <span begin="0:52.140" end="0:54.926">război,</span></p><p begin="0:54.926" end="1:05.280" ttm:agent="v1"><span begin="0:54.926" end="0:56.040">Spre</span> <span begin="0:56.040" end="0:56.597">Isus</span> <span begin="0:56.597" end="0:59.383">privește</span> <span begin="0:59.383" end="1:00.219">și</span> <span begin="1:00.219" end="1:00.498">nu</span> <span begin="1:00.498" end="1:01.612">da</span> <span begin="1:01.612" end="1:05.280">‘napoi!</span></p><p begin="1:05.280" end="1:14.061" ttm:agent="v1"><span begin="1:05.280" end="1:06.103">Fugi</span> <span begin="1:06.103" end="1:06.378">de</span> <span begin="1:06.378" end="1:06.926">răi</span> <span begin="1:06.926" end="1:09.670">tovarăși,</span> <span begin="1:09.670" end="1:11.317">ține-te</span> <span begin="1:11.317" end="1:14.061">curat,</span></p><p begin="1:14.061" end="1:22.842" ttm:agent="v1"><span begin="1:14.061" end="1:14.884">Nu</span> <span begin="1:14.884" end="1:15.707">lăsa</span> <span begin="1:15.707" end="1:16.256">să-ți</span> <span begin="1:16.256" end="1:18.451">piară</span> <span begin="1:18.451" end="1:19.549">teama</span> <span begin="1:19.549" end="1:20.098">de</span> <span begin="1:20.098" end="1:22.842">păcat!</span></p><p begin="1:22.842" end="1:31.622" ttm:agent="v1"><span begin="1:22.842" end="1:23.665">Chiar</span> <span begin="1:23.665" end="1:23.939">când</span> <span begin="1:23.939" end="1:24.488">în</span> <span begin="1:24.488" end="1:27.232">credință</span> <span begin="1:27.232" end="1:28.055">au</span> <span begin="1:28.055" end="1:28.878">rămas</span> <span begin="1:28.878" end="1:29.427">doar</span> <span begin="1:29.427" end="1:31.622">doi,</span></p><p begin="1:31.622" end="1:46.334" ttm:agent="v1"><span begin="1:31.622" end="1:32.720">Spre</span> <span begin="1:32.720" end="1:33.269">Isus</span> <span begin="1:33.269" end="1:36.013">privește,</span> <span begin="1:36.013" end="1:36.836">și</span> <span begin="1:36.836" end="1:37.110">nu</span> <span begin="1:37.110" end="1:46.334">da-napoi!</span></p><p begin="1:46.334" end="1:55.114" ttm:agent="v1"><span begin="1:46.334" end="1:47.980">Luptător</span> <span begin="1:47.980" end="1:48.529">al</span> <span begin="1:48.529" end="1:50.724">crucii,</span> <span begin="1:50.724" end="1:52.370">răsplătit</span> <span begin="1:52.370" end="1:52.919">vei</span> <span begin="1:52.919" end="1:55.114">fi!</span></p><p begin="1:55.114" end="2:03.893" ttm:agent="v1"><span begin="1:55.114" end="1:56.211">Rabdă,</span> <span begin="1:56.211" end="1:56.760">chiar</span> <span begin="1:56.760" end="1:57.309">când</span> <span begin="1:57.309" end="1:59.503">lumea</span> <span begin="1:59.503" end="2:00.327">te-ar</span> <span begin="2:00.327" end="2:03.893">batjocori!</span></p><p begin="2:03.893" end="2:12.673" ttm:agent="v1"><span begin="2:03.893" end="2:04.717">Să</span> <span begin="2:04.717" end="2:04.991">nu-ți</span> <span begin="2:04.991" end="2:05.540">pierzi</span> <span begin="2:05.540" end="2:08.283">curajul</span> <span begin="2:08.283" end="2:09.107">când</span> <span begin="2:09.107" end="2:09.381">vezi</span> <span begin="2:09.381" end="2:10.478">lupta-n</span> <span begin="2:10.478" end="2:12.673">toi,</span></p><p begin="2:12.673" end="2:21.453" ttm:agent="v1"><span begin="2:12.673" end="2:13.771">Spre</span> <span begin="2:13.771" end="2:14.320">Isus</span> <span begin="2:14.320" end="2:17.063">privește</span> <span begin="2:17.063" end="2:17.886">și</span> <span begin="2:17.886" end="2:18.161">nu</span> <span begin="2:18.161" end="2:19.258">da</span> <span begin="2:19.258" end="2:21.453">‘napoi!</span></p></div></body></tt>