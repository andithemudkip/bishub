<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>543. Privește la Domnul!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:46.371"><div><p begin="0:06.460" end="0:13.334" ttm:agent="v1"><span begin="0:06.460" end="0:08.178">Privește</span> <span begin="0:08.178" end="0:08.751">la</span> <span begin="0:08.751" end="0:09.897">Domnul</span> <span begin="0:09.897" end="0:10.470">și</span> <span begin="0:10.470" end="0:11.329">nu</span> <span begin="0:11.329" end="0:13.334">dispera,</span></p><p begin="0:13.334" end="0:20.208" ttm:agent="v1"><span begin="0:13.334" end="0:13.907">El</span> <span begin="0:13.907" end="0:15.052">știe</span> <span begin="0:15.052" end="0:16.771">durerea</span> <span begin="0:16.771" end="0:17.344">din</span> <span begin="0:17.344" end="0:19.062">inima</span> <span begin="0:19.062" end="0:20.208">ta!</span></p><p begin="0:20.208" end="0:29.282" ttm:agent="v1"><span begin="0:20.208" end="0:20.781">El</span> <span begin="0:20.781" end="0:22.499">simte</span> <span begin="0:22.499" end="0:23.645">azi</span> <span begin="0:23.645" end="0:24.217">cu</span> <span begin="0:24.217" end="0:29.282">tine...</span></p><p begin="0:29.282" end="0:35.812" ttm:agent="v1"><span begin="0:29.282" end="0:29.826">Noi</span> <span begin="0:29.826" end="0:30.914">plângem</span> <span begin="0:30.914" end="0:31.458">cu</span> <span begin="0:31.458" end="0:32.002">cei</span> <span begin="0:32.002" end="0:32.547">ce</span> <span begin="0:32.547" end="0:34.179">suspină</span> <span begin="0:34.179" end="0:34.723">și</span> <span begin="0:34.723" end="0:35.812">plâng;</span></p><p begin="0:35.812" end="0:42.342" ttm:agent="v1"><span begin="0:35.812" end="0:36.356">În</span> <span begin="0:36.356" end="0:37.444">rugă</span> <span begin="0:37.444" end="0:37.988">și</span> <span begin="0:37.988" end="0:39.621">mâinile</span> <span begin="0:39.621" end="0:40.709">noastre</span> <span begin="0:40.709" end="0:41.254">se</span> <span begin="0:41.254" end="0:42.342">strâng</span></p><p begin="0:42.342" end="0:50.752" ttm:agent="v1"><span begin="0:42.342" end="0:42.886">Și</span> <span begin="0:42.886" end="0:44.519">suntem</span> <span begin="0:44.519" end="0:46.151">lângă</span> <span begin="0:46.151" end="0:50.752">tine!</span></p><p begin="0:50.752" end="0:57.348" ttm:agent="v1"><span begin="0:50.752" end="0:51.302">Cu</span> <span begin="0:51.302" end="0:52.401">Domnul</span> <span begin="0:52.401" end="0:52.951">să</span> <span begin="0:52.951" end="0:53.500">nu-ți</span> <span begin="0:53.500" end="0:54.599">fie</span> <span begin="0:54.599" end="0:55.699">frică</span> <span begin="0:55.699" end="0:57.348">defel:</span></p><p begin="0:57.348" end="1:03.943" ttm:agent="v1"><span begin="0:57.348" end="0:57.897">Să</span> <span begin="0:57.897" end="0:58.447">treci</span> <span begin="0:58.447" end="1:00.645">suferința</span> <span begin="1:00.645" end="1:01.195">te</span> <span begin="1:01.195" end="1:02.844">sprijină</span> <span begin="1:02.844" end="1:03.943">El,</span></p><p begin="1:03.943" end="1:11.278" ttm:agent="v1"><span begin="1:03.943" end="1:04.493">Cu</span> <span begin="1:04.493" end="1:07.241">brațele-I</span> <span begin="1:07.241" end="1:11.278">divine!</span></p><p begin="1:11.278" end="1:18.039" ttm:agent="v1"><span begin="1:11.278" end="1:11.842">Se</span> <span begin="1:11.842" end="1:12.969">scrie</span> <span begin="1:12.969" end="1:13.532">în</span> <span begin="1:13.532" end="1:14.095">cer</span> <span begin="1:14.095" end="1:15.222">toată</span> <span begin="1:15.222" end="1:16.912">lacrima</span> <span begin="1:16.912" end="1:18.039">ta.</span></p><p begin="1:18.039" end="1:24.799" ttm:agent="v1"><span begin="1:18.039" end="1:18.602">Tu</span> <span begin="1:18.602" end="1:19.166">n-ai</span> <span begin="1:19.166" end="1:19.729">să</span> <span begin="1:19.729" end="1:20.292">treci</span> <span begin="1:20.292" end="1:21.419">singur</span> <span begin="1:21.419" end="1:21.982">prin</span> <span begin="1:21.982" end="1:23.109">ora</span> <span begin="1:23.109" end="1:23.672">cea</span> <span begin="1:23.672" end="1:24.799">grea:</span></p><p begin="1:24.799" end="1:30.996" ttm:agent="v1"><span begin="1:24.799" end="1:26.489">Isus</span> <span begin="1:26.489" end="1:27.053">e</span> <span begin="1:27.053" end="1:28.743">lângă</span> <span begin="1:28.743" end="1:30.996">tine.</span></p></div></body></tt>