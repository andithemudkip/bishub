<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>106. Noapte-adâncă s-a lăsat</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:56.741"><div><p begin="0:12.190" end="0:17.412" ttm:agent="v1"><span begin="0:12.190" end="0:14.801">Noapte-adâncă</span> <span begin="0:14.801" end="0:15.454">s-a</span> <span begin="0:15.454" end="0:17.412">lăsat,</span></p><p begin="0:17.412" end="0:22.635" ttm:agent="v1"><span begin="0:17.412" end="0:18.065">Viu</span> <span begin="0:18.065" end="0:18.718">e</span> <span begin="0:18.718" end="0:20.024">cerul,</span> <span begin="0:20.024" end="0:22.635">minunat!</span></p><p begin="0:22.635" end="0:27.857" ttm:agent="v1"><span begin="0:22.635" end="0:24.593">Fremătând,</span> <span begin="0:24.593" end="0:25.246">o</span> <span begin="0:25.246" end="0:25.826">stea</span> <span begin="0:25.826" end="0:27.857">răsare,</span></p><p begin="0:27.857" end="0:33.080" ttm:agent="v1"><span begin="0:27.857" end="0:28.510">Ca</span> <span begin="0:28.510" end="0:29.163">o</span> <span begin="0:29.163" end="0:30.468">dalbă</span> <span begin="0:30.468" end="0:33.080">floare...</span></p><p begin="0:33.080" end="0:38.302" ttm:agent="v1"><span begin="0:33.080" end="0:34.385">Steaua</span> <span begin="0:34.385" end="0:35.038">ce</span> <span begin="0:35.038" end="0:35.691">ne-a</span> <span begin="0:35.691" end="0:38.302">răsărit</span></p><p begin="0:38.302" end="0:46.084" ttm:agent="v1"><span begin="0:38.302" end="0:39.934">Este</span> <span begin="0:39.934" end="0:40.913">Domnul</span> <span begin="0:40.913" end="0:41.566">mult</span> <span begin="0:41.566" end="0:46.084">dorit.</span></p><p begin="0:46.084" end="0:51.307" ttm:agent="v1"><span begin="0:46.084" end="0:46.737">Sus,</span> <span begin="0:46.737" end="0:47.390">pe</span> <span begin="0:47.390" end="0:48.696">cerul</span> <span begin="0:48.696" end="0:51.307">înstelat,</span></p><p begin="0:51.307" end="0:56.529" ttm:agent="v1"><span begin="0:51.307" end="0:51.960">Un</span> <span begin="0:51.960" end="0:53.918">luceafăr</span> <span begin="0:53.918" end="0:56.529">minunat,</span></p><p begin="0:56.529" end="1:01.752" ttm:agent="v1"><span begin="0:56.529" end="0:57.182">Cu</span> <span begin="0:57.182" end="0:58.488">aripi</span> <span begin="0:58.488" end="1:01.752">scânteietoare:</span></p><p begin="1:01.752" end="1:06.974" ttm:agent="v1"><span begin="1:01.752" end="1:02.404">Ce</span> <span begin="1:02.404" end="1:03.057">să</span> <span begin="1:03.057" end="1:04.363">fie</span> <span begin="1:04.363" end="1:06.974">oare?...</span></p><p begin="1:06.974" end="1:12.196" ttm:agent="v1"><span begin="1:06.974" end="1:07.627">Grup</span> <span begin="1:07.627" end="1:08.280">de</span> <span begin="1:08.280" end="1:09.585">îngeri,</span> <span begin="1:09.585" end="1:10.238">zeci</span> <span begin="1:10.238" end="1:10.891">de</span> <span begin="1:10.891" end="1:12.196">mii,</span></p><p begin="1:12.196" end="1:18.599" ttm:agent="v1"><span begin="1:12.196" end="1:12.849">Soli</span> <span begin="1:12.849" end="1:13.502">și</span> <span begin="1:13.502" end="1:14.155">ai</span> <span begin="1:14.155" end="1:16.113">luminii</span> <span begin="1:16.113" end="1:18.599">fii.</span></p><p begin="1:18.599" end="1:23.873" ttm:agent="v1"><span begin="1:18.599" end="1:19.258">Și</span> <span begin="1:19.258" end="1:19.917">din</span> <span begin="1:19.917" end="1:21.236">grupul</span> <span begin="1:21.236" end="1:23.873">luminos,</span></p><p begin="1:23.873" end="1:29.148" ttm:agent="v1"><span begin="1:23.873" end="1:24.533">Cor</span> <span begin="1:24.533" end="1:25.192">de</span> <span begin="1:25.192" end="1:26.511">îngeri,</span> <span begin="1:26.511" end="1:29.148">maiestuos,</span></p><p begin="1:29.148" end="1:34.423" ttm:agent="v1"><span begin="1:29.148" end="1:29.807">Se</span> <span begin="1:29.807" end="1:31.785">desprinde</span> <span begin="1:31.785" end="1:32.371">o</span> <span begin="1:32.371" end="1:34.423">cântare,</span></p><p begin="1:34.423" end="1:39.697" ttm:agent="v1"><span begin="1:34.423" end="1:37.060">Bucurie</span> <span begin="1:37.060" end="1:39.697">mare:</span></p><p begin="1:39.697" end="1:44.972" ttm:agent="v1"><span begin="1:39.697" end="1:41.016">Slavă,</span> <span begin="1:41.016" end="1:42.335">slavă</span> <span begin="1:42.335" end="1:43.653">Celui</span> <span begin="1:43.653" end="1:44.972">sfânt!</span></p><p begin="1:44.972" end="1:49.587" ttm:agent="v1"><span begin="1:44.972" end="1:46.291">Pace,</span> <span begin="1:46.291" end="1:47.609">pace</span> <span begin="1:47.609" end="1:48.269">pe</span> <span begin="1:48.269" end="1:49.587">pământ!</span></p></div></body></tt>