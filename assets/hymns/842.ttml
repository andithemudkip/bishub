<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>842. Când odată va să sune</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:39.896"><div><p begin="0:07.030" end="0:09.718" ttm:agent="v1"><span begin="0:07.030" end="0:07.397">Când</span> <span begin="0:07.397" end="0:08.415">odată</span> <span begin="0:08.415" end="0:08.741">va</span> <span begin="0:08.741" end="0:09.067">să</span> <span begin="0:09.067" end="0:09.718">sune</span></p><p begin="0:09.718" end="0:12.896" ttm:agent="v1"><span begin="0:09.718" end="0:11.063">Trâmbița</span> <span begin="0:11.063" end="0:11.429">prin</span> <span begin="0:11.429" end="0:11.796">munți</span> <span begin="0:11.796" end="0:12.162">și</span> <span begin="0:12.162" end="0:12.896">văi</span></p><p begin="0:12.896" end="0:18.761" ttm:agent="v1"><span begin="0:12.896" end="0:13.262">Și</span> <span begin="0:13.262" end="0:13.629">când</span> <span begin="0:13.629" end="0:14.281">Domnul</span> <span begin="0:14.281" end="0:14.606">va</span> <span begin="0:14.606" end="0:15.584">s-adune</span> <span begin="0:15.584" end="0:15.910">pe</span> <span begin="0:15.910" end="0:16.562">ai</span> <span begin="0:16.562" end="0:18.761">Săi,</span></p><p begin="0:18.761" end="0:24.627" ttm:agent="v1"><span begin="0:18.761" end="0:19.128">Noi</span> <span begin="0:19.128" end="0:19.494">ne</span> <span begin="0:19.494" end="0:19.820">vom</span> <span begin="0:19.820" end="0:21.124">înfățișa</span> <span begin="0:21.124" end="0:21.450">la</span> <span begin="0:21.450" end="0:22.427">marea</span> <span begin="0:22.427" end="0:23.160">lină</span> <span begin="0:23.160" end="0:23.527">de</span> <span begin="0:23.527" end="0:24.627">cristal</span></p><p begin="0:24.627" end="0:27.552" ttm:agent="v1"><span begin="0:24.627" end="0:24.993">Și</span> <span begin="0:24.993" end="0:25.360">în</span> <span begin="0:25.360" end="0:25.727">cor</span> <span begin="0:25.727" end="0:26.826">înalt</span> <span begin="0:26.826" end="0:27.926">cânta-vom</span> <span begin="0:27.926" end="0:27.552">triumfal!</span></p><p begin="0:27.552" end="0:33.330" ttm:agent="v1"><span begin="0:27.552" end="0:27.914">O,</span> <span begin="0:27.914" end="0:28.275">ce</span> <span begin="0:28.275" end="0:33.330">fericire</span></p><p begin="0:33.330" end="0:39.108" ttm:agent="v1"><span begin="0:33.330" end="0:33.691">Când</span> <span begin="0:33.691" end="0:34.373">la</span> <span begin="0:34.373" end="0:35.015">sunetul</span> <span begin="0:35.015" end="0:35.336">de</span> <span begin="0:35.336" end="0:35.978">trâmbiți</span> <span begin="0:35.978" end="0:36.299">ne-om</span> <span begin="0:36.299" end="0:39.108">vedea,</span></p><p begin="0:39.108" end="0:44.885" ttm:agent="v1"><span begin="0:39.108" end="0:39.469">Cu</span> <span begin="0:39.469" end="0:41.274">Isus,</span> <span begin="0:41.274" end="0:42.719">cu</span> <span begin="0:42.719" end="0:44.885">Isus!</span></p><p begin="0:44.885" end="0:51.983" ttm:agent="v1"><span begin="0:44.885" end="0:45.246">O</span> <span begin="0:45.246" end="0:45.607">ce</span> <span begin="0:45.607" end="0:47.052">fericire</span> <span begin="0:47.052" end="0:47.774">mare</span> <span begin="0:47.774" end="0:48.135">vom</span> <span begin="0:48.135" end="0:51.983">avea!</span></p><p begin="0:51.983" end="0:54.604" ttm:agent="v1"><span begin="0:51.983" end="0:52.340">Și</span> <span begin="0:52.340" end="0:52.698">când</span> <span begin="0:52.698" end="0:53.651">îngerul</span> <span begin="0:53.651" end="0:53.969">din</span> <span begin="0:53.969" end="0:54.604">ceruri</span></p><p begin="0:54.604" end="0:57.703" ttm:agent="v1"><span begin="0:54.604" end="0:55.240">Va</span> <span begin="0:55.240" end="0:55.915">striga</span> <span begin="0:55.915" end="0:56.273">în</span> <span begin="0:56.273" end="0:57.703">infinit:</span></p><p begin="0:57.703" end="1:03.780" ttm:agent="v1"><span begin="0:57.703" end="0:58.060">„Nu</span> <span begin="0:58.060" end="0:58.418">mai</span> <span begin="0:58.418" end="0:59.053">este</span> <span begin="0:59.053" end="0:59.689">timp</span> <span begin="0:59.689" end="1:00.324">de-acuma,</span> <span begin="1:00.324" end="1:00.642">s-a</span> <span begin="1:00.642" end="1:03.780">sfârșit!”</span></p><p begin="1:03.780" end="1:09.142" ttm:agent="v1"><span begin="1:03.780" end="1:04.455">Domnu-atunci</span> <span begin="1:04.455" end="1:04.773">îi</span> <span begin="1:04.773" end="1:05.091">va</span> <span begin="1:05.091" end="1:06.044">conduce</span> <span begin="1:06.044" end="1:06.680">pe</span> <span begin="1:06.680" end="1:06.997">toți</span> <span begin="1:06.997" end="1:08.427">credincioșii</span> <span begin="1:08.427" end="1:09.142">Lui</span></p><p begin="1:09.142" end="1:13.482" ttm:agent="v1"><span begin="1:09.142" end="1:09.500">În</span> <span begin="1:09.500" end="1:10.572">splendoarea</span> <span begin="1:10.572" end="1:12.002">minunată-a</span> <span begin="1:12.002" end="1:13.482">cerului!</span></p><p begin="1:13.482" end="1:19.202" ttm:agent="v1"><span begin="1:13.482" end="1:13.840">O,</span> <span begin="1:13.840" end="1:14.197">ce</span> <span begin="1:14.197" end="1:19.202">fericire</span></p><p begin="1:19.202" end="1:24.922" ttm:agent="v1"><span begin="1:19.202" end="1:19.560">Când</span> <span begin="1:19.560" end="1:20.235">la</span> <span begin="1:20.235" end="1:20.870">sunetul</span> <span begin="1:20.870" end="1:21.188">de</span> <span begin="1:21.188" end="1:21.824">trâmbiți</span> <span begin="1:21.824" end="1:22.141">ne-om</span> <span begin="1:22.141" end="1:24.922">vedea,</span></p><p begin="1:24.922" end="1:30.642" ttm:agent="v1"><span begin="1:24.922" end="1:25.279">Cu</span> <span begin="1:25.279" end="1:27.067">Isus,</span> <span begin="1:27.067" end="1:28.497">cu</span> <span begin="1:28.497" end="1:30.642">Isus!</span></p><p begin="1:30.642" end="1:33.462" ttm:agent="v1"><span begin="1:30.642" end="1:30.999">O</span> <span begin="1:30.999" end="1:31.357">ce</span> <span begin="1:31.357" end="1:32.787">fericire</span> <span begin="1:32.787" end="1:33.502">mare</span> <span begin="1:33.502" end="1:33.859">vom</span> <span begin="1:33.859" end="1:33.462">avea!</span></p><p begin="1:33.462" end="1:39.181" ttm:agent="v1"><span begin="1:33.462" end="1:33.819">Când,</span> <span begin="1:33.819" end="1:34.177">la</span> <span begin="1:34.177" end="1:34.812">marea</span> <span begin="1:34.812" end="1:36.083">judecată,</span> <span begin="1:36.083" end="1:36.719">cei</span> <span begin="1:36.719" end="1:37.394">greșiți</span> <span begin="1:37.394" end="1:37.751">se</span> <span begin="1:37.751" end="1:38.109">vor</span> <span begin="1:38.109" end="1:39.181">vădi</span></p><p begin="1:39.181" end="1:44.901" ttm:agent="v1"><span begin="1:39.181" end="1:39.539">Și</span> <span begin="1:39.539" end="1:39.896">când</span> <span begin="1:39.896" end="1:40.532">Domnul</span> <span begin="1:40.532" end="1:40.850">în</span> <span begin="1:40.850" end="1:41.803">mărire</span> <span begin="1:41.803" end="1:42.121">va</span> <span begin="1:42.121" end="1:44.901">veni,</span></p><p begin="1:44.901" end="1:47.523" ttm:agent="v1"><span begin="1:44.901" end="1:45.616">Celor</span> <span begin="1:45.616" end="1:45.934">buni,</span> <span begin="1:45.934" end="1:46.570">Isus</span> <span begin="1:46.570" end="1:46.887">va</span> <span begin="1:46.887" end="1:47.523">zice:</span></p><p begin="1:47.523" end="1:50.621" ttm:agent="v1"><span begin="1:47.523" end="1:48.476">„Veniți</span> <span begin="1:48.476" end="1:48.834">voi,</span> <span begin="1:48.834" end="1:49.191">cei</span> <span begin="1:49.191" end="1:49.549">drepți</span> <span begin="1:49.549" end="1:49.906">și</span> <span begin="1:49.906" end="1:50.621">sfinți,</span></p><p begin="1:50.621" end="1:56.321" ttm:agent="v1"><span begin="1:50.621" end="1:50.979">În</span> <span begin="1:50.979" end="1:51.694">etern</span> <span begin="1:51.694" end="1:52.051">să-Mi</span> <span begin="1:52.051" end="1:52.766">fiți</span> <span begin="1:52.766" end="1:53.481">alături,</span> <span begin="1:53.481" end="1:56.321">fericiți!”</span></p><p begin="1:56.321" end="2:01.984" ttm:agent="v1"><span begin="1:56.321" end="1:56.675">O,</span> <span begin="1:56.675" end="1:57.029">ce</span> <span begin="1:57.029" end="2:01.984">fericire</span></p><p begin="2:01.984" end="2:07.646" ttm:agent="v1"><span begin="2:01.984" end="2:02.337">Când</span> <span begin="2:02.337" end="2:03.006">la</span> <span begin="2:03.006" end="2:03.635">sunetul</span> <span begin="2:03.635" end="2:03.950">de</span> <span begin="2:03.950" end="2:04.579">trâmbiți</span> <span begin="2:04.579" end="2:04.894">ne-om</span> <span begin="2:04.894" end="2:07.646">vedea,</span></p><p begin="2:07.646" end="2:13.309" ttm:agent="v1"><span begin="2:07.646" end="2:08.000">Cu</span> <span begin="2:08.000" end="2:09.770">Isus,</span> <span begin="2:09.770" end="2:11.185">cu</span> <span begin="2:11.185" end="2:13.309">Isus!</span></p><p begin="2:13.309" end="2:17.910" ttm:agent="v1"><span begin="2:13.309" end="2:13.663">O</span> <span begin="2:13.663" end="2:14.017">ce</span> <span begin="2:14.017" end="2:15.432">fericire</span> <span begin="2:15.432" end="2:16.140">mare</span> <span begin="2:16.140" end="2:16.494">vom</span> <span begin="2:16.494" end="2:17.910">avea!</span></p></div></body></tt>