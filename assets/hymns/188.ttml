715">veci</span> <span begin="1:30.715" end="1:32.868">iubirea</span> <span begin="1:32.868" end="1:34.303">Sa,</span></p><p begin="1:34.303" end="1:40.044" ttm:agent="v1"><span begin="1:34.303" end="1:35.021">Când</span> <span begin="1:35.021" end="1:35.738">Îi</span> <span begin="1:35.738" end="1:36.456">spun</span> <span begin="1:36.456" end="1:38.609">durerea</span> <span begin="1:38.609" end="1:40.044">toată,</span></p><p begin="1:40.044" end="1:47.305" ttm:agent="v1"><span begin="1:40.044" end="1:41.479">Domnul</span> <span begin="1:41.479" end="1:42.914">umple</span> <span begin="1:42.914" end="1:44.350">viața</span> <span begin="1:44.350" end="1:47.305">mea.</span></p><p begin="1:47.305" end="1:53.160" ttm:agent="v1"><span begin="1:47.305" end="1:48.037">Când</span> <span begin="1:48.037" end="1:48.769">mă</span> <span begin="1:48.769" end="1:49.501">plec</span> <span begin="1:49.501" end="1:50.233">în</span> <span begin="1:50.233" end="1:53.160">rugăciune,</span></p><p begin="1:53.160" end="1:59.016" ttm:agent="v1"><span begin="1:53.160" end="1:53.892">Stau</span> <span begin="1:53.892" end="1:54.624">pe</span> <span begin="1:54.624" end="1:56.088">sfinte</span> <span begin="1:56.088" end="1:59.016">înălțimi,</span></p><p begin="1:59.016" end="2:04.872" ttm:agent="v1"><span begin="1:59.016" end="2:00.480">Unde</span> <span begin="2:00.480" end="2:01.944">pacea</span> <span begin="2:01.944" end="2:02.676">mă</span> <span begin="2:02.676" end="2:04.872">pătrunde</span></p><p begin="2:04.872" end="2:10.727" ttm:agent="v1"><span begin="2:04.872" end="2:05.604">Cu</span> <span begin="2:05.604" end="2:07.068">lumini</span> <span begin="2:07.068" end="2:07.800">de</span> <span begin="2:07.800" end="2:10.727">heruvimi;</span></p><p begin="2:10.727" end="2:16.583" ttm:agent="v1"><span begin="2:10.727" end="2:11.459">Uit</span> <span begin="2:11.459" end="2:12.923">atunci</span> <span begin="2:12.923" end="2:13.655">de</span> <span begin="2:13.655" end="2:16.583">suf