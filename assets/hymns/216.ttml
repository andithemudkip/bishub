<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>216. Trăiește-același Dumnezeu</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:04.604"><div><p begin="0:14.730" end="0:21.824" ttm:agent="v1"><span begin="0:14.730" end="0:17.914">Trăiește-același</span> <span begin="0:17.914" end="0:21.824">Dumnezeu,</span></p><p begin="0:21.824" end="0:28.918" ttm:agent="v1"><span begin="0:21.824" end="0:23.734">Iubire</span> <span begin="0:23.734" end="0:24.371">ce</span> <span begin="0:24.371" end="0:28.918">veghează!</span></p><p begin="0:28.918" end="0:36.012" ttm:agent="v1"><span begin="0:28.918" end="0:30.829">Povara</span> <span begin="0:30.829" end="0:32.739">zilelor,</span> <span begin="0:32.739" end="0:36.012">mereu,</span></p><p begin="0:36.012" end="0:41.267" ttm:agent="v1"><span begin="0:36.012" end="0:38.649">Doar</span> <span begin="0:38.649" end="0:39.286">Lui</span> <span begin="0:39.286" end="0:41.267">o-ncredințează!</span></p><p begin="0:41.267" end="0:48.208" ttm:agent="v1"><span begin="0:41.267" end="0:44.355">Trăiește-același</span> <span begin="0:44.355" end="0:48.208">Dumnezeu,</span></p><p begin="0:48.208" end="0:55.149" ttm:agent="v1"><span begin="0:48.208" end="0:50.061">Tărie</span> <span begin="0:50.061" end="0:51.296">veșnic</span> <span begin="0:51.296" end="0:55.149">tare!</span></p><p begin="0:55.149" end="1:02.091" ttm:agent="v1"><span begin="0:55.149" end="0:57.002">Vrăjmașul,</span> <span begin="0:57.002" end="0:57.620">când</span> <span begin="0:57.620" end="0:59.473">te-apasă</span> <span begin="0:59.473" end="1:02.091">greu,</span></p><p begin="1:02.091" end="1:07.652" ttm:agent="v1"><span begin="1:02.091" end="1:05.326">Isus</span> <span begin="1:05.326" end="1:05.944">îți</span> <span begin="1:05.944" end="1:06.561">e</span> <span begin="1:06.561" end="1:07.652">salvare!</span></p><p begin="1:07.652" end="1:14.667" ttm:agent="v1"><span begin="1:07.652" end="1:10.787">Trăiește-același</span> <span begin="1:10.787" end="1:14.667">Dumnezeu,</span></p><p begin="1:14.667" end="1:21.683" ttm:agent="v1"><span begin="1:14.667" end="1:16.548">Eternă</span> <span begin="1:16.548" end="1:21.683">îndurare!</span></p><p begin="1:21.683" end="1:28.698" ttm:agent="v1"><span begin="1:21.683" end="1:22.310">În</span> <span begin="1:22.310" end="1:22.937">griji</span> <span begin="1:22.937" end="1:23.564">și</span> <span begin="1:23.564" end="1:25.444">suferinți,</span> <span begin="1:25.444" end="1:26.071">e-al</span> <span begin="1:26.071" end="1:28.698">tău</span></p><p begin="1:28.698" end="1:34.834" ttm:agent="v1"><span begin="1:28.698" end="1:31.952">Frumos</span> <span begin="1:31.952" end="1:32.579">și</span> <span begin="1:32.579" end="1:33.833">veșnic</span> <span begin="1:33.833" end="1:34.834">soare!</span></p><p begin="1:34.834" end="1:41.749" ttm:agent="v1"><span begin="1:34.834" end="1:37.906">Trăiește-același</span> <span begin="1:37.906" end="1:41.749">Dumnezeu,</span></p><p begin="1:41.749" end="1:48.664" ttm:agent="v1"><span begin="1:41.749" end="1:43.592">Lumină</span> <span begin="1:43.592" end="1:48.664">infinită!</span></p><p begin="1:48.664" end="1:55.579" ttm:agent="v1"><span begin="1:48.664" end="1:49.278">Prin</span> <span begin="1:49.278" end="1:50.507">jertfa</span> <span begin="1:50.507" end="1:51.121">și</span> <span begin="1:51.121" end="1:51.736">prin</span> <span begin="1:51.736" end="1:52.965">harul</span> <span begin="1:52.965" end="1:55.579">Său,</span></p><p begin="1:55.579" end="2:00.651" ttm:agent="v1"><span begin="1:55.579" end="1:58.193">Ai</span> <span begin="1:58.193" end="1:59.422">viață</span> <span begin="1:59.422" end="2:00.651">nesfârșită!</span></p></div></body></tt>