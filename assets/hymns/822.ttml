<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>822. Hai, copile, vin la Mine!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:32.500"><div><p begin="0:10.480" end="0:15.296" ttm:agent="v1"><span begin="0:10.480" end="0:10.881">„Hai,</span> <span begin="0:10.881" end="0:12.888">copile,</span> <span begin="0:12.888" end="0:13.289">vin</span> <span begin="0:13.289" end="0:13.691">la</span> <span begin="0:13.691" end="0:15.296">Mine,</span></p><p begin="0:15.296" end="0:20.112" ttm:agent="v1"><span begin="0:15.296" end="0:15.697">Vin</span> <span begin="0:15.697" end="0:16.901">acum</span> <span begin="0:16.901" end="0:17.704">de</span> <span begin="0:17.704" end="0:20.112">grab’,</span></p><p begin="0:20.112" end="0:24.928" ttm:agent="v1"><span begin="0:20.112" end="0:20.915">Harul</span> <span begin="0:20.915" end="0:21.717">Meu</span> <span begin="0:21.717" end="0:22.520">și</span> <span begin="0:22.520" end="0:23.323">peste</span> <span begin="0:23.323" end="0:24.928">tine</span></p><p begin="0:24.928" end="0:27.804" ttm:agent="v1"><span begin="0:24.928" end="0:25.329">Vreau</span> <span begin="0:25.329" end="0:25.731">să-L</span> <span begin="0:25.731" end="0:26.533">dau</span> <span begin="0:26.533" end="0:27.336">cu</span> <span begin="0:27.336" end="0:27.804">drag!”</span></p><p begin="0:27.804" end="0:32.620" ttm:agent="v1"><span begin="0:27.804" end="0:29.409">Auzind</span> <span begin="0:29.409" end="0:30.212">a</span> <span begin="0:30.212" end="0:30.613">Ta</span> <span begin="0:30.613" end="0:32.620">chemare,</span></p><p begin="0:32.620" end="0:37.436" ttm:agent="v1"><span begin="0:32.620" end="0:33.021">Eu</span> <span begin="0:33.021" end="0:33.423">am</span> <span begin="0:33.423" end="0:37.436">alergat,</span></p><p begin="0:37.436" end="0:42.252" ttm:agent="v1"><span begin="0:37.436" end="0:37.837">Căci</span> <span begin="0:37.837" end="0:38.239">nu-i</span> <span begin="0:38.239" end="0:39.041">timp</span> <span begin="0:39.041" end="0:39.844">de</span> <span begin="0:39.844" end="0:42.252">așteptare,</span></p><p begin="0:42.252" end="0:50.008" ttm:agent="v1"><span begin="0:42.252" end="0:42.653">Vreau</span> <span begin="0:42.653" end="0:43.055">să</span> <span begin="0:43.055" end="0:43.857">fiu</span> <span begin="0:43.857" end="0:50.008">salvat!</span></p><p begin="0:50.008" end="0:54.824" ttm:agent="v1"><span begin="0:50.008" end="0:50.409">Sunt</span> <span begin="0:50.409" end="0:51.613">micuț,</span> <span begin="0:51.613" end="0:52.416">dar</span> <span begin="0:52.416" end="0:52.817">vin</span> <span begin="0:52.817" end="0:53.219">la</span> <span begin="0:53.219" end="0:54.824">Tine,</span></p><p begin="0:54.824" end="0:59.640" ttm:agent="v1"><span begin="0:54.824" end="0:55.627">Bunul</span> <span begin="0:55.627" end="0:56.429">meu</span> <span begin="0:56.429" end="0:59.640">Isus,</span></p><p begin="0:59.640" end="1:04.456" ttm:agent="v1"><span begin="0:59.640" end="1:00.041">Și</span> <span begin="1:00.041" end="1:00.443">Te</span> <span begin="1:00.443" end="1:01.245">rog</span> <span begin="1:01.245" end="1:02.048">să</span> <span begin="1:02.048" end="1:02.449">faci</span> <span begin="1:02.449" end="1:02.851">din</span> <span begin="1:02.851" end="1:04.456">mine</span></p><p begin="1:04.456" end="1:07.432" ttm:agent="v1"><span begin="1:04.456" end="1:04.857">Un</span> <span begin="1:04.857" end="1:05.259">prinț</span> <span begin="1:05.259" end="1:06.061">în</span> <span begin="1:06.061" end="1:06.864">cer</span> <span begin="1:06.864" end="1:07.432">sus!</span></p><p begin="1:07.432" end="1:12.176" ttm:agent="v1"><span begin="1:07.432" end="1:07.827">Deci</span> <span begin="1:07.827" end="1:08.223">Te</span> <span begin="1:08.223" end="1:09.013">rog,</span> <span begin="1:09.013" end="1:10.595">iubite</span> <span begin="1:10.595" end="1:12.176">Tată,</span></p><p begin="1:12.176" end="1:16.920" ttm:agent="v1"><span begin="1:12.176" end="1:12.571">Nu</span> <span begin="1:12.571" end="1:12.966">mă</span> <span begin="1:12.966" end="1:16.920">părăsi,</span></p><p begin="1:16.920" end="1:21.663" ttm:agent="v1"><span begin="1:16.920" end="1:17.315">Ca</span> <span begin="1:17.315" end="1:17.710">în</span> <span begin="1:17.710" end="1:18.501">cer</span> <span begin="1:18.501" end="1:19.291">să</span> <span begin="1:19.291" end="1:19.687">pot,</span> <span begin="1:19.687" end="1:21.663">odată,</span></p><p begin="1:21.663" end="1:25.616" ttm:agent="v1"><span begin="1:21.663" end="1:22.454">Lângă</span> <span begin="1:22.454" end="1:24.035">Tine-a</span> <span begin="1:24.035" end="1:25.616">fi.</span></p></div></body></tt>