<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>236. Dacă vrăbii pot să cadă</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:07.843"><div><p begin="0:18.534" end="0:23.770" ttm:agent="v1"><span begin="0:18.534" end="0:19.407">Dacă</span> <span begin="0:19.407" end="0:21.152">vrăbii</span> <span begin="0:21.152" end="0:21.588">pot</span> <span begin="0:21.588" end="0:22.025">să</span> <span begin="0:22.025" end="0:23.770">cadă,</span></p><p begin="0:23.770" end="0:29.006" ttm:agent="v1"><span begin="0:23.770" end="0:24.643">Dacă</span> <span begin="0:24.643" end="0:26.388">stele</span> <span begin="0:26.388" end="0:26.824">se</span> <span begin="0:26.824" end="0:27.261">pot</span> <span begin="0:27.261" end="0:29.006">stinge,</span></p><p begin="0:29.006" end="0:34.242" ttm:agent="v1"><span begin="0:29.006" end="0:29.879">Lângă</span> <span begin="0:29.879" end="0:31.624">Domnul,</span> <span begin="0:31.624" end="0:34.242">niciodată</span></p><p begin="0:34.242" end="0:36.002" ttm:agent="v1"><span begin="0:34.242" end="0:35.115">Frica</span> <span begin="0:35.115" end="0:36.860">morții</span> <span begin="0:36.860" end="0:37.296">nu</span> <span begin="0:37.296" end="0:36.002">ne-atinge...</span></p><p begin="0:36.002" end="0:41.161" ttm:agent="v1"><span begin="0:36.002" end="0:36.862">Dacă</span> <span begin="0:36.862" end="0:39.011">totuși,</span> <span begin="0:39.011" end="0:39.441">câte-o</span> <span begin="0:39.441" end="0:41.161">mamă</span></p><p begin="0:41.161" end="0:46.320" ttm:agent="v1"><span begin="0:41.161" end="0:43.741">Copilașul</span> <span begin="0:43.741" end="0:44.170">își</span> <span begin="0:44.170" end="0:44.600">mai</span> <span begin="0:44.600" end="0:46.320">uită,</span></p><p begin="0:46.320" end="0:51.479" ttm:agent="v1"><span begin="0:46.320" end="0:48.040">Dumnezeu</span> <span begin="0:48.040" end="0:48.900">ne</span> <span begin="0:48.900" end="0:49.759">ține-n</span> <span begin="0:49.759" end="0:51.479">palmă,</span></p><p begin="0:51.479" end="0:55.728" ttm:agent="v1"><span begin="0:51.479" end="0:51.909">Ne</span> <span begin="0:51.909" end="0:54.059">hrănește</span> <span begin="0:54.059" end="0:54.489">și</span> <span begin="0:54.489" end="0:55.728">ne-ajută...</span></p><p begin="0:55.728" end="1:00.887" ttm:agent="v1"><span begin="0:55.728" end="0:56.158">Când</span> <span begin="0:56.158" end="0:56.588">e</span> <span begin="0:56.588" end="0:58.307">gata,</span> <span begin="0:58.307" end="0:58.737">în</span> <span begin="0:58.737" end="1:00.887">furtună,</span></p><p begin="1:00.887" end="1:06.045" ttm:agent="v1"><span begin="1:00.887" end="1:01.746">Vasul</span> <span begin="1:01.746" end="1:03.466">nostru</span> <span begin="1:03.466" end="1:03.896">să</span> <span begin="1:03.896" end="1:04.326">se</span> <span begin="1:04.326" end="1:06.045">sfarme,</span></p><p begin="1:06.045" end="1:11.204" ttm:agent="v1"><span begin="1:06.045" end="1:08.624">Domnu-aduce</span> <span begin="1:08.624" end="1:09.484">vreme</span> <span begin="1:09.484" end="1:11.204">bună,</span></p><p begin="1:11.204" end="1:18.088" ttm:agent="v1"><span begin="1:11.204" end="1:13.783">Niciodată</span> <span begin="1:13.783" end="1:14.213">El</span> <span begin="1:14.213" end="1:14.643">nu</span> <span begin="1:14.643" end="1:18.088">doarme...</span></p><p begin="1:18.088" end="1:23.247" ttm:agent="v1"><span begin="1:18.088" end="1:18.948">Cine-n</span> <span begin="1:18.948" end="1:20.668">lumea</span> <span begin="1:20.668" end="1:21.527">asta</span> <span begin="1:21.527" end="1:23.247">oare</span></p><p begin="1:23.247" end="1:28.405" ttm:agent="v1"><span begin="1:23.247" end="1:23.677">Ar</span> <span begin="1:23.677" end=