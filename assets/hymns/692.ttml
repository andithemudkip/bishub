<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>692. Iar o noapte-am odihnit</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:31.011"><div><p begin="0:13.570" end="0:19.608" ttm:agent="v1"><span begin="0:13.570" end="0:14.702">Iar</span> <span begin="0:14.702" end="0:15.079">o</span> <span begin="0:15.079" end="0:15.834">noapte-am</span> <span begin="0:15.834" end="0:19.608">odihnit,</span></p><p begin="0:19.608" end="0:25.647" ttm:agent="v1"><span begin="0:19.608" end="0:21.118">De-orice</span> <span begin="0:21.118" end="0:21.495">rău</span> <span begin="0:21.495" end="0:21.873">am</span> <span begin="0:21.873" end="0:22.250">fost</span> <span begin="0:22.250" end="0:25.647">păzit...</span></p><p begin="0:25.647" end="0:31.685" ttm:agent="v1"><span begin="0:25.647" end="0:27.156">Tată,</span> <span begin="0:27.156" end="0:27.534">cum</span> <span begin="0:27.534" end="0:28.288">mereu</span> <span begin="0:28.288" end="0:28.666">mi-ai</span> <span begin="0:28.666" end="0:31.685">fost,</span></p><p begin="0:31.685" end="0:37.043" ttm:agent="v1"><span begin="0:31.685" end="0:32.817">Fi-mi</span> <span begin="0:32.817" end="0:33.195">și</span> <span begin="0:33.195" end="0:33.949">astăzi</span> <span begin="0:33.949" end="0:37.043">adăpost.</span></p><p begin="0:37.043" end="0:42.991" ttm:agent="v1"><span begin="0:37.043" end="0:38.530">Spirit</span> <span begin="0:38.530" end="0:38.902">Sfânt</span> <span begin="0:38.902" end="0:39.274">să-mi</span> <span begin="0:39.274" end="0:39.646">dai</span> <span begin="0:39.646" end="0:40.389">și</span> <span begin="0:40.389" end="0:42.991">sfat,</span></p><p begin="0:42.991" end="0:48.939" ttm:agent="v1"><span begin="0:42.991" end="0:44.106">Să</span> <span begin="0:44.106" end="0:44.478">mă</span> <span begin="0:44.478" end="0:45.222">aperi</span> <span begin="0:45.222" end="0:45.593">de</span> <span begin="0:45.593" end="0:48.939">păcat!</span></p><p begin="0:48.939" end="0:54.887" ttm:agent="v1"><span begin="0:48.939" end="0:50.054">Pe</span> <span begin="0:50.054" end="0:50.426">al</span> <span begin="0:50.426" end="0:51.169">vieții</span> <span begin="0:51.169" end="0:51.541">drum</span> <span begin="0:51.541" end="0:54.887">spinos,</span></p><p begin="0:54.887" end="0:57.175" ttm:agent="v1"><span begin="0:54.887" end="0:56.002">Fă</span> <span begin="0:56.002" end="0:56.374">să</span> <span begin="0:56.374" end="0:56.746">merg</span> <span begin="0:56.746" end="0:57.175">victorios!</span></p><p begin="0:57.175" end="1:03.063" ttm:agent="v1"><span begin="0:57.175" end="0:59.015">Binele</span> <span begin="0:59.015" end="0:59.383">să-l</span> <span begin="0:59.383" end="1:03.063">săvârșesc,</span></p><p begin="1:03.063" end="1:08.951" ttm:agent="v1"><span begin="1:03.063" end="1:04.535">Orice</span> <span begin="1:04.535" end="1:04.903">rău</span> <span begin="1:04.903" end="1:05.271">să</span> <span begin="1:05.271" end="1:08.951">ocolesc,</span></p><p begin="1:08.951" end="1:14.840" ttm:agent="v1"><span begin="1:08.951" end="1:10.423">Legea</span> <span begin="1:10.423" end="1:10.792">Ta</span> <span begin="1:10.792" end="1:11.528">mereu</span> <span begin="1:11.528" end="1:11.896">s-o</span> <span begin="1:11.896" end="1:14.840">țiu</span></p><p begin="1:14.840" end="1:19.256" ttm:agent="v1"><span begin="1:14.840" end="1:15.944">Și</span> <span begin="1:15.944" end="1:16.312">de</span> <span begin="1:16.312" end="1:17.048">Tine</span> <span begin="1:17.048" end="1:17.416">demn</span> <span begin="1:17.416" end="1:17.784">să</span> <span begin="1:17.784" end="1:19.256">fiu!</span></p></div></body></tt>