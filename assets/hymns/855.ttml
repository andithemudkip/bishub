<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>855. Totul piere-n astă lume</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:31.223"><div><p begin="0:12.486" end="0:18.112" ttm:agent="v1"><span begin="0:12.486" end="0:14.244">Totul</span> <span begin="0:14.244" end="0:14.596">piere-n</span> <span begin="0:14.596" end="0:15.299">astă</span> <span begin="0:15.299" end="0:18.112">lume,</span></p><p begin="0:18.112" end="0:22.331" ttm:agent="v1"><span begin="0:18.112" end="0:19.167">Tot</span> <span begin="0:19.167" end="0:19.870">ce-aveți</span> <span begin="0:19.870" end="0:20.222">și</span> <span begin="0:20.222" end="0:20.573">ce</span> <span begin="0:20.573" end="0:22.331">sperați.</span></p><p begin="0:22.331" end="0:27.957" ttm:agent="v1"><span begin="0:22.331" end="0:23.738">Câte</span> <span begin="0:23.738" end="0:24.089">cu</span> <span begin="0:24.089" end="0:25.144">mărețe</span> <span begin="0:25.144" end="0:27.957">nume</span></p><p begin="0:27.957" end="0:32.176" ttm:agent="v1"><span begin="0:27.957" end="0:29.012">Le</span> <span begin="0:29.012" end="0:29.715">cinstiți</span> <span begin="0:29.715" end="0:30.066">și</span> <span begin="0:30.066" end="0:32.176">lăudați.</span></p><p begin="0:32.176" end="0:37.802" ttm:agent="v1"><span begin="0:32.176" end="0:34.286">Pământeasca</span> <span begin="0:34.286" end="0:34.989">viață</span> <span begin="0:34.989" end="0:37.802">piere,</span></p><p begin="0:37.802" end="0:42.021" ttm:agent="v1"><span begin="0:37.802" end="0:38.856">Și</span> <span begin="0:38.856" end="0:40.263">dorințele</span> <span begin="0:40.263" end="0:40.614">la</span> <span begin="0:40.614" end="0:42.021">fel.</span></p><p begin="0:42.021" end="0:47.646" ttm:agent="v1"><span begin="0:42.021" end="0:43.427">Orice</span> <span begin="0:43.427" end="0:44.482">ideal</span> <span begin="0:44.482" end="0:44.834">se</span> <span begin="0:44.834" end="0:47.646">pierde:</span></p><p begin="0:47.646" end="0:53.386" ttm:agent="v1"><span begin="0:47.646" end="0:49.053">Planuri,</span> <span begin="0:49.053" end="0:50.108">străduinți</span> <span begin="0:50.108" end="0:50.459">și</span> <span begin="0:50.459" end="0:53.386">zel.</span></p><p begin="0:53.386" end="0:59.039" ttm:agent="v1"><span begin="0:53.386" end="0:54.799">Totuși</span> <span begin="0:54.799" end="0:55.506">grija</span> <span begin="0:55.506" end="0:55.859">nu</span> <span begin="0:55.859" end="0:59.039">m-apasă,</span></p><p begin="0:59.039" end="1:03.280" ttm:agent="v1"><span begin="0:59.039" end="1:00.099">Căci</span> <span begin="1:00.099" end="1:00.806">aștept</span> <span begin="1:00.806" end="1:01.159">o</span> <span begin="1:01.159" end="1:01.866">sfântă</span> <span begin="1:01.866" end="1:03.280">zi,</span></p><p begin="1:03.280" end="1:08.933" ttm:agent="v1"><span begin="1:03.280" end="1:04.340">Când</span> <span begin="1:04.340" end="1:04.693">o</span> <span begin="1:04.693" end="1:05.400">viață</span> <span begin="1:05.400" end="1:05.753">mai</span> <span begin="1:05.753" end="1:08.933">aleasă</span></p><p begin="1:08.933" end="1:16.614" ttm:agent="v1"><span begin="1:08.933" end="1:09.993">De</span> <span begin="1:09.993" end="1:10.347">la</span> <span begin="1:10.347" end="1:11.054">Domnul</span> <span begin="1:11.054" end="1:11.407">voi</span> <span begin="1:11.407" end="1:16.614">primi!</span></p><p begin="1:16.614" end="1:22.324" ttm:agent="v1"><span begin="1:16.614" end="1:18.041">Domnul</span> <span begin="1:18.041" end="1:18.755">peste</span> <span begin="1:18.755" end="1:19.112">toți</span> <span begin="1:19.112" end="1:22.324">privește</span></p><p begin="1:22.324" end="1:26.607" ttm:agent="v1"><span begin="1:22.324" end="1:24.108">Și-apoi</span> <span begin="1:24.108" end="1:24.465">zice-n</span> <span begin="1:24.465" end="1:25.179">mila</span> <span begin="1:25.179" end="1:26.607">Sa:</span></p><p begin="1:26.607" end="1:32.317" ttm:agent="v1"><span begin="1:26.607" end="1:28.034">„Crede-n</span> <span begin="1:28.034" end="1:28.748">Mine,</span> <span begin="1:28.748" end="1:32.317">te-ntărește,</span></p><p begin="1:32.317" end="1:36.600" ttm:agent="v1"><span begin="1:32.317" end="1:33.744">Speră,</span> <span begin="1:33.744" end="1:34.458">nu</span> <span begin="1:34.458" end="1:36.600">te-nspăimânta!”</span></p><p begin="1:36.600" end="1:42.310" ttm:agent="v1"><span begin="1:36.600" end="1:38.027">Domnul</span> <span begin="1:38.027" end="1:38.741">este</span> <span begin="1:38.741" end="1:39.455">viața</span> <span begin="1:39.455" end="1:42.310">noastră:</span></p><p begin="1:42.310" end="1:46.593" ttm:agent="v1"><span begin="1:42.310" end="1:44.451">Fericire</span> <span begin="1:44.451" end="1:44.808">ne</span> <span begin="1:44.808" end="1:45.165">va</span> <span begin="1:45.165" end="1:46.593">da.</span></p><p begin="1:46.593" end="1:52.303" ttm:agent="v1"><span begin="1:46.593" end="1:48.020">De-L</span> <span begin="1:48.020" end="1:48.377">păstrăm</span> <span begin="1:48.377" end="1:48.734">în</span> <span begin="1:48.734" end="1:49.448">mintea</span> <span begin="1:49.448" end="1:52.303">noastră</span></p><p begin="1:52.303" end="1:56.666" ttm:agent="v1"><span begin="1:52.303" end="1:53.730">El</span> <span begin="1:53.730" end="1:54.444">ne-nscrie-n</span> <span begin="1:54.444" end="1:55.158">cartea</span> <span begin="1:55.158" end="1:56.666">Sa.</span></p><p begin="1:56.666" end="2:02.376" ttm:agent="v1"><span begin="1:56.666" end="1:58.093">Totuși</span> <span begin="1:58.093" end="1:58.807">grija</span> <span begin="1:58.807" end="1:59.164">nu</span> <span begin="1:59.164" end="2:02.376">m-apasă,</span></p><p begin="2:02.376" end="2:06.658" ttm:agent="v1"><span begin="2:02.376" end="2:03.446">Căci</span> <span begin="2:03.446" end="2:04.160">aștept</span> <span begin="2:04.160" end="2:04.517">o</span> <span begin="2:04.517" end="2:05.231">sfântă</span> <span begin="2:05.231" end="2:06.658">zi,</span></p><p begin="2:06.658" end="2:12.369" ttm:agent="v1"><span begin="2:06.658" end="2:07.729">Când</span> <span begin="2:07.729" end="2:08.086">o</span> <span begin="2:08.086" end="2:08.800">viață</span> <span begin="2:08.800" end="2:09.157">mai</span> <span begin="2:09.157" end="2:12.369">aleasă</span></p><p begin="2:12.369" end="2:15.581" ttm:agent="v1"><span begin="2:12.369" end="2:13.439">De</span> <span begin="2:13.439" end="2:13.796">la</span> <span begin="2:13.796" end="2:14.510">Domnul</span> <span begin="2:14.510" end="2:14.867">voi</span> <span begin="2:14.867" end="2:15.581">primi!</span></p></div></body></tt>