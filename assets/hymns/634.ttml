<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>634. Cu credință-n fața Ta</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:31.376"><div><p begin="0:13.090" end="0:19.030" ttm:agent="v1"><span begin="0:13.090" end="0:13.832">Cu</span> <span begin="0:13.832" end="0:16.060">credință-n</span> <span begin="0:16.060" end="0:17.545">fața</span> <span begin="0:17.545" end="0:19.030">Ta,</span></p><p begin="0:19.030" end="0:24.969" ttm:agent="v1"><span begin="0:19.030" end="0:20.515">Astăzi</span> <span begin="0:20.515" end="0:21.257">vom</span> <span begin="0:21.257" end="0:24.969">îngenunchea;</span></p><p begin="0:24.969" end="0:30.909" ttm:agent="v1"><span begin="0:24.969" end="0:25.712">De</span> <span begin="0:25.712" end="0:26.454">la</span> <span begin="0:26.454" end="0:27.939">Tine</span> <span begin="0:27.939" end="0:28.682">vom</span> <span begin="0:28.682" end="0:30.909">primi</span></p><p begin="0:30.909" end="0:38.509" ttm:agent="v1"><span begin="0:30.909" end="0:32.394">Multe,</span> <span begin="0:32.394" end="0:33.879">sfinte</span> <span begin="0:33.879" end="0:38.509">bucurii!</span></p><p begin="0:38.509" end="0:44.389" ttm:agent="v1"><span begin="0:38.509" end="0:39.244">O,</span> <span begin="0:39.244" end="0:42.184">Mântuitor</span> <span begin="0:42.184" end="0:44.389">divin,</span></p><p begin="0:44.389" end="0:50.270" ttm:agent="v1"><span begin="0:44.389" end="0:45.124">Tot</span> <span begin="0:45.124" end="0:46.594">ce-avem</span> <span begin="0:46.594" end="0:47.329">și</span> <span begin="0:47.329" end="0:48.064">ce</span> <span begin="0:48.064" end="0:50.270">primim</span></p><p begin="0:50.270" end="0:56.150" ttm:agent="v1"><span begin="0:50.270" end="0:51.005">E</span> <span begin="0:51.005" end="0:51.740">din</span> <span begin="0:51.740" end="0:54.680">îndurarea</span> <span begin="0:54.680" end="0:56.150">Ta,</span></p><p begin="0:56.150" end="0:58.570" ttm:agent="v1"><span begin="0:56.150" end="0:56.885">Ce</span> <span begin="0:56.885" end="0:57.620">ne</span> <span begin="0:57.620" end="0:59.090">umple</span> <span begin="0:59.090" end="0:58.570">inima!</span></p><p begin="0:58.570" end="1:04.451" ttm:agent="v1"><span begin="0:58.570" end="0:59.305">Tu</span> <span begin="0:59.305" end="1:00.040">ne</span> <span begin="1:00.040" end="1:00.775">ești</span> <span begin="1:00.775" end="1:04.451">Judecător</span></p><p begin="1:04.451" end="1:10.331" ttm:agent="v1"><span begin="1:04.451" end="1:05.186">Drept</span> <span begin="1:05.186" end="1:05.921">și</span> <span begin="1:05.921" end="1:06.656">bun</span> <span begin="1:06.656" end="1:07.391">și</span> <span begin="1:07.391" end="1:10.331">iertător;</span></p><p begin="1:10.331" end="1:16.211" ttm:agent="v1"><span begin="1:10.331" end="1:11.066">Prin</span> <span begin="1:11.066" end="1:14.741">neprihănirea</span> <span begin="1:14.741" end="1:16.211">Ta,</span></p><p begin="1:16.211" end="1:21.357" ttm:agent="v1"><span begin="1:16.211" end="1:17.681">Numai</span> <span begin="1:17.681" end="1:18.416">Tu</span> <span begin="1:18.416" end="1:19.151">ne</span> <span begin="1:19.151" end="1:19.886">poți</span> <span begin="1:19.886" end="1:21.357">salva!</span></p></div></body></tt>