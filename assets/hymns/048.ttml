<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>48. Măriți pe Domnul ne-ncetat!</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:01.257"><div><p begin="0:17.517" end="0:25.663" ttm:agent="v1"><span begin="0:17.517" end="0:19.116">Măriți</span> <span begin="0:19.116" end="0:19.916">pe</span> <span begin="0:19.916" end="0:21.515">Domnul</span> <span begin="0:21.515" end="0:25.663">ne-ncetat</span></p><p begin="0:25.663" end="0:33.809" ttm:agent="v1"><span begin="0:25.663" end="0:26.463">Că</span> <span begin="0:26.463" end="0:27.262">El</span> <span begin="0:27.262" end="0:28.062">ne-a</span> <span begin="0:28.062" end="0:33.809">binecuvântat!</span></p><p begin="0:33.809" end="0:41.955" ttm:agent="v1"><span begin="0:33.809" end="0:35.408">Măriți,</span> <span begin="0:35.408" end="0:36.208">voi,</span> <span begin="0:36.208" end="0:37.807">ceruri</span> <span begin="0:37.807" end="0:38.606">și</span> <span begin="0:38.606" end="0:41.955">pământ,</span></p><p begin="0:41.955" end="0:52.500" ttm:agent="v1"><span begin="0:41.955" end="0:42.755">Pe</span> <span begin="0:42.755" end="0:46.104">Tatăl,</span> <span begin="0:46.104" end="0:47.703">Fiul,</span> <span begin="0:47.703" end="0:49.302">Duhul</span> <span begin="0:49.302" end="0:50.901">Sfânt!</span> <span begin="0:50.901" end="0:52.500">Amin!</span></p></div></body></tt>