<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>108. Niște șoapte într-o noapte</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:24.509"><div><p begin="0:12.390" end="0:17.395" ttm:agent="v1"><span begin="0:12.390" end="0:13.224">Niște</span> <span begin="0:13.224" end="0:14.893">șoapte,</span> <span begin="0:14.893" end="0:15.727">într-o</span> <span begin="0:15.727" end="0:17.395">noapte,</span></p><p begin="0:17.395" end="0:22.400" ttm:agent="v1"><span begin="0:17.395" end="0:17.812">Au</span> <span begin="0:17.812" end="0:19.064">venit</span> <span begin="0:19.064" end="0:19.898">la</span> <span begin="0:19.898" end="0:22.400">Betleem</span></p><p begin="0:22.400" end="0:27.406" ttm:agent="v1"><span begin="0:22.400" end="0:22.817">Să</span> <span begin="0:22.817" end="0:23.235">ne</span> <span begin="0:23.235" end="0:24.903">spună</span> <span begin="0:24.903" end="0:25.737">veste</span> <span begin="0:25.737" end="0:27.406">bună,</span></p><p begin="0:27.406" end="0:32.411" ttm:agent="v1"><span begin="0:27.406" end="0:29.908">Mântuire</span> <span begin="0:29.908" end="0:30.325">că</span> <span begin="0:30.325" end="0:32.411">avem;</span></p><p begin="0:32.411" end="0:37.416" ttm:agent="v1"><span begin="0:32.411" end="0:32.828">Să</span> <span begin="0:32.828" end="0:34.913">se-arate</span> <span begin="0:34.913" end="0:35.330">cu</span> <span begin="0:35.330" end="0:37.416">iubire,</span></p><p begin="0:37.416" end="0:42.421" ttm:agent="v1"><span begin="0:37.416" end="0:37.833">Să</span> <span begin="0:37.833" end="0:39.919">coboare</span> <span begin="0:39.919" end="0:40.336">din</span> <span begin="0:40.336" end="0:42.421">mărire,</span></p><p begin="0:42.421" end="0:47.426" ttm:agent="v1"><span begin="0:42.421" end="0:42.838">O</span> <span begin="0:42.838" end="0:44.924">minune</span> <span begin="0:44.924" end="0:45.341">s-a</span> <span begin="0:45.341" end="0:47.426">făcut:</span></p><p begin="0:47.426" end="0:54.932" ttm:agent="v1"><span begin="0:47.426" end="0:48.261">Pruncul</span> <span begin="0:48.261" end="0:49.929">vieții</span> <span begin="0:49.929" end="0:50.346">S-a</span> <span begin="0:50.346" end="0:54.932">născut...</span></p><p begin="0:54.932" end="1:00.087" ttm:agent="v1"><span begin="0:54.932" end="0:55.791">Raze</span> <span begin="0:55.791" end="0:57.509">scaldă</span> <span begin="0:57.509" end="0:58.369">ieslea</span> <span begin="0:58.369" end="1:00.087">caldă,</span></p><p begin="1:00.087" end="1:05.242" ttm:agent="v1"><span begin="1:00.087" end="1:00.946">Cerul</span> <span begin="1:00.946" end="1:02.665">face-n</span> <span begin="1:02.665" end="1:03.094">ea</span> <span begin="1:03.094" end="1:05.242">popas...</span></p><p begin="1:05.242" end="1:10.398" ttm:agent="v1"><span begin="1:05.242" end="1:06.102">Pace</span> <span begin="1:06.102" end="1:07.820">sfântă,</span> <span begin="1:07.820" end="1:08.679">îngeri</span> <span begin="1:08.679" end="1:10.398">cântă</span></p><p begin="1:10.398" end="1:15.553" ttm:agent="v1"><span begin="1:10.398" end="1:10.827">Cu</span> <span begin="1:10.827" end="1:12.975">păstorii</span> <span begin="1:12.975" end="1:13.835">într-un</span> <span begin="1:13.835" end="1:15.553">glas:</span></p><p begin="1:15.553" end="1:20.708" ttm:agent="v1"><span begin="1:15.553" end="1:15.983">„Sus</span> <span begin="1:15.983" end="1:16.412">în</span> <span begin="1:16.412" end="1:18.131">ceruri</span> <span begin="1:18.131" end="1:20.708">preamărire,</span></p><p begin="1:20.708" end="1:25.864" ttm:agent="v1"><span begin="1:20.708" end="1:21.568">Printre</span> <span begin="1:21.568" end="1:23.286">oameni</span> <span begin="1:23.286" end="1:25.864">învoire!”</span></p><p begin="1:25.864" end="1:31.019" ttm:agent="v1"><span begin="1:25.864" end="1:26.293">Se</span> <span begin="1:26.293" end="1:28.871">aude-așa</span> <span begin="1:28.871" end="1:31.019">frumos:</span></p><p begin="1:31.019" end="1:37.594" ttm:agent="v1"><span begin="1:31.019" end="1:31.449">„S-a</span> <span begin="1:31.449" end="1:32.738">născut</span> <span begin="1:32.738" end="1:34.026">Isus</span> <span begin="1:34.026" end="1:37.594">Hristos!”</span></p><p begin="1:37.594" end="1:42.518" ttm:agent="v1"><span begin="1:37.594" end="1:38.415">Pentru</span> <span begin="1:38.415" end="1:40.056">cine</span> <span begin="1:40.056" end="1:40.466">zări</span> <span begin="1:40.466" end="1:42.518">senine</span></p><p begin="1:42.518" end="1:47.441" ttm:agent="v1"><span begin="1:42.518" end="1:43.338">Poartă-n</span> <span begin="1:43.338" end="1:44.979">ceruri</span> <span begin="1:44.979" end="1:45.390">au</span> <span begin="1:45.390" end="1:47.441">deschis,</span></p><p begin="1:47.441" end="1:52.365" ttm:agent="v1"><span begin="1:47.441" end="1:47.851">Ca</span> <span begin="1:47.851" end="1:48.262">să</span> <span begin="1:48.262" end="1:49.903">vină,</span> <span begin="1:49.903" end="1:50.313">din</span> <span begin="1:50.313" end="1:52.365">lumină,</span></p><p begin="1:52.365" end="1:57.288" ttm:agent="v1"><span begin="1:52.365" end="1:52.775">Cel</span> <span begin="1:52.775" end="1:53.185">ce-a</span> <span begin="1:53.185" end="1:54.006">fost</span> <span begin="1:54.006" end="1:54.826">din</span> <span begin="1:54.826" end="1:55.237">vremi</span> <span begin="1:55.237" end="1:57.288">prezis?</span></p><p begin="1:57.288" end="2:02.211" ttm:agent="v1"><span begin="1:57.288" end="1:58.108">Domnul</span> <span begin="1:58.108" end="1:59.750">slavei</span> <span begin="1:59.750" end="2:00.570">pentru</span> <span begin="2:00.570" end="2:02.211">mine,</span></p><p begin="2:02.211" end="2:07.135" ttm:agent="v1"><span begin="2:02.211" end="2:03.032">Domnul</span> <span begin="2:03.032" end="2:04.673">slavei</span> <span begin="2:04.673" end="2:05.494">pentru</span> <span begin="2:05.494" end="2:07.135">tine,</span></p><p begin="2:07.135" end="2:12.058" ttm:agent="v1"><span begin="2:07.135" end="2:09.596">Mântuire</span> <span begin="2:09.596" end="2:10.007">să</span> <span begin="2:10.007" end="2:12.058">avem,</span></p><p begin="2:12.058" end="2:16.161" ttm:agent="v1"><span begin="2:12.058" end="2:12.468">S-a</span> <span begin="2:12.468" end="2:13.699">născut</span> <span begin="2:13.699" end="2:14.520">în</span> <span begin="2:14.520" end="2:16.161">Betleem.</span></p></div></body></tt>