<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>134. Hristos, Mare Preot</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="4:00.327"><div><p begin="1:13.276" end="1:19.639" ttm:agent="v1"><span begin="1:13.276" end="1:15.397">Hristos,</span> <span begin="1:15.397" end="1:17.518">Mare</span> <span begin="1:17.518" end="1:19.639">Preot,</span></p><p begin="1:19.639" end="1:29.183" ttm:agent="v1"><span begin="1:19.639" end="1:21.759">În</span> <span begin="1:21.759" end="1:24.941">ceruri</span> <span begin="1:24.941" end="1:26.001">se</span> <span begin="1:26.001" end="1:29.183">roagă,</span></p><p begin="1:29.183" end="1:36.606" ttm:agent="v1"><span begin="1:29.183" end="1:30.243">Un</span> <span begin="1:30.243" end="1:32.364">scump</span> <span begin="1:32.364" end="1:36.606">Salvator</span></p><p begin="1:36.606" end="1:46.150" ttm:agent="v1"><span begin="1:36.606" end="1:37.666">Și</span> <span begin="1:37.666" end="1:41.908">Prieten</span> <span begin="1:41.908" end="1:42.969">al</span> <span begin="1:42.969" end="1:46.150">meu...</span></p><p begin="1:46.150" end="1:53.573" ttm:agent="v1"><span begin="1:46.150" end="1:47.210">El</span> <span begin="1:47.210" end="1:49.331">mi-e</span> <span begin="1:49.331" end="1:53.573">adăpost</span></p><p begin="1:53.573" end="2:03.117" ttm:agent="v1"><span begin="1:53.573" end="1:55.694">Pentru</span> <span begin="1:55.694" end="1:58.875">viața</span> <span begin="1:58.875" end="2:03.117">întreagă,</span></p><p begin="2:03.117" end="2:10.540" ttm:agent="v1"><span begin="2:03.117" end="2:04.178">Ah,</span> <span begin="2:04.178" end="2:06.298">mult</span> <span begin="2:06.298" end="2:07.359">aș</span> <span begin="2:07.359" end="2:10.540">dori</span></p><p begin="2:10.540" end="2:30.450" ttm:agent="v1"><span begin="2:10.540" end="2:11.601">Ca</span> <span begin="2:11.601" end="2:12.661">să</span> <span begin="2:12.661" end="2:15.843">fie</span> <span begin="2:15.843" end="2:16.903">și-al</span> <span begin="2:16.903" end="2:30.450">tău!</span></p><p begin="2:30.450" end="2:36.845" ttm:agent="v1"><span begin="2:30.450" end="2:30.450">Și</span> <span begin="2:30.450" end="2:32.582">când,</span> <span begin="2:32.582" end="2:33.648">în</span> <span begin="2:33.648" end="2:36.845">sfârșit,</span></p><p begin="2:36.845" end="2:46.437" ttm:agent="v1"><span begin="2:36.845" end="2:37.911">În</span> <span begin="2:37.911" end="2:42.174">iubirea</span> <span begin="2:42.174" end="2:43.239">Lui</span> <span begin="2:43.239" end="2:46.437">caldă,</span></p><p begin="2:46.437" end="2:53.897" ttm:agent="v1"><span begin="2:46.437" end="2:47.502">Un</span> <span begin="2:47.502" end="2:49.634">scump</span> <span begin="2:49.634" end="2:53.897">Salvator</span></p><p begin="2:53.897" end="3:03.489" ttm:agent="v1"><span begin="2:53.897" end="2:54.963">În</span> <span begin="2:54.963" end="2:58.160">Isus</span> <span begin="2:58.160" end="2:59.226">ai</span> <span begin="2:59.226" end="3:03.489">aflat,</span></p><p begin="3:03.489" end="3:12.015" ttm:agent="v1"><span begin="3:03.489" end="3:04.554">Și</span> <span begin="3:04.554" end="3:06.686">tu</span> <span begin="3:06.686" end="3:08.817">pentru</span> <span begin="3:08.817" end="3:12.015">alții</span></p><p begin="3:12.015" end="3:20.541" ttm:agent="v1"><span begin="3:12.015" end="3:16.278">Fierbinte</span> <span begin="3:16.278" end="3:17.344">te</span> <span begin="3:17.344" end="3:20.541">roagă,</span></p><p begin="3:20.541" end="3:28.001" ttm:agent="v1"><span begin="3:20.541" end="3:24.804">Salvează-i</span> <span begin="3:24.804" end="3:25.870">pe</span> <span begin="3:25.870" end="3:28.001">ei,</span></p><p begin="3:28.001" end="3:35.461" ttm:agent="v1"><span begin="3:28.001" end="3:29.067">Cum</span> <span begin="3:29.067" end="3:30.133">și</span> <span begin="3:30.133" end="3:32.264">tu</span> <span begin="3:32.264" end="3:33.330">ești</span> <span begin="3:33.330" end="3:35.461">salvat!</span></p></div></body></tt>