<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>775. De Cel Etern</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:55.644"><div><p begin="0:16.558" end="0:24.109" ttm:agent="v1"><span begin="0:16.558" end="0:17.188">De</span> <span begin="0:17.188" end="0:18.446">Cel</span> <span begin="0:18.446" end="0:19.705">Etern</span> <span begin="0:19.705" end="0:20.334">tot</span> <span begin="0:20.334" end="0:22.222">cuprinsul</span> <span begin="0:22.222" end="0:22.851">dă</span> <span begin="0:22.851" end="0:24.109">știre,</span></p><p begin="0:24.109" end="0:31.660" ttm:agent="v1"><span begin="0:24.109" end="0:26.626">Rostindu-I</span> <span begin="0:26.626" end="0:29.772">Numele</span> <span begin="0:29.772" end="0:31.660">preasfânt,</span></p><p begin="0:31.660" end="0:39.211" ttm:agent="v1"><span begin="0:31.660" end="0:33.548">Întreg</span> <span begin="0:33.548" end="0:35.436">pământul</span> <span begin="0:35.436" end="0:37.323">I-aduce</span> <span begin="0:37.323" end="0:39.211">mărire,</span></p><p begin="0:39.211" end="0:48.722" ttm:agent="v1"><span begin="0:39.211" end="0:41.728">Ascultă</span> <span begin="0:41.728" end="0:42.986">dar</span> <span begin="0:42.986" end="0:43.616">al</span> <span begin="0:43.616" end="0:44.874">Său</span> <span begin="0:44.874" end="0:48.722">Cuvânt!</span></p><p begin="0:48.722" end="0:56.311" ttm:agent="v1"><span begin="0:48.722" end="0:49.354">„A</span> <span begin="0:49.354" end="0:50.619">Mea-i</span> <span begin="0:50.619" end="0:52.516">tăria</span> <span begin="0:52.516" end="0:53.149">și</span> <span begin="0:53.149" end="0:54.413">cerul</span> <span begin="0:54.413" end="0:55.046">și</span> <span begin="0:55.046" end="0:56.311">marea,</span></p><p begin="0:56.311" end="1:03.899" ttm:agent="v1"><span begin="0:56.311" end="0:56.943">Sunt</span> <span begin="0:56.943" end="0:58.208">Cel</span> <span begin="0:58.208" end="0:58.840">ce</span> <span begin="0:58.840" end="1:00.105">sunt</span> <span begin="1:00.105" end="1:00.737">și-n</span> <span begin="1:00.737" end="1:02.002">veac</span> <span begin="1:02.002" end="1:02.634">voi</span> <span begin="1:02.634" end="1:03.899">sta,</span></p><p begin="1:03.899" end="1:11.488" ttm:agent="v1"><span begin="1:03.899" end="1:04.532">Mă</span> <span begin="1:04.532" end="1:05.796">poți</span> <span begin="1:05.796" end="1:07.693">cunoaște</span> <span begin="1:07.693" end="1:08.326">din</span> <span begin="1:08.326" end="1:09.591">toată</span> <span begin="1:09.591" end="1:11.488">lucrarea,</span></p><p begin="1:11.488" end="1:19.216" ttm:agent="v1"><span begin="1:11.488" end="1:14.017">Părinte</span> <span begin="1:14.017" end="1:15.282">bun</span> <span begin="1:15.282" end="1:15.914">Mă</span> <span begin="1:15.914" end="1:17.179">poți</span> <span begin="1:17.179" end="1:19.216">afla.”</span></p><p begin="1:19.216" end="1:26.691" ttm:agent="v1"><span begin="1:19.216" end="1:19.839">„Sunt</span> <span begin="1:19.839" end="1:22.954">Creatorul,</span> <span begin="1:22.954" end="1:24.822">Iubirea,</span> <span begin="1:24.822" end="1:26.691">Știința,</span></p><p begin="1:26.691" end="1:34.166" ttm:agent="v1"><span begin="1:26.691" end="1:27.314">Sunt</span> <span begin="1:27.314" end="1:29.183">Domnul</span> <span begin="1:29.183" end="1:30.429">și</span> <span begin="1:30.429" end="1:32.920">Salvarea</span> <span begin="1:32.920" end="1:34.166">ta,</span></p><p begin="1:34.166" end="1:41.641" ttm:agent="v1"><span begin="1:34.166" end="1:36.658">Predă-te</span> <span begin="1:36.658" end="1:37.903">Mie</span> <span begin="1:37.903" end="1:38.526">cu</span> <span begin="1:38.526" end="1:39.772">toată</span> <span begin="1:39.772" end="1:41.641">ființa</span></p><p begin="1:41.641" end="1:48.493" ttm:agent="v1"><span begin="1:41.641" end="1:42.264">Și</span> <span begin="1:42.264" end="1:44.132">harul</span> <span begin="1:44.132" end="1:45.378">Meu</span> <span begin="1:45.378" end="1:46.001">îl</span> <span begin="1:46.001" end="1:47.247">vei</span> <span begin="1:47.247" end="1:48.493">avea!”</span></p></div></body></tt>