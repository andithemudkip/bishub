<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>690. Blând Păstor al vieții mele</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:37.149"><div><p begin="0:14.225" end="0:20.604" ttm:agent="v1"><span begin="0:14.225" end="0:15.023">Blând</span> <span begin="0:15.023" end="0:17.016">Păstor</span> <span begin="0:17.016" end="0:17.415">al</span> <span begin="0:17.415" end="0:19.009">vieții</span> <span begin="0:19.009" end="0:20.604">mele,</span></p><p begin="0:20.604" end="0:26.983" ttm:agent="v1"><span begin="0:20.604" end="0:21.401">Somn</span> <span begin="0:21.401" end="0:22.199">pe</span> <span begin="0:22.199" end="0:23.793">pleoape</span> <span begin="0:23.793" end="0:24.989">Tu</span> <span begin="0:24.989" end="0:25.388">să-mi</span> <span begin="0:25.388" end="0:26.983">pui!</span></p><p begin="0:26.983" end="0:33.361" ttm:agent="v1"><span begin="0:26.983" end="0:29.375">Picură-mi</span> <span begin="0:29.375" end="0:31.590">argint</span> <span begin="0:31.590" end="0:31.944">de</span> <span begin="0:31.944" end="0:33.361">stele</span></p><p begin="0:33.361" end="0:36.120" ttm:agent="v1"><span begin="0:33.361" end="0:34.159">În</span> <span begin="0:34.159" end="0:36.551">potirul</span> <span begin="0:36.551" end="0:36.120">visului...</span></p><p begin="0:36.120" end="0:42.435" ttm:agent="v1"><span begin="0:36.120" end="0:37.699">Mâna</span> <span begin="0:37.699" end="0:38.883">Ta</span> <span begin="0:38.883" end="0:39.277">m-a</span> <span begin="0:39.277" end="0:40.067">dus,</span> <span begin="0:40.067" end="0:40.856">de</span> <span begin="0:40.856" end="0:42.435">mână,</span></p><p begin="0:42.435" end="0:48.750" ttm:agent="v1"><span begin="0:42.435" end="0:43.224">Pe</span> <span begin="0:43.224" end="0:44.014">al</span> <span begin="0:44.014" end="0:45.987">zilei</span> <span begin="0:45.987" end="0:46.382">drum</span> <span begin="0:46.382" end="0:48.750">spinos,</span></p><p begin="0:48.750" end="0:55.065" ttm:agent="v1"><span begin="0:48.750" end="0:49.539">Chiar</span> <span begin="0:49.539" end="0:50.329">și-n</span> <span begin="0:50.329" end="0:51.907">noapte</span> <span begin="0:51.907" end="0:53.661">să</span> <span begin="0:53.661" end="0:55.065">rămână,</span></p><p begin="0:55.065" end="1:02.560" ttm:agent="v1"><span begin="0:55.065" end="0:56.643">Peste</span> <span begin="0:56.643" end="0:58.222">mine,</span> <span begin="0:58.222" end="0:59.801">scump</span> <span begin="0:59.801" end="1:02.560">Hristos!</span></p><p begin="1:02.560" end="1:08.780" ttm:agent="v1"><span begin="1:02.560" end="1:05.670">Mângâierea</span> <span begin="1:05.670" end="1:06.447">Ta</span> <span begin="1:06.447" end="1:08.780">divină</span></p><p begin="1:08.780" end="1:15.000" ttm:agent="v1"><span begin="1:08.780" end="1:09.557">Să</span> <span begin="1:09.557" end="1:10.335">mă</span> <span begin="1:10.335" end="1:11.890">țină</span> <span begin="1:11.890" end="1:13.445">până-n</span> <span begin="1:13.445" end="1:15.000">zori</span></p><p begin="1:15.000" end="1:21.220" ttm:agent="v1"><span begin="1:15.000" end="1:15.777">Și-mi</span> <span begin="1:15.777" end="1:16.555">vei</span> <span begin="1:16.555" end="1:17.332">fi</span> <span begin="1:17.332" end="1:18.110">din</span> <span begin="1:18.110" end="1:19.492">nou</span> <span begin="1:19.492" end="1:21.220">lumină,</span></p><p begin="1:21.220" end="1:26.663" ttm:agent="v1"><span begin="1:21.220" end="1:21.998">Tu,</span> <span begin="1:21.998" end="1:24.330">iubitul</span> <span begin="1:24.330" end="1:25.108">meu</span> <span begin="1:25.108" end="1:26.663">Păstor!</span></p></div></body></tt>