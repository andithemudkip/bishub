<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>149. Sfânt Cuvânt</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="1:56.976"><div><p begin="0:13.100" end="0:18.812" ttm:agent="v1"><span begin="0:13.100" end="0:13.814">Sfânt</span> <span begin="0:13.814" end="0:15.242">Cuvânt</span> <span begin="0:15.242" end="0:15.956">de</span> <span begin="0:15.956" end="0:16.670">har</span> <span begin="0:16.670" end="0:18.812">divin,</span></p><p begin="0:18.812" end="0:24.524" ttm:agent="v1"><span begin="0:18.812" end="0:19.526">De</span> <span begin="0:19.526" end="0:21.668">lumina</span> <span begin="0:21.668" end="0:23.096">vieții</span> <span begin="0:23.096" end="0:24.524">plin,</span></p><p begin="0:24.524" end="0:30.236" ttm:agent="v1"><span begin="0:24.524" end="0:25.952">Lasă</span> <span begin="0:25.952" end="0:27.380">astăzi</span> <span begin="0:27.380" end="0:28.808">raza</span> <span begin="0:28.808" end="0:30.236">Ta</span></p><p begin="0:30.236" end="0:37.848" ttm:agent="v1"><span begin="0:30.236" end="0:30.950">Să</span> <span begin="0:30.950" end="0:31.664">ne</span> <span begin="0:31.664" end="0:33.092">umple</span> <span begin="0:33.092" end="0:37.848">inima!</span></p><p begin="0:37.848" end="0:43.560" ttm:agent="v1"><span begin="0:37.848" end="0:38.562">Sfânt</span> <span begin="0:38.562" end="0:39.990">Cuvânt</span> <span begin="0:39.990" end="0:43.560">ocrotitor,</span></p><p begin="0:43.560" end="0:49.273" ttm:agent="v1"><span begin="0:43.560" end="0:44.274">De</span> <span begin="0:44.274" end="0:46.417">viață</span> <span begin="0:46.417" end="0:49.273">dătător,</span></p><p begin="0:49.273" end="0:54.985" ttm:agent="v1"><span begin="0:49.273" end="0:49.987">Prin</span> <span begin="0:49.987" end="0:53.557">înțelepciunea</span> <span begin="0:53.557" end="0:54.985">Ta,</span></p><p begin="0:54.985" end="0:57.177" ttm:agent="v1"><span begin="0:54.985" end="0:56.413">Numai</span> <span begin="0:56.413" end="0:57.127">Tu</span> <span begin="0:57.127" end="0:57.841">ne</span> <span begin="0:57.841" end="0:58.555">poți</span> <span begin="0:58.555" end="0:57.177">salva!</span></p><p begin="0:57.177" end="1:02.746" ttm:agent="v1"><span begin="0:57.177" end="0:57.873">Sfânt</span> <span begin="0:57.873" end="0:59.265">Cuvânt,</span> <span begin="0:59.265" end="0:59.961">Tu</span> <span begin="0:59.961" end="1:00.658">să</span> <span begin="1:00.658" end="1:01.354">ne</span> <span begin="1:01.354" end="1:02.746">fii</span></p><p begin="1:02.746" end="1:08.315" ttm:agent="v1"><span begin="1:02.746" end="1:03.442">Drum</span> <span begin="1:03.442" end="1:04.835">deschis</span> <span begin="1:04.835" end="1:05.531">spre</span> <span begin="1:05.531" end="1:08.315">bucurii!</span></p><p begin="1:08.315" end="1:13.885" ttm:agent="v1"><span begin="1:08.315" end="1:09.012">Cu</span> <span begin="1:09.012" end="1:11.100">nădejde</span> <span begin="1:11.100" end="1:13.885">ne-ndreptăm</span></p><p begin="1:13.885" end="1:21.974" ttm:agent="v1"><span begin="1:13.885" end="1:14.581">Spre</span> <span begin="1:14.581" end="1:15.973">Isus</span> <span begin="1:15.973" end="1:16.669">și</span> <span begin="1:16.669" end="1:21.974">ne-nchinăm!</span></p><p begin="1:21.974" end="1:27.627" ttm:agent="v1"><span begin="1:21.974" end="1:22.681">Sfânt</span> <span begin="1:22.681" end="1:24.094">Cuvânt</span> <span begin="1:24.094" end="1:24.800">al</span> <span begin="1:24.800" end="1:25.507">lui</span> <span begin="1:25.507" end="1:27.627">Hristos,</span></p><p begin="1:27.627" end="1:33.280" ttm:agent="v1"><span begin="1:27.627" end="1:28.333">Viu,</span> <span begin="1:28.333" end="1:29.747">curat</span> <span begin="1:29.747" end="1:30.453">și</span> <span begin="1:30.453" end="1:33.280">credincios,</span></p><p begin="1:33.280" end="1:38.932" ttm:agent="v1"><span begin="1:33.280" end="1:34.693">Vino</span> <span begin="1:34.693" end="1:35.399">și</span> <span begin="1:35.399" end="1:37.519">zidește-n</span> <span begin="1:37.519" end="1:38.932">noi</span></p><p begin="1:38.932" end="1:44.585" ttm:agent="v1"><span begin="1:38.932" end="1:40.346">Templul</span> <span begin="1:40.346" end="1:41.759">unor</span> <span begin="1:41.759" end="1:43.172">inimi</span> <span begin="1:43.172" end="1:44.585">noi!</span></p></div></body></tt>