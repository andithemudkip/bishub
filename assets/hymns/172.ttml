<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:composer="https://composer.boidu.dev/ttml" ttp:timeBase="media" xml:lang="ro" composer:timing="Word"><head><metadata><ttm:title>172. Mai e har și pentru mine?</ttm:title><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent></metadata></head><body dur="2:23.935"><div><p begin="0:15.091" end="0:21.901" ttm:agent="v1"><span begin="0:15.091" end="0:16.226">Mai</span> <span begin="0:16.226" end="0:16.794">e</span> <span begin="0:16.794" end="0:17.929">har</span> <span begin="0:17.929" end="0:18.496">și</span> <span begin="0:18.496" end="0:20.199">pentru</span> <span begin="0:20.199" end="0:21.901">mine,</span></p><p begin="0:21.901" end="0:28.711" ttm:agent="v1"><span begin="0:21.901" end="0:23.036">Când</span> <span begin="0:23.036" end="0:25.306">atâta-s</span> <span begin="0:25.306" end="0:26.441">de</span> <span begin="0:26.441" end="0:28.711">căzut?</span></p><p begin="0:28.711" end="0:35.521" ttm:agent="v1"><span begin="0:28.711" end="0:29.846">Simt</span> <span begin="0:29.846" end="0:31.549">regret</span> <span begin="0:31.549" end="0:33.251">adânc</span> <span begin="0:33.251" end="0:33.819">în</span> <span begin="0:33.819" end="0:35.521">suflet</span></p><p begin="0:35.521" end="0:42.231" ttm:agent="v1"><span begin="0:35.521" end="0:37.223">Fiindcă</span> <span begin="0:37.223" end="0:38.358">mult</span> <span begin="0:38.358" end="0:38.926">m-am</span> <span begin="0:38.926" end="0:42.231">abătut.</span></p><p begin="0:42.231" end="0:49.007" ttm:agent="v1"><span begin="0:42.231" end="0:43.925">Doamne,</span> <span begin="0:43.925" end="0:46.748">spală-mă</span> <span begin="0:46.748" end="0:49.007">curat</span></p><p begin="0:49.007" end="0:57.182" ttm:agent="v1"><span begin="0:49.007" end="0:50.136">De</span> <span begin="0:50.136" end="0:52.394">grozavul</span> <span begin="0:52.394" end="0:53.524">meu</span> <span begin="0:53.524" end="0:57.182">păcat!</span></p><p begin="0:57.182" end="1:03.890" ttm:agent="v1"><span begin="0:57.182" end="0:58.300">Da,</span> <span begin="0:58.300" end="0:58.859">am</span> <span begin="0:58.859" end="1:01.654">meritat</span> <span begin="1:01.654" end="1:03.890">pedeapsa,</span></p><p begin="1:03.890" end="1:10.598" ttm:agent="v1"><span begin="1:03.890" end="1:05.567">Moartea</span> <span begin="1:05.567" end="1:06.685">chiar</span> <span begin="1:06.685" end="1:07.244">e</span> <span begin="1:07.244" end="1:08.921">plata</span> <span begin="1:08.921" end="1:10.598">mea...</span></p><p begin="1:10.598" end="1:17.306" ttm:agent="v1"><span begin="1:10.598" end="1:11.716">De</span> <span begin="1:11.716" end="1:13.952">ocara</span> <span begin="1:13.952" end="1:15.070">ce</span> <span begin="1:15.070" end="1:17.306">m-apasă</span></p><p begin="1:17.306" end="1:22.434" ttm:agent="v1"><span begin="1:17.306" end="1:18.983">Cine</span> <span begin="1:18.983" end="1:20.101">mă</span> <span begin="1:20.101" end="1:20.660">va</span> <span begin="1:20.660" end="1:22.434">libera?</span></p><p begin="1:22.434" end="1:29.243" ttm:agent="v1"><span begin="1:22.434" end="1:24.137">Doamne,</span> <span begin="1:24.137" end="1:26.973">spală-mă</span> <span begin="1:26.973" end="1:29.243">curat</span></p><p begin="1:29.243" end="1:39.252" ttm:agent="v1"><span begin="1:29.243" end="1:30.378">De</span> <span begin="1:30.378" end="1:32.647">grozavul</span> <span begin="1:32.647" end="1:33.782">meu</span> <span begin="1:33.782" end="1:39.252">păcat!</span></p><p begin="1:39.252" end="1:45.992" ttm:agent="v1"><span begin="1:39.252" end="1:40.375">Cu</span> <span begin="1:40.375" end="1:42.622">povara-mi</span> <span begin="1:42.622" end="1:43.745">de</span> <span begin="1:43.745" end="1:45.992">păcate,</span></p><p begin="1:45.992" end="1:52.733" ttm:agent="v1"><span begin="1:45.992" end="1:47.677">Doamne,</span> <span begin="1:47.677" end="1:48.801">nu</span> <span begin="1:48.801" end="1:49.363">mă</span> <span begin="1:49.363" end="1:52.733">lepăda,</span></p><p begin="1:52.733" end="1:59.473" ttm:agent="v1"><span begin="1:52.733" end="1:55.541">Lasă-mă</span> <span begin="1:55.541" end="1:56.103">să</span> <span begin="1:56.103" end="1:57.226">vin</span> <span begin="1:57.226" end="1:57.788">la</span> <span begin="1:57.788" end="1:59.473">Tine,</span></p><p begin="1:59.473" end="2:06.174" ttm:agent="v1"><span begin="1:59.473" end="2:01.158">Numai</span> <span begin="2:01.158" end="2:02.282">Tu</span> <span begin="2:02.282" end="2:02.844">mă</span> <span begin="2:02.844" end="2:03.967">poți</span> <span begin="2:03.967" end="2:06.174">salva!</span></p><p begin="2:06.174" end="2:12.948" ttm:agent="v1"><span begin="2:06.174" end="2:07.867">Doamne,</span> <span begin="2:07.867" end="2:10.690">spală-mă</span> <span begin="2:10.690" end="2:12.948">curat</span></p><p begin="2:12.948" end="2:18.593" ttm:agent="v1"><span begin="2:12.948" end="2:14.077">De</span> <span begin="2:14.077" end="2:16.335">grozavul</span> <span begin="2:16.335" end="2:17.464">meu</span> <span begin="2:17.464" end="2:18.593">păcat!</span></p></div></body></tt>