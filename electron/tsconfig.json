{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "composite": false
  },
  "include": ["./**/*.ts", "../src/shared/**/*.ts"],
  "exclude": ["node_modules"]
}
